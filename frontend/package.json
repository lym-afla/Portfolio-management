{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node scripts/check-lint-baseline.mjs && node scripts/check-lint-scope.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "node tests/browser/run-smoke.mjs",
    "test:delivery": "node tests/browser/run-smoke.mjs --case delivery",
    "test:dialogs": "node tests/browser/run-smoke.mjs --case dialogs",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss}\"",
    "type-check": "vue-tsc --noEmit",
    "type-check:charts": "vue-tsc --noEmit -p tsconfig.charts.json",
    "type-check:reliability": "vue-tsc --noEmit -p tsconfig.reliability.json",
    "api:types:generate": "node scripts/generate-api-types.mjs --write",
    "api:types:check": "node scripts/generate-api-types.mjs --check"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@vee-validate/i18n": "^4.13.2",
    "@vee-validate/rules": "^4.13.2",
    "axios": "^1.7.3",
    "chart.js": "^4.4.4",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "core-js": "^3.8.3",
    "date-fns": "^3.6.0",
    "lodash": "^4.17.21",
    "pinia": "^3.0.4",
    "vee-validate": "^4.5.8",
    "vue": "^3.4.37",
    "vue-chartjs": "^5.3.1",
    "vue-router": "^4.4.3",
    "vuetify": "^3.12.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "agent-browser": "0.36.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.1.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
