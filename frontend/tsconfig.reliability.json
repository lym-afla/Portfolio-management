{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "checkJs": false,
    "composite": false
  },
  "include": [
    "src/types/portfolioContext.ts",
    "src/stores/portfolioContext.ts",
    "src/composables/useLatestRequest.ts",
    "src/composables/usePortfolioRequest.ts",
    "src/types/query.ts",
    "src/services/http/**/*.ts",
    "src/services/api/**/*.ts",
    "src/types/portfolioTables.ts",
    "src/services/contracts/**/*.ts",
    "src/services/transport/**/*.ts",
    "tests/unit/helpers/**/*.ts",
    "tests/unit/harness/**/*.ts",
    "tests/unit/composables/**/*.ts",
    "tests/unit/services/**/*.ts",
    "env.d.ts"
  ],
  "exclude": [
    // D6: the useWebSocket spec imports the auth store and services/api,
    // dragging the whole (not strict-clean) app graph into this strict
    // project. The spec is type-checked by the main tsconfig (explicit
    // include there) and exercised by vitest; it is excluded here to keep
    // this project scoped to the reliability platform files.
    "tests/unit/composables/useWebSocket.spec.ts"
  ],
  "references": []
}
