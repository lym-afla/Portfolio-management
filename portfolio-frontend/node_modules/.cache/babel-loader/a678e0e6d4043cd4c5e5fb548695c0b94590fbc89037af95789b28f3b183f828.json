{"ast":null,"code":"import { resolveComponent as _resolveComponent, openBlock as _openBlock, createBlock as _createBlock, createCommentVNode as _createCommentVNode, createElementBlock as _createElementBlock, pushScopeId as _pushScopeId, popScopeId as _popScopeId } from \"vue\";\nconst _withScopeId = n => (_pushScopeId(\"data-v-d030c262\"), n = n(), _popScopeId(), n);\nconst _hoisted_1 = {\n  key: 1\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_Line = _resolveComponent(\"Line\");\n  return _openBlock(), _createElementBlock(\"div\", null, [$options.chartData.datasets.length > 0 ? (_openBlock(), _createBlock(_component_Line, {\n    key: 0,\n    data: $options.chartData,\n    options: $options.chartOptions\n  }, null, 8 /* PROPS */, [\"data\", \"options\"])) : (_openBlock(), _createElementBlock(\"p\", _hoisted_1, \"No data available for the chart.\"))]);\n}","map":{"version":3,"names":["key","_createElementBlock","$options","chartData","datasets","length","_createBlock","_component_Line","data","options","chartOptions","_hoisted_1"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\charts\\PriceChart.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <Line v-if=\"chartData.datasets.length > 0\" :data=\"chartData\" :options=\"chartOptions\" />\r\n    <p v-else>No data available for the chart.</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Line } from 'vue-chartjs'\r\nimport { Chart as ChartJS, Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale } from 'chart.js'\r\n\r\nChartJS.register(Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale)\r\n\r\nexport default {\r\n  name: 'PriceChart',\r\n  components: {\r\n    Line\r\n  },\r\n  props: {\r\n    prices: {\r\n      type: Array,\r\n      required: true\r\n    }\r\n  },\r\n  computed: {\r\n    chartData() {\r\n      console.log('Prices prop:', this.prices);\r\n\r\n      if (!this.prices || this.prices.length === 0) {\r\n        console.log('No prices available');\r\n        return {\r\n          labels: [],\r\n          datasets: []\r\n        }\r\n      }\r\n\r\n      // Group prices by security\r\n      const pricesBySecurity = this.prices.reduce((acc, price) => {\r\n        if (!acc[price.security__name]) {\r\n          acc[price.security__name] = [];\r\n        }\r\n        acc[price.security__name].push(price);\r\n        return acc;\r\n      }, {});\r\n\r\n      // Get unique dates across all securities\r\n      const allDates = [...new Set(this.prices.map(price => price.date))].sort();\r\n\r\n      // Generate datasets for each security\r\n      const datasets = Object.entries(pricesBySecurity).map(([securityName, prices], index) => {\r\n        const data = allDates.map(date => {\r\n          const price = prices.find(p => p.date === date);\r\n          return price ? parseFloat(price.price) : null;\r\n        });\r\n\r\n        return {\r\n          label: securityName,\r\n          data: data,\r\n          borderColor: this.getColor(index),\r\n          backgroundColor: this.getColor(index, 0.2),\r\n          fill: false,\r\n          tension: 0.1\r\n        };\r\n      });\r\n\r\n      console.log('Datasets:', datasets);\r\n\r\n      return {\r\n        labels: allDates,\r\n        datasets: datasets\r\n      }\r\n    },\r\n    chartOptions() {\r\n      return {\r\n        responsive: true,\r\n        maintainAspectRatio: false,\r\n        scales: {\r\n          y: {\r\n            beginAtZero: true\r\n          }\r\n        },\r\n        plugins: {\r\n          legend: {\r\n            display: true\r\n          }\r\n        }\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    getColor(index, alpha = 1) {\r\n      const colors = [\r\n        `rgba(66, 165, 245, ${alpha})`,   // blue\r\n        `rgba(239, 83, 80, ${alpha})`,    // red\r\n        `rgba(102, 187, 106, ${alpha})`,  // green\r\n        `rgba(255, 167, 38, ${alpha})`,   // orange\r\n        `rgba(171, 71, 188, ${alpha})`,   // purple\r\n        `rgba(255, 214, 0, ${alpha})`,    // yellow\r\n      ];\r\n      return colors[index % colors.length];\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n  position: relative;\r\n  /* height: 40vh;\r\n  width: 100%; */\r\n}\r\n</style>"],"mappings":";;;EAAAA,GAAA;AAAA;;;uBACEC,mBAAA,CAGM,cAFQC,QAAA,CAAAC,SAAS,CAACC,QAAQ,CAACC,MAAM,Q,cAArCC,YAAA,CAAuFC,eAAA;IAF3FP,GAAA;IAEgDQ,IAAI,EAAEN,QAAA,CAAAC,SAAS;IAAGM,OAAO,EAAEP,QAAA,CAAAQ;iEACvET,mBAAA,CAA8C,KAHlDU,UAAA,EAGc,kCAAgC,G","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}