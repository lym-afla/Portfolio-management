{"ast":null,"code":"import { computed, watch } from 'vue';\nexport default {\n  name: 'ProgressDialog',\n  props: {\n    modelValue: Boolean,\n    title: {\n      type: String,\n      default: 'Progress'\n    },\n    progress: {\n      type: Number,\n      default: 0\n    },\n    current: {\n      type: Number,\n      default: 0\n    },\n    total: {\n      type: Number,\n      default: 0\n    },\n    currentMessage: {\n      type: String,\n      default: ''\n    },\n    error: {\n      type: String,\n      default: ''\n    }\n  },\n  emits: ['update:modelValue'],\n  setup(props, {\n    emit\n  }) {\n    const dialogModel = computed({\n      get: () => props.modelValue,\n      set: value => emit('update:modelValue', value)\n    });\n    const closeDialog = () => {\n      emit('update:modelValue', false);\n    };\n    watch(() => props.progress, newValue => {\n      console.log('ProgressDialog: progress prop changed to', newValue);\n    });\n    return {\n      dialogModel,\n      closeDialog\n    };\n  }\n};","map":{"version":3,"names":["computed","watch","name","props","modelValue","Boolean","title","type","String","default","progress","Number","current","total","currentMessage","error","emits","setup","emit","dialogModel","get","set","value","closeDialog","newValue","console","log"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\ProgressDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialogModel\" persistent max-width=\"400px\">\r\n    <v-card>\r\n      <v-card-title class=\"d-flex align-center\">\r\n        {{ title }}\r\n        <v-spacer></v-spacer>\r\n        <v-progress-circular\r\n          indeterminate\r\n          color=\"primary\"\r\n          size=\"24\"\r\n          width=\"2\"\r\n          class=\"ml-2\"\r\n        ></v-progress-circular>\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-progress-linear\r\n          :model-value=\"progress\"\r\n          height=\"25\"\r\n          color=\"primary\"\r\n          class=\"mb-2\"\r\n        >\r\n          <template v-slot:default=\"{ value }\">\r\n            <strong :class=\"{ 'white--text': Math.ceil(value) > 10 }\">{{ Math.ceil(value) }}%</strong>\r\n          </template>\r\n        </v-progress-linear>\r\n        <v-row no-gutters>\r\n          <v-col cols=\"12\" class=\"text-center\">\r\n            <div class=\"text-subtitle-2 font-weight-medium\">\r\n              Processing {{ current }} of {{ total }}\r\n            </div>\r\n          </v-col>\r\n        </v-row>\r\n        <v-row no-gutters v-if=\"currentMessage\">\r\n          <v-col cols=\"12\">\r\n            <v-card outlined class=\"mt-2 pa-2\">\r\n              <div class=\"text-body-2\">{{ currentMessage }}</div>\r\n            </v-card>\r\n          </v-col>\r\n        </v-row>\r\n        <v-alert v-if=\"error\" type=\"error\" class=\"mt-4\">\r\n          {{ error }}\r\n        </v-alert>\r\n      </v-card-text>\r\n      <v-card-actions v-if=\"error\">\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"closeDialog\">Close</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { computed, watch } from 'vue'\r\n\r\nexport default {\r\n  name: 'ProgressDialog',\r\n  props: {\r\n    modelValue: Boolean,\r\n    title: {\r\n      type: String,\r\n      default: 'Progress'\r\n    },\r\n    progress: {\r\n      type: Number,\r\n      default: 0\r\n    },\r\n    current: {\r\n      type: Number,\r\n      default: 0\r\n    },\r\n    total: {\r\n      type: Number,\r\n      default: 0\r\n    },\r\n    currentMessage: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    error: {\r\n      type: String,\r\n      default: ''\r\n    }\r\n  },\r\n  emits: ['update:modelValue'],\r\n  setup(props, { emit }) {\r\n    const dialogModel = computed({\r\n      get: () => props.modelValue,\r\n      set: (value) => emit('update:modelValue', value)\r\n    })\r\n\r\n    const closeDialog = () => {\r\n      emit('update:modelValue', false)\r\n    }\r\n\r\n    watch(() => props.progress, (newValue) => {\r\n      console.log('ProgressDialog: progress prop changed to', newValue)\r\n    })\r\n\r\n    return {\r\n      dialogModel,\r\n      closeDialog\r\n    }\r\n  }\r\n}\r\n\r\n</script>"],"mappings":"AAoDA,SAASA,QAAQ,EAAEC,KAAI,QAAS,KAAI;AAEpC,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,KAAK,EAAE;IACLC,UAAU,EAAEC,OAAO;IACnBC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,QAAQ,EAAE;MACRH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDG,OAAO,EAAE;MACPL,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDI,KAAK,EAAE;MACLN,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDK,cAAc,EAAE;MACdP,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDM,KAAK,EAAE;MACLR,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX;EACF,CAAC;EACDO,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,KAAKA,CAACd,KAAK,EAAE;IAAEe;EAAK,CAAC,EAAE;IACrB,MAAMC,WAAU,GAAInB,QAAQ,CAAC;MAC3BoB,GAAG,EAAEA,CAAA,KAAMjB,KAAK,CAACC,UAAU;MAC3BiB,GAAG,EAAGC,KAAK,IAAKJ,IAAI,CAAC,mBAAmB,EAAEI,KAAK;IACjD,CAAC;IAED,MAAMC,WAAU,GAAIA,CAAA,KAAM;MACxBL,IAAI,CAAC,mBAAmB,EAAE,KAAK;IACjC;IAEAjB,KAAK,CAAC,MAAME,KAAK,CAACO,QAAQ,EAAGc,QAAQ,IAAK;MACxCC,OAAO,CAACC,GAAG,CAAC,0CAA0C,EAAEF,QAAQ;IAClE,CAAC;IAED,OAAO;MACLL,WAAW;MACXI;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}