\", \"onInput\"])) : field.type === 'number' ? (_openBlock(), _createBlock(_component_v_text_field, {\n              key: 2,\n              modelValue: $setup.form[field.name],\n              \"onUpdate:modelValue\": $event => $setup.form[field.name] = $event,\n              label: field.label,\n              type: \"number\",\n              step: \"0.01\",\n              required: field.required,\n              \"error-messages\": $setup.errors[field.name],\n              onInput: $event => $setup.clearFieldError(field.name)\n            }, null, 8 /* PROPS */, [\"modelValue\", \"onUpdate:modelValue\", \"label\", \"required\", \"error-messages\", \"onInput\"])) : field.type === 'textarea' ? (_openBlock(), _createBlock(_component_v_textarea, {\n              key: 3,\n              modelValue: $setup.form[field.name],\n              \"onUpdate:modelValue\": $event => $setup.form[field.name] = $event,\n              label: field.label,\n              required: field.required,\n              \"error-messages\": $setup.errors[field.name],\n              onInput: $event => $setup.clearFieldError(field.name)\n            }, null, 8 /* PROPS */, [\"modelValue\", \"onUpdate:modelValue\", \"label\", \"required\", \"error-messages\", \"onInput\"])) : _createCommentVNode(\"v-if\", true)], 64 /* STABLE_FRAGMENT */);\n          }), 128 /* KEYED_FRAGMENT */))]),\n          _: 1 /* STABLE */\n        }, 8 /* PROPS */, [\"onSubmit\"]), $setup.generalError ? (_openBlock(), _createBlock(_component_v_alert, {\n          key: 0,\n          type: \"error\",\n          class: \"mt-4\"\n        }, {\n          default: _withCtx(() => [_createTextVNode(_toDisplayString($setup.generalError), 1 /* TEXT */)]),\n          _: 1 /* STABLE */\n        })) : _createCommentVNode(\"v-if\", true)]),\n        _: 1 /* STABLE */\n      }), _createVNode(_component_v_card_actions, null, {\n        default: _withCtx(() => [_createVNode(_component_v_spacer), _createVNode(_component_v_btn, {\n          color