{"ast":null,"code":"import { ref, computed, onMounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport { getBrokersForDatabase, createBroker, updateBroker, deleteBroker } from '@/services/api';\nimport { useTableSettings } from '@/composables/useTableSettings';\nimport debounce from 'lodash/debounce';\nexport default {\n  name: 'BrokersPage',\n  setup() {\n    const store = useStore();\n    const {\n      itemsPerPage,\n      currentPage,\n      sortBy,\n      search,\n      handlePageChange,\n      handleItemsPerPageChange,\n      handleSortChange\n    } = useTableSettings();\n    const brokers = ref([]);\n    const loading = ref(true);\n    const tableLoading = ref(false);\n    const dialog = ref(false);\n    const editedIndex = ref(-1);\n    const editedItem = ref({\n      name: '',\n      country: '',\n      comment: '',\n      restricted: false\n    });\n    const defaultItem = {\n      name: '',\n      country: '',\n      comment: '',\n      restricted: false\n    };\n    const totalItems = ref(0);\n    const itemsPerPageOptions = [5, 10, 25, 50];\n    const headers = [{\n      title: '',\n      key: 'actions',\n      sortable: false,\n      align: 'center',\n      width: '100px'\n    }, {\n      title: 'Name',\n      key: 'name',\n      align: 'start'\n    }, {\n      title: 'Country',\n      key: 'country',\n      align: 'center'\n    }, {\n      title: 'Currencies',\n      key: 'currencies',\n      align: 'center'\n    }, {\n      title: 'Number of securities',\n      key: 'no_of_securities',\n      align: 'center'\n    }, {\n      title: 'First investment',\n      key: 'first_investment',\n      align: 'center'\n    }, {\n      title: 'Current NAV',\n      key: 'NAV',\n      align: 'center'\n    }, {\n      title: 'Cash balance',\n      key: 'cash',\n      align: 'center'\n    }, {\n      title: 'Return to date',\n      key: 'irr',\n      align: 'center'\n    }];\n    const formTitle = computed(() => {\n      return editedIndex.value === -1 ? 'New Broker' : 'Edit Broker';\n    });\n    const pageCount = computed(() => {\n      return Math.ceil(totalItems.value / itemsPerPage.value);\n    });\n    const fetchBrokers = async () => {\n      tableLoading.value = true;\n      try {\n        const response = await getBrokersForDatabase({\n          page: currentPage.value,\n          itemsPerPage: itemsPerPage.value,\n          sortBy: sortBy.value[0] || {},\n          search: search.value\n        });\n        brokers.value = response.brokers;\n        totalItems.value = response.total_items;\n      } catch (error) {\n        console.error('Error fetching brokers:', error);\n      } finally {\n        tableLoading.value = false;\n        loading.value = false;\n      }\n    };\n    const handleTableUpdate = options => {\n      currentPage.value = options.page;\n      itemsPerPage.value = options.itemsPerPage;\n      handleSortChange(options.sortBy);\n      fetchBrokers();\n    };\n    const debouncedSearch = debounce(() => {\n      currentPage.value = 1;\n      fetchBrokers();\n    }, 300);\n    const openAddDialog = () => {\n      editedIndex.value = -1;\n      editedItem.value = Object.assign({}, defaultItem);\n      dialog.value = true;\n    };\n    const editBroker = item => {\n      editedIndex.value = brokers.value.indexOf(item);\n      editedItem.value = Object.assign({}, item);\n      dialog.value = true;\n    };\n    const deleteBroker = async item => {\n      const confirm = window.confirm('Are you sure you want to delete this broker?');\n      if (confirm) {\n        try {\n          await deleteBroker(item.id);\n          fetchBrokers();\n        } catch (error) {\n          console.error('Error deleting broker:', error);\n        }\n      }\n    };\n    const close = () => {\n      dialog.value = false;\n      editedIndex.value = -1;\n      editedItem.value = Object.assign({}, defaultItem);\n    };\n    const save = async () => {\n      try {\n        if (editedIndex.value > -1) {\n          await updateBroker(editedItem.value.id, editedItem.value);\n        } else {\n          await createBroker(editedItem.value);\n        }\n        close();\n        fetchBrokers();\n      } catch (error) {\n        console.error('Error saving broker:', error);\n      }\n    };\n    onMounted(() => {\n      fetchBrokers();\n    });\n    watch(() => store.state.dataRefreshTrigger, fetchBrokers);\n    return {\n      brokers,\n      loading,\n      tableLoading,\n      dialog,\n      editedIndex,\n      editedItem,\n      defaultItem,\n      headers,\n      formTitle,\n      itemsPerPage,\n      currentPage,\n      totalItems,\n      sortBy,\n      search,\n      itemsPerPageOptions,\n      pageCount,\n      handleTableUpdate,\n      handlePageChange,\n      handleItemsPerPageChange,\n      debouncedSearch,\n      openAddDialog,\n      editBroker,\n      deleteBroker,\n      close,\n      save\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","watch","useStore","getBrokersForDatabase","createBroker","updateBroker","deleteBroker","useTableSettings","debounce","name","setup","store","itemsPerPage","currentPage","sortBy","search","handlePageChange","handleItemsPerPageChange","handleSortChange","brokers","loading","tableLoading","dialog","editedIndex","editedItem","country","comment","restricted","defaultItem","totalItems","itemsPerPageOptions","headers","title","key","sortable","align","width","formTitle","value","pageCount","Math","ceil","fetchBrokers","response","page","total_items","error","console","handleTableUpdate","options","debouncedSearch","openAddDialog","Object","assign","editBroker","item","indexOf","confirm","window","id","close","save","state","dataRefreshTrigger"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\BrokersPage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\" justify=\"space-between\">\r\n          <v-col cols=\"auto\">\r\n            <v-btn color=\"primary\" @click=\"openAddDialog\">\r\n              Add Broker\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-data-table\r\n      :headers=\"headers\"\r\n      :items=\"brokers\"\r\n      :loading=\"tableLoading\"\r\n      :items-per-page=\"itemsPerPage\"\r\n      :page=\"currentPage\"\r\n      :items-per-page-options=\"itemsPerPageOptions\"\r\n      :server-items-length=\"totalItems\"\r\n      :sort-by=\"sortBy\"\r\n      @update:options=\"handleTableUpdate\"\r\n    >\r\n      <template v-slot:top>\r\n        <v-toolbar flat>\r\n          <v-toolbar-title>Brokers</v-toolbar-title>\r\n          <v-divider class=\"mx-4\" inset vertical></v-divider>\r\n          <v-spacer></v-spacer>\r\n          <v-text-field\r\n            v-model=\"search\"\r\n            append-icon=\"mdi-magnify\"\r\n            label=\"Search\"\r\n            single-line\r\n            hide-details\r\n            @input=\"debouncedSearch\"\r\n          ></v-text-field>\r\n        </v-toolbar>\r\n      </template>\r\n\r\n      <template v-slot:item.actions=\"{ item }\">\r\n        <v-icon small class=\"mr-2\" @click=\"editBroker(item)\">\r\n          mdi-pencil\r\n        </v-icon>\r\n        <v-icon small @click=\"deleteBroker(item)\">\r\n          mdi-delete\r\n        </v-icon>\r\n      </template>\r\n\r\n      <template v-slot:bottom>\r\n        <v-row class=\"mt-2\" align=\"center\" justify=\"end\">\r\n          <span class=\"text-caption mr-2 grey--text\">Items per page</span>\r\n          <v-select\r\n            v-model=\"itemsPerPage\"\r\n            :items=\"itemsPerPageOptions\"\r\n            class=\"mt-0 pt-0\"\r\n            hide-details\r\n            @change=\"handleItemsPerPageChange\"\r\n          ></v-select>\r\n          <v-spacer></v-spacer>\r\n          <v-pagination\r\n            v-model=\"currentPage\"\r\n            :length=\"pageCount\"\r\n            :total-visible=\"7\"\r\n            @input=\"handlePageChange\"\r\n          ></v-pagination>\r\n        </v-row>\r\n      </template>\r\n    </v-data-table>\r\n\r\n    <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>\r\n          <span class=\"text-h5\">{{ formTitle }}</span>\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-container>\r\n            <v-row>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-text-field v-model=\"editedItem.name\" label=\"Name\"></v-text-field>\r\n              </v-col>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-text-field v-model=\"editedItem.country\" label=\"Country\"></v-text-field>\r\n              </v-col>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-checkbox v-model=\"editedItem.restricted\" label=\"Restricted\"></v-checkbox>\r\n              </v-col>\r\n              <v-col cols=\"12\">\r\n                <v-textarea v-model=\"editedItem.comment\" label=\"Comment\"></v-textarea>\r\n              </v-col>\r\n            </v-row>\r\n          </v-container>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"close\">Cancel</v-btn>\r\n          <v-btn color=\"blue darken-1\" text @click=\"save\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, watch } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { getBrokersForDatabase, createBroker, updateBroker, deleteBroker } from '@/services/api'\r\nimport { useTableSettings } from '@/composables/useTableSettings'\r\nimport debounce from 'lodash/debounce'\r\n\r\nexport default {\r\n  name: 'BrokersPage',\r\n  setup() {\r\n    const store = useStore()\r\n    const {\r\n      itemsPerPage,\r\n      currentPage,\r\n      sortBy,\r\n      search,\r\n      handlePageChange,\r\n      handleItemsPerPageChange,\r\n      handleSortChange,\r\n    } = useTableSettings()\r\n\r\n    const brokers = ref([])\r\n    const loading = ref(true)\r\n    const tableLoading = ref(false)\r\n    const dialog = ref(false)\r\n    const editedIndex = ref(-1)\r\n    const editedItem = ref({\r\n      name: '',\r\n      country: '',\r\n      comment: '',\r\n      restricted: false\r\n    })\r\n    const defaultItem = {\r\n      name: '',\r\n      country: '',\r\n      comment: '',\r\n      restricted: false\r\n    }\r\n    const totalItems = ref(0)\r\n    const itemsPerPageOptions = [5, 10, 25, 50]\r\n\r\n    const headers = [\r\n      { title: '', key: 'actions', sortable: false, align: 'center', width: '100px' },\r\n      { title: 'Name', key: 'name', align: 'start' },\r\n      { title: 'Country', key: 'country', align: 'center' },\r\n      { title: 'Currencies', key: 'currencies', align: 'center' },\r\n      { title: 'Number of securities', key: 'no_of_securities', align: 'center' },\r\n      { title: 'First investment', key: 'first_investment', align: 'center' },\r\n      { title: 'Current NAV', key: 'NAV', align: 'center' },\r\n      { title: 'Cash balance', key: 'cash', align: 'center' },\r\n      { title: 'Return to date', key: 'irr', align: 'center' }\r\n    ]\r\n\r\n    const formTitle = computed(() => {\r\n      return editedIndex.value === -1 ? 'New Broker' : 'Edit Broker'\r\n    })\r\n\r\n    const pageCount = computed(() => {\r\n      return Math.ceil(totalItems.value / itemsPerPage.value)\r\n    })\r\n\r\n    const fetchBrokers = async () => {\r\n      tableLoading.value = true\r\n      try {\r\n        const response = await getBrokersForDatabase({\r\n          page: currentPage.value,\r\n          itemsPerPage: itemsPerPage.value,\r\n          sortBy: sortBy.value[0] || {},\r\n          search: search.value\r\n        })\r\n        brokers.value = response.brokers\r\n        totalItems.value = response.total_items\r\n      } catch (error) {\r\n        console.error('Error fetching brokers:', error)\r\n      } finally {\r\n        tableLoading.value = false\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    const handleTableUpdate = (options) => {\r\n      currentPage.value = options.page\r\n      itemsPerPage.value = options.itemsPerPage\r\n      handleSortChange(options.sortBy)\r\n      fetchBrokers()\r\n    }\r\n\r\n    const debouncedSearch = debounce(() => {\r\n      currentPage.value = 1\r\n      fetchBrokers()\r\n    }, 300)\r\n\r\n    const openAddDialog = () => {\r\n      editedIndex.value = -1\r\n      editedItem.value = Object.assign({}, defaultItem)\r\n      dialog.value = true\r\n    }\r\n\r\n    const editBroker = (item) => {\r\n      editedIndex.value = brokers.value.indexOf(item)\r\n      editedItem.value = Object.assign({}, item)\r\n      dialog.value = true\r\n    }\r\n\r\n    const deleteBroker = async (item) => {\r\n      const confirm = window.confirm('Are you sure you want to delete this broker?')\r\n      if (confirm) {\r\n        try {\r\n          await deleteBroker(item.id)\r\n          fetchBrokers()\r\n        } catch (error) {\r\n          console.error('Error deleting broker:', error)\r\n        }\r\n      }\r\n    }\r\n\r\n    const close = () => {\r\n      dialog.value = false\r\n      editedIndex.value = -1\r\n      editedItem.value = Object.assign({}, defaultItem)\r\n    }\r\n\r\n    const save = async () => {\r\n      try {\r\n        if (editedIndex.value > -1) {\r\n          await updateBroker(editedItem.value.id, editedItem.value)\r\n        } else {\r\n          await createBroker(editedItem.value)\r\n        }\r\n        close()\r\n        fetchBrokers()\r\n      } catch (error) {\r\n        console.error('Error saving broker:', error)\r\n      }\r\n    }\r\n\r\n    onMounted(() => {\r\n      fetchBrokers()\r\n    })\r\n\r\n    watch(() => store.state.dataRefreshTrigger, fetchBrokers)\r\n\r\n    return {\r\n      brokers,\r\n      loading,\r\n      tableLoading,\r\n      dialog,\r\n      editedIndex,\r\n      editedItem,\r\n      defaultItem,\r\n      headers,\r\n      formTitle,\r\n      itemsPerPage,\r\n      currentPage,\r\n      totalItems,\r\n      sortBy,\r\n      search,\r\n      itemsPerPageOptions,\r\n      pageCount,\r\n      handleTableUpdate,\r\n      handlePageChange,\r\n      handleItemsPerPageChange,\r\n      debouncedSearch,\r\n      openAddDialog,\r\n      editBroker,\r\n      deleteBroker,\r\n      close,\r\n      save\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA6GA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,KAAI,QAAS,KAAI;AACpD,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,qBAAqB,EAAEC,YAAY,EAAEC,YAAY,EAAEC,YAAW,QAAS,gBAAe;AAC/F,SAASC,gBAAe,QAAS,gCAA+B;AAChE,OAAOC,QAAO,MAAO,iBAAgB;AAErC,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIT,QAAQ,CAAC;IACvB,MAAM;MACJU,YAAY;MACZC,WAAW;MACXC,MAAM;MACNC,MAAM;MACNC,gBAAgB;MAChBC,wBAAwB;MACxBC;IACF,IAAIX,gBAAgB,CAAC;IAErB,MAAMY,OAAM,GAAIrB,GAAG,CAAC,EAAE;IACtB,MAAMsB,OAAM,GAAItB,GAAG,CAAC,IAAI;IACxB,MAAMuB,YAAW,GAAIvB,GAAG,CAAC,KAAK;IAC9B,MAAMwB,MAAK,GAAIxB,GAAG,CAAC,KAAK;IACxB,MAAMyB,WAAU,GAAIzB,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAM0B,UAAS,GAAI1B,GAAG,CAAC;MACrBW,IAAI,EAAE,EAAE;MACRgB,OAAO,EAAE,EAAE;MACXC,OAAO,EAAE,EAAE;MACXC,UAAU,EAAE;IACd,CAAC;IACD,MAAMC,WAAU,GAAI;MAClBnB,IAAI,EAAE,EAAE;MACRgB,OAAO,EAAE,EAAE;MACXC,OAAO,EAAE,EAAE;MACXC,UAAU,EAAE;IACd;IACA,MAAME,UAAS,GAAI/B,GAAG,CAAC,CAAC;IACxB,MAAMgC,mBAAkB,GAAI,CAAC,CAAC,EAAE,EAAE,EAAE,EAAE,EAAE,EAAE;IAE1C,MAAMC,OAAM,GAAI,CACd;MAAEC,KAAK,EAAE,EAAE;MAAEC,GAAG,EAAE,SAAS;MAAEC,QAAQ,EAAE,KAAK;MAAEC,KAAK,EAAE,QAAQ;MAAEC,KAAK,EAAE;IAAQ,CAAC,EAC/E;MAAEJ,KAAK,EAAE,MAAM;MAAEC,GAAG,EAAE,MAAM;MAAEE,KAAK,EAAE;IAAQ,CAAC,EAC9C;MAAEH,KAAK,EAAE,SAAS;MAAEC,GAAG,E