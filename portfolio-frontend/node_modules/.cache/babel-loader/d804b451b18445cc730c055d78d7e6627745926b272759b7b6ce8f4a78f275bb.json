{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport RegisterForm from '@/components/RegisterForm.vue';\nexport default {\n  name: 'RegisterPage',\n  components: {\n    RegisterForm\n  },\n  setup() {\n    const loading = ref(false);\n    const router = useRouter();\n    const store = useStore();\n    const registerForm = ref(null);\n    const handleRegister = async credentials => {\n      console.log('Handling registration with credentials:', credentials);\n      loading.value = true;\n      try {\n        await store.dispatch('register', credentials);\n        console.log(\"Registration successful\");\n        router.push('/login');\n      } catch (error) {\n        console.log('Registration failed', error);\n        if (error.response && error.response.data) {\n          registerForm.value.setErrors(error.response.data);\n        } else {\n          registerForm.value.setErrors('An unknown error occurred. Please try again.');\n        }\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      loading,\n      handleRegister,\n      registerForm\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","useStore","RegisterForm","name","components","setup","loading","router","store","registerForm","handleRegister","credentials","console","log","value","dispatch","push","error","response","data","setErrors"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\RegisterPage.vue"],"sourcesContent":["<template>\r\n  <v-container class=\"fill-height\" fluid>\r\n    <v-row align=\"center\" justify=\"center\">\r\n      <v-col cols=\"12\" sm=\"8\" md=\"4\">\r\n        <v-card class=\"pa-4\">\r\n          <v-card-title class=\"headline\">Register</v-card-title>\r\n          <v-card-text>\r\n            <RegisterForm \r\n              ref=\"registerForm\"\r\n              @register=\"handleRegister\" \r\n              :loading=\"loading\" \r\n            />\r\n          </v-card-text>\r\n          <v-card-actions>\r\n            <v-spacer></v-spacer>\r\n            <span>Already have an account? <router-link to=\"/login\">Login</router-link></span>\r\n          </v-card-actions>\r\n        </v-card>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <!-- Success Dialog -->\r\n    <v-dialog v-model=\"showSuccessDialog\" max-width=\"400\">\r\n      <v-card>\r\n        <v-card-title class=\"headline\">Registration Successful</v-card-title>\r\n        <v-card-text>\r\n          {{ successMessage }}\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"primary\" text @click=\"redirectToLogin\">\r\n            Go to Login\r\n          </v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport RegisterForm from '@/components/RegisterForm.vue'\r\n\r\nexport default {\r\n  name: 'RegisterPage',\r\n  components: {\r\n    RegisterForm\r\n  },\r\n  setup() {\r\n    const loading = ref(false)\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const registerForm = ref(null)\r\n\r\n    const handleRegister = async (credentials) => {\r\n      console.log('Handling registration with credentials:', credentials)\r\n      loading.value = true\r\n\r\n      try {\r\n        await store.dispatch('register', credentials)\r\n        console.log(\"Registration successful\")\r\n        router.push('/login')\r\n      } catch (error) {\r\n        console.log('Registration failed', error)\r\n        if (error.response && error.response.data) {\r\n          registerForm.value.setErrors(error.response.data)\r\n        } else {\r\n          registerForm.value.setErrors('An unknown error occurred. Please try again.')\r\n        }\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    return { loading, handleRegister, registerForm }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-card-actions a {\r\n  text-decoration: none;\r\n  color: #1976D2;\r\n}\r\n</style>"],"mappings":";AAwCA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,YAAW,MAAO,+BAA8B;AAEvD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIP,GAAG,CAAC,KAAK;IACzB,MAAMQ,MAAK,GAAIP,SAAS,CAAC;IACzB,MAAMQ,KAAI,GAAIP,QAAQ,CAAC;IACvB,MAAMQ,YAAW,GAAIV,GAAG,CAAC,IAAI;IAE7B,MAAMW,cAAa,GAAI,MAAOC,WAAW,IAAK;MAC5CC,OAAO,CAACC,GAAG,CAAC,yCAAyC,EAAEF,WAAW;MAClEL,OAAO,CAACQ,KAAI,GAAI,IAAG;MAEnB,IAAI;QACF,MAAMN,KAAK,CAACO,QAAQ,CAAC,UAAU,EAAEJ,WAAW;QAC5CC,OAAO,CAACC,GAAG,CAAC,yBAAyB;QACrCN,MAAM,CAACS,IAAI,CAAC,QAAQ;MACtB,EAAE,OAAOC,KAAK,EAAE;QACdL,OAAO,CAACC,GAAG,CAAC,qBAAqB,EAAEI,KAAK;QACxC,IAAIA,KAAK,CAACC,QAAO,IAAKD,KAAK,CAACC,QAAQ,CAACC,IAAI,EAAE;UACzCV,YAAY,CAACK,KAAK,CAACM,SAAS,CAACH,KAAK,CAACC,QAAQ,CAACC,IAAI;QAClD,OAAO;UACLV,YAAY,CAACK,KAAK,CAACM,SAAS,CAAC,8CAA8C;QAC7E;MACF,UAAU;QACRd,OAAO,CAACQ,KAAI,GAAI,KAAI;MACtB;IACF;IAEA,OAAO;MAAER,OAAO;MAAEI,cAAc;MAAED;IAAa;EACjD;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}