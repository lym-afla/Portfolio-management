{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nexport default {\n  name: 'ClosedPositions',\n  emits: ['update-page-title'],\n  setup(props, {\n    emit\n  }) {\n    const closedPositions = ref([]);\n    const totals = ref({});\n    const loading = ref(true);\n    const tableLoading = ref(true);\n    const selectedYear = ref('YTD');\n    const yearOptions = ref([]);\n    const search = ref('');\n    const headers = [{\n      title: 'Type',\n      align: 'start',\n      key: 'type'\n    }, {\n      title: 'Name',\n      align: 'start',\n      key: 'name'\n    }, {\n      title: 'Currency',\n      align: 'center',\n      key: 'currency'\n    }, {\n      title: 'Max position',\n      align: 'center',\n      key: 'max_position'\n    }, {\n      title: 'Entry Date',\n      align: 'center',\n      key: 'investment_date'\n    }, {\n      title: 'Entry Value',\n      align: 'center',\n      key: 'entry_value'\n    }, {\n      title: 'Exit Date',\n      align: 'center',\n      key: 'exit_date'\n    }, {\n      title: 'Exit Value',\n      align: 'center',\n      key: 'exit_value'\n    }, {\n      title: 'Realized G/L',\n      align: 'center',\n      key: 'realized_gl'\n    }, {\n      title: 'Realized G/L %',\n      align: 'center',\n      key: 'price_change_percentage'\n    }, {\n      title: 'Capital Distribution',\n      align: 'center',\n      key: 'capital_distribution'\n    }, {\n      title: 'Capital Distribution %',\n      align: 'center',\n      key: 'capital_distribution_percentage'\n    }, {\n      title: 'Commission',\n      align: 'center',\n      key: 'commission'\n    }, {\n      title: 'Commission %',\n      align: 'center',\n      key: 'commission_percentage'\n    }, {\n      title: 'Total Return',\n      align: 'center',\n      key: 'total_return_amount'\n    }, {\n      title: 'Total Return %',\n      align: 'center',\n      key: 'total_return_percentage'\n    }, {\n      title: 'IRR',\n      align: 'center',\n      key: 'irr'\n    }];\n    const fetchClosedPositions = async () => {\n      tableLoading.value = true;\n      try {\n        const response = await axios.post('/closed_positions/api/get_closed_positions_table/', {\n          timespan: selectedYear.value\n        });\n        closedPositions.value = response.data.portfolio_closed;\n        totals.value = response.data.portfolio_closed_totals;\n      } catch (error) {\n        console.error('Error fetching closed positions:', error);\n      } finally {\n        tableLoading.value = false;\n      }\n    };\n    const handleYearChange = newValue => {\n      selectedYear.value = newValue;\n      fetchClosedPositions();\n    };\n    const fetchYearOptions = async () => {\n      try {\n        const response = await axios.get('/closed_positions/api/get_year_options/');\n        yearOptions.value = response.data.closed_table_years.map(year => {\n          if (typeof year === 'string') {\n            return {\n              text: year,\n              value: year\n            };\n          }\n          return year; // For divider and special options\n        });\n      } catch (error) {\n        console.error('Error fetching year options:', error);\n      }\n    };\n    const fetchData = async () => {\n      loading.value = true;\n      await Promise.all([fetchYearOptions(), fetchClosedPositions()]);\n      loading.value = false;\n    };\n    onMounted(() => {\n      fetchData();\n      emit('update-page-title', 'Closed Positions');\n    });\n    onUnmounted(() => {\n      emit('update-page-title', ''); // Clear the page title when component is unmounted\n    });\n    return {\n      closedPositions,\n      totals,\n      loading,\n      tableLoading,\n      headers,\n      selectedYear,\n      yearOptions,\n      handleYearChange,\n      search\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","axios","name","emits","setup","props","emit","closedPositions","totals","loading","tableLoading","selectedYear","yearOptions","search","headers","title","align","key","fetchClosedPositions","value","response","post","timespan","data","portfolio_closed","portfolio_closed_totals","error","console","handleYearChange","newValue","fetchYearOptions","get","closed_table_years","map","year","text","fetchData","Promise","all"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\ClosedPositionsPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid>\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\" md=\"3\" lg=\"2\">\r\n        <v-select\r\n          v-model=\"selectedYear\"\r\n          :items=\"yearOptions\"\r\n          item-title=\"text\"\r\n          item-value=\"value\"\r\n          label=\"Year\"\r\n          @update:model-value=\"handleYearChange\"\r\n          density=\"compact\"\r\n        >\r\n          <template v-slot:item=\"{ item, props }\">\r\n            <v-list-item\r\n              v-if=\"!item.raw.divider\"\r\n              v-bind=\"props\"\r\n              :title=\"item.title\"\r\n            ></v-list-item>\r\n            <v-divider v-else class=\"my-2\"></v-divider>\r\n          </template>\r\n        </v-select>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\">\r\n        <v-data-table\r\n          :headers=\"headers\"\r\n          :items=\"closedPositions\"\r\n          :loading=\"tableLoading\"\r\n          :search=\"search\"\r\n          class=\"elevation-1\"\r\n          density=\"compact\"\r\n        >\r\n          <template v-slot:top>\r\n            <v-toolbar flat>\r\n              <v-toolbar-title>Closed Positions</v-toolbar-title>\r\n              <v-divider\r\n                class=\"mx-4\"\r\n                inset\r\n                vertical\r\n              ></v-divider>\r\n              <v-text-field\r\n                v-model=\"search\"\r\n                append-icon=\"mdi-magnify\"\r\n                label=\"Search\"\r\n                single-line\r\n                hide-details\r\n              ></v-text-field>\r\n            </v-toolbar>\r\n          </template>\r\n\r\n          <template v-slot:[`item.price_change_percentage`]=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.price_change_percentage }}</span>\r\n          </template>\r\n\r\n          <template v-slot:[`item.capital_distribution_percentage`]=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.capital_distribution_percentage }}</span>\r\n          </template>\r\n\r\n          <template v-slot:[`item.commission_percentage`]=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.commission_percentage }}</span>\r\n          </template>\r\n\r\n          <template v-slot:[`item.total_return_percentage`]=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.total_return_percentage }}</span>\r\n          </template>\r\n\r\n          <template v-slot:[`item.irr`]=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.irr }}</span>\r\n          </template>\r\n\r\n          <template v-slot:bottom>\r\n            <tr class=\"font-weight-bold\">\r\n              <td colspan=\"2\" class=\"text-right\">TOTAL</td>\r\n              <td></td>\r\n              <td></td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.entry_value }}</td>\r\n              <td></td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.exit_value }}</td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.realized_gl }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.price_change_percentage }}</td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.capital_distribution }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.capital_distribution_percentage }}</td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.commission }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.commission_percentage }}</td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.total_return_amount }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.total_return_percentage }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.irr }}</td>\r\n            </tr>\r\n          </template>\r\n        </v-data-table>\r\n      </v-col>\r\n    </v-row>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted } from 'vue'\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'ClosedPositions',\r\n  emits: ['update-page-title'],\r\n  setup(props, { emit }) {\r\n    const closedPositions = ref([])\r\n    const totals = ref({})\r\n    const loading = ref(true)\r\n    const tableLoading = ref(true)\r\n    const selectedYear = ref('YTD')\r\n    const yearOptions = ref([])\r\n    const search = ref('')\r\n\r\n    const headers = [\r\n      {\r\n        title: 'Type',\r\n        align: 'start',\r\n        key: 'type',\r\n      },\r\n      { title: 'Name', align: 'start', key: 'name' },\r\n      { title: 'Currency', align: 'center', key: 'currency' },\r\n      { title: 'Max position', align: 'center', key: 'max_position' },\r\n      { title: 'Entry Date', align: 'center', key: 'investment_date' },\r\n      { title: 'Entry Value', align: 'center', key: 'entry_value' },\r\n      { title: 'Exit Date', align: 'center', key: 'exit_date' },\r\n      { title: 'Exit Value', align: 'center', key: 'exit_value' },\r\n      { title: 'Realized G/L', align: 'center', key: 'realized_gl' },\r\n      { title: 'Realized G/L %', align: 'center', key: 'price_change_percentage' },\r\n      { title: 'Capital Distribution', align: 'center', key: 'capital_distribution' },\r\n      { title: 'Capital Distribution %', align: 'center', key: 'capital_distribution_percentage' },\r\n      { title: 'Commission', align: 'center', key: 'commission' },\r\n      { title: 'Commission %', align: 'center', key: 'commission_percentage' },\r\n      { title: 'Total Return', align: 'center', key: 'total_return_amount' },\r\n      { title: 'Total Return %', align: 'center', key: 'total_return_percentage' },\r\n      { title: 'IRR', align: 'center', key: 'irr' },\r\n    ]\r\n\r\n    const fetchClosedPositions = async () => {\r\n      tableLoading.value = true\r\n      try {\r\n        const response = await axios.post(\r\n          '/closed_positions/api/get_closed_positions_table/',\r\n          {\r\n            timespan: selectedYear.value,\r\n          }\r\n        )\r\n        closedPositions.value = response.data.portfolio_closed\r\n        totals.value = response.data.portfolio_closed_totals\r\n      } catch (error) {\r\n        console.error('Error fetching closed positions:', error)\r\n      } finally {\r\n        tableLoading.value = false\r\n      }\r\n    }\r\n\r\n    const handleYearChange = (newValue) => {\r\n      selectedYear.value = newValue\r\n      fetchClosedPositions()\r\n    }\r\n\r\n    const fetchYearOptions = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          '/closed_positions/api/get_year_options/'\r\n        )\r\n        yearOptions.value = response.data.closed_table_years.map(year => {\r\n          if (typeof year === 'string') {\r\n            return { text: year, value: year }\r\n          }\r\n          return year  // For divider and special options\r\n        })\r\n      } catch (error) {\r\n        console.error('Error fetching year options:', error)\r\n      }\r\n    }\r\n\r\n    const fetchData = async () => {\r\n      loading.value = true\r\n      await Promise.all([fetchYearOptions(), fetchClosedPositions()])\r\n      loading.value = false\r\n    }\r\n\r\n    onMounted(() => {\r\n      fetchData()\r\n      emit('update-page-title', 'Closed Positions')\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      emit('update-page-title', '') // Clear the page title when component is unmounted\r\n    })\r\n\r\n    return {\r\n      closedPositions,\r\n      totals,\r\n      loading,\r\n      tableLoading,\r\n      headers,\r\n      selectedYear,\r\n      yearOptions,\r\n      handleYearChange,\r\n      search,\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-data-table ::v-deep .v-data-table__wrapper {\r\n  overflow-x: auto;\r\n}\r\n\r\n.v-data-table ::v-deep table {\r\n  white-space: nowrap;\r\n}\r\n\r\n.v-data-table ::v-deep th {\r\n  font-weight: bold !important;\r\n}\r\n\r\n.v-data-table ::v-deep td, .v-data-table ::v-deep th {\r\n  font-size: 0.875rem;\r\n}\r\n\r\n.font-italic {\r\n  font-style: italic;\r\n}\r\n</style>"],"mappings":"AA6GA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAChD,OAAOC,KAAI,MAAO,OAAM;AAExB,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IACrB,MAAMC,eAAc,GAAIT,GAAG,CAAC,EAAE;IAC9B,MAAMU,MAAK,GAAIV,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMW,OAAM,GAAIX,GAAG,CAAC,IAAI;IACxB,MAAMY,YAAW,GAAIZ,GAAG,CAAC,IAAI;IAC7B,MAAMa,YAAW,GAAIb,GAAG,CAAC,KAAK;IAC9B,MAAMc,WAAU,GAAId,GAAG,CAAC,EAAE;IAC1B,MAAMe,MAAK,GAAIf,GAAG,CAAC,EAAE;IAErB,MAAMgB,OAAM,GAAI,CACd;MACEC,KAAK,EAAE,MAAM;MACbC,KAAK,EAAE,OAAO;MACdC,GAAG,EAAE;IACP,CAAC,EACD;MAAEF,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE,OAAO;MAAEC,GAAG,EAAE;IAAO,CAAC,EAC9C;MAAEF,KAAK,EAAE,UAAU;MAAEC,KAAK,EAAE,QAAQ;MAAEC,GAAG,EAAE;IAAW,CAAC,EACvD;MAAEF,KAAK,EAAE,cAAc;MAAEC,KAAK,EAAE,QAAQ;MAAEC,GAAG,EAAE;IAAe,CAAC,EAC/D;MAAEF,KAAK,EAAE,YAAY;MAAEC,KAAK,EAAE,QAAQ;MAAEC,GAAG,EAAE;IAAkB,CAAC,EAChE;MAAEF,KAAK,EAAE,aAAa;MAAEC,KAAK,EAAE,QAAQ;MAAEC,GAAG,EAAE;IAAc,CAAC,EAC7D;MAAEF,KAAK,EAAE,WAAW;MAAEC,KAAK,EAAE,QAAQ;MAAEC,GAAG,EAAE;IAAY,CAAC,EACzD;MAAEF,KAAK,EAAE,YAAY;MAAEC,KAAK,EAAE,QAAQ;MAAEC,GAAG,EAAE;IAAa,CAAC,EAC3D;MAAEF,KAAK,EAAE,cAA