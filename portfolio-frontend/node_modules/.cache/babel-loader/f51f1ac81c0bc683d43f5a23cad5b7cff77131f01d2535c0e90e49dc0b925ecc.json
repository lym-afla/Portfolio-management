{"ast":null,"code":"import { ref, watch, computed, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { getAssetTypes, getBrokers, getSecurities, getPrices, updatePriceEntry, deletePriceEntry } from '@/services/api';\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue';\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue';\nimport PriceChart from '@/components/charts/PriceChart.vue';\nimport debounce from 'lodash/debounce';\nimport { useTableSettings } from '@/composables/useTableSettings';\nexport default {\n  name: 'PricesPage',\n  components: {\n    AddSecurityButton,\n    AddPriceEntryButton,\n    PriceChart\n  },\n  setup() {\n    const store = useStore();\n    const {\n      dateFrom,\n      dateTo,\n      itemsPerPage,\n      currentPage,\n      sortBy,\n      handlePageChange,\n      handleItemsPerPageChange,\n      handleSortChange,\n      handleTimespanChange\n    } = useTableSettings();\n    const assetTypes = ref([]);\n    const brokers = ref([]);\n    const securities = ref([]);\n    const selectedAssetTypes = ref([]);\n    const selectedBroker = ref(null);\n    const selectedSecurities = ref([]);\n    const priceData = ref([]);\n    const loading = ref(false);\n    const tableLoading = ref(false);\n    const totalItems = ref(0);\n    const editDialog = ref(false);\n    const deleteDialog = ref(false);\n    const editedItem = ref({});\n    const deletedItem = ref({});\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions);\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value));\n    const headers = computed(() => [{\n      title: '',\n      key: 'actions',\n      align: 'center',\n      sortable: false\n    }, {\n      title: 'Date',\n      key: 'date',\n      align: 'start',\n      sortable: true\n    }, {\n      title: 'Security',\n      key: 'security',\n      align: 'start',\n      sortable: true\n    }, {\n      title: 'Type',\n      key: 'type',\n      align: 'center',\n      sortable: false\n    }, {\n      title: 'Broker',\n      key: 'broker',\n      align: 'start',\n      sortable: true\n    }, {\n      title: 'Price',\n      key: 'price',\n      align: 'center',\n      sortable: false,\n      children: [{\n        title: 'Value',\n        key: 'price_value',\n        align: 'center',\n        sortable: true\n      }, {\n        title: 'Currency',\n        key: 'price_currency',\n        align: 'center',\n        sortable: false\n      }]\n    }]);\n    const assetTypesAllSelected = computed(() => {\n      return selectedAssetTypes.value.length === assetTypes.value.length;\n    });\n    const assetTypesIndeterminate = computed(() => {\n      return selectedAssetTypes.value.length > 0 && !assetTypesAllSelected.value;\n    });\n    const securitiesAllSelected = computed(() => {\n      return selectedSecurities.value.length === securities.value.length;\n    });\n    const securitiesIndeterminate = computed(() => {\n      return selectedSecurities.value.length > 0 && !securitiesAllSelected.value;\n    });\n    const toggleSelectAllAssetTypes = () => {\n      if (assetTypesAllSelected.value) {\n        selectedAssetTypes.value = [];\n      } else {\n        selectedAssetTypes.value = assetTypes.value.map(item => item.value);\n      }\n    };\n    const toggleSelectAllSecurities = () => {\n      if (securitiesAllSelected.value) {\n        selectedSecurities.value = [];\n      } else {\n        selectedSecurities.value = securities.value.map(item => item.id);\n      }\n    };\n    onMounted(async () => {\n      try {\n        const [assetTypesData, brokersData, securitiesData] = await Promise.all([getAssetTypes(), getBrokers(), getSecurities()]);\n        console.log('brokersData', brokersData);\n        console.log('securitiesData', securitiesData);\n        console.log('assetTypesData', assetTypesData);\n        assetTypes.value = assetTypesData;\n        brokers.value = brokersData;\n        securities.value = securitiesData;\n        await handleTimespanChange('ytd');\n      } catch (error) {\n        console.error('Error fetching initial data:', error);\n      }\n    });\n    const fetchSecurities = debounce(async () => {\n      try {\n        securities.value = await getSecurities(selectedAssetTypes.value, selectedBroker.value);\n        // Reset securities if they are no longer in the list\n        selectedSecurities.value = selectedSecurities.value.filter(id => securities.value.some(security => security.id === id));\n        // Automatically select all securities if a broker is selected\n        if (selectedBroker.value) {\n          selectedSecurities.value = securities.value.map(item => item.id);\n        }\n      } catch (error) {\n        console.error('Error fetching securities:', error);\n      }\n    }, 300); // 300ms debounce\n\n    watch([selectedAssetTypes, selectedBroker], () => {\n      fetchSecurities();\n    });\n    const fetchPriceData = async () => {\n      tableLoading.value = true;\n      try {\n        const response = await getPrices({\n          assetTypes: selectedAssetTypes.value,\n          brokers: selectedBroker.value ? [selectedBroker.value] : [],\n          securities: selectedSecurities.value,\n          dateFrom: dateFrom.value,\n          dateTo: dateTo.value,\n          page: currentPage.value,\n          itemsPerPage: itemsPerPage.value,\n          sortBy: sortBy.value[0] || {},\n          search: search.value\n        });\n        priceData.value = response.prices.map(price => ({\n          ...price,\n          price_value: price.price,\n          price_currency: price.currency\n        }));\n        totalItems.value = response.total_items;\n      } catch (error) {\n        console.error('Error fetching price data:', error);\n      } finally {\n        tableLoading.value = false;\n        isApplyingFilters.value = false;\n      }\n    };\n    const isApplyingFilters = ref(false);\n    const applyFilters = () => {\n      isApplyingFilters.value = true;\n      currentPage.value = 1;\n      fetchPriceData();\n    };\n    const showImportModal = () => {\n      // TODO: Implement import modal logic\n      console.log('Showing import modal');\n    };\n    const editPrice = item => {\n      editedItem.value = Object.assign({}, item);\n      editDialog.value = true;\n    };\n    const closeEditDialog = () => {\n      editDialog.value = false;\n      editedItem.value = {};\n    };\n    const updatePrice = async () => {\n      try {\n        await updatePriceEntry({\n          id: editedItem.value.id,\n          date: editedItem.value.date,\n          price: editedItem.value.price_value\n        });\n        closeEditDialog();\n        fetchPriceData();\n      } catch (error) {\n        console.error('Error updating price:', error);\n      }\n    };\n    const deletePrice = item => {\n      editedItem.value = Object.assign({}, item);\n      deleteDialog.value = true;\n    };\n    const closeDeleteDialog = () => {\n      deleteDialog.value = false;\n      editedItem.value = {};\n    };\n    const confirmDelete = async () => {\n      try {\n        await deletePriceEntry(editedItem.value.id);\n        closeDeleteDialog();\n        fetchPriceData();\n      } catch (error) {\n        console.error('Error deleting price:', error);\n      }\n    };\n    watch([() => store.state.dataRefreshTrigger, itemsPerPage, currentPage, sortBy\n    // dateFrom,\n    // dateTo\n    ], () => {\n      if (!isApplyingFilters.value) {\n        fetchPriceData();\n      }\n      isApplyingFilters.value = false;\n    }, {\n      deep: true\n    });\n    return {\n      assetTypes,\n      brokers,\n      securities,\n      selectedAssetTypes,\n      selectedBroker,\n      selectedSecurities,\n      dateFrom,\n      dateTo,\n      applyFilters,\n      showImportModal,\n      headers,\n      priceData,\n      loading,\n      tableLoading,\n      totalItems,\n      itemsPerPage,\n      currentPage,\n      sortBy,\n      editDialog,\n      deleteDialog,\n      editedItem,\n      handlePageChange,\n      handleItemsPerPageChange,\n      handleSortChange,\n      fetchPriceData,\n      editPrice,\n      closeEditDialog,\n      updatePrice,\n      deletePrice,\n      closeDeleteDialog,\n      confirmDelete,\n      assetTypesAllSelected,\n      assetTypesIndeterminate,\n      securitiesAllSelected,\n      securitiesIndeterminate,\n      toggleSelectAllAssetTypes,\n      toggleSelectAllSecurities,\n      fetchSecurities,\n      itemsPerPageOptions,\n      pageCount\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","computed","onMounted","useStore","getAssetTypes","getBrokers","getSecurities","getPrices","updatePriceEntry","deletePriceEntry","AddSecurityButton","AddPriceEntryButton","PriceChart","debounce","useTableSettings","name","components","setup","store","dateFrom","dateTo","itemsPerPage","currentPage","sortBy","handlePageChange","handleItemsPerPageChange","handleSortChange","handleTimespanChange","assetTypes","brokers","securities","selectedAssetTypes","selectedBroker","selectedSecurities","priceData","loading","tableLoading","totalItems","editDialog","deleteDialog","editedItem","deletedItem","itemsPerPageOptions","state","pageCount","Math","ceil","value","headers","title","key","align","sortable","children","assetTypesAllSelected","length","assetTypesIndeterminate","securitiesAllSelected","securitiesIndeterminate","toggleSelectAllAssetTypes","map","item","toggleSelectAllSecurities","id","assetTypesData","brokersData","securitiesData","Promise","all","console","log","error","fetchSecurities","filter","some","security","fetchPriceData","response","page","search","prices","price","price_value","price_currency","currency","total_items","isApplyingFilters","applyFilters","showImportModal","editPrice","Object","assign","closeEditDialog","updatePrice","date","deletePrice","closeDeleteDialog","confirmDelete","dataRefreshTrigger","deep"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\PricesPage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text class=\"pa-4\">\r\n        <v-row>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedAssetTypes\"\r\n              :items=\"assetTypes\"\r\n              label=\"Asset Types\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              multiple\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item\r\n                title=\"Select All\"\r\n                @click=\"toggleSelectAllAssetTypes\"\r\n                >\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"assetTypesAllSelected\"\r\n                      :indeterminate=\"assetTypesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 3\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 3\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedAssetTypes.length - 3 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedBroker\"\r\n              :items=\"brokers\"\r\n              label=\"Brokers\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              clearable\r\n            ></v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedSecurities\"\r\n              :items=\"securities\"\r\n              label=\"Securities\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              multiple\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item\r\n                title=\"Select All\"\r\n                @click=\"toggleSelectAllSecurities\"\r\n                >\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"securitiesAllSelected\"\r\n                      :indeterminate=\"securitiesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 1\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 1\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedSecurities.length - 1 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n        </v-row>\r\n        <v-row class=\"mt-n6\">\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-text-field\r\n              v-model=\"dateFrom\"\r\n              label=\"Start Date\"\r\n              type=\"date\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-text-field\r\n              v-model=\"dateTo\"\r\n              label=\"End Date\"\r\n              type=\"date\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\" class=\"d-flex align-center\">\r\n            <v-btn color=\"primary\" @click=\"applyFilters\" block>\r\n              Apply Filters\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\" justify=\"space-between\">\r\n          <v-col cols=\"auto\">\r\n            <v-row>\r\n              <v-col cols=\"auto\">\r\n                <AddSecurityButton />\r\n              </v-col>\r\n              <v-col cols=\"auto\">\r\n                <AddPriceEntryButton />\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n          <v-col cols=\"auto\">\r\n            <v-btn color=\"success\" @click=\"showImportModal\">\r\n              Import Prices\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <PriceChart v-if=\"priceData.length > 0\" :prices=\"priceData\" />\r\n        <p v-else>No price data available. Please apply filters.</p>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card>\r\n      <v-data-table\r\n        :headers=\"headers\"\r\n        :items=\"priceData\"\r\n        :loading=\"tableLoading\"\r\n        :items-per-page=\"itemsPerPage\"\r\n        :page=\"currentPage\"\r\n        :server-items-length=\"totalItems\"\r\n        :sort-by=\"sortBy\"\r\n        @update:sort-by=\"handleSortChange\"\r\n        class=\"elevation-1\"\r\n        density=\"compact\"\r\n      >\r\n        <template #header>\r\n          <tr>\r\n            <th v-for=\"header in headers\" :key=\"header.key\" :colspan=\"header.children ? header.children.length : 1\" :rowspan=\"header.children ? 1 : 2\" :class=\"['text-' + header.align]\">\r\n              {{ header.title }}\r\n            </th>\r\n          </tr>\r\n          <tr>\r\n            <template v-for=\"header in headers\" :key=\"header.key\">\r\n              <th v-for=\"subHeader in header.children\" :key=\"subHeader.key\" :class=\"['text-' + subHeader.align]\">\r\n                {{ subHeader.title }}\r\n              </th>\r\n            </template>\r\n          </tr>\r\n        </template>\r\n\r\n        <template #item=\"{ item }\">\r\n          <tr>\r\n            <td class=\"text-center\">\r\n              <v-icon small class=\"mr-2\" @click=\"editPrice(item)\">\r\n                mdi-pencil\r\n              </v-icon>\r\n              <v-icon small @click=\"deletePrice(item)\">\r\n                mdi-delete\r\n              </v-icon>\r\n            </td>\r\n            <td>{{ item.date }}</td>\r\n            <td>{{ item.security }}</td>\r\n            <td class=\"text-center\">{{ item.type }}</td>\r\n            <td>{{ item.broker }}</td>\r\n            <td class=\"text-center\">{{ item.price_value }}</td>\r\n            <td class=\"text-center\">{{ item.price_currency }}</td>\r\n          </tr>\r\n        </template>\r\n\r\n        <template v-slot:bottom>\r\n          <v-row align=\"center\" class=\"pa-4\">\r\n            <v-col cols=\"12\" sm=\"4\">\r\n              <v-select\r\n                v-model=\"itemsPerPage\"\r\n                :items=\"itemsPerPageOptions\"\r\n                label=\"Rows per page\"\r\n                density=\"compact\"\r\n                variant=\"outlined\"\r\n                @update:model-value=\"handleItemsPerPageChange\"\r\n                hide-details\r\n              ></v-select>\r\n            </v-col>\r\n            <v-col cols=\"12\" sm=\"4\" class=\"text-center\">\r\n              <span class=\"text-caption\">\r\n                Showing {{ ((currentPage - 1) * itemsPerPage) + 1 }} - {{ Math.min(currentPage * itemsPerPage, totalItems) }} of {{ totalItems }}\r\n              </span>\r\n            </v-col>\r\n            <v-col cols=\"12\" sm=\"4\">\r\n              <v-pagination\r\n                v-model=\"currentPage\"\r\n                :length=\"pageCount\"\r\n                rounded=\"circle\"\r\n                :total-visible=\"7\"\r\n                @update:model-value=\"handlePageChange\"\r\n              ></v-pagination>\r\n            </v-col>\r\n          </v-row>\r\n        </template>\r\n      </v-data-table>\r\n    </v-card>\r\n\r\n    <v-dialog v-model=\"editDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>\r\n          <span class=\"text-h5\">Edit Price</span>\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-container>\r\n            <v-row>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-text-field v-model=\"editedItem.date\" label=\"Date\"></v-text-field>\r\n              </v-col>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-text-field v-model=\"editedItem.price_value\" label=\"Price\"></v-text-field>\r\n              </v-col>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-text-field v-model=\"editedItem.price_currency\" label=\"Currency\" disabled></v-text-field>\r\n              </v-col>\r\n            </v-row>\r\n          </v-container>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeEditDialog\">Cancel</v-btn>\r\n          <v-btn color=\"blue darken-1\" text @click=\"updatePrice\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n\r\n    <v-dialog v-model=\"deleteDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Delete Price Entry</v-card-title>\r\n        <v-card-text>Are you sure you want to delete this price entry?</v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeDeleteDialog\">Cancel</v-btn>\r\n          <v-btn color=\"red darken-1\" text @click=\"confirmDelete\">Delete</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch, computed, onMounted } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { getAssetTypes, getBrokers, getSecurities, getPrices, updatePriceEntry, deletePriceEntry } from '@/services/api'\r\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue'\r\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue'\r\nimport PriceChart from '@/components/charts/PriceChart.vue'\r\nimport debounce from 'lodash/debounce'\r\nimport { useTableSettings } from '@/composables/useTableSettings'\r\n\r\nexport default {\r\n  name: 'PricesPage',\r\n  components: {\r\n    AddSecurityButton,\r\n    AddPriceEntryButton,\r\n    PriceChart,\r\n  },\r\n  setup() {\r\n    const store = useStore()\r\n    const {\r\n      dateFrom,\r\n      dateTo,\r\n      itemsPerPage,\r\n      currentPage,\r\n      sortBy,\r\n      handlePageChange,\r\n      handleItemsPerPageChange,\r\n      handleSortChange,\r\n      handleTimespanChange\r\n    } = useTableSettings()\r\n\r\n    const assetTypes = ref([])\r\n    const brokers = ref([])\r\n    const securities = ref([])\r\n    const selectedAssetTypes = ref([])\r\n    const selectedBroker = ref(null)\r\n    const selectedSecurities = ref([])\r\n    const priceData = ref([])\r\n    const loading = ref(false)\r\n    const tableLoading = ref(false)\r\n    const totalItems = ref(0)\r\n    const editDialog = ref(false)\r\n    const deleteDialog = ref(false)\r\n    const editedItem = ref({})\r\n    const deletedItem = ref({})\r\n\r\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions)\r\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value))\r\n\r\n    const headers = computed(() => [\r\n      { title: '', key: 'actions', align: 'center', sortable: false },\r\n      { title: 'Date', key: 'date', align: 'start', sortable: true },\r\n      { title: 'Security', key: 'security', align: 'start', sortable: true },\r\n      { title: 'Type', key: 'type', align: 'center', sortable: false },\r\n      { title: 'Broker', key: 'broker', align: 'start', sortable: true },\r\n      {\r\n        title: 'Price',\r\n        key: 'price',\r\n        align: 'center',\r\n        sortable: false,\r\n        children: [\r\n          { title: 'Value', key: 'price_value', align: 'center', sortable: true },\r\n          { title: 'Currency', key: 'price_currency', align: 'center', sortable: false },\r\n        ],\r\n      },\r\n    ])\r\n\r\n    const assetTypesAllSelected = computed(() => {\r\n      return selectedAssetTypes.value.length === assetTypes.value.length\r\n    })\r\n\r\n    const assetTypesIndeterminate = computed(() => {\r\n      return selectedAssetTypes.value.length > 0 && !assetTypesAllSelected.value\r\n    })\r\n\r\n    const securitiesAllSelected = computed(() => {\r\n      return selectedSecurities.value.length === securities.value.length\r\n    })\r\n\r\n    const securitiesIndeterminate = computed(() => {\r\n      return selectedSecurities.value.length > 0 && !securitiesAllSelected.value\r\n    })\r\n\r\n    const toggleSelectAllAssetTypes = () => {\r\n      if (assetTypesAllSelected.value) {\r\n        selectedAssetTypes.value = []\r\n      } else {\r\n        selectedAssetTypes.value = assetTypes.value.map(item => item.value)\r\n      }\r\n    }\r\n\r\n    const toggleSelectAllSecurities = () => {\r\n      if (securitiesAllSelected.value) {\r\n        selectedSecurities.value = []\r\n      } else {\r\n        selectedSecurities.value = securities.value.map(item => item.id)\r\n      }\r\n    }\r\n\r\n    onMounted(async () => {\r\n      try {\r\n        const [assetTypesData, brokersData, securitiesData] = await Promise.all([\r\n          getAssetTypes(),\r\n          getBrokers(),\r\n          getSecurities(),\r\n        ])\r\n        console.log('brokersData', brokersData)\r\n        console.log('securitiesData', securitiesData)\r\n        console.log('assetTypesData', assetTypesData)\r\n        assetTypes.value = assetTypesData\r\n        brokers.value = brokersData\r\n        securities.value = securitiesData\r\n\r\n        await handleTimespanChange('ytd')\r\n\r\n      } catch (error) {\r\n        console.error('Error fetching initial data:', error)\r\n      }\r\n    })\r\n\r\n    const fetchSecurities = debounce(async () => {\r\n      try {\r\n        securities.value = await getSecurities(selectedAssetTypes.value, selectedBroker.value)\r\n        // Reset securities if they are no longer in the list\r\n        selectedSecurities.value = selectedSecurities.value.filter(id =>\r\n          securities.value.some(security => security.id === id)\r\n        )\r\n        // Automatically select all securities if a broker is selected\r\n        if (selectedBroker.value) {\r\n          selectedSecurities.value = securities.value.map(item => item.id);\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching securities:', error)\r\n      }\r\n    }, 300) // 300ms debounce\r\n\r\n    watch([selectedAssetTypes, selectedBroker], () => {\r\n      fetchSecurities()\r\n    })\r\n\r\n    const fetchPriceData = async () => {\r\n      tableLoading.value = true\r\n      try {\r\n        const response = await getPrices({\r\n          assetTypes: selectedAssetTypes.value,\r\n          brokers: selectedBroker.value ? [selectedBroker.value] : [],\r\n          securities: selectedSecurities.value,\r\n          dateFrom: dateFrom.value,\r\n          dateTo: dateTo.value,\r\n          page: currentPage.value,\r\n          itemsPerPage: itemsPerPage.value,\r\n          sortBy: sortBy.value[0] || {},\r\n          search: search.value,\r\n        })\r