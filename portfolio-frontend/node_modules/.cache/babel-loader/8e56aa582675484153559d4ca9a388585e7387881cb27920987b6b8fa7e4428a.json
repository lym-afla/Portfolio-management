{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { Pie } from 'vue-chartjs';\nimport { Chart as ChartJS, Title, Tooltip, Legend, ArcElement, CategoryScale } from 'chart.js';\nimport ChartDataLabels from 'chartjs-plugin-datalabels';\nimport { pieChartOptions, colorPalette } from '@/config/chartConfig';\nChartJS.register(Title, Tooltip, Legend, ArcElement, CategoryScale, ChartDataLabels);\nexport default {\n  name: 'BreakdownChart',\n  components: {\n    Pie\n  },\n  props: {\n    title: {\n      type: String,\n      required: true\n    },\n    data: {\n      type: Object,\n      required: true\n    },\n    currency: {\n      type: String,\n      required: true\n    }\n  },\n  setup(props) {\n    const tab = ref('chart');\n    const chartReady = ref(false);\n\n    // onMounted(() => {\n    //   // Small delay to ensure fonts are loaded\n    //   setTimeout(() => {\n    //     chartReady.value = true\n    //   }, 100)\n    // })\n\n    console.log(\"BreakdownChart.vue. props.data\", props.data);\n    const sortedData = computed(() => {\n      return Object.entries(props.data.data).map(([label, value]) => ({\n        label,\n        value,\n        percentage: props.data.percentage[label]\n      })).sort((a, b) => parseFloat(b.value.replace(/[^0-9.-]+/g, \"\")) - parseFloat(a.value.replace(/[^0-9.-]+/g, \"\")));\n    });\n    const chartData = computed(() => ({\n      labels: sortedData.value.map(item => item.label),\n      datasets: [{\n        data: sortedData.value.map(item => parseFloat(item.value.replace(/[^0-9.-]+/g, \"\"))),\n        backgroundColor: colorPalette\n      }]\n    }));\n    return {\n      tab,\n      chartData,\n      pieChartOptions,\n      sortedData,\n      props,\n      // Expose props to the template\n      chartReady\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","Pie","Chart","ChartJS","Title","Tooltip","Legend","ArcElement","CategoryScale","ChartDataLabels","pieChartOptions","colorPalette","register","name","components","props","title","type","String","required","data","Object","currency","setup","tab","chartReady","console","log","sortedData","entries","map","label","value","percentage","sort","a","b","parseFloat","replace","chartData","labels","item","datasets","backgroundColor"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\BreakdownChart.vue"],"sourcesContent":["<template>\r\n  <v-card>\r\n    <v-card-title>{{ title }}</v-card-title>\r\n    <v-card-text class=\"pa-0\">\r\n      <v-tabs v-model=\"tab\">\r\n        <v-tab value=\"chart\">Pie Chart</v-tab>\r\n        <v-tab value=\"table\">Table</v-tab>\r\n      </v-tabs>\r\n\r\n      <v-window v-model=\"tab\">\r\n        <v-window-item value=\"chart\">\r\n          <div class=\"chart-container\">\r\n            <Pie v-if=\"chartReady\" :data=\"chartData\" :options=\"pieChartOptions\" :width=\"300\" :height=\"300\" />\r\n          </div>\r\n        </v-window-item>\r\n\r\n        <v-window-item value=\"table\">\r\n          <v-table density=\"compact\">\r\n            <thead>\r\n              <tr>\r\n                <th class=\"text-left category-column\"></th>\r\n                <th class=\"text-right font-weight-bold\">{{ currency }}</th>\r\n                <th class=\"text-right font-weight-bold\">%</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr v-for=\"(item, index) in sortedData\" :key=\"index\">\r\n                <td class=\"text-left category-column\">{{ item.label }}</td>\r\n                <td class=\"text-right\">{{ item.value }}</td>\r\n                <td class=\"text-right\">{{ item.percentage }}</td>\r\n              </tr>\r\n              <tr class=\"font-weight-bold\">\r\n                <td class=\"text-left category-column\">Total</td>\r\n                <td class=\"text-right\">{{ props.data.totalNAV }}</td>\r\n                <td class=\"text-right\">100%</td>\r\n              </tr>\r\n            </tbody>\r\n          </v-table>\r\n        </v-window-item>\r\n      </v-window>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed,  } from 'vue'\r\nimport { Pie } from 'vue-chartjs'\r\nimport { Chart as ChartJS, Title, Tooltip, Legend, ArcElement, CategoryScale } from 'chart.js'\r\nimport ChartDataLabels from 'chartjs-plugin-datalabels'\r\nimport { pieChartOptions, colorPalette } from '@/config/chartConfig'\r\n\r\nChartJS.register(Title, Tooltip, Legend, ArcElement, CategoryScale, ChartDataLabels)\r\n\r\nexport default {\r\n  name: 'BreakdownChart',\r\n  components: { Pie },\r\n  props: {\r\n    title: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    data: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    currency: {\r\n      type: String,\r\n      required: true\r\n    }\r\n  },\r\n  setup(props) {\r\n    const tab = ref('chart')\r\n    const chartReady = ref(false)\r\n\r\n    // onMounted(() => {\r\n    //   // Small delay to ensure fonts are loaded\r\n    //   setTimeout(() => {\r\n    //     chartReady.value = true\r\n    //   }, 100)\r\n    // })\r\n\r\n    console.log(\"BreakdownChart.vue. props.data\", props.data)\r\n\r\n    const sortedData = computed(() => {\r\n      return Object.entries(props.data.data)\r\n        .map(([label, value]) => ({ \r\n          label, \r\n          value,\r\n          percentage: props.data.percentage[label]\r\n        }))\r\n        .sort((a, b) => parseFloat(b.value.replace(/[^0-9.-]+/g,\"\")) - parseFloat(a.value.replace(/[^0-9.-]+/g,\"\")))\r\n    })\r\n\r\n    const chartData = computed(() => ({\r\n      labels: sortedData.value.map(item => item.label),\r\n      datasets: [{\r\n        data: sortedData.value.map(item => parseFloat(item.value.replace(/[^0-9.-]+/g,\"\"))),\r\n        backgroundColor: colorPalette\r\n      }]\r\n    }))\r\n\r\n    return {\r\n      tab,\r\n      chartData,\r\n      pieChartOptions,\r\n      sortedData,\r\n      props, // Expose props to the template\r\n      chartReady\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n  /* height: 300px; */\r\n  position: relative;\r\n}\r\n\r\n.category-column {\r\n  width: 50%;\r\n}\r\n\r\n.v-table :deep(th) {\r\n  font-weight: bold !important;\r\n}\r\n\r\n.v-table :deep(td), .v-table :deep(th) {\r\n  padding: 0 16px !important;\r\n}\r\n</style>"],"mappings":"AA6CA,SAASA,GAAG,EAAEC,QAAQ,QAAU,KAAI;AACpC,SAASC,GAAE,QAAS,aAAY;AAChC,SAASC,KAAI,IAAKC,OAAO,EAAEC,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,UAAU,EAAEC,aAAY,QAAS,UAAS;AAC7F,OAAOC,eAAc,MAAO,2BAA0B;AACtD,SAASC,eAAe,EAAEC,YAAW,QAAS,sBAAqB;AAEnER,OAAO,CAACS,QAAQ,CAACR,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,UAAU,EAAEC,aAAa,EAAEC,eAAe;AAEnF,eAAe;EACbI,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAEb;EAAI,CAAC;EACnBc,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,IAAI,EAAE;MACJH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ,CAAC;IACDG,QAAQ,EAAE;MACRL,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDI,KAAKA,CAACR,KAAK,EAAE;IACX,MAAMS,GAAE,GAAIzB,GAAG,CAAC,OAAO;IACvB,MAAM0B,UAAS,GAAI1B,GAAG,CAAC,KAAK;;IAE5B;IACA;IACA;IACA;IACA;IACA;;IAEA2B,OAAO,CAACC,GAAG,CAAC,gCAAgC,EAAEZ,KAAK,CAACK,IAAI;IAExD,MAAMQ,UAAS,GAAI5B,QAAQ,CAAC,MAAM;MAChC,OAAOqB,MAAM,CAACQ,OAAO,CAACd,KAAK,CAACK,IAAI,CAACA,IAAI,EAClCU,GAAG,CAAC,CAAC,CAACC,KAAK,EAAEC,KAAK,CAAC,MAAM;QACxBD,KAAK;QACLC,KAAK;QACLC,UAAU,EAAElB,KAAK,CAACK,IAAI,CAACa,UAAU,CAACF,KAAK;MACzC,CAAC,CAAC,EACDG,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKC,UAAU,CAACD,CAAC,CAACJ,KAAK,CAACM,OAAO,CAAC,YAAY,EAAC,EAAE,CAAC,IAAID,UAAU,CAACF,CAAC,CAACH,KAAK,CAACM,OAAO,CAAC,YAAY,EAAC,EAAE,CAAC,CAAC;IAC/G,CAAC;IAED,MAAMC,SAAQ,GAAIvC,QAAQ,CAAC,OAAO;MAChCwC,MAAM,EAAEZ,UAAU,CAACI,KAAK,CAACF,GAAG,CAACW,IAAG,IAAKA,IAAI,CAACV,KAAK,CAAC;MAChDW,QAAQ,EAAE,CAAC;QACTtB,IAAI,EAAEQ,UAAU,CAACI,KAAK,CAACF,GAAG,CAACW,IAAG,IAAKJ,UAAU,CAACI,IAAI,CAACT,KAAK,CAACM,OAAO,CAAC,YAAY,EAAC,EAAE,CAAC,CAAC,CAAC;QACnFK,eAAe,EAAEhC;MACnB,CAAC;IACH,CAAC,CAAC;IAEF,OAAO;MACLa,GAAG;MA