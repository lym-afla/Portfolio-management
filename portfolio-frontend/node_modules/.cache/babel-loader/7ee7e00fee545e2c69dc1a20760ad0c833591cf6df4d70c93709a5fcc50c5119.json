{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { analyzeFile, getBrokers, importTransactions, getSecurities } from '@/services/api';\nimport { useErrorHandler } from '@/composables/useErrorHandler';\nimport ProgressDialog from '@/components/dialogs/ProgressDialog.vue';\nimport SecurityMappingDialog from '@/components/dialogs/SecurityMappingDialog.vue';\nimport { useWebSocket } from '@/composables/useWebSocket';\nexport default {\n  name: 'TransactionImportDialog',\n  components: {\n    ProgressDialog,\n    SecurityMappingDialog\n  },\n  props: {\n    modelValue: Boolean\n  },\n  emits: ['update:modelValue', 'import-completed'],\n  setup(props, {\n    emit\n  }) {\n    const {\n      handleApiError\n    } = useErrorHandler();\n    const {\n      isConnected,\n      lastMessage,\n      sendMessage,\n      connect,\n      disconnect\n    } = useWebSocket();\n    const dialog = ref(props.modelValue);\n    const fileId = ref(null);\n    const selectedBroker = ref(null);\n    const showProgressDialog = ref(false);\n    const importProgress = ref(0);\n    const currentImported = ref(0);\n    const totalToImport = ref(0);\n    const currentImportMessage = ref('');\n    const showSecurityMappingDialog = ref(false);\n    const securityToMap = ref('');\n    const bestMatch = ref(null);\n    const startImport = async () => {\n      if (fileId.value && selectedBroker.value) {\n        try {\n          showProgressDialog.value = true;\n          const eventSource = new EventSource(`/api/transactions/import/?file_id=${fileId.value}&broker_id=${selectedBroker.value}`);\n          eventSource.onmessage = event => {\n            const data = JSON.parse(event.data);\n            handleImportUpdate(data);\n          };\n          eventSource.onerror = error => {\n            console.error('EventSource failed:', error);\n            eventSource.close();\n            showProgressDialog.value = false;\n          };\n        } catch (error) {\n          handleApiError(error);\n          showProgressDialog.value = false;\n        }\n      }\n    };\n    const handleImportUpdate = update => {\n      if (update.status === 'progress') {\n        importProgress.value = update.progress;\n        currentImported.value = update.current;\n        totalToImport.value = update.total;\n        currentImportMessage.value = update.message;\n      } else if (update.status === 'security_mapping') {\n        securityToMap.value = update.security;\n        bestMatch.value = update.best_match;\n        showSecurityMappingDialog.value = true;\n      } else if (update.status === 'complete') {\n        handleImportSuccess(update.data);\n      }\n    };\n    const handleSecurityMapped = securityId => {\n      showSecurityMappingDialog.value = false;\n      sendMessage({\n        type: 'security_mapped',\n        securityId\n      });\n    };\n    const handleImportSuccess = result => {\n      emit('import-completed', result);\n      // Additional logic for handling import success\n    };\n    onMounted(() => {\n      connect();\n    });\n    onUnmounted(() => {\n      disconnect();\n    });\n\n    // Watch for incoming WebSocket messages\n    watch(lastMessage, newMessage => {\n      if (newMessage && newMessage.type === 'import_update') {\n        handleImportUpdate(newMessage.data);\n      }\n    });\n\n    // ... rest of the setup code ...\n\n    return {\n      dialog,\n      fileId,\n      selectedBroker,\n      showProgressDialog,\n      importProgress,\n      currentImported,\n      totalToImport,\n      currentImportMessage,\n      showSecurityMappingDialog,\n      securityToMap,\n      bestMatch,\n      isConnected,\n      startImport,\n      handleSecurityMapped\n      // ... other necessary properties and methods\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","analyzeFile","getBrokers","importTransactions","getSecurities","useErrorHandler","ProgressDialog","SecurityMappingDialog","useWebSocket","name","components","props","modelValue","Boolean","emits","setup","emit","handleApiError","isConnected","lastMessage","sendMessage","connect","disconnect","dialog","fileId","selectedBroker","showProgressDialog","importProgress","currentImported","totalToImport","currentImportMessage","showSecurityMappingDialog","securityToMap","bestMatch","startImport","value","eventSource","EventSource","onmessage","event","data","JSON","parse","handleImportUpdate","onerror","error","console","close","update","status","progress","current","total","message","security","best_match","handleImportSuccess","handleSecurityMapped","securityId","type","result","watch","newMessage"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\TransactionImportDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5\">Import Transactions</v-card-title>\r\n      <v-card-text>\r\n        <v-file-input\r\n          v-model=\"file\"\r\n          label=\"Select Excel or CSV file to import\"\r\n          accept=\".csv, .xlsx, .xls\"\r\n          :rules=\"[v => !!v || 'File is required']\"\r\n          @change=\"handleFileChange\"\r\n          :disabled=\"isAnalyzed\"\r\n        ></v-file-input>\r\n        <v-alert\r\n          v-if=\"isAnalyzed && brokerIdentificationComplete\"\r\n          :type=\"brokerIdentified ? 'success' : 'info'\"\r\n          class=\"mt-4 mb-4\"\r\n        >\r\n          {{ brokerIdentified \r\n            ? `Broker \"${identifiedBroker.name}\" was automatically identified. Please confirm or select a different broker.` \r\n            : 'Broker could not be automatically identified. Please select a broker below.' }}\r\n        </v-alert>\r\n        <v-autocomplete\r\n          v-if=\"isAnalyzed\"\r\n          v-model=\"selectedBroker\"\r\n          :items=\"brokers\"\r\n          item-title=\"name\"\r\n          item-value=\"id\"\r\n          label=\"Select Broker\"\r\n          class=\"mt-4\"\r\n        ></v-autocomplete>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n        <v-btn \r\n          v-if=\"!isAnalyzed\" \r\n          color=\"blue darken-1\" \r\n          text \r\n          @click=\"submitFile\" \r\n          :disabled=\"!file || isLoading\"\r\n          :loading=\"isLoading\"\r\n        >\r\n          Analyze File\r\n        </v-btn>\r\n        <v-btn\r\n          v-if=\"isAnalyzed\"\r\n          color=\"blue darken-1\"\r\n          text\r\n          @click=\"startImport\"\r\n          :disabled=\"!selectedBroker\"\r\n        >\r\n          Import Transactions\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <ProgressDialog\r\n    v-model=\"showProgressDialog\"\r\n    :title=\"'Importing Transactions'\"\r\n    :progress=\"importProgress\"\r\n    :current=\"currentImported\"\r\n    :total=\"totalToImport\"\r\n    :current-message=\"currentImportMessage\"\r\n    :error=\"importError\"\r\n    :can-stop=\"canStopImport\"\r\n    @stop-import=\"stopImport\"\r\n    @reset=\"resetProgressDialog\"\r\n  />\r\n\r\n  <SecurityMappingDialog\r\n    v-model=\"showSecurityMappingDialog\"\r\n    :security=\"securityToMap\"\r\n    :best-match=\"bestMatch\"\r\n    @security-mapped=\"handleSecurityMapped\"\r\n  />\r\n\r\n  <v-dialog v-model=\"showSuccessDialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5 pb-2\">\r\n        <v-icon color=\"success\" class=\"mr-2\">mdi-check-circle</v-icon>\r\n        Import Completed\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"primary\" size=\"40\">\r\n                    <v-icon dark>mdi-database-import</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.totalTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Total transactions processed</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"success\" size=\"40\">\r\n                    <v-icon dark>mdi-check-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.importedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Successfully imported</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"error\" size=\"40\">\r\n                    <v-icon dark>mdi-alert-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.skippedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Skipped transactions</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"info\" size=\"40\">\r\n                    <v-icon dark>mdi-plus-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.newSecurities }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>New securities added</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"warning\" size=\"40\">\r\n                    <v-icon dark>mdi-help-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.unrecognizedSecurities.length }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Unrecognized securities</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"closeSuccessDialog\">Close</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <v-dialog v-model=\"showUnrecognizedSecuritiesDialog\" max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title>Unrecognized Securities</v-card-title>\r\n      <v-card-text>\r\n        <p>The following securities were not recognized. Please map them to existing securities or create new ones:</p>\r\n        <v-list>\r\n          <v-list-item v-for=\"security in unrecognizedSecurities\" :key=\"security\">\r\n            <v-list-item-title>{{ security }}</v-list-item-title>\r\n            <template v-slot:append>\r\n              <v-autocomplete\r\n                v-model=\"securityMappings[security]\"\r\n                :items=\"existingSecurities\"\r\n                item-title=\"name\"\r\n                item-value=\"id\"\r\n                label=\"Select existing security\"\r\n                clearable\r\n                style=\"max-width: 300px;\"\r\n              ></v-autocomplete>\r\n              <v-btn v-if=\"!securityMappings[security]\" @click=\"createNewSecurity(security)\" color=\"primary\" text>\r\n                Create New Security\r\n              </v-btn>\r\n            </template>\r\n          </v-list-item>\r\n        </v-list>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"confirmSecurityMappings\">Confirm and Import</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue'\r\nimport { analyzeFile, getBrokers, importTransactions, getSecurities } from '@/services/api'\r\nimport { useErrorHandler } from '@/composables/useErrorHandler'\r\nimport ProgressDialog from '@/components/dialogs/ProgressDialog.vue'\r\nimport SecurityMappingDialog from '@/components/dialogs/SecurityMappingDialog.vue'\r\nimport { useWebSocket } from '@/composables/useWebSocket'\r\n\r\nexport default {\r\n  name: 'TransactionImportDialog',\r\n  components: {\r\n    ProgressDialog,\r\n    SecurityMappingDialog\r\n  },\r\n  props: {\r\n    modelValue: Boolean,\r\n  },\r\n  emits: ['update:modelValue', 'import-completed'],\r\n  setup(props, { emit }) {\r\n    const { handleApiError } = useErrorHandler()\r\n    const { isConnected, lastMessage, sendMessage, connect, disconnect } = useWebSocket()\r\n\r\n    const dialog = ref(props.modelValue)\r\n    const fileId = ref(null)\r\n    const selectedBroker = ref(null)\r\n    const showProgressDialog = ref(false)\r\n    const importProgress = ref(0)\r\n    const currentImported = ref(0)\r\n    const totalToImport = ref(0)\r\n    const currentImportMessage = ref('')\r\n    const showSecurityMappingDialog = ref(false)\r\n    const securityToMap = ref('')\r\n    const bestMatch = ref(null)\r\n\r\n    const startImport = async () => {\r\n      if (fileId.value && selectedBroker.value) {\r\n        try {\r\n          showProgressDialog.value = true\r\n          const eventSource = new EventSource(`/api/transactions/import/?file_id=${fileId.value}&broker_id=${selectedBroker.value}`);\r\n          \r\n          eventSource.onmessage = (event) => {\r\n            const data = JSON.parse(event.data);\r\n            handleImportUpdate(data);\r\n          };\r\n\r\n          eventSource.onerror = (error) => {\r\n            console.error('EventSource failed:', error);\r\n            eventSource.close();\r\n            showProgressDialog.value = false;\r\n          };\r\n        } catch (error) {\r\n          handleApiError(error)\r\n          showProgressDialog.value = false\r\n        }\r\n      }\r\n    }\r\n\r\n    const handleImportUpdate = (update) => {\r\n      if (update.status === 'progress') {\r\n        importProgress.value = update.progress\r\n        currentImported.value = update.current\r\n        totalToImport.value = update.total\r\n        currentImportMessage.value = update.message\r\n      } else if (update.status === 'security_mapping') {\r\n        securityToMap.value = update.security\r\n        bestMatch.value = update.best_match\r\n        showSecurityMappingDialog.value = true\r\n      } else if (update.status === 'complete') {\r\n        handleImportSuccess(update.data)\r\n      }\r\n    }\r\n\r\n    const handleSecurityMapped = (securityId) => {\r\n      showSecurityMappingDialog.value = false\r\n      sendMessage({ type: 'security_mapped', securityId })\r\n    }\r\n\r\n    const handleImportSuccess = (result) => {\r\n      emit('import-completed', result)\r\n      // Additional logic for handling import success\r\n    }\r\n\r\n    onMounted(() => {\r\n      connect()\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      disconnect()\r\n    })\r\n\r\n    // Watch for incoming WebSocket messages\r\n    watch(lastMessage, (newMessage) => {\r\n      if (newMessage && newMessage.type === 'import_update') {\r\n        handleImportUpdate(newMessage.data)\r\n      }\r\n    })\r\n\r\n    // ... rest of the setup code ...\r\n\r\n    return {\r\n      dialog,\r\n      fileId,\r\n      selectedBroker,\r\n      showProgressDialog,\r\n      importProgress,\r\n      currentImported,\r\n      totalToImport,\r\n      currentImportMessage,\r\n      showSecurityMappingDialog,\r\n      securityToMap,\r\n      bestMatch,\r\n      isConnected,\r\n      startImport,\r\n      handleSecurityMapped,\r\n      // ... other necessary properties and methods\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA4MA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAC1D,SAASC,WAAW,EAAEC,UAAU,EAAEC,kBAAkB,EAAEC,aAAY,QAAS,gBAAe;AAC1F,SAASC,eAAc,QAAS,+BAA8B;AAC9D,OAAOC,cAAa,MAAO,yCAAwC;AACnE,OAAOC,qBAAoB,MAAO,gDAA+C;AACjF,SAASC,YAAW,QAAS,4BAA2B;AAExD,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVJ,cAAc;IACdC;EACF,CAAC;EACDI,KAAK,EAAE;IACLC,UAAU,EAAEC;EACd,CAAC;EACDC,KAAK,EAAE,CAAC,mBAAmB,EAAE,kBAAkB,CAAC;EAChDC,KAAKA,CAACJ,KAAK,EAAE;IAAEK;EAAK,CAAC,EAAE;IACrB,MAAM;MAAEC;IAAe,IAAIZ,eAAe,CAAC;IAC3C,MAAM;MAAEa,WAAW;MAAEC,WAAW;MAAEC,WAAW;MAAEC,OAAO;MAAEC;IAAW,IAAId,YAAY,CAAC;IAEpF,MAAMe,MAAK,GAAI1B,GAAG,CAACc,KAAK,CAACC,UAAU;IACnC,MAAMY,MAAK,GAAI3B,GAAG,CAAC,IAAI;IACvB,MAAM4B,cAAa,GAAI5B,GAAG,CAAC,IAAI;IAC/B,MAAM6B,kBAAiB,GAAI7B,GAAG,CAAC,KAAK;IACpC,MAAM8B,cAAa,GAAI9B,GAAG,CAAC,CAAC;IAC5B,MAAM+B,eAAc,GAAI/B,GAAG,CAAC,CAAC;IAC7B,MAAMgC,aAAY,GAAIhC,GAAG,CAAC,CAAC;IAC3B,MAAMiC,oBAAmB,GAAIjC,GAAG,CAAC,EAAE;IACnC,MAAMkC,yBAAwB,GAAIlC,GAAG,CAAC,KAAK;IAC3C,MAAMmC,aAAY,GAAInC,GAAG,CAAC,EAAE;IAC5B,MAAMoC,SAAQ,GAAIpC,GAAG,CAAC,IAAI;IAE1B,MAAMqC,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9B,IAAIV,MAAM,CAACW,KAAI,IAAKV,cAAc,CAACU,KAAK,EAAE;QACxC,IAAI;UACFT,kBAAkB,CAACS,KAAI,GAAI,IAAG;UAC9B,MAAMC,WAAU,GAAI,IAAIC,WAAW,CAAC,qCAAqCb,MAAM,CAACW,KAAK,cAAcV,cAAc,CAACU,KAAK,EAAE,CAAC;UAE1HC,WAAW,CAACE,SAAQ,GAAKC,KAAK,IAA