{"ast":null,"code":"import { defineComponent } from 'vue';\nimport { Line } from 'vue-chartjs';\nimport { Chart as ChartJS, Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale } from 'chart.js';\nChartJS.register(Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale);\nexport default defineComponent({\n  name: 'PriceChart',\n  components: {\n    Line\n  },\n  props: {\n    prices: {\n      type: Array,\n      required: true\n    }\n  },\n  computed: {\n    chartData() {\n      console.log('Prices prop:', this.prices);\n      if (!this.prices || this.prices.length === 0) {\n        console.log('No prices available');\n        return {\n          labels: [],\n          datasets: []\n        };\n      }\n      const labels = this.prices.map(price => price.date);\n      const data = this.prices.map(price => parseFloat(price.price));\n      console.log('Labels:', labels);\n      console.log('Data:', data);\n      return {\n        labels,\n        datasets: [{\n          label: 'Price Series',\n          data,\n          borderColor: '#42A5F5',\n          backgroundColor: 'rgba(66, 165, 245, 0.2)',\n          fill: true\n        }]\n      };\n    },\n    chartOptions() {\n      return {\n        responsive: true,\n        maintainAspectRatio: false,\n        scales: {\n          y: {\n            beginAtZero: true\n          }\n        }\n      };\n    }\n  }\n});","map":{"version":3,"names":["defineComponent","Line","Chart","ChartJS","Title","Tooltip","Legend","LineElement","PointElement","LinearScale","CategoryScale","register","name","components","props","prices","type","Array","required","computed","chartData","console","log","length","labels","datasets","map","price","date","data","parseFloat","label","borderColor","backgroundColor","fill","chartOptions","responsive","maintainAspectRatio","scales","y","beginAtZero"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\charts\\PriceChart.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <Line v-if=\"chartData.datasets.length > 0\" :data=\"chartData\" :options=\"chartOptions\" />\r\n    <p v-else>No data available for the chart.</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { defineComponent } from 'vue'\r\nimport { Line } from 'vue-chartjs'\r\nimport { Chart as ChartJS, Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale } from 'chart.js'\r\n\r\nChartJS.register(Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale)\r\n\r\nexport default defineComponent({\r\n  name: 'PriceChart',\r\n  components: {\r\n    Line\r\n  },\r\n  props: {\r\n    prices: {\r\n      type: Array,\r\n      required: true\r\n    }\r\n  },\r\n  computed: {\r\n    chartData() {\r\n      console.log('Prices prop:', this.prices);\r\n\r\n      if (!this.prices || this.prices.length === 0) {\r\n        console.log('No prices available');\r\n        return {\r\n          labels: [],\r\n          datasets: []\r\n        }\r\n      }\r\n\r\n      const labels = this.prices.map(price => price.date);\r\n      const data = this.prices.map(price => parseFloat(price.price));\r\n\r\n      console.log('Labels:', labels);\r\n      console.log('Data:', data);\r\n\r\n      return {\r\n        labels,\r\n        datasets: [\r\n          {\r\n            label: 'Price Series',\r\n            data,\r\n            borderColor: '#42A5F5',\r\n            backgroundColor: 'rgba(66, 165, 245, 0.2)',\r\n            fill: true,\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    chartOptions() {\r\n      return {\r\n        responsive: true,\r\n        maintainAspectRatio: false,\r\n        scales: {\r\n          y: {\r\n            beginAtZero: true\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n  position: relative;\r\n  height: 40vh;\r\n  width: 80vw;\r\n}\r\n</style>"],"mappings":"AAQA,SAASA,eAAc,QAAS,KAAI;