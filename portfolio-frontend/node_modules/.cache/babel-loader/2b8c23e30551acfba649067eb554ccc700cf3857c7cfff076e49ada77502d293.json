{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onBeforeUnmount } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { register } from '@/services/api';\nimport RegisterForm from '@/components/RegisterForm.vue';\nexport default {\n  name: 'RegisterPage',\n  components: {\n    RegisterForm\n  },\n  setup() {\n    const loading = ref(false);\n    const successMessage = ref('');\n    const router = useRouter();\n    const registerForm = ref(null);\n    const handleRegister = async credentials => {\n      loading.value = true;\n      successMessage.value = '';\n      try {\n        await register(credentials.username, credentials.email, credentials.password);\n        successMessage.value = 'Registration successful. Please log in.';\n        // Redirect to login page after a short delay\n        setTimeout(() => {\n          router.push('/login');\n        }, 2000); // 2 seconds delay\n      } catch (err) {\n        console.error('Registration error:', err);\n        if (typeof err === 'object') {\n          registerForm.value.setErrors(err);\n        } else {\n          registerForm.value.setErrors('An error occurred during registration.');\n        }\n      } finally {\n        loading.value = false;\n      }\n    };\n    onBeforeUnmount(() => {\n      if (registerForm.value) {\n        registerForm.value.setErrors({});\n      }\n    });\n    return {\n      loading,\n      handleRegister,\n      registerForm,\n      successMessage\n    };\n  },\n  mounted() {\n    this.$emit('update-page-title', ''); // Clear the page title for register page\n  }\n};","map":{"version":3,"names":["ref","onBeforeUnmount","useRouter","register","RegisterForm","name","components","setup","loading","successMessage","router","registerForm","handleRegister","credentials","value","username","email","password","setTimeout","push","err","console","error","setErrors","mounted","$emit"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-fronten