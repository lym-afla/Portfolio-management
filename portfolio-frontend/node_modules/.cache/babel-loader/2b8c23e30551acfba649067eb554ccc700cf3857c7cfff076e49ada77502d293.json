egisterForm.value.setErrors(err)\r\n        } else {\r\n          registerForm.value.setErrors('An error occurred during registration.')\r\n        }\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    onBeforeUnmount(() => {\r\n      if (registerForm.value) {\r\n        registerForm.value.setErrors({})\r\n      }\r\n    })\r\n\r\n    return { loading, handleRegister, registerForm, successMessage }\r\n  },\r\n  mounted() {\r\n    this.$emit('update-page-title', ''); // Clear the page title for register page\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.v-card-actions a {\r\n  text-decoration: none;\r\n  color: #1976D2;\r\n}\r\n</style>"],"mappings":";AAyBA,SAASA,GAAG,EAAEC,eAAc,QAAS,KAAI;AACzC,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,gBAAe;AACxC,OAAOC,YAAW,MAAO,+BAA8B;AAEvD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,cAAa,GAAIT,GAAG,CAAC,EAAE;IAC7B,MAAMU,MAAK,GAAIR,SAAS,CAAC;IACzB,MAAMS,YAAW,GAAIX,GAAG,CAAC,IAAI;IAE7B,MAAMY,cAAa,GAAI,MAAOC,WAAW,IAAK;MAC5CL,OAAO,CAACM,KAAI,GAAI,IAAG;MACnBL,cAAc,CAACK,KAAI,GAAI,EAAC;MAExB,IAAI;QACF,MAAMX,QAAQ,CAACU,WAAW,CAACE,QAAQ,EAAEF,WAAW,CAACG,KAAK,EAAEH,WAAW,CAACI,QAAQ;QAC5ER,cAAc,CAACK,KAAI,GAAI,yCAAwC;QAC/D;QACAI,UAAU,CAAC,MAAM;UACfR,MAAM,CAACS,IAAI,CAAC,QAAQ;QACtB,CAAC,EAAE,IAAI,GAAE;MACX,EAAE,OAAOC,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,qBAAqB,EAAEF,GAAG;QACxC,IAAI,OAAOA,GAAE,KAAM,QAAQ,EAAE;UAC3BT,YAAY,CAACG,KAAK,CAACS,SAAS,CAACH,GAAG;QAClC,OAAO;UACLT,YAAY,CAACG,KAAK,CAACS,SAAS,CAAC,wCAAwC;QACvE;MACF,UAAU;QACRf,OAAO,CAACM,KAAI,GAAI,KAAI;MACtB;IACF;IAEAb,eAAe,CAAC,MAAM;MACpB,IAAIU,YAAY,CAACG,KAAK,EAAE;QACtBH,YAAY,CAACG,KAAK,CAACS,SAAS,CAAC,CAAC,CAAC;MACjC;IACF,CAAC;IAED,OAAO;MAAEf,OAAO;MAAEI,cAAc;MAAED,YAAY;MAAEF;IAAe;EACjE,CAAC;EACDe,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,KAAK,CAAC,mBAAmB,EAAE,EAAE,CAAC,EAAE;EACvC;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}