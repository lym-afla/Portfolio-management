{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport axios from 'axios';\nexport default {\n  name: 'LoginPage',\n  setup() {\n    const username = ref('');\n    const password = ref('');\n    const error = ref('');\n    const router = useRouter();\n    const login = async () => {\n      try {\n        const response = await axios.post('/users/api/login/', {\n          username: username.value,\n          password: password.value\n        });\n        localStorage.setItem('token', response.data.token);\n        router.push('/dashboard');\n      } catch (err) {\n        error.value = 'Invalid login credentials. Please try again.';\n      }\n    };\n    return {\n      username,\n      password,\n      error,\n      login\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","axios","name","setup","username","password","error","router","login","response","post","value","localStorage","setItem","data","token","push","err"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\LoginPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-page\">\r\n    <h1>Login</h1>\r\n    <form @submit.prevent=\"login\">\r\n      <div>\r\n        <label for=\"username\">Username:</label>\r\n        <input type=\"text\" id=\"username\" v-model=\"username\" required />\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">Password:</label>\r\n        <input type=\"password\" id=\"password\" v-model=\"password\" required />\r\n      </div>\r\n      <button type=\"submit\">Login</button>\r\n    </form>\r\n    <p v-if=\"error\" class=\"error\">{{ error }}</p>\r\n    <p>\r\n      Don't have an account? <router-link to=\"/register\">Register</router-link>\r\n    </p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'LoginPage',\r\n  setup() {\r\n    const username = ref('')\r\n    const password = ref('')\r\n    const error = ref('')\r\n    const router = useRouter()\r\n\r\n    const login = async () => {\r\n      try {\r\n        const response = await axios.post('/users/api/login/', {\r\n          username: username.value,\r\n          password: password.value,\r\n        })\r\n        localStorage.setItem('token', response.data.token)\r\n        router.push('/dashboard')\r\n      } catch (err) {\r\n        error.value = 'Invalid login credentials. Please try again.'\r\n      }\r\n    }\r\n\r\n    return { username, password, error, login }\r\n  },\r\n}\r\n</script>\r\n"],"mappings":";AAsBA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,OAAOC,KAAI,MAAO,OAAM;AAExB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAKA,CAAA,EAAG;IACN,MAAMC,QAAO,GAAIL,GAAG,CAAC,EAAE;IACvB,MAAMM,QAAO,GAAIN,GAAG,CAAC,EAAE;IACvB,MAAMO,KAAI,GAAIP,GAAG,CAAC,EAAE;IACpB,MAAMQ,MAAK,GAAIP,SAAS,CAAC;IAEzB,MAAMQ,KAAI,GAAI,MAAAA,CAAA,KAAY;MACxB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMR,KAAK,CAACS,IAAI,CAAC,mBAAmB,EAAE;UACrDN,QAAQ,EAAEA,QAAQ,CAACO,KAAK;UACxBN,QAAQ,EAAEA,QAAQ,CAACM;QACrB,CAAC;QACDC,YAAY,CAACC,OAAO,CAAC,OAAO,EAAEJ,QAAQ,CAACK,IAAI,CAACC,KAAK;QACjDR,MAAM,CAACS,IAAI,CAAC,YAAY;MAC1B,EAAE,OAAOC,GAAG,EAAE;QACZX,KAAK,CAACK,KAAI,GAAI,8CAA6C;MAC7D;IACF;IAEA,OAAO;MAAEP,QAAQ;MAAEC,QAAQ;MAAEC,KAAK;MAAEE;IAAM;EAC5C;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}