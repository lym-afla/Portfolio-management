ue / itemsPerPage.value))\r\n\r\n    const openDateDialog = () => {\r\n      dateDialog.value = true\r\n    }\r\n\r\n    const closeDateDialog = () => {\r\n      dateDialog.value = false\r\n    }\r\n\r\n    const applyDateRange = () => {\r\n      // Here you would typically update your data based on the new date range\r\n      console.log('Applying date range:', dateFrom.value, 'to', dateTo.value)\r\n      // You might want to call an API or update your store here\r\n      closeDateDialog()\r\n    }\r\n\r\n    const handleItemsPerPageChange = (value) => {\r\n      itemsPerPage.value = value\r\n      // You might want to refresh your data here\r\n    }\r\n\r\n    const handleSortChange = (value) => {\r\n      // Handle sort change\r\n      console.log('Sort changed:', value)\r\n    }\r\n\r\n    const handlePageChange = (value) => {\r\n      currentPage.value = value\r\n      // You might want to refresh your data here\r\n    }\r\n\r\n    onMounted(() => {\r\n      emit('update-page-title', 'Transactions')\r\n      console.log('TransactionsPage mounted')\r\n      // You might want to fetch initial data here\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      emit('update-page-title', '')\r\n    })\r\n\r\n    return {\r\n      dateDialog,\r\n      menuFrom,\r\n      menuTo,\r\n      dateFrom,\r\n      dateTo,\r\n      loading,\r\n      tableLoading,\r\n      transactions,\r\n      totalItems,\r\n      currentPage,\r\n      itemsPerPage,\r\n      itemsPerPageOptions,\r\n      pageCount,\r\n      search,\r\n      headers,\r\n      openDateDialog,\r\n      closeDateDialog,\r\n      applyDateRange,\r\n      handleItemsPerPageChange,\r\n      handleSortChange,\r\n      handlePageChange\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.rows-per-page-select {\r\n  max-width: 150px;\r\n}\r\n</style>"],"mappings":"AAkJA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAC1D,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC