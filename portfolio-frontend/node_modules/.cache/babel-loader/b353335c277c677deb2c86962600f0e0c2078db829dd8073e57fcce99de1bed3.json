{"ast":null,"code":"export default {\n  name: 'SummaryOverTimeTable',\n  props: {\n    lines: {\n      type: Array,\n      default: () => []\n    },\n    years: {\n      type: Array,\n      default: () => []\n    },\n    currentYear: {\n      type: String,\n      default: ''\n    },\n    error: {\n      type: String,\n      default: ''\n    }\n  }\n};","map":{"version":3,"names":["name","props","lines","type","Array","default","years","currentYear","String","error"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\SummaryOverTimeTable.vue"],"sourcesContent":["<template>\r\n  <v-card v-if=\"lines && years && currentYear\">\r\n    <v-card-title>Summary Over Time</v-card-title>\r\n    <v-card-text>\r\n      <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n        {{ error }}\r\n      </v-alert>\r\n      <v-table v-if=\"!error\" density=\"compact\">\r\n        <thead>\r\n          <tr>\r\n            <th></th>\r\n            <th v-for=\"year in years\" :key=\"year\" class=\"text-center font-weight-bold\">{{ year }}</th>\r\n            <th class=\"text-center highlight font-weight-bold\">{{ currentYear }}YTD</th>\r\n            <th class=\"text-center highlight font-weight-bold\">All-time</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"line in lines\" :key=\"line.name\" :class=\"{ 'font-weight-bold': line.name === 'BoP NAV' || line.name === 'EoP NAV', 'font-italic': line.name === 'TSR' }\">\r\n            <td>\r\n              {{ line.name }}\r\n            </td>\r\n            <td v-for=\"year in years\" :key=\"`${line.name}-${year}`\" class=\"text-center\">\r\n              {{ line.data[year] }}\r\n            </td>\r\n            <td class=\"text-center highlight\">{{ line.data['YTD'] }}</td>\r\n            <td class=\"text-center font-weight-bold highlight\">{{ line.data['All-time'] }}</td>\r\n          </tr>\r\n        </tbody>\r\n      </v-table>\r\n    </v-card-text>\r\n  </v-card>\r\n  <v-card v-else>\r\n    <v-card-title>Summary Over Time</v-card-title>\r\n    <v-card-text>\r\n      <v-alert type=\"info\">\r\n        No data available for the selected broker.\r\n      </v-alert>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'SummaryOverTimeTable',\r\n  props: {\r\n    lines: {\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    years: {\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    currentYear: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    error: {\r\n      type: String,\r\n      default: ''\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.highlight {\r\n  background-color: rgba(0, 0, 0, 0.05);\r\n}\r\n</style>\r\n"],"mappings":"AA0CA,eAAe;EACbA,IAAI,EAAE,sBAAsB;EAC5BC,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB,CAAC;IACDE,WAAW,EAAE;MACXJ,IAAI,EAAEK,MAAM;MACZH,OAAO,EAAE;IACX,CAAC;IACDI,KAAK,EAAE;MACLN,IAAI,EAAEK,MAAM;MACZH,OAAO,EAAE;IACX;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}