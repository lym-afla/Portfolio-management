      </template>\r\n              <v-list-item-title class=\"text-caption text-medium-emphasis\">Total</v-list-item-title>\r\n              <v-list-item-subtitle class=\"text-body-2\">{{ formatCurrency(currentTransaction.total) }}</v-list-item-subtitle>\r\n            </v-list-item>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n    <v-row class=\"mt-4\">\r\n      <v-col>\r\n        <v-btn color=\"primary\" block @click=\"$emit('confirm')\">\r\n          <v-icon start icon=\"mdi-check\"></v-icon>\r\n          Confirm\r\n        </v-btn>\r\n      </v-col>\r\n      <v-col>\r\n        <v-btn color=\"error\" block @click=\"$emit('skip')\">\r\n          <v-icon start icon=\"mdi-close\"></v-icon>\r\n          Skip\r\n        </v-btn>\r\n      </v-col>\r\n    </v-row>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { format } from 'date-fns';\r\n\r\nexport default {\r\n  name: 'TransactionConfirmationSection',\r\n  props: {\r\n    showConfirmation: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    currentTransaction: {\r\n      type: Object,\r\n      default: () => ({})\r\n    }\r\n  },\r\n  emits: ['confirm', 'skip'],\r\n  methods: {\r\n    formatDate(date) {\r\n      return format(new Date(date), 'dd MMM yyyy');\r\n    },\r\n    formatNumber(number) {\r\n      return new Intl.NumberFormat().format(number);\r\n    },\r\n    formatCurrency(amount) {\r\n      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount);\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAmFA,SAASA,MAAK,QAAS,UAAU;AAEjC,eAAe;EACbC,IAAI,EAAE,gCAAgC;EACtCC,KAAK,EAAE;IACLC,gBAAgB,EAAE;MAChBC,IAAI,EAAEC,OAAO;MACbC,OAAO,EAAE;IACX,CAAC;IACDC,kBAAkB,EAAE;MAClBH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAEA,CAAA,MAAO,CAAC,CAAC;IACpB;EACF,CAAC;EACDG,KAAK,EAAE,CAAC,SAAS,EAAE,MAAM,CAAC;EAC1BC,OAAO,EAAE;IACPC,UAAUA,CAACC,IAAI,EAAE;MACf,OAAOZ,MAAM,CAAC,IAAIa,IAAI,CAACD,IAAI,CAAC,EAAE,aAAa,CAAC;IAC9C,CAAC;IACDE,YAAYA,CAACC,MAAM,