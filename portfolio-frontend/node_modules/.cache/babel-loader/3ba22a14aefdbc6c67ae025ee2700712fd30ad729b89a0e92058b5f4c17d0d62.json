           ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"4\" md=\"3\" lg=\"2\" class=\"ml-auto\">\r\n            <v-select\r\n              v-model=\"itemsPerPage\"\r\n              :items=\"itemsPerPageOptions\"\r\n              label=\"Rows per page\"\r\n              density=\"compact\"\r\n              hide-details\r\n              class=\"rows-per-page-select\"\r\n              @update:model-value=\"handleItemsPerPageChange\"\r\n              bg-color=\"white\"\r\n            ></v-select>\r\n          </v-col>\r\n        </v-toolbar>\r\n      </template>\r\n\r\n      <template #item=\"{ item }\">\r\n        <tr>\r\n          <td v-for=\"header in headers\" :key=\"header.key\" :class=\"`text-${headerAlignments[header.key]} ${header.key === 'irr' ? 'font-italic' : ''}`\">\r\n            <template v-if=\"header.key === 'actions'\">\r\n              <v-icon small class=\"mr-2\" @click=\"editSecurity(item)\">\r\n                mdi-pencil\r\n              </v-icon>\r\n              <v-icon small @click=\"processDeleteSecurity(item)\">\r\n                mdi-delete\r\n              </v-icon>\r\n            </template>\r\n            <template v-else>\r\n              {{ item[header.key] }}\r\n            </template>\r\n          </td>\r\n        </tr>\r\n      </template>\r\n\r\n      <template #bottom>\r\n        <div class=\"d-flex align-center justify-space-between pa-4\">\r\n          <span class=\"text-caption mr-4\">\r\n            Showing {{ (currentPage - 1) * itemsPerPage + 1 }}-{{\r\n              Math.min(currentPage * itemsPerPage, totalItems)\r\n            }}\r\n            of {{ totalItems }} entries\r\n          </span>\r\n          <v-pagination\r\n            v-model=\"currentPage\"\r\n            :length=\"pageCount\"\r\n            :total-visible=\"7\"\r\n            rounded=\"circle\"\r\n            @update:model-value=\"handlePageChange\"\r\n          ></v-pagination>\r\n        </div>\r\n      </template>\r\n    </