{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { useWebSocket } from '@/composables/useWebSocket';\nimport { useImportState } from '@/composables/useImportState';\nimport ProgressDialog from './ProgressDialog.vue';\nimport SecurityMappingDialog from './SecurityMappingDialog.vue';\nimport { analyzeFile, importTransactions } from '@/services/api';\nexport default {\n  name: 'TransactionImportDialog',\n  components: {\n    ProgressDialog,\n    SecurityMappingDialog\n  },\n  props: {\n    modelValue: Boolean\n  },\n  emits: ['update:modelValue', 'import-completed'],\n  setup(props, {\n    emit\n  }) {\n    const dialog = computed({\n      get: () => props.modelValue,\n      set: value => {\n        emit('update:modelValue', value);\n        if (!value) {\n          // Only reset certain parts of the dialog when closing\n          resetDialogPartial();\n        }\n      }\n    });\n    const file = ref(null);\n    const isAnalyzed = ref(false);\n    const brokers = ref([]);\n    const selectedBroker = ref(null);\n    const identifiedBroker = ref(null);\n    const brokerIdentified = computed(() => !!identifiedBroker.value);\n    const brokerIdentificationComplete = ref(false);\n    const importState = useImportState();\n    const {\n      isConnected,\n      lastMessage,\n      sendMessage\n    } = useWebSocket(computed(() => {\n      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';\n      return `${protocol}//${window.location.host}/ws/transactions/`;\n    }));\n    const showProgressDialog = computed(() => importState.isImporting.value || importState.isComplete.value || importState.isError.value);\n    const showSecurityMappingDialog = computed(() => importState.isMapping.value);\n    const handleFileChange = newFile => {\n      file.value = newFile;\n      isAnalyzed.value = false;\n      brokerIdentificationComplete.value = false;\n    };\n    const submitFile = async () => {\n      try {\n        const result = await analyzeFile(file.value);\n        identifiedBroker.value = result.identified_broker;\n        brokers.value = result.brokers;\n        selectedBroker.value = identifiedBroker.value ? identifiedBroker.value.id : null;\n        isAnalyzed.value = true;\n        brokerIdentificationComplete.value = true;\n      } catch (error) {\n        console.error('Error analyzing file:', error);\n        // Handle error (show error message to user)\n      }\n    };\n    const startImport = async () => {\n      try {\n        const response = await importTransactions(file.value.id, selectedBroker.value);\n        importState.setState('importing');\n        dialog.value = false; // Close the initial dialog\n      } catch (error) {\n        console.error('Error starting import:', error);\n        importState.setState('error', error.message);\n      }\n    };\n    const handleWebSocketMessage = message => {\n      if (message.status === 'progress') {\n        importState.setProgress(message.progress);\n        importState.setState('importing', message.message);\n      } else if (message.status === 'security_mapping') {\n        importState.setSecurityToMap(message.security);\n      } else if (message.status === 'complete') {\n        importState.setState('complete', 'Import completed successfully');\n        emit('import-completed', message.importResults);\n      } else if (message.error) {\n        importState.setState('error', message.error);\n      }\n    };\n    const handleSecurityMapped = mappedSecurity => {\n      sendMessage({\n        type: 'security_mapped',\n        security: mappedSecurity\n      });\n      importState.setState('importing');\n    };\n    const stopImport = () => {\n      sendMessage({\n        type: 'stop_import'\n      });\n    };\n    const resetProgressDialog = () => {\n      importState.reset();\n    };\n    onMounted(() => {\n      // Any setup needed when the component is mounted\n    });\n    onUnmounted(() => {\n      // Any cleanup needed when the component is unmounted\n    });\n    return {\n      dialog,\n      file,\n      isAnalyzed,\n      brokers,\n      selectedBroker,\n      identifiedBroker,\n      brokerIdentified,\n      brokerIdentificationComplete,\n      showProgressDialog,\n      showSecurityMappingDialog,\n      handleFileChange,\n      submitFile,\n      startImport,\n      handleSecurityMapped,\n      stopImport,\n      resetProgressDialog\n      // Expose other necessary methods and computed properties\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","useWebSocket","useImportState","ProgressDialog","SecurityMappingDialog","analyzeFile","importTransactions","name","components","props","modelValue","Boolean","emits","setup","emit","dialog","get","set","value","resetDialogPartial","file","isAnalyzed","brokers","selectedBroker","identifiedBroker","brokerIdentified","brokerIdentificationComplete","importState","isConnected","lastMessage","sendMessage","protocol","window","location","host","showProgressDialog","isImporting","isComplete","isError","showSecurityMappingDialog","isMapping","handleFileChange","newFile","submitFile","result","identified_broker","id","error","console","startImport","response","setState","message","handleWebSocketMessage","status","setProgress","progress","setSecurityToMap","security","importResults","handleSecurityMapped","mappedSecurity","type","stopImport","resetProgressDialog","reset"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\TransactionImportDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5\">Import Transactions</v-card-title>\r\n      <v-card-text>\r\n        <v-file-input\r\n          v-model=\"file\"\r\n          label=\"Select Excel or CSV file to import\"\r\n          accept=\".csv, .xlsx, .xls\"\r\n          :rules=\"[v => !!v || 'File is required']\"\r\n          @change=\"handleFileChange\"\r\n          :disabled=\"isAnalyzed\"\r\n        ></v-file-input>\r\n        <v-alert\r\n          v-if=\"isAnalyzed && brokerIdentificationComplete\"\r\n          :type=\"brokerIdentified ? 'success' : 'info'\"\r\n          class=\"mt-4 mb-4\"\r\n        >\r\n          {{ brokerIdentified \r\n            ? `Broker \"${identifiedBroker.name}\" was automatically identified. Please confirm or select a different broker.` \r\n            : 'Broker could not be automatically identified. Please select a broker below.' }}\r\n        </v-alert>\r\n        <v-autocomplete\r\n          v-if=\"isAnalyzed\"\r\n          v-model=\"selectedBroker\"\r\n          :items=\"brokers\"\r\n          item-title=\"name\"\r\n          item-value=\"id\"\r\n          label=\"Select Broker\"\r\n          class=\"mt-4\"\r\n        ></v-autocomplete>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n        <v-btn \r\n          v-if=\"!isAnalyzed\" \r\n          color=\"blue darken-1\" \r\n          text \r\n          @click=\"submitFile\" \r\n          :disabled=\"!file || isLoading\"\r\n          :loading=\"isLoading\"\r\n        >\r\n          Analyze File\r\n        </v-btn>\r\n        <v-btn\r\n          v-if=\"isAnalyzed\"\r\n          color=\"blue darken-1\"\r\n          text\r\n          @click=\"startImport\"\r\n          :disabled=\"!selectedBroker\"\r\n        >\r\n          Import Transactions\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n    <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n      {{ error }}\r\n    </v-alert>\r\n  </v-dialog>\r\n\r\n  <ProgressDialog\r\n    v-model=\"showProgressDialog\"\r\n    :title=\"'Importing Transactions'\"\r\n    :progress=\"importProgress\"\r\n    :current=\"currentImported\"\r\n    :total=\"totalToImport\"\r\n    :current-message=\"currentImportMessage\"\r\n    :error=\"importError\"\r\n    :can-stop=\"canStopImport\"\r\n    @stop-import=\"stopImport\"\r\n    @reset=\"resetProgressDialog\"\r\n  />\r\n\r\n  <SecurityMappingDialog\r\n    v-model=\"showSecurityMappingDialog\"\r\n    :security=\"securityToMap\"\r\n    :best-match=\"bestMatch\"\r\n    @security-mapped=\"handleSecurityMapped\"\r\n  />\r\n\r\n  <v-dialog v-model=\"showSuccessDialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5 pb-2\">\r\n        <v-icon color=\"success\" class=\"mr-2\">mdi-check-circle</v-icon>\r\n        Import Completed\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"primary\" size=\"40\">\r\n                    <v-icon dark>mdi-database-import</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.totalTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Total transactions processed</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"success\" size=\"40\">\r\n                    <v-icon dark>mdi-check-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.importedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Successfully imported</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"error\" size=\"40\">\r\n                    <v-icon dark>mdi-alert-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.skippedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Skipped transactions</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"info\" size=\"40\">\r\n                    <v-icon dark>mdi-plus-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.newSecurities }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>New securities added</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"warning\" size=\"40\">\r\n                    <v-icon dark>mdi-help-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.unrecognizedSecurities.length }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Unrecognized securities</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"closeSuccessDialog\">Close</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <v-dialog v-model=\"showUnrecognizedSecuritiesDialog\" max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title>Unrecognized Securities</v-card-title>\r\n      <v-card-text>\r\n        <p>The following securities were not recognized. Please map them to existing securities or create new ones:</p>\r\n        <v-list>\r\n          <v-list-item v-for=\"security in unrecognizedSecurities\" :key=\"security\">\r\n            <v-list-item-title>{{ security }}</v-list-item-title>\r\n            <template v-slot:append>\r\n              <v-autocomplete\r\n                v-model=\"securityMappings[security]\"\r\n                :items=\"existingSecurities\"\r\n                item-title=\"name\"\r\n                item-value=\"id\"\r\n                label=\"Select existing security\"\r\n                clearable\r\n                style=\"max-width: 300px;\"\r\n              ></v-autocomplete>\r\n              <v-btn v-if=\"!securityMappings[security]\" @click=\"createNewSecurity(security)\" color=\"primary\" text>\r\n                Create New Security\r\n              </v-btn>\r\n            </template>\r\n          </v-list-item>\r\n        </v-list>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"confirmSecurityMappings\">Confirm and Import</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n\r\n    <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n      {{ error }}\r\n    </v-alert>\r\n\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue'\r\nimport { useWebSocket } from '@/composables/useWebSocket'\r\nimport { useImportState } from '@/composables/useImportState'\r\nimport ProgressDialog from './ProgressDialog.vue'\r\nimport SecurityMappingDialog from './SecurityMappingDialog.vue'\r\nimport { analyzeFile, importTransactions } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'TransactionImportDialog',\r\n  components: {\r\n    ProgressDialog,\r\n    SecurityMappingDialog,\r\n  },\r\n  props: {\r\n    modelValue: Boolean,\r\n  },\r\n  emits: ['update:modelValue', 'import-completed'],\r\n  setup(props, { emit }) {\r\n    const dialog = computed({\r\n      get: () => props.modelValue,\r\n      set: (value) => {\r\n        emit('update:modelValue', value)\r\n        if (!value) {\r\n          // Only reset certain parts of the dialog when closing\r\n          resetDialogPartial()\r\n        }\r\n      }\r\n    })\r\n\r\n    const file = ref(null)\r\n    const isAnalyzed = ref(false)\r\n    const brokers = ref([])\r\n    const selectedBroker = ref(null)\r\n    const identifiedBroker = ref(null)\r\n    const brokerIdentified = computed(() => !!identifiedBroker.value)\r\n    const brokerIdentificationComplete = ref(false)\r\n\r\n    const importState = useImportState()\r\n    const { isConnected, lastMessage, sendMessage } = useWebSocket(computed(() => {\r\n      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:'\r\n      return `${protocol}//${window.location.host}/ws/transactions/`\r\n    }))\r\n\r\n    const showProgressDialog = computed(() => importState.isImporting.value || importState.isComplete.value || importState.isError.value)\r\n    const showSecurityMappingDialog = computed(() => importState.isMapping.value)\r\n\r\n    const handleFileChange = (newFile) => {\r\n      file.value = newFile\r\n      isAnalyzed.value = false\r\n      brokerIdentificationComplete.value = false\r\n    }\r\n\r\n    const submitFile = async () => {\r\n      try {\r\n        const result = await analyzeFile(file.value)\r\n        identifiedBroker.value = result.identified_broker\r\n        brokers.value = result.brokers\r\n        selectedBroker.value = identifiedBroker.value ? identifiedBroker.value.id : 