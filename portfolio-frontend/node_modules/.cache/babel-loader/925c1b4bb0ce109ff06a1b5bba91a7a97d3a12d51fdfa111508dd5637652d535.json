{"ast":null,"code":"import { useImportState } from '@/composables/useImportState';\nexport default {\n  setup() {\n    const importState = useImportState();\n    return {\n      importState\n      // ... other properties ...\n    };\n  }\n};","map":{"version":3,"names":["useImportState","setup","importState"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\ProgressDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialogModel\" persistent max-width=\"400px\">\r\n    <v-card>\r\n      <v-card-title class=\"d-flex align-center\">\r\n        {{ title }}\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-progress-linear\r\n          :model-value=\"importState.progress\"\r\n          height=\"25\"\r\n          color=\"primary\"\r\n          class=\"mb-2\"\r\n        >\r\n          <template v-slot:default=\"{ value }\">\r\n            <strong>{{ Math.ceil(value) }}%</strong>\r\n          </template>\r\n        </v-progress-linear>\r\n        <v-row no-gutters>\r\n          <v-col cols=\"12\" class=\"text-center\">\r\n            <div class=\"text-subtitle-2 font-weight-medium\">\r\n              {{ importState.currentMessage }}\r\n            </div>\r\n          </v-col>\r\n        </v-row>\r\n        <v-row no-gutters v-if=\"currentMessage\" class=\"mb-4\">\r\n          <v-col cols=\"12\">\r\n            <v-card outlined class=\"mt-2 pa-2\">\r\n              <div class=\"d-flex align-center\">\r\n                <v-progress-circular\r\n                  indeterminate\r\n                  color=\"primary\"\r\n                  size=\"24\"\r\n                  width=\"2\"\r\n                  class=\"ml-2\"\r\n                ></v-progress-circular>\r\n                <div class=\"text-body-2 ml-2\">{{ currentMessage }}...</div>\r\n              </div>\r\n            </v-card>\r\n          </v-col>\r\n        </v-row>\r\n        <v-row no-gutters class=\"mb-4\">\r\n          <v-col cols=\"12\" class=\"text-center\">\r\n            <v-btn color=\"error\" @click=\"stopImport\" :disabled=\"!canStop\">Stop Import</v-btn>\r\n          </v-col>\r\n        </v-row>\r\n        <v-alert v-if=\"error\" type=\"error\" class=\"mt-4\">\r\n          {{ error }}\r\n        </v-alert>\r\n      </v-card-text>\r\n      <v-card-actions v-if=\"error\">\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"closeDialog\">Close</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { useImportState } from '@/composables/useImportState'\r\n\r\nexport default {\r\n  setup() {\r\n    const importState = useImportState()\r\n\r\n    return {\r\n      importState,\r\n      // ... other properties ...\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA0DA,SAASA,cAAa,QAAS,8BAA6B;AAE5D,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,WAAU,GAAIF,cAAc,CAAC;IAEnC,OAAO;MACLE;MACA;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}