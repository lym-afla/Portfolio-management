{"ast":null,"code":"import { Line } from 'vue-chartjs';\nimport { Chart as ChartJS, Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale } from 'chart.js';\nChartJS.register(Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale);\nexport default {\n  name: 'PriceChart',\n  components: {\n    Line\n  },\n  props: {\n    prices: {\n      type: Array,\n      required: true\n    }\n  },\n  computed: {\n    chartData() {\n      // Log the prices prop to check its structure\n      console.log('Prices prop:', this.prices);\n\n      // Check if prices are available\n      if (!this.prices || this.prices.length === 0) {\n        console.log('No prices available');\n        return {\n          labels: [],\n          datasets: []\n        };\n      }\n\n      // Extract labels and data\n      const labels = this.prices.map(price => price.date);\n      const data = this.prices.map(price => parseFloat(price.price));\n\n      // Log the labels and data\n      console.log('Labels:', labels);\n      console.log('Data:', data);\n      return {\n        labels: labels,\n        // Return an empty array for labels\n        datasets: [{\n          label: 'Price Series',\n          data: data,\n          // Ensure price is a number\n          borderColor: '#42A5F5',\n          backgroundColor: 'rgba(66, 165, 245, 0.2)',\n          fill: true\n        }]\n      };\n    },\n    chartOptions() {\n      return {\n        responsive: true,\n        maintainAspectRatio: false,\n        scales: {\n          y: {\n            beginAtZero: true\n          }\n        }\n      };\n    }\n  }\n};","map":{"version":3,"names":["Line","Chart","ChartJS","Title","Tooltip","Legend","LineElement","PointElement","LinearScale","CategoryScale","register","name","components","props","prices","type","Array","required","computed","chartData","console","log","length","labels","datasets","map","price","date","data","parseFloat","label","borderColor","backgroundColor","fill","chartOptions","responsive","maintainAspectRatio","scales","y","beginAtZero"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\charts\\PriceChart.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <Line v-if=\"chartData.labels.length > 0\" :chart-data=\"chartData\" :options=\"chartOptions\" />\r\n    <p v-else>No data available for the chart. Labels: {{ chartData.labels }}, Data: {{ chartData.datasets }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Line } from 'vue-chartjs'\r\nimport { Chart as ChartJS, Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale } from 'chart.js'\r\n\r\nChartJS.register(Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale)\r\n\r\nexport default {\r\n  name: 'PriceChart',\r\n  components: {\r\n    Line\r\n  },\r\n  props: {\r\n    prices: {\r\n      type: Array,\r\n      required: true\r\n    }\r\n  },\r\n  computed: {\r\n    chartData() {\r\n      // Log the prices prop to check its structure\r\n      console.log('Prices prop:', this.prices);\r\n\r\n      // Check if prices are available\r\n      if (!this.prices || this.prices.length === 0) {\r\n        console.log('No prices available');\r\n        return {\r\n          labels: [],\r\n          datasets: []\r\n        }\r\n      }\r\n\r\n      // Extract labels and data\r\n      const labels = this.prices.map(price => price.date);\r\n      const data = this.prices.map(price => parseFloat(price.price));\r\n\r\n      // Log the labels and data\r\n      console.log('Labels:', labels);\r\n      console.log('Data:', data);\r\n\r\n      return {\r\n        labels: labels, // Return an empty array for labels\r\n        datasets: [\r\n          {\r\n            label: 'Price Series',\r\n            data: data, // Ensure price is a number\r\n            borderColor: '#42A5F5',\r\n            backgroundColor: 'rgba(66, 165, 245, 0.2)',\r\n            fill: true,\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    chartOptions() {\r\n      return {\r\n        responsive: true,\r\n        maintainAspectRatio: false,\r\n        scales: {\r\n          y: {\r\n            beginAtZero: true\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n  position: relative;\r\n  /* height: 40vh; */\r\n  width: 80vw;\r\n}\r\n</style>"],"mappings":"AAQA,SAASA,IAAG,QAAS,aAAY;AACjC,SAASC,KAAI,IAAKC,OAAO,EAAEC,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,WAAW,EAAEC,YAAY,EAAEC,WAAW,EAAEC,aAAY,QAAS,UAAS;AAEzHP,OAAO,CAACQ,QAAQ,CAACP,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,WAAW,EAAEC,YAAY,EAAEC,WAAW,EAAEC,aAAa;AAE9F,eAAe;EACbE,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IACVZ;EACF,CAAC;EACDa,KAAK,EAAE;IACLC,MAAM,EAAE;MACNC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,SAASA,CAAA,EAAG;MACV;MACAC,OAAO,CAACC,GAAG,CAAC,cAAc,EAAE,IAAI,CAACP,MAAM,CAAC;;MAExC;MACA,IAAI,CAAC,IAAI,CAACA,MAAK,IAAK,IAAI,CAACA,MAAM,CAACQ,MAAK,KAAM,CAAC,EAAE;QAC5CF,OAAO,CAACC,GAAG,CAAC,qBAAqB,CAAC;QAClC,OAAO;UACLE,MAAM,EAAE,EAAE;UACVC,QAAQ,EAAE;QACZ;MACF;;MAEA;MACA,MAAMD,MAAK,GAAI,IAAI,CAACT,MAAM,CAACW,GAAG,CAACC,KAAI,IAAKA,KAAK,CAACC,IAAI,CAAC;MACnD,MAAMC,IAAG,GAAI,IAAI,CAACd,MAAM,CAACW,GAAG,CAACC,KAAI,IAAKG,UAAU,CAACH,KAAK,CAACA,KAAK,CAAC,CAAC;;MAE9D;MACAN,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEE,MAAM,CAAC;MAC9BH,OAAO,CAACC,GAAG,CAAC,OAAO,EAAEO,IAAI,CAAC;MAE1B,OAAO;QACLL,MAAM,EAAEA,MAAM;QAAE;QAChBC,QAAQ,EAAE,CACR;UACEM,KAAK,EAAE,cAAc;UACrBF,IAAI,EAAEA,IAAI;UAAE;UACZG,WAAW,EAAE,SAAS;UACtBC,eAAe,EAAE,yBAAyB;UAC1CC,IAAI,EAAE;QACR;MAEJ;IACF,CAAC;IACDC,YAAYA,CAAA,EAAG;MACb,OAAO;QACLC,UAAU,EAAE,IAAI;QAChBC,mBAAmB,EAAE,KAAK;QAC1BC,MAAM,EAAE;UACNC,CAAC,EAAE;YACDC,WAAW,EAAE;UACf;QACF;MACF;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}