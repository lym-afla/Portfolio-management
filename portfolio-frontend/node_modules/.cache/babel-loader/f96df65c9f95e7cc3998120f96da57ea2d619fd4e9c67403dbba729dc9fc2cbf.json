{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { provide, ref, onMounted, watch, computed } from 'vue';\nimport Navigation from './components/Navigation.vue';\nimport BrokerSelection from './components/BrokerSelection.vue';\nimport { checkAuth } from './utils/auth';\nimport { useRouter, useRoute } from 'vue-router';\nexport default {\n  name: 'App',\n  components: {\n    Navigation,\n    BrokerSelection\n  },\n  setup() {\n    const router = useRouter();\n    const route = useRoute();\n    const user = ref(null);\n    const isAuthenticated = ref(false);\n    const layoutLoading = ref(true);\n    const pageTitle = ref('');\n    const isProfilePage = computed(() => {\n      return route.path.startsWith('/profile');\n    });\n    const setUser = userData => {\n      user.value = userData;\n    };\n    const updateAuthStatus = async () => {\n      layoutLoading.value = true;\n      isAuthenticated.value = await checkAuth();\n      if (!isAuthenticated.value && router.currentRoute.value.meta.requiresAuth) {\n        router.push('/login');\n      }\n      layoutLoading.value = false;\n    };\n    const handleLogout = () => {\n      setUser(null);\n      isAuthenticated.value = false;\n      router.push('/login');\n    };\n    const updatePageTitle = title => {\n      pageTitle.value = title;\n    };\n    onMounted(async () => {\n      await updateAuthStatus();\n    });\n    watch(() => router.currentRoute.value, async () => {\n      layoutLoading.value = true;\n      await updateAuthStatus();\n    });\n\n    // Reset page title when authentication status changes\n    watch(() => isAuthenticated.value, newValue => {\n      if (!newValue) {\n        pageTitle.value = '';\n      }\n    });\n\n    // Reset page title on route change for non-authenticated routes\n    watch(() => router.currentRoute.value.path, () => {\n      if (!isAuthenticated.value) {\n        pageTitle.value = '';\n      }\n    });\n    provide('user', user);\n    provide('setUser', setUser);\n    provide('isAuthenticated', isAuthenticated);\n    return {\n      user,\n      setUser,\n      router,\n      isAuthenticated,\n      layoutLoading,\n      pageTitle,\n      handleLogout,\n      updatePageTitle,\n      isProfilePage\n    };\n  }\n};","map":{"version":3,"names":["provide","ref","onMounted","watch","computed","Navigation","BrokerSelection","checkAuth","useRouter","useRoute","name","components","setup","router","route","user","isAuthenticated","layoutLoading","pageTitle","isProfilePage","path","startsWith","setUser","userData","value","updateAuthStatus","currentRoute","meta","requiresAuth","push","handleLogout","updatePageTitle","title","newValue"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\App.vue"],"sourcesContent":["<template>\r\n  <v-app>\r\n    <v-overlay :model-value=\"layoutLoading\" class=\"align-center justify-center\">\r\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <template v-if=\"!layoutLoading\">\r\n      <template v-if=\"isAuthenticated\">\r\n        <Navigation @logout=\"handleLogout\" />\r\n        <v-main>\r\n          <v-container fluid>\r\n            <v-row>\r\n              <v-col cols=\"12\" class=\"px-4\">\r\n                <h2 v-if=\"pageTitle\" class=\"text-h4 mb-2\">{{ pageTitle }}</h2>\r\n                <v-divider v-if=\"pageTitle\" class=\"mb-2\"></v-divider>\r\n                <BrokerSelection v-if=\"!isProfilePage\" class=\"mb-4\" />\r\n                <router-view @update-page-title=\"updatePageTitle\"></router-view>\r\n              </v-col>\r\n            </v-row>\r\n          </v-container>\r\n        </v-main>\r\n      </template>\r\n      <template v-else>\r\n        <v-main>\r\n          <router-view></router-view>\r\n        </v-main>\r\n      </template>\r\n    </template>\r\n  </v-app>\r\n</template>\r\n\r\n<script>\r\nimport { provide, ref, onMounted, watch, computed } from 'vue'\r\nimport Navigation from './components/Navigation.vue'\r\nimport BrokerSelection from './components/BrokerSelection.vue'\r\nimport { checkAuth } from './utils/auth'\r\nimport { useRouter, useRoute } from 'vue-router'\r\n\r\nexport default {\r\n  name: 'App',\r\n  components: {\r\n    Navigation,\r\n    BrokerSelection,\r\n  },\r\n  setup() {\r\n    const router = useRouter();\r\n    const route = useRoute();\r\n    const user = ref(null);\r\n    const isAuthenticated = ref(false);\r\n    const layoutLoading = ref(true);\r\n    const pageTitle = ref('');\r\n\r\n    const isProfilePage = computed(() => {\r\n      return route.path.startsWith('/profile');\r\n    });\r\n\r\n    const setUser = (userData) => {\r\n      user.value = userData\r\n    }\r\n\r\n    const updateAuthStatus = async () => {\r\n      layoutLoading.value = true;\r\n      isAuthenticated.value = await checkAuth();\r\n      if (!isAuthenticated.value && router.currentRoute.value.meta.requiresAuth) {\r\n        router.push('/login');\r\n      }\r\n      layoutLoading.value = false;\r\n    };\r\n\r\n    const handleLogout = () => {\r\n      setUser(null);\r\n      isAuthenticated.value = false;\r\n      router.push('/login');\r\n    };\r\n\r\n    const updatePageTitle = (title) => {\r\n      pageTitle.value = title;\r\n    };\r\n\r\n    onMounted(async () => {\r\n      await updateAuthStatus();\r\n    });\r\n\r\n    watch(() => router.currentRoute.value, async () => {\r\n      layoutLoading.value = true;\r\n      await updateAuthStatus();\r\n    });\r\n\r\n    // Reset page title when authentication status changes\r\n    watch(() => isAuthenticated.value, (newValue) => {\r\n      if (!newValue) {\r\n        pageTitle.value = '';\r\n      }\r\n    });\r\n\r\n    // Reset page title on route change for non-authenticated routes\r\n    watch(() => router.currentRoute.value.path, () => {\r\n      if (!isAuthenticated.value) {\r\n        pageTitle.value = '';\r\n      }\r\n    });\r\n\r\n    provide('user', user)\r\n    provide('setUser', setUser)\r\n    provide('isAuthenticated', isAuthenticated)\r\n\r\n    return { \r\n      user, \r\n      setUser, \r\n      router, \r\n      isAuthenticated, \r\n      layoutLoading, \r\n      pageTitle, \r\n      handleLogout, \r\n      updatePageTitle,\r\n      isProfilePage,\r\n    };\r\n  },\r\n}\r\n</script>\r\n\r\n<style>\r\nhtml, body {\r\n  overflow-y: auto;\r\n}\r\n</style>"],"mappings":";AAgCA,SAASA,OAAO,EAAEC,GAAG,EAAEC,SAAS,EAAEC,KAAK,EAAEC,QAAO,QAAS,KAAI;AAC7D,OAAOC,UAAS,MAAO,6BAA4B;AACnD,OAAOC,eAAc,MAAO,kCAAiC;AAC7D,SAASC,SAAQ,QAAS,cAAa;AACvC,SAASC,SAAS,EAAEC,QAAO,QAAS,YAAW;AAE/C,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IACVN,UAAU;IACVC;EACF,CAAC;EACDM,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIL,SAAS,CAAC,CAAC;IAC1B,MAAMM,KAAI,GAAIL,QAAQ,CAAC,CAAC;IACxB,MAAMM,IAAG,GAAId,GAAG,CAAC,IAAI,CAAC;IACtB,MAAMe,eAAc,GAAIf,GAAG,CAAC,KAAK,CAAC;IAClC,MAAMgB,aAAY,GAAIhB,GAAG,CAAC,IAAI,CAAC;IAC/B,MAAMiB,SAAQ,GAAIjB,GAAG,CAAC,EAAE,CAAC;IAEzB,MAAMkB,aAAY,GAAIf,QAAQ,CAAC,MAAM;MACnC,OAAOU,KAAK,CAACM,IAAI,CAACC,UAAU,CAAC,UAAU,CAAC;IAC1C,CAAC,CAAC;IAEF,MAAMC,OAAM,GAAKC,QAAQ,IAAK;MAC5BR,IAAI,CAACS,KAAI,GAAID,QAAO;IACtB;IAEA,MAAME,gBAAe,GAAI,MAAAA,CAAA,KAAY;MACnCR,aAAa,CAACO,KAAI,GAAI,IAAI;MAC1BR,eAAe,CAACQ,KAAI,GAAI,MAAMjB,SAAS,CAAC,CAAC;MACzC,IAAI,CAACS,eAAe,CAACQ,KAAI,IAAKX,MAAM,CAACa,YAAY,CAACF,KAAK,CAACG,IAAI,CAACC,YAAY,EAAE;QACzEf,MAAM,CAACgB,IAAI,CAAC,QAAQ,CAAC;MACvB;MACAZ,aAAa,CAACO,KAAI,GAAI,KAAK;IAC7B,CAAC;IAED,MAAMM,YAAW,GAAIA,CAAA,KAAM;MACzBR,OAAO,CAAC,IAAI,CAAC;MACbN,eAAe,CAACQ,KAAI,GAAI,KAAK;MAC7BX,MAAM,CAACgB,IAAI,CAAC,QAAQ,CAAC;IACvB,CAAC;IAED,MAAME,eAAc,GAAKC,KAAK,IAAK;MACjCd,SAAS,CAACM,KAAI,GAAIQ,KAAK;IACzB,CAAC;IAED9B,SAAS,CAAC,YAAY;MACpB,MAAMuB,gBAAgB,CAAC,CAAC;IAC1B,CAAC,CAAC;IAEFtB,KAAK,CAAC,MAAMU,MAAM,CAACa,YAAY,CAACF,KAAK,EAAE,YAAY;MACjDP,aAAa,CAACO,KAAI,GAAI,IAAI;MAC1B,MAAMC,gBAAgB,CAAC,CAAC;IAC1B,CAAC,CAAC;;IAEF;IACAtB,KAAK,CAAC,MAAMa,eAAe,CAACQ,KAAK,EAAGS,QAAQ,IAAK;MAC/C,IAAI,CAACA,QAAQ,EAAE;QACbf,SAAS,CAACM,KAAI,GAAI,