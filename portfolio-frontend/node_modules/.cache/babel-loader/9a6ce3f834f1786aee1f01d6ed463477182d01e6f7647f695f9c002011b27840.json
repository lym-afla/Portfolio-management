{"ast":null,"code":"import { ref, computed } from 'vue';\nimport PositionsPageBase from '@/components/PositionsPageBase.vue';\nimport { getClosedPositions } from '@/services/api';\nexport default {\n  name: 'ClosedPositions',\n  components: {\n    PositionsPageBase\n  },\n  setup() {\n    const totals = ref({});\n    const headers = ref([{\n      title: 'Type',\n      key: 'type',\n      align: 'start',\n      sortable: false\n    }, {\n      title: 'Name',\n      key: 'name',\n      align: 'start',\n      sortable: true\n    }, {\n      title: 'Currency',\n      key: 'currency',\n      align: 'center',\n      sortable: true\n    }, {\n      title: 'Entry',\n      key: 'entry',\n      align: 'center',\n      sortable: false,\n      children: [{\n        title: 'Date',\n        key: 'investment_date',\n        align: 'center',\n        sortable: true\n      }, {\n        title: 'Value',\n        key: 'entry_value',\n        align: 'center',\n        sortable: true\n      }]\n    }, {\n      title: 'Exit',\n      key: 'exit',\n      align: 'center',\n      sortable: false,\n      children: [{\n        title: 'Date',\n        key: 'exit_date',\n        align: 'center',\n        sortable: true\n      }, {\n        title: 'Value',\n        key: 'exit_value',\n        align: 'center',\n        sortable: true\n      }]\n    }, {\n      title: 'Realized gain/(loss)',\n      key: 'realized',\n      align: 'center',\n      sortable: false,\n      children: [{\n        title: 'Amount',\n        key: 'realized_gl',\n        align: 'center',\n        sortable: true\n      }, {\n        title: '%',\n        key: 'price_change_percentage',\n        align: 'center',\n        class: 'font-italic',\n        sortable: true\n      }]\n    }, {\n      title: 'Capital distribution',\n      key: 'capital',\n      align: 'center',\n      sortable: false,\n      children: [{\n        title: 'Amount',\n        key: 'capital_distribution',\n        align: 'center',\n        sortable: true\n      }, {\n        title: '%',\n        key: 'capital_distribution_percentage',\n        align: 'center',\n        class: 'font-italic',\n        sortable: true\n      }]\n    }, {\n      title: 'Commission',\n      key: 'commission',\n      align: 'center',\n      sortable: false,\n      children: [{\n        title: 'Amount',\n        key: 'commission',\n        align: 'center',\n        sortable: true\n      }, {\n        title: '%',\n        key: 'commission_percentage',\n        align: 'center',\n        class: 'font-italic',\n        sortable: true\n      }]\n    }, {\n      title: 'Total return',\n      key: 'total',\n      align: 'center',\n      sortable: false,\n      children: [{\n        title: 'Amount',\n        key: 'total_return_amount',\n        align: 'center',\n        sortable: true\n      }, {\n        title: '%',\n        key: 'total_return_percentage',\n        align: 'center',\n        class: 'font-italic',\n        sortable: true\n      }, {\n        title: 'IRR',\n        key: 'irr',\n        align: 'center',\n        class: 'font-italic',\n        sortable: true\n      }]\n    }]);\n    const percentageColumns = ['price_change_percentage', 'capital_distribution_percentage', 'commission_percentage', 'total_return_percentage', 'irr'];\n    const fetchClosedPositions = async ({\n      dateFrom,\n      dateTo,\n      timespan,\n      page,\n      itemsPerPage,\n      search,\n      sortBy\n    }) => {\n      console.log('[ClosedPositionsPage] fetchClosedPositions called with:', {\n        dateFrom,\n        dateTo,\n        timespan,\n        page,\n        itemsPerPage,\n        search,\n        sortBy\n      });\n      const data = await getClosedPositions(dateFrom, dateTo, timespan, page, itemsPerPage, search, sortBy);\n      totals.value = data.portfolio_closed_totals;\n      return {\n        positions: data.portfolio_closed,\n        total_items: data.total_items\n      };\n    };\n    const flattenedHeaders = computed(() => {\n      return headers.value.flatMap(header => header.children ? header.children : header);\n    });\n    return {\n      headers,\n      percentageColumns,\n      fetchClosedPositions,\n      totals,\n      flattenedHeaders\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","PositionsPageBase","getClosedPositions","name","components","setup","totals","headers","title","key","align","sortable","children","class","percentageColumns","fetchClosedPositions","dateFrom","dateTo","timespan","page","itemsPerPage","search","sortBy","console","log","data","value","portfolio_closed_totals","positions","portfolio_closed","total_items","flattenedHeaders","flatMap","header"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\ClosedPositionsPage.vue"],"sourcesContent":["<template>\r\n  <PositionsPageBase\r\n    :fetch-positions=\"fetchClosedPositions\"\r\n    :headers=\"headers\"\r\n    page-title=\"Closed Positions\"\r\n  >\r\n\r\n    <template #header=\"{ header }\">\r\n      <span>{{ header.value }} T {{ header.sortable }}</span>\r\n      <v-icon v-if=\"header.sortable\" size=\"small\" class=\"ml-1\">{{ getSortIcon(header.key) }}</v-icon>\r\n    </template>\r\n\r\n    <template v-for=\"key in percentageColumns\" :key=\"key\" #[`item.${key}`]=\"{ item }\">\r\n      <span v-if=\"item && item[key] !== undefined\" class=\"font-italic\">{{ item[key] }}</span>\r\n      <span v-else>-</span>\r\n    </template>\r\n\r\n    <template #tfoot>\r\n      <tfoot>\r\n        <tr class=\"font-weight-bold\">\r\n          <td v-for=\"header in flattenedHeaders\" :key=\"header.key\" :class=\"['text-' + header.align, header.key === 'type' ? 'start' : '']\">\r\n            <template v-if=\"header.key === 'type'\">\r\n              TOTAL\r\n            </template>\r\n            <template v-else-if=\"percentageColumns.includes(header.key)\">\r\n              <span class=\"font-italic\">{{ totals[header.key] }}</span>\r\n            </template>\r\n            <template v-else>\r\n              {{ totals[header.key] }}\r\n            </template>\r\n          </td>\r\n        </tr>\r\n      </tfoot>\r\n    </template>\r\n  </PositionsPageBase>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport PositionsPageBase from '@/components/PositionsPageBase.vue'\r\nimport { getClosedPositions } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'ClosedPositions',\r\n  components: {\r\n    PositionsPageBase,\r\n  },\r\n  setup() {\r\n    const totals = ref({})\r\n\r\n    const headers = ref([\r\n      { title: 'Type', key: 'type', align: 'start', sortable: false },\r\n      { title: 'Name', key: 'name', align: 'start', sortable: true },\r\n      { title: 'Currency', key: 'currency', align: 'center', sortable: true },\r\n      {\r\n        title: 'Entry',\r\n        key: 'entry',\r\n        align: 'center',\r\n        sortable: false,\r\n        children: [\r\n          { title: 'Date', key: 'investment_date', align: 'center', sortable: true },\r\n          { title: 'Value', key: 'entry_value', align: 'center', sortable: true },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Exit',\r\n        key: 'exit',\r\n        align: 'center',\r\n        sortable: false,\r\n        children: [\r\n          { title: 'Date', key: 'exit_date', align: 'center', sortable: true },\r\n          { title: 'Value', key: 'exit_value', align: 'center', sortable: true },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Realized gain/(loss)',\r\n        key: 'realized',\r\n        align: 'center',\r\n        sortable: false,\r\n        children: [\r\n          { title: 'Amount', key: 'realized_gl', align: 'center', sortable: true },\r\n          { title: '%', key: 'price_change_percentage', align: 'center', class: 'font-italic', sortable: true },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Capital distribution',\r\n        key: 'capital',\r\n        align: 'center',\r\n        sortable: false,\r\n        children: [\r\n          { title: 'Amount', key: 'capital_distribution', align: 'center', sortable: true },\r\n          { title: '%', key: 'capital_distribution_percentage', align: 'center', class: 'font-italic', sortable: true },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Commission',\r\n        key: 'commission',\r\n        align: 'center',\r\n        sortable: false,\r\n        children: [\r\n          { title: 'Amount', key: 'commission', align: 'center', sortable: true },\r\n          { title: '%', key: 'commission_percentage', align: 'center', class: 'font-italic', sortable: true },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Total return',\r\n        key: 'total',\r\n        align: 'center',\r\n        sortable: false,\r\n        children: [\r\n          { title: 'Amount', key: 'total_return_amount', align: 'center', sortable: true },\r\n          { title: '%', key: 'total_return_percentage', align: 'center', class: 'font-italic', sortable: true },\r\n          { title: 'IRR', key: 'irr', align: 'center', class: 'font-italic', sortable: true },\r\n        ],\r\n      },\r\n    ])\r\n\r\n    const percentageColumns = [\r\n      'price_change_percentage',\r\n      'capital_distribution_percentage',\r\n      'commission_percentage',\r\n      'total_return_percentage',\r\n      'irr'\r\n    ]\r\n\r\n    const fetchClosedPositions = async ({ dateFrom, dateTo, timespan, page, itemsPerPage, search, sortBy }) => {\r\n      console.log('[ClosedPositionsPage] fetchClosedPositions called with:', {\r\n        dateFrom,\r\n        dateTo,\r\n        timespan,\r\n        page,\r\n        itemsPerPage,\r\n        search,\r\n        sortBy\r\n      });\r\n      const data = await getClosedPositions(\r\n        dateFrom,\r\n        dateTo,\r\n        timespan,\r\n        page,\r\n        itemsPerPage,\r\n        search,\r\n        sortBy\r\n      )\r\n      totals.value = data.portfolio_closed_totals\r\n      return {\r\n        positions: data.portfolio_closed,\r\n        total_items: data.total_items,\r\n      }\r\n    }\r\n\r\n    const flattenedHeaders = computed(() => {\r\n      return headers.value.flatMap(header => \r\n        header.children \r\n          ? header.children\r\n          : header\r\n      );\r\n    });\r\n\r\n    return {\r\n      headers,\r\n      percentageColumns,\r\n      fetchClosedPositions,\r\n      totals,\r\n      flattenedHeaders,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAsCA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,OAAOC,iBAAgB,MAAO,oCAAmC;AACjE,SAASC,kBAAiB,QAAS,gBAAe;AAElD,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,UAAU,EAAE;IACVH;EACF,CAAC;EACDI,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIP,GAAG,CAAC,CAAC,CAAC;IAErB,MAAMQ,OAAM,GAAIR,GAAG,CAAC,CAClB;MAAES,KAAK,EAAE,MAAM;MAAEC,GAAG,EAAE,MAAM;MAAEC,KAAK,EAAE,OAAO;MAAEC,QAAQ,EAAE;IAAM,CAAC,EAC/D;MAAEH,KAAK,EAAE,MAAM;MAAEC,GAAG,EAAE,MAAM;MAAEC,KAAK,EAAE,OAAO;MAAEC,QAAQ,EAAE;IAAK,CAAC,EAC9D;MAAEH,KAAK,EAAE,UAAU;MAAEC,GAAG,EAAE,UAAU;MAAEC,KAAK,EAAE,QAAQ;MAAEC,QAAQ,EAAE;IAAK,CAAC,EACvE;MACEH,KAAK,EAAE,OAAO;MACdC,GAAG,EAAE,OAAO;MACZC,KAAK,EAAE,QAAQ;MACfC,QAAQ,EAAE,KAAK;MACfC,QAAQ,EAAE,CACR;QAAEJ,KAAK,EAAE,MAAM;QAAEC,GAAG,EAAE,iBAAiB;QAAEC,KAAK,EAAE,QAAQ;QAAEC,QAAQ,EAAE;MAAK,CAAC,EAC1E;QAAEH,KAAK,EAAE,OAAO;QAAEC,GAAG,EAAE,aAAa;QAAEC,KAAK,EAAE,QAAQ;QAAEC,QAAQ,EAAE;MAAK,CAAC;IAE3E,CAAC,EACD;MACEH,KAAK,EAAE,MAAM;MACbC,GAAG,EAAE,MAAM;MACXC,KAAK,EAAE,QAAQ;MACfC,QAAQ,EAAE,KAAK;MACfC,QAAQ,EAAE,CACR;QAAEJ,KAAK,EAAE,MAAM;QAAEC,GAAG,EAAE,WAAW;QAAEC,KAAK,EAAE,QAAQ;QAAEC,QAAQ,EAAE;MAAK,CAAC,EACpE;QAAEH,KAAK,EAAE,OAAO;QAAEC,GAAG,EAAE,YAAY;QAAEC,KAAK,EAAE,QAAQ;QAAEC,QAAQ,EAAE;MAAK,CAAC;IAE1E,CAAC,EACD;MACEH,KAAK,EAAE,sBAAsB;MAC7BC,GAAG,EAAE,UAAU;MACfC,KAAK,EAAE,QAAQ;MACfC,QAAQ,EAAE,KAAK;MACfC,QAAQ,EAAE,CACR;QAAEJ,KAAK,EAAE,QAAQ;QAAEC,GAAG,EAAE,aAAa;QAAEC,KAAK,EAAE,QAAQ;QAAEC,QAAQ,EAAE;MAAK,CAAC,EACxE;QAAEH,KAAK,EAAE,GAAG;QAAEC,GAAG,EAAE,yBAAyB;QAAEC,KAAK,EAAE,QAAQ;QAAEG,KAAK,EAAE,aAAa;QAAEF,QAAQ,EAAE;MAAK,CAAC;IAEzG,CAAC,EACD;MACEH,KAAK,EAAE,sBAAsB;MAC7BC,GAAG,E