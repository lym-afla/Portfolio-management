{"ast":null,"code":"import { ref, reactive, onMounted } from 'vue';\nimport { getDashboardSettings, updateDashboardSettings } from '@/services/api';\nexport default {\n  setup() {\n    const dialog = ref(false);\n    const form = ref(null);\n    const errors = ref({});\n    const currencyChoices = ref([]);\n    const formData = reactive({\n      default_currency: '',\n      digits: 0,\n      table_date: ''\n    });\n    const fetchSettingsData = async () => {\n      try {\n        const response = await getDashboardSettings();\n        formData.default_currency = response.default_currency;\n        formData.digits = response.digits;\n        formData.table_date = response.table_date;\n        currencyChoices.value = response.currency_choices;\n      } catch (error) {\n        console.error('Failed to fetch settings data:', error);\n      }\n    };\n    const openDialog = () => {\n      dialog.value = true;\n      fetchSettingsData();\n    };\n    const closeDialog = () => {\n      dialog.value = false;\n      errors.value = {};\n    };\n    const saveSettings = async () => {\n      try {\n        const response = await updateDashboardSettings(formData);\n        if (response.success) {\n          closeDialog();\n          // Optionally, you can emit an event here to notify the parent component\n          // that settings have been updated\n        } else {\n          errors.value = response.errors;\n        }\n      } catch (error) {\n        console.error('Failed to save settings:', error);\n        if (error.response && error.response.data) {\n          errors.value = error.response.data;\n        }\n      }\n    };\n    onMounted(fetchSettingsData);\n    return {\n      dialog,\n      formData,\n      currencyChoices,\n      form,\n      errors,\n      openDialog,\n      closeDialog,\n      saveSettings\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","getDashboardSettings","updateDashboardSettings","setup","dialog","form","errors","currencyChoices","formData","default_currency","digits","table_date","fetchSettingsData","response","value","currency_choices","error","console","openDialog","closeDialog","saveSettings","success","data"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\SettingsDialog.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-btn icon @click=\"openDialog\">\r\n      <v-icon>mdi-cog</v-icon>\r\n    </v-btn>\r\n\r\n    <v-dialog v-model=\"dialog\" max-width=\"400px\" persistent>\r\n      <v-card>\r\n        <v-card-title class=\"text-h5\">\r\n          Settings\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"saveSettings\" ref=\"form\">\r\n            <v-select\r\n              v-model=\"formData.default_currency\"\r\n              :items=\"currencyChoices\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              label=\"Currency\"\r\n              :error-messages=\"errors.default_currency\"\r\n            ></v-select>\r\n            <v-text-field\r\n              v-model.number=\"formData.digits\"\r\n              label=\"Number of Digits\"\r\n              type=\"number\"\r\n              :error-messages=\"errors.digits\"\r\n            ></v-text-field>\r\n            <v-text-field\r\n              v-model=\"formData.table_date\"\r\n              label=\"Date\"\r\n              type=\"date\"\r\n              :error-messages=\"errors.table_date\"\r\n            ></v-text-field>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"closeDialog\">Close</v-btn>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"saveSettings\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive, onMounted } from 'vue'\r\nimport { getDashboardSettings, updateDashboardSettings } from '@/services/api'\r\n\r\nexport default {\r\n  setup() {\r\n    const dialog = ref(false)\r\n    const form = ref(null)\r\n    const errors = ref({})\r\n    const currencyChoices = ref([])\r\n\r\n    const formData = reactive({\r\n      default_currency: '',\r\n      digits: 0,\r\n      table_date: '',\r\n    })\r\n\r\n    const fetchSettingsData = async () => {\r\n      try {\r\n        const response = await getDashboardSettings()\r\n        formData.default_currency = response.default_currency\r\n        formData.digits = response.digits\r\n        formData.table_date = response.table_date\r\n        currencyChoices.value = response.currency_choices\r\n      } catch (error) {\r\n        console.error('Failed to fetch settings data:', error)\r\n      }\r\n    }\r\n\r\n    const openDialog = () => {\r\n      dialog.value = true\r\n      fetchSettingsData()\r\n    }\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      errors.value = {}\r\n    }\r\n\r\n    const saveSettings = async () => {\r\n      try {\r\n        const response = await updateDashboardSettings(formData)\r\n        if (response.success) {\r\n          closeDialog()\r\n          // Optionally, you can emit an event here to notify the parent component\r\n          // that settings have been updated\r\n        } else {\r\n          errors.value = response.errors\r\n        }\r\n      } catch (error) {\r\n        console.error('Failed to save settings:', error)\r\n        if (error.response && error.response.data) {\r\n          errors.value = error.response.data\r\n        }\r\n      }\r\n    }\r\n\r\n    onMounted(fetchSettingsData)\r\n\r\n    return {\r\n      dialog,\r\n      formData,\r\n      currencyChoices,\r\n      form,\r\n      errors,\r\n      openDialog,\r\n      closeDialog,\r\n      saveSettings\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA8CA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AAC7C,SAASC,oBAAoB,EAAEC,uBAAs