{"ast":null,"code":"import { ref, watch, onMounted } from 'vue';\nimport { Chart, registerables } from 'chart.js';\nimport { getChartOptions } from '@/config/chartConfig';\nimport DateRangeSelector from '@/components/DateRangeSelector.vue';\nimport { calculateDateRange } from '@/utils/dateRangeUtils';\nChart.register(...registerables);\nexport default {\n  name: 'NAVChart',\n  components: {\n    DateRangeSelector\n  },\n  props: {\n    chartData: {\n      type: Object,\n      required: true\n    },\n    loading: {\n      type: Boolean,\n      default: false\n    },\n    initialParams: {\n      type: Object,\n      required: true\n    },\n    effectiveCurrentDate: {\n      type: String,\n      required: true\n    }\n  },\n  emits: ['update-params'],\n  setup(props, {\n    emit\n  }) {\n    const chartRef = ref(null);\n    const chartInstance = ref(null);\n    const selectedBreakdown = ref(props.initialParams.breakdown);\n    const selectedFrequency = ref(props.initialParams.frequency);\n    const selectedRange = ref(props.initialParams.range);\n    const dateRange = ref({\n      from: props.initialParams.from_date,\n      to: props.initialParams.to_date\n    });\n    const breakdownOptions = [{\n      title: 'Broker',\n      value: 'broker'\n    }, {\n      title: 'Asset Type',\n      value: 'asset_type'\n    }, {\n      title: 'Asset Class',\n      value: 'asset_class'\n    }, {\n      title: 'Currency',\n      value: 'currency'\n    }, {\n      title: 'No breakdown',\n      value: 'none'\n    }, {\n      title: 'Value Contributions',\n      value: 'value_contributions'\n    }];\n    const updateParams = () => {\n      emit('update-params', {\n        frequency: selectedFrequency.value,\n        from_date: dateRange.value.from,\n        to_date: dateRange.value.to,\n        breakdown: selectedBreakdown.value\n      });\n    };\n    const handlePredefinedRange = value => {\n      selectedRange.value = value;\n      const newDateRange = calculateDateRange(value, props.effectiveCurrentDate);\n      dateRange.value = newDateRange;\n      updateParams();\n    };\n    onMounted(() => {\n      // Use initial params\n      // handlePredefinedRange(selectedRange.value)\n      initi;\n    });\n    const initChart = async () => {\n      if (!chartRef.value || !props.chartData) return;\n      const ctx = chartRef.value.getContext('2d');\n      const {\n        navChartOptions,\n        colorPalette\n      } = await getChartOptions(props.chartData.currency);\n      if (chartInstance.value) {\n        chartInstance.value.destroy();\n      }\n      const datasets = props.chartData.datasets.map((dataset, index) => ({\n        ...dataset,\n        backgroundColor: dataset.type === 'bar' ? colorPalette[index % colorPalette.length] : dataset.backgroundColor,\n        // Set order for line charts to be higher (will be drawn last)\n        order: dataset.type === 'line' ? 0 : index + 1\n      }));\n      chartInstance.value = new Chart(ctx, {\n        type: 'bar',\n        data: {\n          ...props.chartData,\n          datasets: datasets\n        },\n        options: {\n          ...navChartOptions,\n          plugins: {\n            ...navChartOptions.plugins,\n            legend: {\n              ...navChartOptions.plugins.legend,\n              reverse: true // This will reverse the order of legend items\n            },\n            tooltip: {\n              ...navChartOptions.plugins.tooltip,\n              itemSort: (a, b) => a.datasetIndex - b.datasetIndex // Sort tooltip items to match visual order\n            }\n          }\n        }\n      });\n    };\n    watch(() => props.chartData, initChart, {\n      deep: true\n    });\n    return {\n      chartRef,\n      selectedBreakdown,\n      selectedFrequency,\n      selectedRange,\n      dateRange,\n      breakdownOptions,\n      updateParams,\n      handlePredefinedRange\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","onMounted","Chart","registerables","getChartOptions","DateRangeSelector","calculateDateRange","register","name","components","props","chartData","type","Object","required","loading","Boolean","default","initialParams","effectiveCurrentDate","String","emits","setup","emit","chartRef","chartInstance","selectedBreakdown","breakdown","selectedFrequency","frequency","selectedRange","range","dateRange","from","from_date","to","to_date","breakdownOptions","title","value","updateParams","handlePredefinedRange","newDateRange","initi","initChart","ctx","getContext","navChartOptions","colorPalette","currency","destroy","datasets","map","dataset","index","backgroundColor","length","order","data","options","plugins","legend","reverse","tooltip","itemSort","a","b","datasetIndex","deep"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\NAVChart.vue"],"sourcesContent":["<template>\r\n  <v-card>\r\n    <v-card-title>Value and return over time</v-card-title>\r\n    <v-card-text>\r\n      <v-row>\r\n        <v-col cols=\"12\" sm=\"4\">\r\n          <v-select\r\n            v-model=\"selectedBreakdown\"\r\n            :items=\"breakdownOptions\"\r\n            label=\"Breakdown by\"\r\n            @update:model-value=\"updateParams\"\r\n          ></v-select>\r\n        </v-col>\r\n        <v-col cols=\"12\" sm=\"4\">\r\n          <v-btn-toggle v-model=\"selectedFrequency\" mandatory @update:model-value=\"updateParams\">\r\n            <v-btn value=\"D\">D</v-btn>\r\n            <v-btn value=\"W\">W</v-btn>\r\n            <v-btn value=\"M\">M</v-btn>\r\n            <v-btn value=\"Q\">Q</v-btn>\r\n            <v-btn value=\"Y\">Y</v-btn>\r\n          </v-btn-toggle>\r\n        </v-col>\r\n        <v-col cols=\"12\" sm=\"4\">\r\n          <DateRangeSelector v-model=\"dateRange\" @update:model-value=\"updateParams\" />\r\n        </v-col>\r\n      </v-row>\r\n      <div class=\"chart-wrapper\">\r\n        <canvas ref=\"chartRef\"></canvas>\r\n        <div v-if=\"loading\" class=\"chart-overlay\">\r\n          <v-progress-circular indeterminate color=\"primary\" size=\"64\" />\r\n        </div>\r\n      </div>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch, onMounted } from 'vue'\r\nimport { Chart, registerables } from 'chart.js'\r\nimport { getChartOptions } from '@/config/chartConfig'\r\nimport DateRangeSelector from '@/components/DateRangeSelector.vue'\r\nimport { calculateDateRange } from '@/utils/dateRangeUtils'\r\n\r\nChart.register(...registerables)\r\n\r\nexport default {\r\n  name: 'NAVChart',\r\n  components: { DateRangeSelector },\r\n  props: {\r\n    chartData: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    loading: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    initialParams: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    effectiveCurrentDate: {\r\n      type: String,\r\n      required: true\r\n    }\r\n  },\r\n  emits: ['update-params'],\r\n  setup(props, { emit }) {\r\n    const chartRef = ref(null)\r\n    const chartInstance = ref(null)\r\n    const selectedBreakdown = ref(props.initialParams.breakdown)\r\n    const selectedFrequency = ref(props.initialParams.frequency)\r\n    const selectedRange = ref(props.initialParams.range)\r\n    const dateRange = ref({\r\n      from: props.initialParams.from_date,\r\n      to: props.initialParams.to_date\r\n    })\r\n\r\n    const breakdownOptions = [\r\n      { title: 'Broker', value: 'broker' },\r\n      { title: 'Asset Type', value: 'asset_type' },\r\n      { title: 'Asset Class', value: 'asset_class' },\r\n      { title: 'Currency', value: 'currency' },\r\n      { title: 'No breakdown', value: 'none' },\r\n      { title: 'Value Contributions', value: 'value_contributions' }\r\n    ]\r\n\r\n    const updateParams = () => {\r\n      emit('update-params', {\r\n        frequency: selectedFrequency.value,\r\n        from_date: dateRange.value.from,\r\n        to_date: dateRange.value.to,\r\n        breakdown: selectedBreakdown.value\r\n      })\r\n    }\r\n\r\n    const handlePredefinedRange = (value) => {\r\n      selectedRange.value = value\r\n      const newDateRange = calculateDateRange(value, props.effectiveCurrentDate)\r\n      dateRange.value = newDateRange\r\n      updateParams()\r\n    }\r\n\r\n    onMounted(() => {\r\n      // Use initial params\r\n      // handlePredefinedRange(selectedRange.value)\r\n      initi\r\n    })\r\n\r\n    const initChart = async () => {\r\n      if (!chartRef.value || !props.chartData) return\r\n      const ctx = chartRef.value.getContext('2d')\r\n      const { navChartOptions, colorPalette } = await getChartOptions(props.chartData.currency)\r\n      if (chartInstance.value) {\r\n        chartInstance.value.destroy()\r\n      }\r\n\r\n      const datasets = props.chartData.datasets.map((dataset, index) => ({\r\n        ...dataset,\r\n        backgroundColor: dataset.type === 'bar' ? colorPalette[index % colorPalette.length] : dataset.backgroundColor,\r\n        // Set order for line charts to be higher (will be drawn last)\r\n        order: dataset.type === 'line' ? 0 : index + 1\r\n      }))\r\n\r\n      chartInstance.value = new Chart(ctx, {\r\n        type: 'bar',\r\n        data: {\r\n          ...props.chartData,\r\n          datasets: datasets,\r\n        },\r\n        options: {\r\n          ...navChartOptions,\r\n          plugins: {\r\n            ...navChartOptions.plugins,\r\n            legend: {\r\n              ...navChartOptions.plugins.legend,\r\n              reverse: true, // This will reverse the order of legend items\r\n            },\r\n            tooltip: {\r\n              ...navChartOptions.plugins.tooltip,\r\n              itemSort: (a, b) => a.datasetIndex - b.datasetIndex, // Sort tooltip items to match visual order\r\n            },\r\n          },\r\n        },\r\n      })\r\n    }\r\n\r\n    watch(() => props.chartData, initChart, { deep: true })\r\n\r\n    return {\r\n      chartRef,\r\n      selectedBreakdown,\r\n      selectedFrequency,\r\n      selectedRange,\r\n      dateRange,\r\n      breakdownOptions,\r\n      updateParams,\r\n      handlePredefinedRange\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chart-wrapper {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 600px;\r\n}\r\n\r\n.chart-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  background-color: rgba(255, 255, 255, 0.7);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 1;\r\n}\r\n</style>"],"mappings":"AAqCA,SAASA,GAAG,EAAEC,KAAK,EAAEC,SAAQ,QAAS,KAAI;AAC1C,SAASC,KAAK,EAAEC,aAAY,QAAS,UAAS;AAC9C,SAASC,eAAc,QAAS,sBAAqB;AACrD,OAAOC,iBAAgB,MAAO,oCAAmC;AACjE,SAASC,kBAAiB,QAAS,wBAAuB;AAE1DJ,KAAK,CAACK,QAAQ,CAAC,GAAGJ,aAAa;AAE/B,eAAe;EACbK,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEJ;EAAkB,CAAC;EACjCK,KAAK,EAAE;IACLC,SAAS,EAAE;MACTC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,OAAO,EAAE;MACPH,IAAI,EAAEI,OAAO;MACbC,OAAO,EAAE;IACX,CAAC;IACDC,aAAa,EAAE;MACbN,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDK,oBAAoB,EAAE;MACpBP,IAAI,EAAEQ,MAAM;MACZN,QAAQ,EAAE;IACZ;EACF,CAAC;EACDO,KAAK,EAAE,CAAC,eAAe,CAAC;EACxBC,KAAKA,CAACZ,KAAK,EAAE;IAAEa;EAAK,CAAC,EAAE;IACrB,MAAMC,QAAO,GAAIzB,GAAG,CAAC,IAAI;IACzB,MAAM0B,aAAY,GAAI1B,GAAG,CAAC,IAAI;IAC9B,MAAM2B,iBAAgB,GAAI3B,GAAG,CAACW,KAAK,CAACQ,aAAa,CAACS,SAAS;IAC3D,MAAMC,iBAAgB,GAAI7B,GAAG,CAACW,KAAK,CAACQ,aAAa,CAACW,SAAS;IAC3D,MAAMC,aAAY,GAAI/B,GAAG,CAACW,KAAK,CAACQ,aAAa,CAACa,KAAK;IACnD,MAAMC,SAAQ,GAAIjC,GAAG,CAAC;MACpBkC,IAAI,EAAEvB,KAAK,CAACQ,aAAa,CAACgB,SAAS;MACnCC,EAAE,EAAEzB,KAAK,CAACQ,aAAa,CAACkB;IAC1B,CAAC;IAED,MAAMC,gBAAe,GAAI,CACvB;MAAEC,KAAK,EAAE,QAAQ;MAAEC,KAAK,EAAE;IAAS,CAAC,EACpC;MAAED,KAAK,EAAE,YAAY;MAAEC,KAAK,EAAE;IAAa,CAAC,EAC5C;MAAED,KAAK,EAAE,aAAa;MAAEC,KAAK,EAAE;IAAc,CAAC,EAC9C;MAAED,KAAK,EAAE,UAAU;MAAEC,KAAK,EAAE;IAAW,CAAC,EACxC;MAAED,KAAK,EAAE,cAAc;MAAEC,KAAK,EAAE;IAAO,CAAC,EACxC;MAAED,KAAK,EAAE,qBAAqB;MAAEC,KAAK,EAAE;IAAsB,EAC/D;IAEA,MAA