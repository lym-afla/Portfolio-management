        if (typeof year === 'string') {\n            return {\n              text: year,\n              value: year\n            };\n          }\n          return year; // For divider and special options\n        });\n      } catch (error) {\n        console.error('Error fetching year options:', error);\n      }\n    };\n    const fetchData = async () => {\n      loading.value = true;\n      await Promise.all([fetchYearOptions(), fetchClosedPositions()]);\n      loading.value = false;\n    };\n    onMounted(() => {\n      fetchData();\n      emit('update-page-title', 'Closed Positions');\n    });\n    onUnmounted(() => {\n      emit('update-page-title', ''); // Clear the page title when component is unmounted\n    });\n    return {\n      closedPositions,\n      totals,\n      loading,\n      tableLoading,\n      headers,\n      selectedYear,\n      yearOptions,\n      handleYearChange,\n      search\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","axios","name","emits","setup","props","emit","closedPositions","totals","loading","tableLoading","selectedYear","yearOptions","search","headers","text","value","align","rowspan","colspan","sortable","width","fetchClosedPositions","response","post","timespan","data","portfolio_closed","portfolio_closed_totals","error","console","handleYearChange","newValue","fetchYearOptions","get","closed_table_years","map","year","fetchData","Promise","all","onUnmounted"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\ClosedPositionsPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid>\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\" md=\"3\" lg=\"2\">\r\n        <v-select\r\n          v-model=\"selectedYear\"\r\n          :items=\"yearOptions\"\r\n          item-title=\"text\"\r\n          item-value=\"value\"\r\n          label=\"Year\"\r\n          @update:model-value=\"handleYearChange\"\r\n          density=\"compact\"\r\n        >\r\n          <template v-slot:item=\"{ item, props }\">\r\n            <v-list-item\r\n              v-if=\"!item.raw.divider\"\r\n              v-bind=\"props\"\r\n              :title=\"item.title\"\r\n            ></v-list-item>\r\n            <v-divider v-else class=\"my-2\"></v-divider>\r\n          </template>\r\n        </v-select>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\">\r\n        <v-data-table\r\n          :headers=\"headers\"\r\n          :items=\"closedPositions\"\r\n          :loading=\"tableLoading\"\r\n          :search=\"search\"\r\n          class=\"elevation-1\"\r\n          dense\r\n        >\r\n          <template v-slot:top>\r\n            <v-toolbar flat>\r\n              <v-toolbar-title>Closed Positions</v-toolbar-title>\r\n              <v-divider\r\n                class=\"mx-4\"\r\n                inset\r\n                vertical\r\n              ></v-divider>\r\n              <v-text-field\r\n                v-model=\"search\"\r\n                append-icon=\"mdi-magnify\"\r\n                label=\"Search\"\r\n                single-line\r\n                hide-details\r\n              ></v-text-field>\r\n            </v-toolbar>\r\n          </template>\r\n\r\n          <template v-slot:item.price_change_percentage=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.price_change_percentage }}</span>\r\n          </template>\r\n\r\n          <template v-slot:item.capital_distribution_percentage=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.capital_distribution_percentage }}</span>\r\n          </template>\r\n\r\n          <template v-slot:item.commission_percentage=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.commission_percentage }}</span>\r\n          </template>\r\n\r\n          <template v-slot:item.total_return_percentage=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.total_return_percentage }}</span>\r\n          </template>\r\n\r\n          <template v-slot:item.irr=\"{ item }\">\r\n            <span class=\"font-italic\">{{ item.irr }}</span>\r\n          </template>\r\n\r\n          <template v-slot:footer>\r\n            <tr class=\"font-weight-bold\">\r\n              <td colspan=\"2\" class=\"text-right\">TOTAL</td>\r\n              <td></td>\r\n              <td></td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.entry_value }}</td>\r\n              <td></td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.exit_value }}</td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.realized_gl }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.price_change_percentage }}</td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.capital_distribution }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.capital_distribution_percentage }}</td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.commission }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.commission_percentage }}</td>\r\n              <td></td>\r\n              <td class=\"text-center\">{{ totals.total_return_amount }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.total_return_percentage }}</td>\r\n              <td class=\"text-center font-italic\">{{ totals.irr }}</td>\r\n            </tr>\r\n          </template>\r\n        </v-data-table>\r\n      </v-col>\r\n    </v-row>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue'\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'ClosedPositions',\r\n  emits: ['update-page-title'],\r\n  setup(props, { emit }) {\r\n    const closedPositions = ref([])\r\n    const totals = ref({})\r\n    const loading = ref(true)\r\n    const tableLoading = ref(true)\r\n    const selectedYear = ref('YTD')\r\n    const yearOptions = ref([])\r\n    const search = ref('')\r\n\r\n    const headers = [\r\n      [\r\n        { text: 'Type', value: 'type', align: 'start', rowspan: 2 },\r\n        { text: 'Name', value: 'name', align: 'start', rowspan: 2 },\r\n        { text: 'Currency', value: 'currency', align: 'center', rowspan: 2 },\r\n        { text: 'Max position', value: 'max_position', align: 'center', rowspan: 2 },\r\n        { text: 'Entry', value: 'entry', align: 'center', colspan: 2 },\r\n        { text: '', value: 'spacer1', sortable: false, width: '1px' },\r\n        { text: 'Exit', value: 'exit', align: 'center', colspan: 2 },\r\n        { text: '', value: 'spacer2', sortable: false, width: '1px' },\r\n        { text: 'Realized gain/(loss)', value: 'realized', align: 'center', colspan: 2 },\r\n        { text: '', value: 'spacer3', sortable: false, width: '1px' },\r\n        { text: 'Capital distribution', value: 'capital', align: 'center', colspan: 2 },\r\n        { text: '', value: 'spacer4', sortable: false, width: '1px' },\r\n        { text: 'Commission', value: 'commission', align: 'center', colspan: 2 },\r\n        { text: '', value: 'spacer5', sortable: false, width: '1px' },\r\n        { text: 'Total return', value: 'total', align: 'center', colspan: 3 },\r\n      ],\r\n      [\r\n        { text: 'Date', value: 'investment_date', align: 'center' },\r\n        { text: 'Value', value: 'entry_value', align: 'center' },\r\n        { text: 'Date', value: 'exit_date', align: 'center' },\r\n        { text: 'Value', value: 'exit_value', align: 'center' },\r\n        { text: 'Amount', value: 'realized_gl', align: 'center' },\r\n        { text: '%', value: 'price_change_percentage', align: 'center' },\r\n        { text: 'Amount', value: 'capital_distribution', align: 'center' },\r\n        { text: '%', value: 'capital_distribution_percentage', align: 'center' },\r\n        { text: 'Amount', value: 'commission', align: 'center' },\r\n        { text: '%', value: 'commission_percentage', align: 'center' },\r\n        { text: 'Amount', value: 'total_return_amount', align: 'center' },\r\n        { text: '%', value: 'total_return_percentage', align: 'center' },\r\n        { text: 'IRR', value: 'irr', align: 'center' },\r\n      ],\r\n    ]\r\n\r\n    const fetchClosedPositions = async () => {\r\n      tableLoading.value = true\r\n      try {\r\n        const response = await axios.post(\r\n          '/closed_positions/api/get_closed_positions_table/',\r\n          {\r\n            timespan: selectedYear.value,\r\n          }\r\n        )\r\n        closedPositions.value = response.data.portfolio_closed\r\n        totals.value = response.data.portfolio_closed_totals\r\n      } catch (error) {\r\n        console.error('Error fetching closed positions:', error)\r\n      } finally {\r\n        tableLoading.value = false\r\n      }\r\n    }\r\n\r\n    const handleYearChange = (newValue) => {\r\n      selectedYear.value = newValue\r\n      fetchClosedPositions()\r\n    }\r\n\r\n    const fetchYearOptions = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          '/closed_positions/api/get_year_options/'\r\n        )\r\n        yearOptions.value = response.data.closed_table_years.map(year => {\r\n          if (typeof year === 'string') {\r\n            return { text: year, value: year }\r\n          }\r\n          return year  // For divider and special options\r\n        })\r\n      } catch (error) {\r\n        console.error('Error fetching year options:', error)\r\n      }\r\n    }\r\n\r\n    const fetchData = async () => {\r\n      loading.value = true\r\n      await Promise.all([fetchYearOptions(), fetchClosedPositions()])\r\n      loading.value = false\r\n    }\r\n\r\n    onMounted(() => {\r\n      fetchData()\r\n      emit('update-page-title', 'Closed Positions')\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      emit('update-page-title', '') // Clear the page title when component is unmounted\r\n    })\r\n\r\n    return {\r\n      closedPositions,\r\n      totals,\r\n      loading,\r\n      tableLoading,\r\n      headers,\r\n      selectedYear,\r\n      yearOptions,\r\n      handleYearChange,\r\n      search,\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-data-table ::v-deep .v-data-table__wrapper {\r\n  overflow-x: auto;\r\n}\r\n\r\n.v-data-table ::v-deep table {\r\n  white-space: nowrap;\r\n}\r\n\r\n.v-data-table ::v-deep th {\r\n  font-weight: bold !important;\r\n}\r\n\r\n.v-data-table ::v-deep td, .v-data-table ::v-deep th {\r\n  font-size: 0.875rem;\r\n}\r\n\r\n.font-italic {\r\n  font-style: italic;\r\n}\r\n</style>"],"mappings":"AA6GA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAI;AACnC,OAAOC,KAAI,MAAO,OAAM;AAExB,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IACrB,MAAMC,eAAc,GAAIR,GAAG,CAAC,EAAE;IAC9B,MAAMS,MAAK,GAAIT,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMU,OAAM,GAAIV,GAAG,CAAC,IAAI;IACxB,MAAMW,YAAW,GAAIX,GAAG,CAAC,IAAI;IAC7B,MAAMY,YAAW,GAAIZ,GAAG,CAAC,KAAK;IAC9B,MAAMa,WAAU,GAAIb,GAAG,CAAC,EAAE;IAC1B,MAAMc,MAAK,GAAId,GAAG,CAAC,EAAE;IAErB,MAAMe,OAAM,GAAI,CACd,CACE;MAAEC,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE,OAAO;MAAEC,OAAO,EAAE;IAAE,CAAC,EAC3D;MAAEH,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE,OAAO;MAAEC,OAAO,EAAE;IAAE,CAAC,EAC3D;MAAEH,IAAI,EAAE,UAAU;MAAEC,KAAK,EAAE,UAAU;MAAEC,KAAK,EAAE,QAAQ;MAAEC,OAAO,EAAE;IAAE,CAAC,EACpE;MAAEH,IAAI,EAAE,cAAc;MAAEC,KAAK,EAAE,cAAc;MAAEC,KAAK,EAAE,QAAQ;MAAEC,OAAO,EAAE;IAAE,CAAC,EAC5E;MAAEH,IAAI,EAAE,OAAO;MAAEC,KAAK,EAAE,OAAO;MAAEC,KAAK,EAAE,QAAQ;MAAEE,OAAO,EAAE;IAAE,CAAC,EAC9D;MAAEJ,IAAI,EAAE,EAAE;MAAEC,KAAK,EAAE,SAAS;MAAEI,QAAQ,EAAE,KAAK;MAAEC,KAAK,EAAE;IAAM,CAAC,EAC7D;MAAEN,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE,QAAQ;MAAEE,OAAO,EAAE;IAAE,CAAC,EAC5D;MAAEJ,IAAI,EAAE,EAAE;MAAEC,