{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport axios from 'axios';\nexport default {\n  name: 'ClosedPositions',\n  emits: ['update-page-title'],\n  setup(props, {\n    emit\n  }) {\n    const closedPositions = ref([]);\n    const totals = ref({});\n    const loading = ref(true);\n    const tableLoading = ref(true);\n    const selectedYear = ref('YTD');\n    const yearOptions = ref([]);\n    const search = ref('');\n    const headers = [[{\n      text: 'Type',\n      value: 'type',\n      align: 'start',\n      rowspan: 2\n    }, {\n      text: 'Name',\n      value: 'name',\n      align: 'start',\n      rowspan: 2\n    }, {\n      text: 'Currency',\n      value: 'currency',\n      align: 'center',\n      rowspan: 2\n    }, {\n      text: 'Max position',\n      value: 'max_position',\n      align: 'center',\n      rowspan: 2\n    }, {\n      text: 'Entry',\n      value: 'entry',\n      align: 'center',\n      colspan: 2\n    }, {\n      text: '',\n      value: 'spacer1',\n      sortable: false,\n      width: '1px'\n    }, {\n      text: 'Exit',\n      value: 'exit',\n      align: 'center',\n      colspan: 2\n    }, {\n      text: '',\n      value: 'spacer2',\n      sortable: false,\n      width: '1px'\n    }, {\n      text: 'Realized gain/(loss)',\n      value: 'realized',\n      align: 'center',\n      colspan: 2\n    }, {\n      text: '',\n      value: 'spacer3',\n      sortable: false,\n      width: '1px'\n    }, {\n      text: 'Capital distribution',\n      value: 'capital',\n      align: 'center',\n      colspan: 2\n    }, {\n      text: '',\n      value: 'spacer4',\n      sortable: false,\n      width: '1px'\n    }, {\n      text: 'Commission',\n      value: 'commission',\n      align: 'center',\n      colspan: 2\n    }, {\n      text: '',\n      value: 'spacer5',\n      sortable: false,\n      width: '1px'\n    }, {\n      text: 'Total return',\n      value: 'total',\n      align: 'center',\n      colspan: 3\n    }], [{\n      text: 'Date',\