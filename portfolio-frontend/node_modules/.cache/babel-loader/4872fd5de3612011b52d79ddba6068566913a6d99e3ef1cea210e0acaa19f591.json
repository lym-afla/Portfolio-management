{"ast":null,"code":"import { ref, reactive, onMounted } from 'vue';\nimport { getAssetTypes, getBrokers, getSecurities, getPriceData, updatePrice, deletePrice } from '@/services/api';\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue';\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue';\nexport default {\n  name: 'PricesPage',\n  components: {\n    AddSecurityButton,\n    AddPriceEntryButton\n  },\n  setup() {\n    const assetTypes = ref([]);\n    const brokers = ref([]);\n    const securities = ref([]);\n    const selectedAssetTypes = ref([]);\n    const selectedBroker = ref(null);\n    const selectedSecurities = ref([]);\n    const startDate = ref('');\n    const endDate = ref('');\n    const priceData = ref([]);\n    const loading = ref(false);\n    const totalItems = ref(0);\n    const itemsPerPage = ref(10);\n    const options = reactive({\n      page: 1,\n      itemsPerPage: 10,\n      sortBy: ['date'],\n      sortDesc: [true]\n    });\n    const editDialog = ref(false);\n    const deleteDialog = ref(false);\n    const editedItem = ref({});\n    const deletedItem = ref({});\n    const headers = [{\n      text: 'Date',\n      value: 'date'\n    }, {\n      text: 'Security',\n      value: 'security'\n    }, {\n      text: 'Asset Type',\n      value: 'asset_type'\n    }, {\n      text: 'Currency',\n      value: 'currency'\n    }, {\n      text: 'Price',\n      value: 'price'\n    }, {\n      text: 'Actions',\n      value: 'actions',\n      sortable: false\n    }];\n    onMounted(async () => {\n      try {\n        assetTypes.value = await getAssetTypes();\n        brokers.value = await getBrokers();\n        securities.value = await getSecurities();\n        await fetchPriceData();\n      } catch (error) {\n        console.error('Error fetching initial data:', error);\n      }\n    });\n    const applyFilters = () => {\n      options.page = 1;\n      fetchPriceData();\n    };\n    const showImportModal = () => {\n      // TODO: Implement import modal logic\n      console.log('Showing import modal');\n    };\n    const fetchPriceData = async () => {\n      loading.value = true;\n      try {\n        const response = await getPriceData({\n          page: options.page,\n          itemsPerPage: options.itemsPerPage,\n          sortBy: options.sortBy[0],\n          sortDesc: options.sortDesc[0],\n          assetTypes: selectedAssetTypes.value,\n          broker: selectedBroker.value,\n          securities: selectedSecurities.value,\n          startDate: startDate.value,\n          endDate: endDate.value\n        });\n        priceData.value = response.items;\n        totalItems.value = response.total;\n      } catch (error) {\n        console.error('Error fetching price data:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const editPrice = item => {\n      editedItem.value = {\n        ...item\n      };\n      editDialog.value = true;\n    };\n    const closeEditDialog = () => {\n      editDialog.value = false;\n      editedItem.value = {};\n    };\n    const updatePrice = async () => {\n      try {\n        await updatePrice(editedItem.value.id, editedItem.value);\n        closeEditDialog();\n        fetchPriceData();\n      } catch (error) {\n        console.error('Error updating price:', error);\n      }\n    };\n    const deletePrice = item => {\n      deletedItem.value = item;\n      deleteDialog.value = true;\n    };\n    const closeDeleteDialog = () => {\n      deleteDialog.value = false;\n      deletedItem.value = {};\n    };\n    const confirmDelete = async () => {\n      try {\n        await deletePrice(deletedItem.value.id);\n        closeDeleteDialog();\n        fetchPriceData();\n      } catch (error) {\n        console.error('Error deleting price:', error);\n      }\n    };\n    return {\n      assetTypes,\n      brokers,\n      securities,\n      selectedAssetTypes,\n      selectedBroker,\n      selectedSecurities,\n      startDate,\n      endDate,\n      applyFilters,\n      showImportModal,\n      headers,\n      priceData,\n      loading,\n      totalItems,\n      itemsPerPage,\n      options,\n      editDialog,\n      deleteDialog,\n      editedItem,\n      editPrice,\n      closeEditDialog,\n      updatePrice,\n      deletePrice,\n      closeDeleteDialog,\n      confirmDelete\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","getAssetTypes","getBrokers","getSecurities","getPriceData","updatePrice","deletePrice","AddSecurityButton","AddPriceEntryButton","name","components","setup","assetTypes","brokers","securities","selectedAssetTypes","selectedBroker","selectedSecurities","startDate","endDate","priceData","loading","totalItems","itemsPerPage","options","page","sortBy","sortDesc","editDialog","deleteDialog","editedItem","deletedItem","headers","text","value","sortable","fetchPriceData","error","console","applyFilters","showImportModal","log","response","broker","items","total","editPrice","item","closeEditDialog","id","closeDeleteDialog","confirmDelete"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\PricesPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid>\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\">\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-select\r\n              v-model=\"selectedAssetTypes\"\r\n              :items=\"assetTypes\"\r\n              label=\"Asset Types\"\r\n              multiple\r\n              chips\r\n              dense\r\n            ></v-select>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-select\r\n              v-model=\"selectedBroker\"\r\n              :items=\"brokers\"\r\n              label=\"Brokers\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              dense\r\n            ></v-select>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-select\r\n              v-model=\"selectedSecurities\"\r\n              :items=\"securities\"\r\n              label=\"Securities\"\r\n              multiple\r\n              chips\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              dense\r\n            ></v-select>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-text-field\r\n              v-model=\"startDate\"\r\n              label=\"Start Date\"\r\n              type=\"date\"\r\n              dense\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-text-field\r\n              v-model=\"endDate\"\r\n              label=\"End Date\"\r\n              type=\"date\"\r\n              dense\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-btn color=\"primary\" @click=\"applyFilters\" block>\r\n              Apply Filters\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card>\r\n      <v-card-text>\r\n        <v-row align=\"center\" justify=\"space-between\">\r\n          <v-col cols=\"auto\">\r\n            <v-row>\r\n              <v-col cols=\"auto\">\r\n                <AddSecurityButton />\r\n              </v-col>\r\n              <v-col cols=\"auto\">\r\n                <AddPriceEntryButton />\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n          <v-col cols=\"auto\">\r\n            <v-btn color=\"success\" @click=\"showImportModal\">\r\n              Import Prices\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card class=\"mt-4\">\r\n      <v-data-table\r\n        :headers=\"headers\"\r\n        :items=\"priceData\"\r\n        :loading=\"loading\"\r\n        :options.sync=\"options\"\r\n        :server-items-length=\"totalItems\"\r\n        :items-per-page=\"itemsPerPage\"\r\n        @update:options=\"fetchPriceData\"\r\n      >\r\n        <template v-slot:item.price=\"{ item }\">\r\n          <span class=\"editable\" @click=\"editPrice(item)\">{{ item.price.toFixed(2) }}</span>\r\n        </template>\r\n        <template v-slot:item.actions=\"{ item }\">\r\n          <v-btn small color=\"primary\" class=\"mr-2\" @click=\"editPrice(item)\">Edit</v-btn>\r\n          <v-btn small color=\"error\" @click=\"deletePrice(item)\">Delete</v-btn>\r\n        </template>\r\n      </v-data-table>\r\n    </v-card>\r\n\r\n    <!-- Edit Price Modal -->\r\n    <v-dialog v-model=\"editDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Edit Price</v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"updatePrice\">\r\n            <v-text-field v-model=\"editedItem.price\" label=\"Price\" type=\"number\" step=\"0.01\" required></v-text-field>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeEditDialog\">Cancel</v-btn>\r\n          <v-btn color=\"blue darken-1\" text @click=\"updatePrice\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n\r\n    <!-- Confirm Delete Dialog -->\r\n    <v-dialog v-model=\"deleteDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Delete Price Entry</v-card-title>\r\n        <v-card-text>Are you sure you want to delete this price entry?</v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeDeleteDialog\">Cancel</v-btn>\r\n          <v-btn color=\"red darken-1\" text @click=\"confirmDelete\">Delete</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </v-container>\r\n</template>\r\n\r\n<scr