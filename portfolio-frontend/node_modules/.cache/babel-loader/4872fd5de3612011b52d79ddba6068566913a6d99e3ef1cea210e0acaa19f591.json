   const showImportModal = () => {\r\n      // TODO: Implement import modal logic\r\n      console.log('Showing import modal');\r\n    };\r\n\r\n    const fetchPriceData = async () => {\r\n      loading.value = true;\r\n      try {\r\n        const response = await getPriceData({\r\n          page: options.page,\r\n          itemsPerPage: options.itemsPerPage,\r\n          sortBy: options.sortBy[0],\r\n          sortDesc: options.sortDesc[0],\r\n          assetTypes: selectedAssetTypes.value,\r\n          broker: selectedBroker.value,\r\n          securities: selectedSecurities.value,\r\n          startDate: startDate.value,\r\n          endDate: endDate.value,\r\n        });\r\n        priceData.value = response.items;\r\n        totalItems.value = response.total;\r\n      } catch (error) {\r\n        console.error('Error fetching price data:', error);\r\n      } finally {\r\n        loading.value = false;\r\n      }\r\n    };\r\n\r\n    const editPrice = (item) => {\r\n      editedItem.value = { ...item };\r\n      editDialog.value = true;\r\n    };\r\n\r\n    const closeEditDialog = () => {\r\n      editDialog.value = false;\r\n      editedItem.value = {};\r\n    };\r\n\r\n    const updatePrice = async () => {\r\n      try {\r\n        await updatePrice(editedItem.value.id, editedItem.value);\r\n        closeEditDialog();\r\n        fetchPriceData();\r\n      } catch (error) {\r\n        console.error('Error updating price:', error);\r\n      }\r\n    };\r\n\r\n    const deletePrice = (item) => {\r\n      deletedItem.value = item;\r\n      deleteDialog.value = true;\r\n    };\r\n\r\n    const closeDeleteDialog = () => {\r\n      deleteDialog.value = false;\r\n      deletedItem.value = {};\r\n    };\r\n\r\n    const confirmDelete = async () => {\r\n      try {\r\n        await deletePrice(deletedItem.value.id);\r\n        closeDeleteDialog();\r\n        fetchPriceData();\r\n      } catch (error) {\r\n        console.error('Error deleting price:', error);\r\n      }\r\n    };\r\n\r\n    return {\r\n      assetTypes,\r\n      brokers,\r\n      securities,\r\n      selectedAssetTypes,\r\n      selectedBroker,\r\n      selectedSecurities,\r\n      startDate,\r\n      endDate,\r\n      applyFilters,\r\n      showImportModal,\r\n      headers,\r\n      priceData,\r\n      loading,\r\n      totalItems,\r\n      itemsPerPage,\r\n      options,\r\n      editDialog,\r\n      deleteDialog,\r\n      editedItem,\r\n      editPrice,\r\n      closeEditDialog,\r\n      updatePrice,\r\n      deletePrice,\r\n      closeDeleteDialog,\r\n      confirmDelete,\r\n    };\r\n  },\r\n};\r\n</script>"],"mappings":"AAyIA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AAC9C,SAASC,aAAa,EAAEC,UAAU,EAAEC,aAAa,EAAEC,YAAY,EAAEC,WAAW,EAAEC,WAAU,QAAS,gBAAgB;AACjH,OAAOC,iBAAgB,MAAO,sCAAsC;AACpE,OAAOC,mBAAkB,MAAO,mCAAmC;AAEnE,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IACVH,iBAAiB;IACjBC;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,UAAS,GAAId,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMe,OAAM,GAAIf,GAAG,CAAC,EAAE,CAAC;IACvB,MAAMgB,UAAS,GAAIhB,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMiB,kBAAiB,GAAIjB,GAAG,CAAC,EAAE,CAAC;IAClC,MAAMkB,cAAa,GAAIlB,GAAG,CAAC,IAAI,CAAC;IAChC,MAAMmB,kBAAiB,GAAInB,GAAG,CAAC,EAAE,CAAC;IAClC,MAAMoB,SAAQ,GAAIpB,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMqB,OAAM,GAAIrB,GAAG,CAAC,EAAE,CAAC;IACvB,MAAMsB,SAAQ,GAAItB,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMuB,OAAM,GAAIvB,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMwB,UAAS,GAAIxB,GAAG,CAAC,CAAC,CAAC;IACzB,MAAMyB,YAAW,GAAIzB,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAM0B,OAAM,GAAIzB,QAAQ,CAAC;MACvB0B,IAAI,EAAE,CAAC;MACPF,YAAY,EAAE,EAAE;MAChBG,MAAM,EAAE,CAAC,MAAM,CAAC;MAChBC,QAAQ,EAAE,CAAC,IAAI;IACjB,CAAC,CAAC;IACF,MAAMC,UAAS,GAAI9B,GAAG,CAAC,KAAK,CAAC;IAC7B,MAAM+B,YAAW,GAAI/B,GAAG,CAAC,KAAK,CAAC;IAC/B,MAAMgC,UAAS,GAAIhC,GAAG,CAAC,CAAC,CAAC,CAAC;IAC1B,MAAMiC,WAAU,GAAIjC,GAAG,CAAC,CAAC,CAAC,CAAC;IAE3B,MAAMkC,OAAM,GAAI,CACd;MAAEC,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAO,CAAC,EAC/B;MAAED,IAAI,EAAE,UAAU;MAAEC,KAAK,EAAE;IAAW,CAAC,EACvC;MAAED,IAAI,EAAE,YAAY;MAAEC,KAAK,EAAE;IAAa,CAAC,EAC3