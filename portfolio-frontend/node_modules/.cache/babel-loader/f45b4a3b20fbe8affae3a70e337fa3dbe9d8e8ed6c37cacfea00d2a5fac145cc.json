{"ast":null,"code":"import { ref, computed, watch, onMounted } from 'vue';\nimport { useForm, useField } from 'vee-validate';\nimport * as yup from 'yup';\nimport { getTransactionFormStructure, addTransaction, updateTransaction } from '@/services/api';\nexport default {\n  name: 'TransactionFormDialog',\n  props: {\n    modelValue: Boolean,\n    editItem: Object\n  },\n  emits: ['update:modelValue', 'transaction-added', 'transaction-updated'],\n  setup(props, {\n    emit\n  }) {\n    const dialog = computed({\n      get: () => props.modelValue,\n      set: value => emit('update:modelValue', value)\n    });\n    const isEdit = computed(() => !!props.editItem);\n    const formFields = ref([]);\n    const generalError = ref('');\n    const isSubmitting = ref(false);\n    const schema = computed(() => {\n      const schemaObj = {};\n      formFields.value.forEach(field => {\n        if (field.required) {\n          schemaObj[field.name] = yup.mixed().required(`${field.label} is required`);\n        }\n        if (field.name === 'cash_flow') {\n          schemaObj[field.name] = yup.number().test('cash-flow-validation', 'Cash flow must be negative for cash-out transactions and positive for cash-in transactions', function (value) {\n            const type = this.parent.type;\n            if (type === 'Cash out') return value < 0;\n            if (type === 'Cash in') return value > 0;\n            return true;\n          });\n        }\n        if (field.name === 'price') {\n          schemaObj[field.name] = yup.number().positive('Price must be positive');\n        }\n        if (field.name === 'quantity') {\n          schemaObj[field.name] = yup.number().test('quantity-validation', 'Quantity must be positive for buy transactions and negative for sell transactions', function (value) {\n            const type = this.parent.type;\n            if (type === 'Buy') return value > 0;\n            if (type === 'Sell') return value < 0;\n            return true;\n          });\n        }\n        if (field.name === 'commission') {\n          schemaObj[field.name] = yup.number().negative('Commission must be negative');\n        }\n      });\n      return yup.object().shape(schemaObj);\n    });\n    const {\n      handleSubmit,\n      errors,\n      resetForm,\n      validate\n    } = useForm({\n      validationSchema: schema\n    });\n    const {\n      value: form\n    } = useField('form');\n    const isFormValid = computed(async () => {\n      const result = await validate();\n      return result.valid;\n    });\n    const fetchFormStructure = async () => {\n      try {\n        const response = await getTransactionFormStructure();\n        formFields.value = response.fields;\n        initializeForm();\n        if (props.editItem) {\n          populateFormWithEditItem();\n        }\n      } catch (error) {\n        console.error('Error fetching form structure:', error);\n        generalError.value = 'Failed to load form structure. Please try again.';\n      }\n    };\n    const initializeForm = () => {\n      if (formFields.value && formFields.value.length > 0) {\n        form.value = formFields.value.reduce((acc, field) => {\n          acc[field.name] = '';\n          return acc;\n        }, {});\n      } else {\n        generalError.value = 'Failed to initialize form. Please try again.';\n      }\n    };\n    const populateFormWithEditItem = () => {\n      if (props.editItem && formFields.value.length > 0) {\n        formFields.value.forEach(field => {\n          if (props.editItem.hasOwnProperty(field.name)) {\n            form.value[field.name] = props.editItem[field.name];\n          }\n        });\n      }\n    };\n    const submitForm = handleSubmit(async values => {\n      isSubmitting.value = true;\n      generalError.value = '';\n      try {\n        let response;\n        if (isEdit.value) {\n          response = await updateTransaction(form.value.id, values);\n          emit('transaction-updated', response);\n        } else {\n          response = await addTransaction(values);\n          emit('transaction-added', response);\n        }\n        closeDialog();\n      } catch (error) {\n        console.error('Error submitting transaction:', error);\n        if (error && typeof error === 'object') {\n          Object.entries(error).forEach(([key, value]) => {\n            if (key === '__all__') {\n              generalError.value = Array.isArray(value) ? value[0] : value;\n            } else {\n              errors.value[key] = Array.isArray(value) ? value[0] : value;\n            }\n          });\n        } else {\n          generalError.value = error.message || 'An unexpected error occurred. Please try again.';\n        }\n      } finally {\n        isSubmitting.value = false;\n      }\n    });\n    const closeDialog = () => {\n      dialog.value = false;\n      resetForm();\n      generalError.value = '';\n    };\n    watch(() => props.editItem, newValue => {\n      if (newValue) {\n        populateFormWithEditItem();\n      } else {\n        initializeForm();\n      }\n    });\n    watch(() => props.modelValue, newValue => {\n      if (newValue) {\n        fetchFormStructure();\n      }\n    });\n    onMounted(fetchFormStructure);\n    return {\n      dialog,\n      isEdit,\n      form,\n      formFields,\n      errors,\n      generalError,\n      isSubmitting,\n      isFormValid,\n      closeDialog,\n      submitForm\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","onMounted","useForm","useField","yup","getTransactionFormStructure","addTransaction","updateTransaction","name","props","modelValue","Boolean","editItem","Object","emits","setup","emit","dialog","get","set","value","isEdit","formFields","generalError","isSubmitting","schema","schemaObj","forEach","field","required","mixed","label","number","test","type","parent","positive","negative","object","shape","handleSubmit","errors","resetForm","validate","validationSchema","form","isFormValid","result","valid","fetchFormStructure","response","fields","initializeForm","populateFormWithEditItem","error","console","length","reduce","acc","hasOwnProperty","submitForm","values","id","closeDialog","entries","key","Array","isArray","message","newValue"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\TransactionFormDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title>\r\n        <span class=\"text-h5\">{{ isEdit ? 'Edit Transaction' : 'Add Transaction' }}</span>\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-form @submit.prevent=\"submitForm\">\r\n          <template v-for=\"field in formFields\" :key=\"field.name\">\r\n            <v-text-field\r\n              v-if=\"field.type === 'datepicker'\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              type=\"date\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errors[field.name]\"\r\n            ></v-text-field>\r\n            <v-autocomplete\r\n              v-else-if=\"field.type === 'select'\"\r\n              v-model=\"form[field.name]\"\r\n              :items=\"field.choices\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              :label=\"field.label\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errors[field.name]\"\r\n            ></v-autocomplete>\r\n            <v-text-field\r\n              v-else-if=\"field.type === 'number'\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              type=\"number\"\r\n              step=\"0.01\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errors[field.name]\"\r\n            ></v-text-field>\r\n            <v-textarea\r\n              v-else-if=\"field.type === 'textarea'\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errors[field.name]\"\r\n            ></v-textarea>\r\n          </template>\r\n        </v-form>\r\n        <v-alert\r\n          v-if=\"generalError\"\r\n          type=\"error\"\r\n          class=\"mt-4\"\r\n        >\r\n          {{ generalError }}\r\n        </v-alert>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n        <v-btn color=\"blue darken-1\" text @click=\"submitForm\" :loading=\"isSubmitting\" :disabled=\"!isFormValid\">Save</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch, onMounted } from 'vue'\r\nimport { useForm, useField } from 'vee-validate'\r\nimport * as yup from 'yup'\r\nimport { getTransactionFormStructure, addTransaction, updateTransaction } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'TransactionFormDialog',\r\n  props: {\r\n    modelValue: Boolean,\r\n    editItem: Object,\r\n  },\r\n  emits: ['update:modelValue', 'transaction-added', 'transaction-updated'],\r\n  setup(props, { emit }) {\r\n    const dialog = computed({\r\n      get: () => props.modelValue,\r\n      set: (value) => emit('update:modelValue', value)\r\n    })\r\n    const isEdit = computed(() => !!props.editItem)\r\n    const formFields = ref([])\r\n    const generalError = ref('')\r\n    const isSubmitting = ref(false)\r\n\r\n    const schema = computed(() => {\r\n      const schemaObj = {}\r\n      formFields.value.forEach(field => {\r\n        if (field.required) {\r\n          schemaObj[field.name] = yup.mixed().required(`${field.label} is required`)\r\n        }\r\n        if (field.name === 'cash_flow') {\r\n          schemaObj[field.name] = yup.number().test(\r\n            'cash-flow-validation',\r\n            'Cash flow must be negative for cash-out transactions and positive for cash-in transactions',\r\n            function (value) {\r\n              const type = this.parent.type\r\n              if (type === 'Cash out') return value < 0\r\n              if (type === 'Cash in') return value > 0\r\n              return true\r\n            }\r\n          )\r\n        }\r\n        if (field.name === 'price') {\r\n          schemaObj[field.name] = yup.number().positive('Price must be positive')\r\n        }\r\n        if (field.name === 'quantity') {\r\n          schemaObj[field.name] = yup.number().test(\r\n            'quantity-validation',\r\n            'Quantity must be positive for buy transactions and negative for sell transactions',\r\n            function (value) {\r\n              const type = this.parent.type\r\n              if (type === 'Buy') return value > 0\r\n              if (type === 'Sell') return value < 0\r\n              return true\r\n            }\r\n          )\r\n        }\r\n        if (field.name === 'commission') {\r\n          schemaObj[field.name] = yup.number().negative('Commission must be negative')\r\n        }\r\n      })\r\n      return yup.object().shape(schemaObj)\r\n    })\r\n\r\n    const { handleSubmit, errors, resetForm, validate } = useForm({\r\n      validationSchema: schema\r\n    })\r\n\r\n    const { value: form } = useField('form')\r\n\r\n    const isFormValid = computed(async () => {\r\n      const result = await validate()\r\n      return result.valid\r\n    })\r\n\r\n    const fetchFormStructure = async () => {\r\n      try {\r\n        const response = await getTransactionFormStructure()\r\n        formFields.value = response.fields\r\n        initializeForm()\r\n        if (props.editItem) {\r\n          populateFormWithEditItem()\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching form structure:', error)\r\n        generalError.value = 'Failed to load form structure. Please try again.'\r\n      }\r\n    }\r\n\r\n    const initializeForm = () => {\r\n      if (formFields.value && formFields.value.length > 0) {\r\n        form.value = formFields.value.reduce((acc, field) => {\r\n          acc[field.name] = ''\r\n          return acc\r\n        }, {})\r\n      } else {\r\n        generalError.value = 'Failed to initialize form. Please try again.'\r\n      }\r\n    }\r\n\r\n    const populateFormWithEditItem = () => {\r\n      if (props.editItem && formFields.value.length > 0) {\r\n        formFields.value.forEach(field => {\r\n          if (props.editItem.hasOwnProperty(field.name)) {\r\n            form.value[field.name] = props.editItem[field.name]\r\n          }\r\n        })\r\n      }\r\n    }\r\n\r\n    const submitForm = handleSubmit(async (values) => {\r\n      isSubmitting.value = true\r\n      generalError.value = ''\r\n\r\n      try {\r\n        let response\r\n        if (isEdit.value) {\r\n          response = await updateTransaction(form.value.id, values)\r\n          emit('transaction-updated', response)\r\n        } else {\r\n          response = await addTransaction(values)\r\n          emit('transaction-added', response)\r\n        }\r\n        closeDialog()\r\n      } catch (error) {\r\n        console.error('Error submitting transaction:', error)\r\n        if (error && typeof error === 'object') {\r\n          Object.entries(error).forEach(([key, value]) => {\r\n            if (key === '__all__') {\r\n              generalError.value = Array.isArray(value) ? value[0] : value\r\n            } else {\r\n              errors.value[key] = Array.isArray(value) ? value[0] : value\r\n            }\r\n          })\r\n        } else {\r\n          generalError.value = error.message || 'An unexpected error occurred. Please try again.'\r\n        }\r\n      } finally {\r\n        isSubmitting.value = false\r\n      }\r\n    })\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      resetForm()\r\n      generalError.value = ''\r\n    }\r\n\r\n    watch(() => props.editItem, (newValue) => {\r\n      if (newValue) {\r\n        populateFormWithEditItem()\r\n      } else {\r\n        initializeForm()\r\n      }\r\n    })\r\n\r\n    watch(() => props.modelValue, (newValue) => {\r\n      if (newValue) {\r\n        fetchFormStructure()\r\n      }\r\n    })\r\n\r\n    onMounted(fetchFormStructure)\r\n\r\n    return {\r\n      dialog,\r\n      isEdit,\r\n      form,\r\n      formFields,\r\n      errors,\r\n      generalError,\r\n      isSubmitting,\r\n      isFormValid,\r\n      closeDialog,\r\n      submitForm,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA+DA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAK,EAAEC,SAAQ,QAAS,KAAI;AACpD,SAASC,OAAO,EAAEC,QAAO,QAAS,cAAa;AAC/C,OAAO,KAAKC,GAAE,MAAO,KAAI;AACzB,SAASC,2BAA2B,EAAEC,cAAc,EAAEC,iBAAgB,QAAS,gBAAe;AAE9F,eAAe;EACbC,IAAI,EAAE,uBAAuB;EAC7BC,KAAK,EAAE;IACLC,UAAU,EAAEC,OAAO;IACnBC,QAAQ,EAAEC;EACZ,CAAC;EACDC,KAAK,EAAE,CAAC,mBAAmB,EAAE,mBAAmB,EAAE,qBAAqB,CAAC;EACxEC,KAAKA,CAACN,KAAK,EAAE;IAAEO;EAAK,CAAC,EAAE;IACrB,MAAMC,MAAK,GAAIlB,QAAQ,CAAC;MACtBmB,GAAG,EAAEA,CAAA,KAAMT,KAAK,CAACC,UAAU;MAC3BS,GAAG,EAAGC,KAAK,IAAKJ,IAAI,CAAC,mBAAmB,EAAEI,KAAK;IACjD,CAAC;IACD,MAAMC,MAAK,GAAItB,QAAQ,CAAC,MAAM,CAAC,CAACU,KAAK,CAACG,QAAQ;IAC9C,MAAMU,UAAS,GAAIxB,GAAG,CAAC,EAAE;IACzB,MAAMyB,YAAW,GAAIzB,GAAG,CAAC,EAAE;IAC3B,MAAM0B,YAAW,GAAI1B,GAAG,CAAC,KAAK;IAE9B,MAAM2B,MAAK,GAAI1B,QAAQ,CAAC,MAAM;MAC5B,MAAM2B,SAAQ,GAAI,CAAC;MACnBJ,UAAU,CAACF,KAAK,CAACO,OAAO,CAACC,KAAI,IAAK;QAChC,IAAIA,KAAK,CAACC,QAAQ,EAAE;UAClBH,SAAS,CAACE,KAAK,CAACpB,IAAI,IAAIJ,GAAG,CAAC0B,KAAK,CAAC,CAAC,CAACD,QAAQ,CAAC,GAAGD,KAAK,CAACG,KAAK,cAAc;QAC3E;QACA,IAAIH,KAAK,CAACpB,IAAG,KAAM,WAAW,EAAE;UAC9BkB,SAAS,CAACE,KAAK,CAACpB,IAAI,IAAIJ,GAAG,CAAC4B,MAAM,CAAC,CAAC,CAACC,IAAI,CACvC,sBAAsB,EACtB,4FAA4F,EAC5F,UAAUb,KAAK,EAAE;YACf,MAAMc,IAAG,GAAI,IAAI,CAACC,MAAM,CAACD,IAAG;YAC5B,IAAIA,IAAG,KAAM,UAAU,EAAE,OAAOd,KAAI,GAAI;YACxC,IAAIc,IAAG,KAAM,SAAS,EAAE,OAAOd,KAAI,GAAI;YACvC,OAAO,IAAG;UACZ,CACF;QACF;QACA,IAAIQ,KAAK,CAACpB,IA