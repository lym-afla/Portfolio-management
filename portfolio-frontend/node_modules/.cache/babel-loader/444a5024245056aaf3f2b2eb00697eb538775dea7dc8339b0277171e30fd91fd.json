, \"error-messages\", \"onInput\", \"disabled\"])) : field.type === 'number' && (field.name === 'quantity' || field.name === 'price') ? (_openBlock(), _createBlock(_component_v_text_field, {\n              key: 2,\n              modelValue: $setup.form[field.name],\n              \"onUpdate:modelValue\": $event => $setup.form[field.name] = $event,\n              label: field.label,\n              type: \"number\",\n              step: \"0.01\",\n              required: field.required,\n              \"error-messages\": $setup.errors[field.name],\n              onInput: $event => $setup.clearFieldError(field.name),\n              disabled: $setup.isCashTransaction\n            }, null, 8 /* PROPS */, [\"modelValue\", \"onUpdate:modelValue\", \"label\", \"required\", \"error-messages\", \"onInput\", \"disabled\"])) : field.type === 'textarea' ? (_openBlock(), _createBlock(_component_v_textarea, {\n              key: 3,\n              modelValue: $setup.form[field.name],\n              \"onUpdate:modelValue\": $event => $setup.form[field.name] = $event,\n              label: field.label,\n              required: field.required,\n              \"error-messages\": $setup.errors[field.name],\n              onInput: $event => $setup.clearFieldError(field.name)\n            }, null, 8 /* PROPS */, [\"modelValue\", \"onUpdate:modelValue\", \"label\", \"required\", \"error-messages\", \"onInput\"])) : _createCommentVNode(\"v-if\", true)], 64 /* STABLE_FRAGMENT */);\n          }), 128 /* KEYED_FRAGMENT */))]),\n          _: 1 /* STABLE */\n        }, 8 /* PROPS */, [\"onSubmit\"]), $setup.generalError ? (_openBlock(), _createBlock(_component_v_alert, {\n          key: 0,\n          type: \"error\",\n          class: \"mt-4\"\n        }, {\n          default: _withCtx(() => [_createTextVNode(_toDisplayString($setup.generalError), 1 /* TEXT */)]),\n          _: 1 /* STABLE */\n        })) : _createCommentVNode(\"v-if\", true)]),\n        _: 1 /* STABLE */\n      }), _createVNode(_component_v_card_actions, null, {\n        default: _withCtx(() => [_createVNode(_component_v_spacer), _createVNode(_component_v_btn, {\n          color: \"blue darken-1\",\n          text: \"\",\n          onClick: $setup.closeDialog\n        }, {\n          default: _withCtx(() => [_createTextVNode(\"Cancel\")]),\n          _: 1 /* STABLE */\n        }, 8 /* PROPS */, [\"onClick\"]), _createVNode(_component_v_btn, {\n          color: \"blue darken-1\",\n          text: \"\",\n          onClick: $setup.submitForm,\n          loading: $setup.isSubmitting,\n          disabled: !$setup.isFormValid\n        }, {\n          default: _withCtx(() => [_createTextVNode(\"Save\")]),\n          _: 1 /* STABLE */\n        }, 8 /* PROPS */, [\"onClick\", \"loading\", \"disabled\"])]),\n        _: 1 /* STABLE */\n      })]),\n      _: 1 /* STABLE */\n    })]),\n    _: 1 /* STABLE */\n  }, 8 /* PROPS */, [\"modelValue\"]);\n}","map":{"version":3,"names":["class","_createBlock","_component_v_dialog","modelValue","$setup","dialog","_cache","$event","default","_withCtx","_createVNode","_component_v_card","_component_v_card_title","_createElementVNode","_hoisted_1","_toDisplayString","isEdit","_","_component_v_card_text","_component_v_form","onSubmit","_withModifiers","submitForm","_createElementBlock","_Fragment","_renderList","formFields","field","key","name","type","_component_v_text_field","form","label","required","errors","onInput","clearFieldError","_component_v_autocomplete","items","getSelectItems","disabled","isCashTransaction","selection","item","_createTextVNode","raw","text","step","_component_v_textarea","_createCommentVNode","generalError","_component_v_alert","_component_v_card_actions","_component_v_spacer","_component_v_btn","color","onClick","closeDialog","loading","isSubmitting","isFormValid"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\TransactionFormDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title>\r\n        <span class=\"text-h5\">{{ isEdit ? 'Edit Transaction' : 'Add Transaction' }}</span>\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-form @submit.prevent=\"submitForm\">\r\n          <template v-for=\"field in formFields\" :key=\"field.name\">\r\n            <v-text-field\r\n              v-if=\"field.type === 'datepicker'\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              type=\"date\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errors[field.name]\"\r\n              @input=\"clearFieldError(field.name)\"\r\n            ></v-text-field>\r\n            <v-autocomplete\r\n              v-else-if=\"field.type === 'select'\"\r\n              v-model=\"form[field.name]\"\r\n              :items=\"getSelectItems(field)\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              :label=\"field.label\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errors[field.name]\"\r\n              @input=\"clearFieldError(field.name)\"\r\n              :disabled=\"isCashTransaction\"\r\n            >\r\n              <template v-slot:selection=\"{ item }\">\r\n                {{ item.raw.text }}\r\n              </template>\r\n            </v-autocomplete>\r\n            <v-text-field\r\n              v-else-if=\"field.type === 'number' && (field.name === 'quantity' || field.name === 'price')\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              type=\"number\"\r\n              step=\"0.01\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errors[field.name]\"\r\n              @input=\"clearFieldError(field.name)\"\r\n              :disabled=\"isCashTransaction\"\r\n            ></v-text-field>\r\n            <v-textarea\r\n              v-else-if=\"field.type === 'textarea'\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errors[field.name]\"\r\n              @input=\"clearFieldError(field.name)\"\r\n            ></v-textarea>\r\n          </template>\r\n        </v-form>\r\n        <v-alert\r\n          v-if=\"generalError\"\r\n          type=\"error\"\r\n          class=\"mt-4\"\r\n        >\r\n          {{ generalError }}\r\n        </v-alert>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n        <v-btn color=\"blue darken-1\" text @click=\"submitForm\" :loading=\"isSubmitting\" :disabled=\"!isFormValid\">Save</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch, onMounted } from 'vue'\r\nimport { useForm } from 'vee-validate'\r\nimport * as yup from 'yup'\r\nimport { getTransactionFormStructure, addTransaction, updateTransaction } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'TransactionFormDialog',\r\n  props: {\r\n    modelValue: Boolean,\r\n    editItem: Object,\r\n  },\r\n  emits: ['update:modelValue', 'transaction-added', 'transaction-updated'],\r\n  setup(props, { emit }) {\r\n    const dialog = computed({\r\n      get: () => props.modelValue,\r\n      set: (value) => emit('update:modelValue', value)\r\n    })\r\n    const isEdit = computed(() => !!props.editItem)\r\n    const formFields = ref([])\r\n    const generalError = ref('')\r\n    const isSubmitting = ref(false)\r\n\r\n    const schema = computed(() => {\r\n      const schemaObj = {}\r\n      formFields.value.forEach(field => {\r\n        if (field.required) {\r\n          schemaObj[field.name] = yup.mixed().required(`${field.label} is required`)\r\n        } else {\r\n          schemaObj[field.name] = yup.mixed().nullable()\r\n        }\r\n\r\n        if (field.name === 'cash_flow') {\r\n          schemaObj[field.name] = yup.number().nullable().test(\r\n            'cash-flow-validation',\r\n            'Cash flow must be negative for cash-out transactions and positive for cash-in transactions',\r\n            function (value) {\r\n              const type = this.parent.type\r\n              if (value === null || value === undefined) return true\r\n              if (type === 'Cash out') return value < 0\r\n              if (type === 'Cash in') return value > 0\r\n              return true\r\n            }\r\n          )\r\n        }\r\n        if (field.name === 'price') {\r\n          schemaObj[field.name] = yup.number().nullable().positive('Price must be positive')\r\n        }\r\n        if (field.name === 'quantity') {\r\n          schemaObj[field.name] = yup.number().nullable().test(\r\n            'quantity-validation',\r\n            'Quantity must be positive for buy transactions and negative for sell transactions',\r\n            function (value) {\r\n              const type = this.parent.type\r\n              if (value === null || value === undefined) return true\r\n              if (type === 'Buy') return value > 0\r\n              if (type === 'Sell') return value < 0\r\n              return true\r\n            }\r\n          )\r\n        }\r\n        if (field.name === 'commission') {\r\n          schemaObj[field.name] = yup.number().nullable().negative('Commission must be negative')\r\n        }\r\n      })\r\n\r\n      // Add validation for security field\r\n      schemaObj.security = yup.mixed().test(\r\n        'security-validation',\r\n        'Security must not be selected for Cash in or Cash out transactions',\r\n        function (value) {\r\n          const type = this.parent.type\r\n          if (type === 'Cash in' || type === 'Cash out') {\r\n            return value === null || value === undefined || value === ''\r\n          }\r\n          return true\r\n        }\r\n      )\r\n\r\n      return yup.object().shape(schemaObj)\r\n    })\r\n\r\n    const { handleSubmit, errors, resetForm, values: form, setValues, setFieldError, setFieldValue } = useForm({\r\n      validationSchema: schema,\r\n      validateOnChange: true\r\n    })\r\n\r\n    const isFormValid = computed(() => {\r\n      return Object.keys(errors.value).length === 0 && Object.keys(form).some(key => form[key] !== '')\r\n    })\r\n\r\n    const fetchFormStructure = async () => {\r\n      try {\r\n        const response = await getTransactionFormStructure()\r\n        formFields.value = response.fields\r\n        if (props.editItem) {\r\n          populateFormWithEditItem()\r\n        } else {\r\n          initializeForm()\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching form structure:', error)\r\n        generalError.value = 'Failed to load form structure. Please try again.'\r\n      }\r\n    }\r\n\r\n    const initializeForm = () => {\r\n      if (formFields.value && formFields.value.length > 0) {\r\n        const initialValues = formFields.value.reduce((acc, field) => {\r\n          if (field.type === 'select') {\r\n            acc[field.name] = field.choices && field.choices.length > 0 ? field.choices[0].value : null\r\n          } else if (field.type === 'number') {\r\n            acc[field.name] = null\r\n          } else {\r\n            acc[field.name] = ''\r\n          }\r\n          return acc\r\n        }, {})\r\n        setValues(initialValues)\r\n      } else {\r\n        console.warn('Form fields not available for initialization')\r\n      }\r\n    }\r\n\r\n    const populateFormWithEditItem = () => {\r\n      if (props.editItem && formFields.value.length > 0) {\r\n        const formattedValues = { ...props.editItem }\r\n        formFields.value.forEach(field => {\r\n          if (field.type === 'select' && formattedValues[field.name]) {\r\n            if (typeof formattedValues[field.name] === 'object') {\r\n              formattedValues[field.name] = String(formattedValues[field.name].id)\r\n            } else {\r\n              formattedValues[field.name] = String(formattedValues[field.name])\r\n            }\r\n            \r\n            // Verify that the value exists in the choices\r\n            const isValidChoice = field.choices.some(choice => choice.value === formattedValues[field.name])\r\n            if (!isValidChoice) {\r\n              console.warn(`Invalid value for ${field.name}: ${formattedValues[field.name]}`)\r\n              formattedValues[field.name] = ''  // or set to a default value\r\n            }\r\n          }\r\n        })\r\n        setValues(formattedValues)\r\n      }\r\n    }\r\n\r\n    const submitForm = handleSubmit(async (values) => {\r\n      // Validate all fields\r\n      const validationResult = await validate()\r\n      if (!validationResult.valid) {\r\n        return\r\n      }\r\n\r\n      isSubmitting.value = true\r\n      generalError.value = ''\r\n\r\n      try {\r\n        let response\r\n        if (isEdit.value) {\r\n          response = await updateTransaction(values.id, values)\r\n          emit('transaction-updated', response)\r\n        } else {\r\n          response = await addTransaction(values)\r\n          emit('transaction-added', response)\r\n        }\r\n        closeDialog()\r\n      } catch (error) {\r\n        console.error('Error submitting transaction:', error)\r\n        if (error && typeof error === 'object') {\r\n          Object.entries(error).forEach(([key, value]) => {\r\n            if (key === '__all__') {\r\n              generalError.value = Array.isArray(value) ? value[0] : value\r\n            } else {\r\n              setFieldError(key, Array.isArray(value) ? value[0] : value)\r\n            }\r\n          })\r\n        } else {\r\n          generalError.value = error.message || 'An unexpected error occurred. Please try again.'\r\n        }\r\n      } finally {\r\n        isSubmitting.value = false\r\n      }\r\n    })\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      resetForm()\r\n      generalError.value = ''\r\n    }\r\n\r\n    const getSelectItems = (field) => {\r\n      if (field.name === 'broker' || field.name === 'security') {\r\n        return [{ value: '', text: 'None' }, ...field.choices]\r\n      }\r\n      return field.choices\r\n    }\r\n\r\n    const clearFieldError = (fieldName) => {\r\n      setFieldError(fieldName, '')\r\n      // If clearing security field, also clear related fields\r\n      if (fieldName === 'type') {\r\n        const type = form.value.type\r\n        if (type === 'Cash in' || type === 'Cash out') {\r\n          setFieldValue('security', '')\r\n          setFieldValue('quantity', null)\r\n          setFieldValue('price', null)\r\n        }\r\n      }\r\n    }\r\n\r\n    const isCashTransaction = computed(() => {\r\n      return form.value.type === 'Cash in' || form.value.type === 'Cash out'\r\n    })\r\n\r\n    watch(() => props.modelValue, (newValue) => {\r\n      if (newValue) {\r\n        fetchFormStructure()\r\n      }\r\n    })\r\n\r\n    onMounted(fetchFormStructure)\r\n\r\n    return {\r\n      dialog,\r\n      isEdit,\r\n      form,\r\n      formFields,\r\n      errors,\r\n      generalError,\r\n      isSubmitting,\r\n      isFormValid,\r\n      closeDialog,\r\n      submitForm,\r\n      getSelectItems,\r\n      clearFieldError,\r\n      isCashTransaction,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":";;EAIcA,KAAK,EAAC;AAAS;;;;;;;;;;;;;;uBAH3BC,YAAA,CAoEWC,mBAAA;IArEbC,UAAA,EACqBC,MAAA,CAAAC,MAAM;IAD3B,uBAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IACqBH,MAAA,CAAAC,MAAM,GAAAE,MAAA;IAAE,WAAS,EAAC;;IADvCC,OAAA,EAAAC,QAAA,CAEI,MAkES,CAlETC,YAAA,CAkESC,iBAAA;MApEbH,OAAA,EAAAC,QAAA,CAGM,MAEe,CAFfC,YAAA,CAEeE,uBAAA;QALrBJ,OAAA,EAAAC,QAAA,CAIQ,MAAkF,CAAlFI,mBAAA,CAAkF,QAAlFC,UAAkF,EAAAC,gBAAA,CAAzDX,MAAA,CAAAY,MAAM,0D;QAJvCC,CAAA;UAMMP,YAAA,CAwDcQ,sBAAA;QA9DpBV,OAAA,EAAAC,QAAA,CAOQ,MA+