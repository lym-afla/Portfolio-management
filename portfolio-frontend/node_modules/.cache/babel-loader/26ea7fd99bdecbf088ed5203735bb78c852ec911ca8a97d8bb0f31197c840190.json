{"ast":null,"code":"import { ref, computed, watch, inject } from 'vue';\nimport { addPrice, updatePrice } from '@/services/api';\nexport default {\n  name: 'PriceFormDialog',\n  props: {\n    modelValue: Boolean,\n    editItem: Object,\n    securities: Array\n  },\n  emits: ['update:modelValue', 'price-added', 'price-updated'],\n  setup(props, {\n    emit\n  }) {\n    const dialog = computed({\n      get: () => props.modelValue,\n      set: value => emit('update:modelValue', value)\n    });\n    const isEdit = computed(() => !!props.editItem);\n    const form = ref({\n      date: '',\n      security: null,\n      price: null\n    });\n    const errorMessages = ref({\n      date: [],\n      security: [],\n      price: []\n    });\n    const generalError = ref('');\n    const isSubmitting = ref(false);\n    const showError = inject('showError');\n    watch(() => props.editItem, newValue => {\n      if (newValue) {\n        form.value = {\n          ...newValue\n        };\n      } else {\n        form.value = {\n          date: '',\n          security: null,\n          price: null\n        };\n      }\n    }, {\n      immediate: true\n    });\n    const closeDialog = () => {\n      dialog.value = false;\n      form.value = {\n        date: '',\n        security: null,\n        price: null\n      };\n      errorMessages.value = {\n        date: [],\n        security: [],\n        price: []\n      };\n      generalError.value = '';\n    };\n    const submitForm = async () => {\n      isSubmitting.value = true;\n      errorMessages.value = {\n        date: [],\n        security: [],\n        price: []\n      };\n      generalError.value = '';\n      try {\n        let response;\n        if (isEdit.value) {\n          response = await updatePrice(props.editItem.id, form.value);\n          emit('price-updated', response);\n        } else {\n          response = await addPrice(form.value);\n          emit('price-added', response);\n        }\n        closeDialog();\n      } catch (error) {\n        console.error('Error submitting price:', error);\n        if (error.response && error.response.data) {\n          const {\n            errors\n          } = error.response.data;\n          if (errors) {\n            Object.keys(errors).forEach(key => {\n              if (key === '__all__') {\n                generalError.value = errors[key][0];\n              } else {\n                errorMessages.value[key] = errors[key];\n              }\n            });\n          } else {\n            generalError.value = 'An unexpected error occurred. Please try again.';\n          }\n        } else {\n          generalError.value = error.message || 'An unexpected error occurred. Please try again.';\n        }\n        showError(generalError.value || 'Failed to submit price. Please check the form for errors.');\n      } finally {\n        isSubmitting.value = false;\n      }\n    };\n    return {\n      dialog,\n      isEdit,\n      form,\n      errorMessages,\n      generalError,\n      isSubmitting,\n      closeDialog,\n      submitForm\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","inject","addPrice","updatePrice","name","props","modelValue","Boolean","editItem","Object","securities","Array","emits","setup","emit","dialog","get","set","value","isEdit","form","date","security","price","errorMessages","generalError","isSubmitting","showError","newValue","immediate","closeDialog","submitForm","response","id","error","console","data","errors","keys","forEach","key","message"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\PriceFormDialog.vue"],"sourcesContent":["<template>\r\n    <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n        <v-card>\r\n        <v-card-title>\r\n            <span class=\"text-h5\">{{ isEdit ? 'Edit Price' : 'Add Price' }}</span>\r\n        </v-card-title>\r\n        <v-card-text>\r\n            <v-form @submit.prevent=\"submitForm\">\r\n            <v-text-field\r\n                v-model=\"form.date\"\r\n                label=\"Date\"\r\n                type=\"date\"\r\n                required\r\n                :error-messages=\"errorMessages.date\"\r\n            ></v-text-field>\r\n            <v-select\r\n                v-model=\"form.security\"\r\n                :items=\"securities\"\r\n                item-title=\"name\"\r\n                item-value=\"id\"\r\n                label=\"Security\"\r\n                required\r\n                :error-messages=\"errorMessages.security\"\r\n            ></v-select>\r\n            <v-text-field\r\n                v-model=\"form.price\"\r\n                label=\"Price\"\r\n                type=\"number\"\r\n                step=\"0.01\"\r\n                required\r\n                :error-messages=\"errorMessages.price\"\r\n            ></v-text-field>\r\n            </v-form>\r\n            <v-alert\r\n                v-if=\"generalError\"\r\n                type=\"error\"\r\n                class=\"mt-3\"\r\n            >\r\n                {{ generalError }}\r\n            </v-alert>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n            <v-spacer></v-spacer>\r\n            <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n            <v-btn color=\"blue darken-1\" text @click=\"submitForm\" :loading=\"isSubmitting\">Save</v-btn>\r\n        </v-card-actions>\r\n        </v-card>\r\n    </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch, inject } from 'vue'\r\nimport { addPrice, updatePrice } from '@/services/api'\r\n\r\nexport default {\r\n    name: 'PriceFormDialog',\r\n    props: {\r\n        modelValue: Boolean,\r\n        editItem: Object,\r\n        securities: Array\r\n    },\r\n    emits: ['update:modelValue', 'price-added', 'price-updated'],\r\n    setup(props, { emit }) {\r\n        const dialog = computed({\r\n            get: () => props.modelValue,\r\n            set: (value) => emit('update:modelValue', value)\r\n        })\r\n        const isEdit = computed(() => !!props.editItem)\r\n        const form = ref({\r\n            date: '',\r\n            security: null,\r\n            price: null,\r\n        })\r\n        const errorMessages = ref({\r\n            date: [],\r\n            security: [],\r\n            price: [],\r\n        })\r\n        const generalError = ref('')\r\n        const isSubmitting = ref(false)\r\n        const showError = inject('showError')\r\n\r\n        watch(() => props.editItem, (newValue) => {\r\n            if (newValue) {\r\n                form.value = { ...newValue }\r\n            } else {\r\n                form.value = { date: '', security: null, price: null }\r\n            }\r\n        }, { immediate: true })\r\n\r\n        const closeDialog = () => {\r\n            dialog.value = false\r\n            form.value = { date: '', security: null, price: null }\r\n            errorMessages.value = { date: [], security: [], price: [] }\r\n            generalError.value = ''\r\n        }\r\n\r\n        const submitForm = async () => {\r\n            isSubmitting.value = true\r\n            errorMessages.value = { date: [], security: [], price: [] }\r\n            generalError.value = ''\r\n\r\n            try {\r\n                let response\r\n                if (isEdit.value) {\r\n                    response = await updatePrice(props.editItem.id, form.value)\r\n                    emit('price-updated', response)\r\n                } else {\r\n                    response = await addPrice(form.value)\r\n                    emit('price-added', response)\r\n                }\r\n                closeDialog()\r\n            } catch (error) {\r\n                console.error('Error submitting price:', error)\r\n                if (error.response && error.response.data) {\r\n                    const { errors } = error.response.data\r\n                    if (errors) {\r\n                        Object.keys(errors).forEach(key => {\r\n                            if (key === '__all__') {\r\n                                generalError.value = errors[key][0]\r\n                            } else {\r\n                                errorMessages.value[key] = errors[key]\r\n                            }\r\n                        })\r\n                    } else {\r\n                        generalError.value = 'An unexpected error occurred. Please try again.'\r\n                    }\r\n                } else {\r\n                    generalError.value = error.message || 'An unexpected error occurred. Please try again.'\r\n                }\r\n                showError(generalError.value || 'Failed to submit price. Please check the form for errors.')\r\n            } finally {\r\n                isSubmitting.value = false\r\n            }\r\n        }\r\n\r\n        return {\r\n            dialog,\r\n            isEdit,\r\n            form,\r\n            errorMessages,\r\n            generalError,\r\n            isSubmitting,\r\n            closeDialog,\r\n            submitForm,\r\n        }\r\n    }\r\n}\r\n</script>"],"mappings":"AAmDA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAK,EAAEC,MAAK,QAAS,KAAI;AACjD,SAASC,QAAQ,EAAEC,WAAU,QAAS,gBAAe;AAErD,eAAe;EACXC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE;IACHC,UAAU,EAAEC,OAAO;IACnBC,QAAQ,EAAEC,MAAM;IAChBC,UAAU,EAAEC;EAChB,CAAC;EACDC,KAAK,EAAE,CAAC,mBAAmB,EAAE,aAAa,EAAE,eAAe,CAAC;EAC5DC,KAAKA,CAACR,KAAK,EAAE;IAAES;EAAK,CAAC,EAAE;IACnB,MAAMC,MAAK,GAAIhB,QAAQ,CAAC;MACpBiB,GAAG,EAAEA,CAAA,KAAMX,KAAK,CAACC,UAAU;MAC3BW,GAAG,EAAGC,KAAK,IAAKJ,IAAI,CAAC,mBAAmB,EAAEI,KAAK;IACnD,CAAC;IACD,MAAMC,MAAK,GAAIpB,QAAQ,CAAC,MAAM,CAAC,CAACM,KAAK,CAACG,QAAQ;IAC9C,MAAMY,IAAG,GAAItB,GAAG,CAAC;MACbuB,IAAI,EAAE,EAAE;MACRC,QAAQ,EAAE,IAAI;MACdC,KAAK,EAAE;IACX,CAAC;IACD,MAAMC,aAAY,GAAI1B,GAAG,CAAC;MACtBuB,IAAI,EAAE,EAAE;MACRC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE;IACX,CAAC;IACD,MAAME,YAAW,GAAI3B,GAAG,CAAC,EAAE;IAC3B,MAAM4B,YAAW,GAAI5B,GAAG,CAAC,KAAK;IAC9B,MAAM6B,SAAQ,GAAI1B,