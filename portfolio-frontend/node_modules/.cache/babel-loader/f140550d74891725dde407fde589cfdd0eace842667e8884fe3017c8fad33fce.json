{"ast":null,"code":"import { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport RegisterForm from '@/components/RegisterForm.vue';\nexport default {\n  name: 'RegisterPage',\n  components: {\n    RegisterForm\n  },\n  setup() {\n    const loading = ref(false);\n    const successMessage = ref('');\n    const showSuccessDialog = ref(false);\n    const router = useRouter();\n    const registerForm = ref(null);\n    const handleRegister = async credentials => {\n      console.log('Handling registration with credentials:', credentials);\n      loading.value = true;\n      try {\n        await register(credentials.username, credentials.email, credentials.password);\n        successMessage.value = 'Registration successful. You can now log in to your account.';\n        showSuccessDialog.value = true;\n      } catch (err) {\n        console.error('Registration error:', err);\n        if (typeof err === 'object' && err !== null) {\n          if (err.non_field_errors) {\n            registerForm.value.setErrors({\n              general: err.non_field_errors\n            });\n          } else {\n            registerForm.value.setErrors(err);\n          }\n        } else {\n          registerForm.value.setErrors({\n            general: 'An error occurred during registration.'\n          });\n        }\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      loading,\n      handleRegister,\n      registerForm\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","useStore","RegisterForm","name","components","setup","loading","successMessage","showSuccessDialog","router","registerForm","handleRegister","credentials","console","log","value","register","username","email","password","err","error","non_field_errors","setErrors","general"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\RegisterPage.vue"],"sourcesContent":["<template>\r\n  <v-container class=\"fill-height\" fluid>\r\n    <v-row align=\"center\" justify=\"center\">\r\n      <v-col cols=\"12\" sm=\"8\" md=\"4\">\r\n        <v-card class=\"pa-4\">\r\n          <v-card-title class=\"headline\">Register</v-card-title>\r\n          <v-card-text>\r\n            <RegisterForm \r\n              ref=\"registerForm\"\r\n              @register=\"handleRegister\" \r\n              :loading=\"loading\" \r\n            />\r\n          </v-card-text>\r\n          <v-card-actions>\r\n            <v-spacer></v-spacer>\r\n            <span>Already have an account? <router-link to=\"/login\">Login</router-link></span>\r\n          </v-card-actions>\r\n        </v-card>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <!-- Success Dialog -->\r\n    <v-dialog v-model=\"showSuccessDialog\" max-width=\"400\">\r\n      <v-card>\r\n        <v-card-title class=\"headline\">Registration Successful</v-card-title>\r\n        <v-card-text>\r\n          {{ successMessage }}\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"primary\" text @click=\"redirectToLogin\">\r\n            Go to Login\r\n          </v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport RegisterForm from '@/components/RegisterForm.vue'\r\n\r\nexport default {\r\n  name: 'RegisterPage',\r\n  components: {\r\n    RegisterForm\r\n  },\r\n  setup() {\r\n    const loading = ref(false)\r\n    const successMessage = ref('')\r\n    const showSuccessDialog = ref(false)\r\n    const router = useRouter()\r\n    const registerForm = ref(null)\r\n\r\n    const handleRegister = async (credentials) => {\r\n      console.log('Handling registration with credentials:', credentials)\r\n      loading.value = true\r\n\r\n      try {\r\n        await register(credentials.username, credentials.email, credentials.password)\r\n        successMessage.value = 'Registration successful. You can now log in to your account.'\r\n        showSuccessDialog.value = true\r\n      } catch (err) {\r\n        console.error('Registration error:', err)\r\n        if (typeof err === 'object' && err !== null) {\r\n          if (err.non_field_errors) {\r\n            registerForm.value.setErrors({ general: err.non_field_errors })\r\n          } else {\r\n            registerForm.value.setErrors(err)\r\n          }\r\n        } else {\r\n          registerForm.value.setErrors({ general: 'An error occurred during registration.' })\r\n        }\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    return { loading, handleRegister, registerForm }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-card-actions a {\r\n  text-decoration: none;\r\n  color: #1976D2;\r\n}\r\n</style>"],"mappings":"AAwCA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,YAAW,MAAO,+BAA8B;AAEvD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIP,GAAG,CAAC,KAAK;IACzB,MAAMQ,cAAa,GAAIR,GAAG,CAAC,EAAE;IAC7B,MAAMS,iBAAgB,GAAIT,GAAG,CAAC,KAAK;IACnC,MAAMU,MAAK,GAAIT,SAAS,CAAC;IACzB,MAAMU,YAAW,GAAIX,GAAG,CAAC,IAAI;IAE7B,MAAMY,cAAa,GAAI,MAAOC,WAAW,IAAK;MAC5CC,OAAO,CAACC,GAAG,CAAC,yCAAyC,EAAEF,WAAW;MAClEN,OAAO,CAACS,KAAI,GAAI,IAAG;MAEnB,IAAI;QACF,MAAMC,QAAQ,CAACJ,WAAW,CAACK,QAAQ,EAAEL,WAAW,CAACM,KAAK,EAAEN,WAAW,CAACO,QAAQ;QAC5EZ,cAAc,CAACQ,KAAI,GAAI,8DAA6D;QACpFP,iBAAiB,CAACO,KAAI,GAAI,IAAG;MAC/B,EAAE,OAAOK,GAAG,EAAE;QACZP,OAAO,CAACQ,KAAK,CAAC,qBAAqB,EAAED,GAAG;QACxC,IAAI,OAAOA,GAAE,KAAM,QAAO,IAAKA,GAAE,KAAM,IAAI,EAAE;UAC3C,IAAIA,GAAG,CAACE,gBAAgB,EAAE;YACxBZ,YAAY,CAACK,KAAK,CAACQ,SAAS,CAAC;cAAEC,OAAO,EAAEJ,GAAG,CAACE;YAAiB,CAAC;UAChE,OAAO;YACLZ,YAAY,CAACK,KAAK,CAACQ,SAAS,CAACH,GAAG;UAClC;QACF,OAAO;UACLV,YAAY,CAACK,KAAK,CAACQ,SAAS,CAAC;YAAEC,OAAO,EAAE;UAAyC,CAAC;QACpF;MACF,UAAU;QACRlB,OAAO,C