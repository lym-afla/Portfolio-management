{"ast":null,"code":"import { ref, reactive, onMounted, watch } from 'vue';\nimport { getDashboardSettings, updateDashboardSettings } from '@/services/api';\nexport default {\n  setup() {\n    const dialog = ref(false);\n    const form = ref(null);\n    const errors = ref({});\n    const currencyChoices = ref([]);\n    const formData = reactive({\n      default_currency: '',\n      digits: 0,\n      table_date: ''\n    });\n    const fetchSettingsData = async () => {\n      try {\n        const response = await getDashboardSettings();\n        formData.default_currency = response.default_currency;\n        formData.digits = response.digits;\n        formData.table_date = response.table_date;\n        currencyChoices.value = response.currency_choices;\n      } catch (error) {\n        console.error('Failed to fetch settings data:', error);\n      }\n    };\n    const openDialog = () => {\n      dialog.value = true;\n      fetchSettingsData();\n    };\n    const closeDialog = () => {\n      dialog.value = false;\n      clearErrors();\n    };\n    const clearErrors = () => {\n      errors.value = {};\n    };\n    const saveSettings = async () => {\n      try {\n        clearErrors();\n        const response = await updateDashboardSettings(formData);\n        console.log('Save settings response:', response); // Debug log\n        if (response.success) {\n          closeDialog();\n          window.location.reload();\n        } else {\n          handleErrors(response.errors);\n        }\n      } catch (error) {\n        console.error('Failed to save settings:', error);\n        if (error.response && error.response.data && error.response.data.errors) {\n          handleErrors(error.response.data.errors);\n        } else {\n          errors.value = {\n            general: ['An unexpected error occurred. Please try again.']\n          };\n        }\n      }\n    };\n    const handleErrors = errorData => {\n      console.log('Handling errors:', errorData); // Debug log\n      Object.keys(errorData).forEach(field => {\n        if (Array.isArray(errorData[field])) {\n          errors.value[field] = errorData[field];\n        } else {\n          errors.value[field] = [errorData[field]];\n        }\n      });\n      console.log('Errors after handling:', errors.value); // Debug log\n    };\n\n    // Watch for changes in the errors object\n    watch(errors, newErrors => {\n      console.log('Errors changed:', newErrors); // Debug log\n    }, {\n      deep: true\n    });\n    onMounted(fetchSettingsData);\n    return {\n      dialog,\n      formData,\n      currencyChoices,\n      form,\n      errors,\n      openDialog,\n      closeDialog,\n      saveSettings\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","watch","getDashboardSettings","updateDashboardSettings","setup","dialog","form","errors","currencyChoices","formData","default_currency","digits","table_date","fetchSettingsData","response","value","currency_choices","error","console","openDialog","closeDialog","clearErrors","saveSettings","log","success","window","location","reload","handleErrors","data","general","errorData","Object","keys","forEach","field","Array","isArray","newErrors","deep"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\SettingsDialog.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-btn icon @click=\"openDialog\">\r\n      <v-icon>mdi-cog</v-icon>\r\n    </v-btn>\r\n\r\n    <v-dialog v-model=\"dialog\" max-width=\"400px\" persistent>\r\n      <v-card>\r\n        <v-card-title class=\"text-h5\">\r\n          Settings\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"saveSettings\" ref=\"form\">\r\n            <v-select\r\n              v-model=\"formData.default_currency\"\r\n              :items=\"currencyChoices\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              label=\"Currency\"\r\n              :error-messages=\"errors.default_currency\"\r\n            ></v-select>\r\n            <v-text-field\r\n              v-model.number=\"formData.digits\"\r\n              label=\"Number of Digits\"\r\n              type=\"number\"\r\n              :error-messages=\"errors.digits\"\r\n            ></v-text-field>\r\n            <v-text-field\r\n              v-model=\"formData.table_date\"\r\n              label=\"Date\"\r\n              type=\"date\"\r\n              :error-messages=\"errors.table_date\"\r\n            ></v-text-field>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"closeDialog\">Close</v-btn>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"saveSettings\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive, onMounted, watch } from 'vue'\r\nimport { getDashboardSettings, updateDashboardSettings } from '@/services/api'\r\n\r\nexport default {\r\n  setup() {\r\n    const dialog = ref(false)\r\n    const form = ref(null)\r\n    const errors = ref({})\r\n    const currencyChoices = ref([])\r\n\r\n    const formData = reactive({\r\n      default_currency: '',\r\n      digits: 0,\r\n      table_date: '',\r\n    })\r\n\r\n    const fetchSettingsData = async () => {\r\n      try {\r\n        const response = await getDashboardSettings()\r\n        formData.default_currency = response.default_currency\r\n        formData.digits = response.digits\r\n        formData.table_date = response.table_date\r\n        currencyChoices.value = response.currency_choices\r\n      } catch (error) {\r\n        console.error('Failed to fetch settings data:', error)\r\n      }\r\n    }\r\n\r\n    const openDialog = () => {\r\n      dialog.value = true\r\n      fetchSettingsData()\r\n    }\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      clearErrors()\r\n    }\r\n\r\n    const clearErrors = () => {\r\n      errors.value = {}\r\n    }\r\n\r\n    const saveSettings = async () => {\r\n      try {\r\n        clearErrors()\r\n        const response = await updateDashboardSettings(formData)\r\n        console.log('Save settings response:', response)  // Debug log\r\n        if (response.success) {\r\n          closeDialog()\r\n          window.location.reload()\r\n        } else {\r\n          handleErrors(response.errors)\r\n        }\r\n      } catch (error) {\r\n        console.error('Failed to save settings:', error)\r\n        if (error.response && error.response.data && error.response.data.errors) {\r\n          handleErrors(error.response.data.errors)\r\n        } else {\r\n          errors.value = { general: ['An unexpected error occurred. Please try again.'] }\r\n        }\r\n      }\r\n    }\r\n\r\n    const handleErrors = (errorData) => {\r\n      console.log('Handling errors:', errorData)  // Debug log\r\n      Object.keys(errorData).forEach(field => {\r\n        if (Array.isArray(errorData[field])) {\r\n          errors.value[field] = errorData[field]\r\n        } else {\r\n          errors.value[field] = [errorData[field]]\r\n        }\r\n      })\r\n      console.log('Errors after handling:', errors.value)  // Debug log\r\n    }\r\n\r\n    // Watch for changes in the errors object\r\n    watch(errors, (newErrors) => {\r\n      console.log('Errors changed:', newErrors)  // Debug log\r\n    }, { deep: true })\r\n\r\n    onMounted(fetchSettingsData)\r\n\r\n    return {\r\n      dialog,\r\n      formData,\r\n      currencyChoices,\r\n      form,\r\n      errors,\r\n      openDialog,\r\n      closeDialog,\r\n      saveSettings\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA8CA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,KAAI,QAAS,KAAI;AACpD,SAASC,oBAAoB,EAAEC,uBAAsB,QAAS,gBAAe;AAE7E,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIP,GAAG,CAAC,KAAK;IACxB,MAAMQ,IAAG,GAAIR,GAAG