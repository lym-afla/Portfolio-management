{"ast":null,"code":"import { ref, watch, computed, onMounted } from 'vue';\nimport { getAssetTypes, getBrokers, getSecurities, getPrices } from '@/services/api';\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue';\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue';\nimport debounce from 'lodash/debounce';\nexport default {\n  name: 'PricesPage',\n  components: {\n    AddSecurityButton,\n    AddPriceEntryButton\n  },\n  setup() {\n    const assetTypes = ref([]);\n    const brokers = ref([]);\n    const securities = ref([]);\n    const selectedAssetTypes = ref([]);\n    const selectedBroker = ref(null);\n    const selectedSecurities = ref([]);\n    const startDate = ref('');\n    const endDate = ref('');\n    const priceData = ref([]);\n    const loading = ref(false);\n    const totalItems = ref(0);\n    const itemsPerPage = ref(10);\n    const editDialog = ref(false);\n    const deleteDialog = ref(false);\n    const editedItem = ref({});\n    const deletedItem = ref({});\n    const headers = [{\n      title: 'Date',\n      key: 'date'\n    }, {\n      title: 'Security',\n      key: 'security__name'\n    }, {\n      title: 'Asset Type',\n      key: 'security__type'\n    }, {\n      title: 'Currency',\n      key: 'security__currency'\n    }, {\n      title: 'Price',\n      key: 'price'\n    }, {\n      title: 'Actions',\n      key: 'actions',\n      sortable: false\n    }];\n    const assetTypesAllSelected = computed(() => {\n      return selectedAssetTypes.value.length === assetTypes.value.length;\n    });\n    const assetTypesIndeterminate = computed(() => {\n      return selectedAssetTypes.value.length > 0 && !assetTypesAllSelected.value;\n    });\n    const securitiesAllSelected = computed(() => {\n      return selectedSecurities.value.length === securities.value.length;\n    });\n    const securitiesIndeterminate = computed(() => {\n      return selectedSecurities.value.length > 0 && !securitiesAllSelected.value;\n    });\n    const toggleSelectAllAssetTypes = () => {\n      if (assetTypesAllSelected.value) {\n        selectedAssetTypes.value = [];\n      } else {\n        selectedAssetTypes.value = assetTypes.value.map(item => item.value);\n      }\n    };\n    const toggleSelectAllSecurities = () => {\n      if (securitiesAllSelected.value) {\n        selectedSecurities.value = [];\n      } else {\n        selectedSecurities.value = securities.value.map(item => item.id);\n      }\n    };\n    onMounted(async () => {\n      try {\n        const [assetTypesData, brokersData, securitiesData] = await Promise.all([getAssetTypes(), getBrokers(), getSecurities()]);\n        console.log('brokersData', brokersData);\n        console.log('securitiesData', securitiesData);\n        console.log('assetTypesData', assetTypesData);\n        assetTypes.value = assetTypesData;\n        brokers.value = brokersData;\n        securities.value = securitiesData;\n        await fetchPriceData();\n      } catch (error) {\n        console.error('Error fetching initial data:', error);\n      }\n    });\n    const fetchSecurities = debounce(async () => {\n      try {\n        securities.value = await getSecurities(selectedAssetTypes.value, selectedBroker.value);\n        // Reset securities if they are no longer in the list\n        selectedSecurities.value = selectedSecurities.value.filter(id => securities.value.some(security => security.id === id));\n      } catch (error) {\n        console.error('Error fetching securities:', error);\n      }\n    }, 300); // 300ms debounce\n\n    watch([selectedAssetTypes, selectedBroker], () => {\n      fetchSecurities();\n    });\n    const fetchPriceData = async () => {\n      loading.value = true;\n      try {\n        const response = await getPrices({\n          asset_types: selectedAssetTypes.value,\n          broker: selectedBroker.value,\n          securities: selectedSecurities.value,\n          start_date: startDate.value,\n          end_date: endDate.value,\n          page: 1,\n          items_per_page: itemsPerPage.value\n        });\n        priceData.value = response.results;\n        totalItems.value = response.count;\n      } catch (error) {\n        console.error('Error fetching price data:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const applyFilters = () => {\n      fetchPriceData();\n    };\n    const showImportModal = () => {\n      // TODO: Implement import modal logic\n      console.log('Showing import modal');\n    };\n    const handleTableUpdate = options => {\n      console.log('Table options updated:', options);\n      // TODO: Implement server-side sorting and pagination\n      fetchPriceData();\n    };\n    const editPrice = item => {\n      editedItem.value = {\n        ...item\n      };\n      editDialog.value = true;\n    };\n    const closeEditDialog = () => {\n      editDialog.value = false;\n      editedItem.value = {};\n    };\n    const updatePrice = async () => {\n      // TODO: Implement actual API call to update price\n      console.log('Updating price:', editedItem.value);\n      closeEditDialog();\n      await fetchPriceData();\n    };\n    const deletePrice = item => {\n      deletedItem.value = item;\n      deleteDialog.value = true;\n    };\n    const closeDeleteDialog = () => {\n      deleteDialog.value = false;\n      deletedItem.value = {};\n    };\n    const confirmDelete = async () => {\n      // TODO: Implement actual API call to delete price\n      console.log('Deleting price:', deletedItem.value);\n      closeDeleteDialog();\n      await fetchPriceData();\n    };\n    return {\n      assetTypes,\n      brokers,\n      securities,\n      selectedAssetTypes,\n      selectedBroker,\n      selectedSecurities,\n      startDate,\n      endDate,\n      applyFilters,\n      showImportModal,\n      headers,\n      priceData,\n      loading,\n      totalItems,\n      itemsPerPage,\n      editDialog,\n      deleteDialog,\n      editedItem,\n      handleTableUpdate,\n      editPrice,\n      closeEditDialog,\n      updatePrice,\n      deletePrice,\n      closeDeleteDialog,\n      confirmDelete,\n      assetTypesAllSelected,\n      assetTypesIndeterminate,\n      securitiesAllSelected,\n      securitiesIndeterminate,\n      toggleSelectAllAssetTypes,\n      toggleSelectAllSecurities\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","computed","onMounted","getAssetTypes","getBrokers","getSecurities","getPrices","AddSecurityButton","AddPriceEntryButton","debounce","name","components","setup","assetTypes","brokers","securities","selectedAssetTypes","selectedBroker","selectedSecurities","startDate","endDate","priceData","loading","totalItems","itemsPerPage","editDialog","deleteDialog","editedItem","deletedItem","headers","title","key","sortable","assetTypesAllSelected","value","length","assetTypesIndeterminate","securitiesAllSelected","securitiesIndeterminate","toggleSelectAllAssetTypes","map","item","toggleSelectAllSecurities","id","assetTypesData","brokersData","securitiesData","Promise","all","console","log","fetchPriceData","error","fetchSecurities","filter","some","security","response","asset_types","broker","start_date","end_date","page","items_per_page","results","count","applyFilters","showImportModal","handleTableUpdate","options","editPrice","closeEditDialog","updatePrice","deletePrice","closeDeleteDialog","confirmDelete"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\PricesPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid>\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text class=\"pa-4\">\r\n        <v-row>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedAssetTypes\"\r\n              :items=\"assetTypes\"\r\n              label=\"Asset Types\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              multiple\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item\r\n                title=\"Select All\"\r\n                @click=\"toggleSelectAllAssetTypes\"\r\n                >\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"assetTypesAllSelected\"\r\n                      :indeterminate=\"assetTypesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 3\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 3\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedAssetTypes.length - 3 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedBroker\"\r\n              :items=\"brokers\"\r\n              label=\"Brokers\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              clearable\r\n            ></v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedSecurities\"\r\n              :items=\"securities\"\r\n              label=\"Securities\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              multiple\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item\r\n                title=\"Select All\"\r\n                @click=\"toggleSelectAllSecurities\"\r\n                >\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"securitiesAllSelected\"\r\n                      :indeterminate=\"securitiesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 1\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 1\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedSecurities.length - 1 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n        </v-row>\r\n        <v-row class=\"mt-n6\">\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-text-field\r\n              v-model=\"startDate\"\r\n              label=\"Start Date\"\r\n              type=\"date\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-text-field\r\n              v-model=\"endDate\"\r\n              label=\"End Date\"\r\n              type=\"date\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\" class=\"d-flex align-center\">\r\n            <v-btn color=\"primary\" @click=\"applyFilters\" block>\r\n              Apply Filters\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\" justify=\"space-between\">\r\n          <v-col cols=\"auto\">\r\n            <v-row>\r\n              <v-col cols=\"auto\">\r\n                <AddSecurityButton />\r\n              </v-col>\r\n              <v-col cols=\"auto\">\r\n                <AddPriceEntryButton />\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n          <v-col cols=\"auto\">\r\n            <v-btn color=\"success\" @click=\"showImportModal\">\r\n              Import Prices\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card>\r\n      <v-data-table\r\n        :headers=\"headers\"\r\n        :items=\"priceData\"\r\n        :loading=\"loading\"\r\n        :items-per-page=\"itemsPerPage\"\r\n        :server-items-length=\"totalItems\"\r\n        @update:options=\"handleTableUpdate\"\r\n      >\r\n        <template #[`item.price`]=\"{ item }\">\r\n          <span class=\"editable\" @click=\"editPrice(item)\">{{ item.price.toFixed(2) }}</span>\r\n        </template>\r\n        <template #[`item.actions`]=\"{ item }\">\r\n          <v-btn small color=\"primary\" class=\"mr-2\" @click=\"editPrice(item)\">Edit</v-btn>\r\n          <v-btn small color=\"error\" @click=\"deletePrice(item)\">Delete</v-btn>\r\n        </template>\r\n      </v-data-table>\r\n    </v-card>\r\n\r\n    <v-dialog v-model=\"editDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Edit Price</v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"updatePrice\">\r\n            <v-text-field\r\n              v-model=\"editedItem.price\"\r\n              label=\"Price\"\r\n              type=\"number\"\r\n              step=\"0.01\"\r\n              required\r\n            ></v-text-field>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeEditDialog\">Cancel</v-btn>\r\n          <v-btn color=\"blue darken-1\" text @click=\"updatePrice\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n\r\n    <v-dialog v-model=\"deleteDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Delete Price Entry</v-card-title>\r\n        <v-card-text>Are you sure you want to delete this price entry?</v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeDeleteDialog\">Cancel</v-btn>\r\n          <v-btn color=\"red darken-1\" text @click=\"confirmDelete\">Delete</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch, computed, onMounted } from 'vue'\r\nimport { getAssetTypes, getBrokers, getSecurities, getPrices } from '@/services/api'\r\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue'\r\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue'\r\nimport debounce from 'lodash/debounce'\r\n\r\nexport default {\r\n  name: 'PricesPage',\r\n  components: {\r\n    AddSecurityButton,\r\n    AddPriceEntryButton,\r\n  },\r\n  setup() {\r\n    const assetTypes = ref([])\r\n    const brokers = ref([])\r\n    const securities = ref([])\r\n    const selectedAssetTypes = ref([])\r\n    const selectedBroker = ref(null)\r\n    const selectedSecurities = ref([])\r\n    const startDate = ref('')\r\n    const endDate = ref('')\r\n    const priceData = ref([])\r\n    const loading = ref(false)\r\n    const totalItems = ref(0)\r\n    const itemsPerPage = ref(10)\r\n    const editDialog = ref(false)\r\n    const deleteDialog = ref(false)\r\n    const editedItem = ref({})\r\n    const deletedItem = ref({})\r\n\r\n    const headers = [\r\n      { title: 'Date', key: 'date' },\r\n      { title: 'Security', key: 'security__name' },\r\n      { title: 'Asset Type', key: 'security__type' },\r\n      { title: 'Currency', key: 'security__currency' },\r\n      { title: 'Price', key: 'price' },\r\n      { title: 'Actions', key: 'actions', sortable: false },\r\n    ]\r\n\r\n    const assetTypesAllSelected = computed(() => {\r\n      return selectedAssetTypes.value.length === assetTypes.value.length\r\n    })\r\n\r\n    const assetTypesIndeterminate = computed(() => {\r\n      return selectedAssetTypes.value.length > 0 && !assetTypesAllSelected.value\r\n    })\r\n\r\n    const securitiesAllSelected = computed(() => {\r\n      return selectedSecurities.value.length === securities.value.length\r\n    })\r\n\r\n    const securitiesIndeterminate = computed(() => {\r\n      return selectedSecurities.value.length > 0 && !securitiesAllSelected.value\r\n    })\r\n\r\n    const toggleSelectAllAssetTypes = () => {\r\n      if (assetTypesAllSelected.value) {\r\n        selectedAssetTypes.value = []\r\n      } else {\r\n        selectedAssetTypes.value = assetTypes.value.map(item => item.value)\r\n      }\r\n    }\r\n\r\n    const toggleSelectAllSecurities = () => {\r\n      if (securitiesAllSelected.value) {\r\n        selectedSecurities.value = []\r\n      } else {\r\n        selectedSecurities.value = securities.value.map(item => item.id)\r\n      }\r\n    }\r\n\r\n    onMounted(async () => {\r\n      try {\r\n        const [assetTypesData, brokersData, securitiesData] = await Promise.all([\r\n          getAssetTypes(),\r\n          getBrokers(),\r\n          getSecurities(),\r\n        ])\r\n        console.log('brokersData', brokersData)\r\n        console.log('securitiesData', securitiesData)\r\n        console.log('assetTypesData', assetTypesData)\r\n        assetTypes.value = assetTypesData\r\n        brokers.value = brokersData\r\n        securities.value = securitiesData\r\n        await fetchPriceData()\r\n      } catch (error) {\r\n        console.error('Error fetching initial data:', error)\r\n      }\r\n    })\r\n\r\n    const fetchSecurities = debounce(async () => {\r\n      try {\r\n        securities.value = await getSecurities(selectedAssetTypes.value, selectedBroker.value)\r\n        // Reset securities if they are n