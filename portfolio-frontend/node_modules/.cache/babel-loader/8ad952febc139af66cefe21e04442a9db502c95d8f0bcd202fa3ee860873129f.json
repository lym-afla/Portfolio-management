{"ast":null,"code":"import { ref, computed, watch, onUnmounted } from 'vue';\nimport { analyzeFile, getBrokers, importTransactions } from '@/services/api';\nimport { useErrorHandler } from '@/composables/useErrorHandler';\nimport ProgressDialog from '@/components/dialogs/ProgressDialog.vue';\nimport SecurityMappingDialog from '@/components/dialogs/SecurityMappingDialog.vue';\nimport { useStore } from 'vuex';\nimport { useWebSocket } from '@/composables/useWebSocket';\nimport { useImportState } from '@/composables/useImportState';\nexport default {\n  __name: 'TransactionImportDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const dialog = ref(false);\n    const file = ref(null);\n    const isLoading = ref(false);\n    const isAnalyzed = ref(false);\n    const selectedBroker = ref(null);\n    const brokers = ref([]);\n    const fileId = ref(null);\n    const brokerIdentified = ref(false);\n    const identifiedBroker = ref(null);\n    const brokerIdentificationComplete = ref(false);\n    const showSuccessDialog = ref(false);\n    const importStats = ref({\n      totalTransactions: 0,\n      importedTransactions: 0,\n      skippedTransactions: 0,\n      newSecurities: 0,\n      unrecognizedSecurities: []\n    });\n    const unrecognizedSecurities = ref([]);\n    const securityMappings = ref({});\n    const showUnrecognizedSecuritiesDialog = ref(false);\n    const existingSecurities = ref([]);\n    const {\n      handleApiError\n    } = useErrorHandler();\n    const store = useStore();\n    const {\n      isConnected,\n      lastMessage,\n      sendMessage\n    } = useWebSocket('ws://localhost:8000/ws/transactions/');\n    const importState = useImportState();\n    const handleFileChange = event => {\n      file.value = event.target.files[0];\n      isAnalyzed.value = false;\n      brokerIdentified.value = false;\n      selectedBroker.value = null;\n      identifiedBroker.value = null;\n      brokerIdentificationComplete.value = false;\n      fileId.value = null;\n      console.log('File changed:', file.value);\n    };\n    const closeDialog = () => {\n      dialog.value = false;\n      resetDialogPartial();\n    };\n    const submitFile = async () => {\n      if (file.value) {\n        isLoading.value = true;\n        try {\n          const formData = new FormData();\n          formData.append('file', file.value);\n          console.log('Submitting file:', file.value);\n          const result = await analyzeFile(formData);\n          isAnalyzed.value = true;\n          fileId.value = result.fileId;\n          brokers.value = await getBrokers();\n          if (result.status === 'broker_identified') {\n            brokerIdentified.value = true;\n            identifiedBroker.value = result.identifiedBroker;\n            selectedBroker.value = result.identifiedBroker.id;\n          }\n        } catch (error) {\n          handleApiError(error);\n        } finally {\n          isLoading.value = false;\n          brokerIdentificationComplete.value = true;\n        }\n      } else {\n        console.error('No file selected');\n      }\n    };\n    const startImport = () => {\n      error.value = null; // Clear any previous errors\n      const token = store.state.accessToken;\n      const wsScheme = window.location.protocol === \"https:\" ? \"wss\" : \"ws\";\n      const wsUrl = `${wsScheme}://${window.location.hostname}:8000/ws/transactions/?token=${token}`;\n      console.log('Attempting to connect to WebSocket:', wsUrl);\n      sendMessage({\n        type: 'start_import',\n        file_id: fileId.value,\n        broker_id: selectedBroker.value\n      });\n    };\n    const handleWebSocketMessage = message => {\n      if (message.status === 'progress') {\n        importState.setProgress(message.progress);\n        importState.setState('importing', message.message);\n      } else if (message.status === 'security_mapping') {\n        importState.setSecurityToMap(message.security);\n      } else if (message.status === 'complete') {\n        importState.setState('complete', 'Import completed successfully');\n        handleImportSuccess(message.data);\n      } else if (message.error) {\n        importState.setState('error', message.error);\n      }\n    };\n    const handleSecurityMapped = securityId => {\n      sendMessage({\n        type: 'security_mapped',\n        security_id: securityId\n      });\n    };\n    const confirmSecurityMappings = async () => {\n      try {\n        const result = await importTransactions(fileId.value, selectedBroker.value, securityMappings.value);\n        handleImportSuccess(result);\n      } catch (error) {\n        handleApiError(error);\n      } finally {\n        showUnrecognizedSecuritiesDialog.value = false;\n      }\n    };\n    const createNewSecurity = async securityName => {\n      console.log('Creating new security:', securityName);\n      // Implement logic to create a new security\n      // This could open a new dialog or navigate to a new security creation page\n      // After creation, update the securityMappings\n    };\n    const handleImportSuccess = result => {\n      importStats.value = result.importResults;\n      showSuccessDialog.value = true;\n      emit('import-completed', result.importResults);\n    };\n    const closeSuccessDialog = () => {\n      showSuccessDialog.value = false;\n      resetDialogFull();\n      closeDialog();\n    };\n    const resetDialogPartial = () => {\n      file.value = null;\n      isAnalyzed.value = false;\n      brokerIdentified.value = false;\n      identifiedBroker.value = null;\n      brokerIdentificationComplete.value = false;\n      importState.setState('idle');\n    };\n    const resetDialogFull = () => {\n      resetDialogPartial();\n      fileId.value = null;\n      selectedBroker.value = null;\n    };\n    watch(lastMessage, message => {\n      if (message) {\n        handleWebSocketMessage(message);\n      }\n    });\n    onUnmounted(() => {\n      if (isConnected.value) {\n        sendMessage({\n          type: 'close'\n        });\n      }\n    });\n    watch(dialog, newValue => {\n      if (!newValue) {\n        resetDialogPartial();\n      }\n    });\n    const __returned__ = {\n      dialog,\n      file,\n      isLoading,\n      isAnalyzed,\n      selectedBroker,\n      brokers,\n      fileId,\n      brokerIdentified,\n      identifiedBroker,\n      brokerIdentificationComplete,\n      showSuccessDialog,\n      importStats,\n      unrecognizedSecurities,\n      securityMappings,\n      showUnrecognizedSecuritiesDialog,\n      existingSecurities,\n      handleApiError,\n      store,\n      isConnected,\n      lastMessage,\n      sendMessage,\n      importState,\n      handleFileChange,\n      closeDialog,\n      submitFile,\n      startImport,\n      handleWebSocketMessage,\n      handleSecurityMapped,\n      confirmSecurityMappings,\n      createNewSecurity,\n      handleImportSuccess,\n      closeSuccessDialog,\n      resetDialogPartial,\n      resetDialogFull,\n      ref,\n      computed,\n      watch,\n      onUnmounted,\n      get analyzeFile() {\n        return analyzeFile;\n      },\n      get getBrokers() {\n        return getBrokers;\n      },\n      get importTransactions() {\n        return importTransactions;\n      },\n      get useErrorHandler() {\n        return useErrorHandler;\n      },\n      ProgressDialog,\n      SecurityMappingDialog,\n      get useStore() {\n        return useStore;\n      },\n      get useWebSocket() {\n        return useWebSocket;\n      },\n      get useImportState() {\n        return useImportState;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","watch","onUnmounted","analyzeFile","getBrokers","importTransactions","useErrorHandler","ProgressDialog","SecurityMappingDialog","useStore","useWebSocket","useImportState","dialog","file","isLoading","isAnalyzed","selectedBroker","brokers","fileId","brokerIdentified","identifiedBroker","brokerIdentificationComplete","showSuccessDialog","importStats","totalTransactions","importedTransactions","skippedTransactions","newSecurities","unrecognizedSecurities","securityMappings","showUnrecognizedSecuritiesDialog","existingSecurities","handleApiError","store","isConnected","lastMessage","sendMessage","importState","handleFileChange","event","value","target","files","console","log","closeDialog","resetDialogPartial","submitFile","formData","FormData","append","result","status","id","error","startImport","token","state","accessToken","wsScheme","window","location","protocol","wsUrl","hostname","type","file_id","broker_id","handleWebSocketMessage","message","setProgress","progress","setState","setSecurityToMap","security","handleImportSuccess","data","handleSecurityMapped","securityId","security_id","confirmSecurityMappings","createNewSecurity","securityName","importResults","emit","closeSuccessDialog","resetDialogFull","newValue"],"sources":["D:/Programming/Portfolio-management/portfolio-frontend/src/components/dialogs/TransactionImportDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5\">Import Transactions</v-card-title>\r\n      <v-card-text>\r\n        <v-file-input\r\n          v-model=\"file\"\r\n          label=\"Select Excel or CSV file to import\"\r\n          accept=\".csv, .xlsx, .xls\"\r\n          :rules=\"[v => !!v || 'File is required']\"\r\n          @change=\"handleFileChange\"\r\n          :disabled=\"isAnalyzed\"\r\n        ></v-file-input>\r\n        <v-alert\r\n          v-if=\"isAnalyzed && brokerIdentificationComplete\"\r\n          :type=\"brokerIdentified ? 'success' : 'info'\"\r\n          class=\"mt-4 mb-4\"\r\n        >\r\n          {{ brokerIdentified \r\n            ? `Broker \"${identifiedBroker.name}\" was automatically identified. Please confirm or select a different broker.` \r\n            : 'Broker could not be automatically identified. Please select a broker below.' }}\r\n        </v-alert>\r\n        <v-autocomplete\r\n          v-if=\"isAnalyzed\"\r\n          v-model=\"selectedBroker\"\r\n          :items=\"brokers\"\r\n          item-title=\"name\"\r\n          item-value=\"id\"\r\n          label=\"Select Broker\"\r\n          class=\"mt-4\"\r\n        ></v-autocomplete>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n        <v-btn \r\n          v-if=\"!isAnalyzed\" \r\n          color=\"blue darken-1\" \r\n          text \r\n          @click=\"submitFile\" \r\n          :disabled=\"!file || isLoading\"\r\n          :loading=\"isLoading\"\r\n        >\r\n          Analyze File\r\n        </v-btn>\r\n        <v-btn\r\n          v-if=\"isAnalyzed\"\r\n          color=\"blue darken-1\"\r\n          text\r\n          @click=\"startImport\"\r\n          :disabled=\"!selectedBroker\"\r\n        >\r\n          Import Transactions\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n    <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n      {{ error }}\r\n    </v-alert>\r\n  </v-dialog>\r\n\r\n  <ProgressDialog\r\n    v-if=\"importState.isImporting || importState.isComplete || importState.isError\"\r\n    :progress=\"importState.progress\"\r\n    :message=\"importState.currentMessage\"\r\n    :is-complete=\"importState.isComplete\"\r\n    :is-error=\"importState.isError\"\r\n  />\r\n\r\n  <SecurityMappingDialog\r\n    v-if=\"importState.isMapping\"\r\n    :security=\"importState.securityToMap\"\r\n    @mapped=\"handleSecurityMapped\"\r\n  />\r\n\r\n  <v-dialog v-model=\"showSuccessDialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5 pb-2\">\r\n        <v-icon color=\"success\" class=\"mr-2\">mdi-check-circle</v-icon>\r\n        Import Completed\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"primary\" size=\"40\">\r\n                    <v-icon dark>mdi-database-import</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.totalTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Total transactions processed</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"success\" size=\"40\">\r\n                    <v-icon dark>mdi-check-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.importedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Successfully imported</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"error\" size=\"40\">\r\n                    <v-icon dark>mdi-alert-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.skippedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Skipped transactions</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"info\" size=\"40\">\r\n                    <v-icon dark>mdi-plus-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.newSecurities }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>New securities added</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"warning\" size=\"40\">\r\n                    <v-icon dark>mdi-help-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.unrecognizedSecurities.length }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Unrecognized securities</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"closeSuccessDialog\">Close</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <v-dialog v-model=\"showUnrecognizedSecuritiesDialog\" max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title>Unrecognized Securities</v-card-title>\r\n      <v-card-text>\r\n        <p>The following securities were not recognized. Please map them to existing securities or create new ones:</p>\r\n        <v-list>\r\n          <v-list-item v-for=\"security in unrecognizedSecurities\" :key=\"security\">\r\n            <v-list-item-title>{{ security }}</v-list-item-title>\r\n            <template v-slot:append>\r\n              <v-autocomplete\r\n                v-model=\"securityMappings[security]\"\r\n                :items=\"existingSecurities\"\r\n                item-title=\"name\"\r\n                item-value=\"id\"\r\n                label=\"Select existing security\"\r\n                clearable\r\n                style=\"max-width: 300px;\"\r\n              ></v-autocomplete>\r\n              <v-btn v-if=\"!securityMappings[security]\" @click=\"createNewSecurity(security)\" color=\"primary\" text>\r\n                Create New Security\r\n              </v-btn>\r\n            </template>\r\n          </v-list-item>\r\n        </v-list>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"confirmSecurityMappings\">Confirm and Import</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n\r\n    <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n      {{ error }}\r\n    </v-alert>\r\n\r\n  </v-dialog>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, computed, watch, onUnmounted } from 'vue'\r\nimport { analyzeFile, getBrokers, importTransactions } from '@/services/api'\r\nimport { useErrorHandler } from '@/composables/useErrorHandler'\r\nimport ProgressDialog from '@/components/dialogs/ProgressDialog.vue'\r\nimport SecurityMappingDialog from '@/components/dialogs/SecurityMappingDialog.vue'\r\nimport { useStore } from 'vuex';\r\nimport { useWebSocket } from '@/composables/useWebSocket'\r\nimport { useImportState } from '@/composables/useImportState'\r\n\r\nconst dialog = ref(false)\r\nconst file = ref(null)\r\nconst isLoading = ref(false)\r\nconst isAnalyzed = ref(false)\r\nconst selectedBroker = ref(null)\r\nconst brokers = ref([])\r\nconst fileId = ref(null)\r\nconst brokerIdentified = ref(false)\r\nconst identifiedBroker = ref(null)\r\nconst brokerIdentificationComplete = ref(false)\r\n\r\nconst showSuccessDialog = ref(false)\r\nconst importStats = ref({\r\n  totalTransactions: 0,\r\n  importedTransactions: 0,\r\n  skippedTransactions: 0,\r\n  newSecurities: 0,\r\n  unrecognizedSecurities: []\r\n})\r\nconst unrecognizedSecurities = ref([])\r\nconst securityMappings = ref({})\r\nconst showUnrecognizedSecuritiesDialog = ref(false)\r\nconst existingSecurities = ref([])\r\n\r\nconst { handleApiError } = useErrorHandler()\r\nconst store = useStore();\r\n\r\nconst { isConnected, lastMessage, sendMessage } = useWebSocket('ws://localhost:8000/ws/transactions/')\r\nconst importState = useImportState()\r\n\r\nconst handleFileChange = (event) => {\r\n  file.value = event.target.files[0]\r\n  isAnalyzed.value = false\r\n  brokerIdentified.value = false\r\n  selectedBroker.value = null\r\n  identifiedBroker.value = null\r\n  brokerIdentificationComplete.value = false\r\n  fileId.value = null\r\n  console.log('File changed:', file.value)\r\n}\r\n\r\nconst closeDialog = () => {\r\n  dialog.value = false\r\n  resetDialogPartial()\r\n}\r\n\r\nconst submitFile = async () => {\r\n  if (file.value) {\r\n    isLoading.value = true\r\n    try {\r\n      const formData = new FormData()\r\n      formData.append('file', file.value)\r\n      console.log('Submitting file:', file.value)\r\n      const result = await analyzeFile(formData)\r\n      isAnalyzed.value = true\r\n      fileId.value = result.fileId\r\n      brokers.value = await getBrokers()\r\n      \r\n      if (result.status === 'broker_identified') {\r\n        brokerIdentified.value = true\r\n        identifiedBroker.value = result.identifiedBroker\r\n        selectedBroker.value = result.identifiedBroker.id\r\n      }\r\n    } catch (error) {\r\n      handleApiError(error)\r\n    } finally {\r\n      isLoading.value = false\r\n      brokerIdentificationComplete.value = true\r\n    }\r\n  } else {\r\n    console.error('No file selected')\r\n  }\r\n}\r\n\r\nconst startImport = () => {\r\n  error.value = null  // Clear any previous errors\r\n  const token = store.state.accessToken\r\n  const wsScheme = window.location.protocol === \"https:\" ? \"wss\" : \"ws\"\r\n  const wsUrl = `${wsScheme}://${window.location.hostname}:8000/ws/transactions/?token=${token}`\r\n  \r\n  console.log('Attempting to connect to WebSocket:', wsUrl)\r\n  \r\n  sendMessage({\r\n    type: 'start_import',\r\n    file_id: fileId.value,\r\n    broker_id: selectedBroker.value\r\n  })\r\n}\r\n\r\nconst handleWebSocketMessage = (message) => {\r\n  if (message.status === 'progress') {\r\n    importState.setProgress(message.progress)\r\n    importState.setState('importing', message.message)\r\n  } else if (message.status === 'security_mapping') {\r\n    importState.setSecurityToMap(message.security)\r\n  } else if (message.status === 'complete') {\r\n    importState.setState('complete', 'Import completed successfully')\r\n    handleImportSuccess(message.data)\r\n  } else if (message.error) {\r\n    importState.setState('error', message.error)\r\n  }\r\n}\r\n\r\nconst handleSecurityMapped = (securityId) => {\r\n  sendMessage({\r\n    type: 'security_mapped',\r\n    security_id: securityId\r\n  })\r\n}\r\n\r\nconst confirmSecurityMappings = async () => {\r\n  try {\r\n    const result = await importTransactions(fileId.value, selectedBroker.value, securityMappings.value)\r\n    handleImportSuccess(result)\r\n  } catch (error) {\r\n    handleApiError(error)\r\n  } finally {\r\n    showUnrecognizedSecuritiesDialog.value = false\r\n  }\r\n}\r\n\r\nconst createNewSecurity = async (securityName) => {\r\n  console.log('Creating new security:', securityName)\r\n  // Implement logic to create a new security\r\n  // This could open a new dialog or navigate to a new security creation page\r\n  // After creation, update the securityMappings\r\n}\r\n\r\nconst handleImportSuccess = (result) => {\r\n  importStats.value = result.importResults\r\n  showSuccessDialog.value = true\r\n  emit('import-completed', result.importResults)\r\n}\r\n\r\nconst closeSuccessDialog = () => {\r\n  showSuccessDialog.value = false\r\n  resetDialogFull()\r\n  closeDialog()\r\n}\r\n\r\nconst resetDialogPartial = () => {\r\n  file.value = null\r\n  isAnalyzed.value = false\r\n  brokerIdentified.value = false\r\n  identifiedBroker.value = null\r\n  brokerIdentificationComplete.value = false\r\n  importState.setState('idle')\r\n}\r\n\r\nconst resetDialogFull = () => {\r\n  resetDialogPartial()\r\n  fileId.value = null\r\n  selectedBroker.value = null\r\n}\r\n\r\nwatch(lastMessage, (message) => {\r\n  if (message) {\r\n    handleWebSocketMessage(message)\r\n  }\r\n})\r\n\r\nonUnmounted(() => {\r\n  if (isConnected.value) {\r\n    sendMessage({ type: 'close' })\r\n  }\r\n})\r\n\r\nwatch(dialog, (newValue) => {\r\n  if (!newValue) {\r\n    resetDialogPartial()\r\n  }\r\n})\r\n</script>"],"mappings":"AA8MA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAK,EAAEC,WAAW,QAAQ,KAAK;AACvD,SAASC,WAAW,EAAEC,UAAU,EAAEC,kBAAkB,QAAQ,gBAAgB;AAC5E,SAASC,eAAe,QAAQ,+BAA+B;AAC/D,OAAOC,cAAc,MAAM,yCAAyC;AACpE,OAAOC,qBAAqB,MAAM,gDAAgD;AAClF,SAASC,QAAQ,QAAQ,MAAM;AAC/B,SAASC,YAAY,QAAQ,4BAA4B;AACzD,SAASC,cAAc,QAAQ,8BAA8B;;;;;;;IAE7D,MAAMC,MAAM,GAAGb,GAAG,CAAC,KAAK,CAAC;IACzB,MAAMc,IAAI,GAAGd,GAAG,CAAC,IAAI,CAAC;IACtB,MAAMe,SAAS,GAAGf,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAMgB,UAAU,GAAGhB,GAAG,CAAC,KAAK,CAAC;IAC7B,MAAMiB,cAAc,GAAGjB,GAAG,CAAC,IAAI,CAAC;IAChC,MAAMkB,OAAO,GAAGlB,GAAG,CAAC,EAAE,CAAC;IACvB,MAAMmB,MAAM,GAAGnB,GAAG,CAAC,IAAI,CAAC;IACxB,MAAMoB,gBAAgB,GAAGpB,GAAG,CAAC,KAAK,CAAC;IACnC,MAAMqB,gBAAgB,GAAGrB,GAAG,CAAC,IAAI,CAAC;IAClC,MAAMsB,4BAA4B,GAAGtB,GAAG,CAAC,KAAK,CAAC;IAE/C,MAAMuB,iBAAiB,GAAGvB,GAAG,CAAC,KAAK,CAAC;IACpC,MAAMwB,WAAW,GAAGxB,GAAG,CAAC;MACtByB,iBAAiB,EAAE,CAAC;MACpBC,oBAAoB,EAAE,CAAC;MACvBC,mBAAmB,EAAE,CAAC;MACtBC,aAAa,EAAE,CAAC;MAChBC,sBAAsB,EAAE;IAC1B,CAAC,CAAC;IACF,MAAMA,sBAAsB,GAAG7B,GAAG,CAAC,EAAE,CAAC;IACtC,MAAM8B,gBAAgB,GAAG9B,GAAG,CAAC,CAAC,CAAC,CAAC;IAChC,MAAM+B,gCAAgC,GAAG/B,GAAG,CAAC,KAAK