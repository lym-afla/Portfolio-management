ess = await store.dispatch('register', credentials)\r\n        if (success) {\r\n          router.push('/dashboard')\r\n        } else {\r\n          error.value = 'Registration failed. Please try again.'\r\n        }\r\n      } catch (err) {\r\n        error.value = 'An error occurred during registration.'\r\n      }\r\n    }\r\n\r\n    return { error, handleRegister }\r\n  }\r\n}\r\n</script>"],"mappings":";AAYA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,YAAW,MAAO,+BAA8B;AAEvD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIP,GAAG,CAAC,EAAE;IACpB,MAAMQ,MAAK,GAAIP,SAAS,CAAC;IACzB,MAAMQ,KAAI,GAAIP,QAAQ,CAAC;IAEvB,MAAMQ,cAAa,GAAI,MAAOC,WAAW,IAAK;MAC5C,IAAI;QACF,MAAMC,OAAM,GAAI,MAAMH,KAAK,CAACI,QAAQ,CAAC,UAAU,EAAEF,WAAW;QAC5D,IAAIC,OAAO,EAAE;UACXJ,MAAM,CAACM,IAAI,CAAC,YAAY;QAC1B,OAAO;UACLP,KAAK,CAACQ,KAAI,GAAI,wCAAuC;QACvD;MACF,EAAE,OAAOC,GAAG,EAAE;QACZT,KAAK,CAACQ,KAAI,GAAI,wCAAuC;MACvD;IACF;IAEA,OAAO;MAAER,KAAK;MAAEG;IAAe;EACjC;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}