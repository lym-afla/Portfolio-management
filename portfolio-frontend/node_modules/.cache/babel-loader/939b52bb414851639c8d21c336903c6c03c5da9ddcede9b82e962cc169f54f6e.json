{"ast":null,"code":"import { computed, onBeforeUnmount } from 'vue';\nimport TransactionConfirmationSection from '../TransactionConfirmationSection.vue';\nexport default {\n  name: 'ProgressDialog',\n  components: {\n    TransactionConfirmationSection\n  },\n  props: {\n    modelValue: Boolean,\n    title: {\n      type: String,\n      default: 'Progress'\n    },\n    progress: {\n      type: Number,\n      default: 0\n    },\n    current: {\n      type: Number,\n      default: 0\n    },\n    total: {\n      type: Number,\n      default: 0\n    },\n    currentMessage: {\n      type: String,\n      default: ''\n    },\n    error: {\n      type: String,\n      default: ''\n    },\n    canStop: {\n      type: Boolean,\n      default: true\n    },\n    showConfirmation: {\n      type: Boolean,\n      default: false\n    },\n    transactionToConfirm: {\n      type: Object,\n      default: null\n    },\n    confirmationIndex: {\n      type: Number,\n      default: 0\n    },\n    confirmationTotal: {\n      type: Number,\n      default: 0\n    }\n  },\n  emits: ['update:modelValue', 'stop-import', 'reset', 'confirm-transaction', 'skip-transaction'],\n  setup(props, {\n    emit\n  }) {\n    const dialogModel = computed({\n      get: () => props.modelValue,\n      set: value => {\n        emit('update:modelValue', value);\n        if (!value) {\n          resetDialog();\n        }\n      }\n    });\n    const closeDialog = () => {\n      dialogModel.value = false;\n    };\n    const stopImport = () => {\n      emit('stop-import');\n    };\n    const resetDialog = () => {\n      emit('reset');\n    };\n    onBeforeUnmount(() => {\n      resetDialog();\n    });\n    return {\n      dialogModel,\n      closeDialog,\n      stopImport\n    };\n  }\n};","map":{"version":3,"names":["computed","onBeforeUnmount","TransactionConfirmationSection","name","components","props","modelValue","Boolean","title","type","String","default","progress","Number","current","total","currentMessage","error","canStop","showConfirmation","transactionToConfirm","Object","confirmationIndex","confirmationTotal","emits","setup","emit","dialogModel","get","set","value","resetDialog","closeDialog","stopImport"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\ProgressDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialogModel\" persistent max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"d-flex align-center\">\r\n        {{ title }}\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-progress-linear\r\n          :model-value=\"progress\"\r\n          height=\"25\"\r\n          color=\"primary\"\r\n          class=\"mb-2\"\r\n        >\r\n          <template v-slot:default=\"{ value }\">\r\n            <strong>{{ Math.ceil(value) }}%</strong>\r\n          </template>\r\n        </v-progress-linear>\r\n        <v-row no-gutters>\r\n          <v-col cols=\"12\" class=\"text-center\">\r\n            <div class=\"text-subtitle-2 font-weight-medium\">\r\n              Processing {{ current }} of {{ total }}\r\n            </div>\r\n          </v-col>\r\n        </v-row>\r\n        <v-row no-gutters v-if=\"currentMessage\" class=\"mb-4\">\r\n          <v-col cols=\"12\">\r\n            <v-card outlined class=\"mt-2 pa-2\">\r\n              <div class=\"d-flex align-center\">\r\n                <v-progress-circular\r\n                  indeterminate\r\n                  color=\"primary\"\r\n                  size=\"24\"\r\n                  width=\"2\"\r\n                  class=\"ml-2\"\r\n                ></v-progress-circular>\r\n                <div class=\"text-body-2 ml-2\">{{ currentMessage }}...</div>\r\n              </div>\r\n            </v-card>\r\n          </v-col>\r\n        </v-row>\r\n        \r\n        <!-- New TransactionConfirmationSection component -->\r\n        <TransactionConfirmationSection\r\n          v-modelowConfirmation\"\r\n          :transaction=\"transactionToConfirm\"\r\n          :index=\"confirmationIndex\"\r\n          :total=\"confirmationTotal\"\r\n          @confirm=\"$emit('confirm-transaction')\"\r\n          @skip=\"$emit('skip-transaction')\"\r\n        />\r\n\r\n        <v-row no-gutters class=\"mb-4\" v-if=\"!showConfirmation\">\r\n          <v-col cols=\"12\" class=\"text-center\">\r\n            <v-btn color=\"error\" @click=\"stopImport\" :disabled=\"!canStop\">Stop Import</v-btn>\r\n          </v-col>\r\n        </v-row>\r\n        <v-alert v-if=\"error\" type=\"error\" class=\"mt-4\">\r\n          {{ error }}\r\n        </v-alert>\r\n      </v-card-text>\r\n      <v-card-actions v-if=\"error\">\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"closeDialog\">Close</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onBeforeUnmount } from 'vue'\r\nimport TransactionConfirmationSection from '../TransactionConfirmationSection.vue'\r\n\r\nexport default {\r\n  name: 'ProgressDialog',\r\n  components: {\r\n    TransactionConfirmationSection\r\n  },\r\n  props: {\r\n    modelValue: Boolean,\r\n    title: {\r\n      type: String,\r\n      default: 'Progress'\r\n    },\r\n    progress: {\r\n      type: Number,\r\n      default: 0\r\n    },\r\n    current: {\r\n      type: Number,\r\n      default: 0\r\n    },\r\n    total: {\r\n      type: Number,\r\n      default: 0\r\n    },\r\n    currentMessage: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    error: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    canStop: {\r\n      type: Boolean,\r\n      default: true\r\n    },\r\n    showConfirmation: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    transactionToConfirm: {\r\n      type: Object,\r\n      default: null\r\n    },\r\n    confirmationIndex: {\r\n      type: Number,\r\n      default: 0\r\n    },\r\n    confirmationTotal: {\r\n      type: Number,\r\n      default: 0\r\n    }\r\n  },\r\n  emits: ['update:modelValue', 'stop-import', 'reset', 'confirm-transaction', 'skip-transaction'],\r\n  setup(props, { emit }) {\r\n    const dialogModel = computed({\r\n      get: () => props.modelValue,\r\n      set: (value) => {\r\n        emit('update:modelValue', value)\r\n        if (!value) {\r\n          resetDialog()\r\n        }\r\n      }\r\n    })\r\n\r\n    const closeDialog = () => {\r\n      dialogModel.value = false\r\n    }\r\n\r\n    const stopImport = () => {\r\n      emit('stop-import')\r\n    }\r\n\r\n    const resetDialog = () => {\r\n      emit('reset')\r\n    }\r\n\r\n    onBeforeUnmount(() => {\r\n      resetDialog()\r\n    })\r\n\r\n    return {\r\n      dialogModel,\r\n      closeDialog,\r\n      stopImport,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAqEA,SAASA,QAAQ,EAAEC,eAAc,QAAS,KAAI;AAC9C,OAAOC,8BAA6B,MAAO,uCAAsC;AAEjF,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAK,EAAE;IACLC,UAAU,EAAEC,OAAO;IACnBC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,QAAQ,EAAE;MACRH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDG,OAAO,EAAE;MACPL,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDI,KAAK,EAAE;MACLN,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDK,cAAc,EAAE;MACdP,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDM,KAAK,EAAE;MACLR,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDO,OAAO,EAAE;MACPT,IAAI,EAAEF,OAAO;MACbI,OAAO,EAAE;IACX,CAAC;IACDQ,gBAAgB,EAAE;MAChBV,IAAI,EAAEF,OAAO;MACbI,OAAO,EAAE;IACX,CAAC;IACDS,oBAAoB,EAAE;MACpBX,IAAI,EAAEY,MAAM;MACZV,OAAO,EAAE;IACX,CAAC;IACDW,iBAAiB,EAAE;MACjBb,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDY,iBAAiB,EAAE;MACjBd,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX;EACF,CAAC;EACDa,KAAK,EAAE,CAAC,mBAAmB,EAAE,aAAa,EAAE,OAAO,EAAE,qBAAqB,EAAE,kBAAkB,CAAC;EAC/FC,KAAKA,CAACpB,KAAK,EAAE;IAAEqB;EAAK,CAAC,EAAE;IACrB,MAAMC,WAAU,GAAI3B,QAAQ,CAAC;MAC3B4B,GAAG,EAAEA,CAAA,KAAMvB,KAAK,CAACC,UAAU;MAC3BuB,GAAG,EAAGC,KAAK,IAAK;QACdJ,IAAI,CAAC,mBAAmB,EAAEI,KAAK;QAC/B,IAA