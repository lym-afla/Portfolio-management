{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const showDeleteConfirmation = ref(false);\n    const confirmationText = ref('');\n    return {\n      router,\n      store,\n      showDeleteConfirmation,\n      confirmationText\n    };\n  },\n  data() {\n    return {\n      menuItems: [{\n        title: 'User details',\n        to: '/profile'\n      }, {\n        title: 'Settings',\n        to: '/profile/settings'\n      }]\n    };\n  },\n  methods: {\n    async logout() {\n      try {\n        const response = await this.store.dispatch('logout');\n        if (response.success) {\n          this.$emit('update-page-title', ''); // Clear the page title\n          this.router.push('/login');\n        } else {\n          console.error('Logout failed:', response.error);\n        }\n      } catch (error) {\n        console.error('Logout error:', error);\n      }\n    },\n    isActive(route) {\n      return this.$route.path === route;\n    },\n    async deleteAccount() {\n      if (this.confirmationText !== 'DELETE') {\n        return;\n      }\n      try {\n        const response = await this.store.dispatch('deleteAccount');\n        if (response.success) {\n          this.router.push('/register');\n        } else {\n          // Handle error (e.g., show error message to user)\n          console.error('Account deletion failed:', response.error);\n        }\n      } finally {\n        this.showDeleteConfirmation = false;\n        this.confirmationText = '';\n      }\n    }\n  },\n  mounted() {\n    this.$emit('update-page-title', 'User Profile');\n  },\n  beforeUnmount() {\n    this.$emit('update-page-title', ''); // Clear the page title when component is unmounted\n  }\n};","map":{"version":3,"names":["ref","useRouter","useStore","setup","router","store","showDeleteConfirmation","confirmationText","data","menuItems","title","to","methods","logout","response","dispatch","success","$emit","push","console","error","isActive","route","$route","path","deleteAccount","mounted","beforeUnmount"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\ProfileLayout.vue"],"sourcesContent":["<template>\r\n  <v-container fluid class=\"mt-4\">\r\n    <v-row>\r\n      <v-col cols=\"12\" md=\"4\">\r\n        <!-- Side Navigation -->\r\n        <v-card>\r\n          <v-list>\r\n            <v-list-item\r\n              v-for=\"(item, i) in menuItems\"\r\n              :key=\"i\"\r\n              :to=\"item.to\"\r\n              :active=\"isActive(item.to)\"\r\n              active-class=\"primary white--text\"\r\n            >\r\n              <v-list-item-title>{{ item.title }}</v-list-item-title>\r\n            </v-list-item>\r\n          </v-list>\r\n          <v-divider></v-divider>\r\n          <v-list-item @click=\"logout\">\r\n            <v-list-item-title>Logout</v-list-item-title>\r\n          </v-list-item>\r\n        </v-card>\r\n        <v-divider></v-divider>\r\n        <v-list-item>\r\n          <v-btn\r\n            @click=\"showDeleteConfirmation = true\"\r\n            color=\"error\"\r\n            outlined\r\n            block\r\n            class=\"mt-2\"\r\n          >\r\n          <v-icon left>mdi-delete</v-icon>\r\n            Delete Account\r\n          </v-btn>\r\n        </v-list-item>\r\n      </v-col>\r\n      <v-col cols=\"12\" md=\"8\">\r\n        <!-- Tab Content -->\r\n        <router-view></router-view>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <!-- Delete Account Confirmation Dialog -->\r\n    <v-dialog v-model=\"showDeleteConfirmation\" max-width=\"400\">\r\n      <v-card>\r\n        <v-card-title class=\"text-h5 error--text\">Delete Account</v-card-title>\r\n        <v-card-text>\r\n          <p>\r\n            Are you sure you want to delete your account? This action cannot be\r\n            undone.\r\n          </p>\r\n          <v-text-field\r\n            v-model=\"confirmationText\"\r\n            label=\"Type 'DELETE' to confirm\"\r\n            :rules=\"[(v) => v === 'DELETE' || 'Please type DELETE to confirm']\"\r\n          ></v-text-field>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"primary\" text @click=\"showDeleteConfirmation = false\"\r\n            >Cancel</v-btn\r\n          >\r\n          <v-btn\r\n            color=\"error\"\r\n            :disabled=\"confirmationText !== 'DELETE'\"\r\n            @click=\"deleteAccount\"\r\n          >\r\n            Delete Account\r\n          </v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const showDeleteConfirmation = ref(false)\r\n    const confirmationText = ref('')\r\n\r\n    return { router, store, showDeleteConfirmation, confirmationText }\r\n  },\r\n  data() {\r\n    return {\r\n      menuItems: [\r\n        { title: 'User details', to: '/profile' },\r\n        { title: 'Settings', to: '/profile/settings' },\r\n      ],\r\n    }\r\n  },\r\n  methods: {\r\n    async logout() {\r\n      try {\r\n        const response = await this.store.dispatch('logout')\r\n        if (response.success) {\r\n          this.$emit('update-page-title', '') // Clear the page title\r\n          this.router.push('/login')\r\n        } else {\r\n          console.error('Logout failed:', response.error)\r\n        }\r\n      } catch (error) {\r\n        console.error('Logout error:', error)\r\n      }\r\n    },\r\n    isActive(route) {\r\n      return this.$route.path === route\r\n    },\r\n    async deleteAccount() {\r\n      if (this.confirmationText !== 'DELETE') {\r\n        return\r\n      }\r\n      try {\r\n        const response = await this.store.dispatch('deleteAccount')\r\n        if (response.success) {\r\n          this.router.push('/register')\r\n        } else {\r\n          // Handle error (e.g., show error message to user)\r\n          console.error('Account deletion failed:', response.error)\r\n        }\r\n      } finally {\r\n        this.showDeleteConfirmation = false\r\n        this.confirmationText = ''\r\n      }\r\n    },\r\n  },\r\n  mounted() {\r\n    this.$emit('update-page-title', 'User Profile')\r\n  },\r\n  beforeUnmount() {\r\n    this.$emit('update-page-title', '') // Clear the page title when component is unmounted\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-btn.error--text {\r\n  border-color: currentColor;\r\n}\r\n</style>\r\n"],"mappings":";AA4EA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIH,SAAS,CAAC;IACzB,MAAMI,KAAI,GAAIH,QAAQ,CAAC;IACvB,MAAMI,sBAAqB,GAAIN,GAAG,CAAC,KAAK;IACxC,MAAMO,gBAAe,GAAIP,GAAG,CAAC,EAAE;IAE/B,OAAO;MAAEI,MAAM;MAAEC,KAAK;MAAEC,sBAAsB;MAAEC;IAAiB;EACnE,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,CACT;QAAEC,KAAK,EAAE,cAAc;QAAEC,EAAE,EAAE;MAAW,CAAC,EACzC;QAAED,KAAK,EAAE,UAAU;QAAEC,EAAE,EAAE;MAAoB,CAAC;IAElD;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,MAAMA,CAAA,EAAG;MACb,IAAI;QACF,MAAMC,QAAO,GAAI,MAAM,IAAI,CAACT,KAAK,CAACU,QAAQ,CAAC,QAAQ;QACnD,IAAID,QAAQ,CAACE,OAAO,EAAE;UACpB,IAAI,CAACC,KAAK,CAAC,mBAAmB,EAAE,EAAE,GAAE;UACpC,IAAI,CAACb,MAAM,CAACc,IAAI,CAAC,QAAQ;QAC3B,OAAO;UACLC,OAAO,CAACC,KAAK,CAAC,gBAAgB,EAAEN,QAAQ,CAACM,KAAK;QAChD;MACF,EAAE,OAAOA,KAAK,EAAE;QACdD,OAAO,CAACC,KAAK,CAAC,eAAe,EAAEA,KAAK;MACtC;IACF,CAAC;IACDC,QAAQA,CAACC,KAAK,EAAE;MACd,OAAO,IAAI,CAACC,MAAM,CAACC,IAAG,KAAMF,KAAI;IAClC,CAAC;IACD,MAAMG,aAAaA,CAAA,EAAG;MACpB,IAAI,IAAI,CAAClB,gBAAe,KAAM,QAAQ,EAAE;QACtC;MACF;MACA,IAAI;QACF,MAAMO,QAAO,GAAI,MAAM,IAAI,CAACT,KAAK,CA