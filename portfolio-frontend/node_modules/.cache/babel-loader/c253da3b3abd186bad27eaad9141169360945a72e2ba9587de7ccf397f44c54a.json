{"ast":null,"code":"import { onMounted, onUnmounted, ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nexport default {\n  name: \"TransactionsPage\",\n  emits: ['update-page-title'],\n  setup(props, {\n    emit\n  }) {\n    const store = useStore();\n    const dateFrom = ref('');\n    const dateTo = ref('');\n    const loading = ref(false);\n    const tableLoading = ref(false);\n    const transactions = ref([{\n      id: 1,\n      name: 'Test Transaction'\n    }]);\n    const totalItems = ref(1);\n    const search = ref('');\n    const headers = ref([{\n      title: 'ID',\n      key: 'id'\n    }, {\n      title: 'Name',\n      key: 'name'\n    }]);\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions);\n    const currentPage = computed({\n      get: () => store.state.tableSettings.page,\n      set: value => store.dispatch('updateTableSettings', {\n        page: value\n      })\n    });\n    const itemsPerPage = computed({\n      get: () => store.state.tableSettings.itemsPerPage,\n      set: value => store.dispatch('updateTableSettings', {\n        itemsPerPage: value\n      })\n    });\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value));\n    const dateDialog = ref(false);\n    const openDateDialog = () => {\n      dateDialog.value = true;\n    };\n    const closeDateDialog = () => {\n      dateDialog.value = false;\n    };\n    const applyDateRange = () => {\n      // Here you can add logic to apply the selected date range\n      // For example, you might want to fetch new data or update the store\n      closeDateDialog();\n    };\n    onMounted(() => {\n      emit('update-page-title', 'Transactions');\n      console.log('TransactionsPage mounted');\n    });\n    onUnmounted(() => {\n      emit('update-page-title', '');\n    });\n    return {\n      dateFrom,\n      dateTo,\n      loading,\n      tableLoading,\n      transactions,\n      totalItems,\n      currentPage,\n      itemsPerPage,\n      itemsPerPageOptions,\n      pageCount,\n      search,\n      headers,\n      dateDialog,\n      openDateDialog,\n      closeDateDialog,\n      applyDateRange\n    };\n  }\n};","map":{"version":3,"names":["onMounted","onUnmounted","ref","computed","useStore","name","emits","setup","props","emit","store","dateFrom","dateTo","loading","tableLoading","transactions","id","totalItems","search","headers","title","key","itemsPerPageOptions","state","currentPage","get","tableSettings","page","set","value","dispatch","itemsPerPage","pageCount","Math","ceil","dateDialog","openDateDialog","closeDateDialog","applyDateRange","console","log"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\TransactionsPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid class=\"pa-0\">\r\n    <v-progress-circular\r\n      v-if=\"loading\"\r\n      color=\"primary\"\r\n      indeterminate\r\n      size=\"64\"\r\n    ></v-progress-circular>\r\n\r\n    <v-row no-gutters>\r\n      <v-col cols=\"12\">\r\n        <v-data-table\r\n          :headers=\"headers\"\r\n          :items=\"transactions\"\r\n          :loading=\"tableLoading\"\r\n          :search=\"search\"\r\n          :items-per-page=\"itemsPerPage\"\r\n          class=\"elevation-1 nowrap-table\"\r\n          density=\"compact\"\r\n          @update:sort-by=\"handleSortChange\"\r\n          :server-items-length=\"totalItems\"\r\n          :items-length=\"totalItems\"\r\n          must-sort\r\n          disable-sort\r\n        >\r\n          <template #top>\r\n            <v-toolbar flat class=\"bg-grey-lighten-4 border-b\">\r\n              <v-btn icon @click=\"openDateDialog\">\r\n                <v-icon>mdi-calendar-range</v-icon>\r\n              </v-btn>\r\n              <v-divider vertical class=\"mx-2\"></v-divider>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"7\" lg=\"8\">\r\n                <v-text-field\r\n                  v-model=\"search\"\r\n                  append-icon=\"mdi-magnify\"\r\n                  label=\"Search\"\r\n                  single-line\r\n                  hide-details\r\n                  density=\"compact\"\r\n                  bg-color=\"white\"\r\n                  class=\"rounded-lg\"\r\n                ></v-text-field>\r\n              </v-col>\r\n              <v-spacer></v-spacer>\r\n              <v-col cols=\"12\" sm=\"3\" md=\"3\" lg=\"2\">\r\n                <v-select\r\n                  v-model=\"itemsPerPage\"\r\n                  :items=\"itemsPerPageOptions\"\r\n                  label=\"Rows per page\"\r\n                  density=\"compact\"\r\n                  variant=\"outlined\"\r\n                  hide-details\r\n                  class=\"mr-2 rows-per-page-select\"\r\n                  @update:model-value=\"handleItemsPerPageChange\"\r\n                  bg-color=\"white\"\r\n                ></v-select>\r\n              </v-col>\r\n            </v-toolbar>\r\n          </template>\r\n\r\n          <template #bottom>\r\n            <div class=\"d-flex align-center justify-space-between pa-4\">\r\n              <span class=\"text-caption mr-4\">\r\n                Showing {{ (currentPage - 1) * itemsPerPage + 1 }}-{{\r\n                  Math.min(currentPage * itemsPerPage, totalItems)\r\n                }}\r\n                of {{ totalItems }} entries\r\n              </span>\r\n              <v-pagination\r\n                v-model=\"currentPage\"\r\n                :length=\"pageCount\"\r\n                :total-visible=\"7\"\r\n                rounded=\"circle\"\r\n                @update:model-value=\"handlePageChange\"\r\n              ></v-pagination>\r\n            </div>\r\n          </template>\r\n        </v-data-table>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <!-- Date Range Dialog -->\r\n    <v-dialog v-model=\"dateDialog\" max-width=\"400px\">\r\n      <v-card>\r\n        <v-card-title class=\"text-h5\">\r\n          Select Date Range\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-row>\r\n            <v-col cols=\"12\">\r\n              <v-date-picker\r\n                v-model=\"transactionsTableFrom\"\r\n                label=\"From\"\r\n                prepend-icon=\"mdi-calendar\"\r\n              ></v-date-picker>\r\n            </v-col>\r\n            <v-col cols=\"12\">\r\n              <v-date-picker\r\n                v-model=\"dateTo\"\r\n                label=\"To\"\r\n                prepend-icon=\"mdi-calendar\"\r\n              ></v-date-picker>\r\n            </v-col>\r\n          </v-row>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"closeDateDialog\">Cancel</v-btn>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"applyDateRange\">Apply</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { onMounted, onUnmounted, ref, computed } from 'vue'\r\nimport { useStore } from 'vuex'\r\n\r\nexport default {\r\n  name: \"TransactionsPage\",\r\n  emits: ['update-page-title'],\r\n  setup(props, { emit }) {\r\n    const store = useStore()\r\n\r\n    const dateFrom = ref('')\r\n    const dateTo = ref('')\r\n    const loading = ref(false)\r\n    const tableLoading = ref(false)\r\n    const transactions = ref([{ id: 1, name: 'Test Transaction' }])\r\n    const totalItems = ref(1)\r\n    const search = ref('')\r\n    const headers = ref([\r\n      { title: 'ID', key: 'id' },\r\n      { title: 'Name', key: 'name' },\r\n    ])\r\n\r\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions)\r\n  \r\n    const currentPage = computed({\r\n      get: () => store.state.tableSettings.page,\r\n      set: (value) => store.dispatch('updateTableSettings', { page: value })\r\n    })\r\n\r\n    const itemsPerPage = computed({\r\n      get: () => store.state.tableSettings.itemsPerPage,\r\n      set: (value) => store.dispatch('updateTableSettings', { itemsPerPage: value })\r\n    })\r\n\r\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value))\r\n\r\n    const dateDialog = ref(false)\r\n\r\n    const openDateDialog = () => {\r\n      dateDialog.value = true\r\n    }\r\n\r\n    const closeDateDialog = () => {\r\n      dateDialog.value = false\r\n    }\r\n\r\n    const applyDateRange = () => {\r\n      // Here you can add logic to apply the selected date range\r\n      // For example, you might want to fetch new data or update the store\r\n      closeDateDialog()\r\n    }\r\n\r\n    onMounted(() => {\r\n      emit('update-page-title', 'Transactions')\r\n      console.log('TransactionsPage mounted')\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      emit('update-page-title', '')\r\n    })\r\n\r\n    return {\r\n      dateFrom,\r\n      dateTo,\r\n      loading,\r\n      tableLoading,\r\n      transactions,\r\n      totalItems,\r\n      currentPage,\r\n      itemsPerPage,\r\n      itemsPerPageOptions,\r\n      pageCount,\r\n      search,\r\n      headers,\r\n      dateDialog,\r\n      openDateDialog,\r\n      closeDateDialog,\r\n      applyDateRange,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAoHA,SAASA,SAAS,EAAEC,WAAW,EAAEC,GAAG,EAAEC,QAAO,QAAS,KAAI;AAC1D,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IACrB,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IAEvB,MAAMO,QAAO,GAAIT,GAAG,CAAC,EAAE;IACvB,MAAMU,MAAK,GAAIV,GAAG,CAAC,EAAE;IACrB,MAAMW,OAAM,GAAIX,GAAG,CAAC,KAAK;IACzB,MAAMY,YAAW,GAAIZ,GAAG,CAAC,KAAK;IAC9B,MAAMa,YAAW,GAAIb,GAAG,CAAC,CAAC;MAAEc,EAAE,EAAE,CAAC;MAAEX,IAAI,EAAE;IAAmB,CAAC,CAAC;IAC9D,MAAMY,UAAS,GAAIf,GAAG,CAAC,CAAC;IACxB,MAAMgB,MAAK,GAAIhB,GAAG,CAAC,EAAE;IACrB,MAAMiB,OAAM,GAAIjB,GAAG,CAAC,CAClB;MAAEkB,KAAK,EAAE,IAAI;MAAEC,GAAG,EAAE;IAAK,CAAC,EAC1B;MAAED,KAAK,EAAE,MAAM;MAAEC,GAAG,EAAE;IAAO,CAAC,CAC/B;IAED,MAAMC,mBAAkB,GAAInB,QAAQ,CA