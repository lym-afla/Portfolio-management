{"ast":null,"code":"import { ref, computed, watch, onMounted } from 'vue';\nimport { getTransactionFormStructure, addTransaction, updateTransaction } from '@/services/api';\nexport default {\n  name: 'TransactionDialog',\n  props: {\n    modelValue: Boolean,\n    editItem: Object\n  },\n  emits: ['update:modelValue', 'transaction-added', 'transaction-updated'],\n  setup(props, {\n    emit\n  }) {\n    const dialog = computed({\n      get: () => props.modelValue,\n      set: value => emit('update:modelValue', value)\n    });\n    const isEdit = computed(() => !!props.editItem);\n    const form = ref({});\n    const formFields = ref([]);\n    const errorMessages = ref({});\n    const generalError = ref('');\n    const isSubmitting = ref(false);\n    const initializeForm = () => {\n      if (formFields.value && formFields.value.length > 0) {\n        form.value = formFields.value.reduce((acc, field) => {\n          acc[field.name] = '';\n          return acc;\n        }, {});\n        errorMessages.value = formFields.value.reduce((acc, field) => {\n          acc[field.name] = [];\n          return acc;\n        }, {});\n      } else {\n        generalError.value = 'Failed to initialize form. Please try again.';\n      }\n    };\n    const fetchFormStructure = async () => {\n      try {\n        const response = await getTransactionFormStructure();\n        formFields.value = response.fields;\n        initializeForm();\n      } catch (error) {\n        console.error('Error fetching form structure:', error);\n        generalError.value = 'Failed to load form structure. Please try again.';\n      }\n    };\n\n    // const populateForm = (item) => {\n    //   formFields.value.forEach(field => {\n    //     if (field.name in item) {\n    //       form.value[field.name] = item[field.name]\n    //     }\n    //   })\n    // }\n\n    watch(() => props.editItem, newValue => {\n      if (newValue) {\n        fetchFormStructure();\n      } else {\n        initializeForm();\n      }\n    });\n    onMounted(fetchFormS);\n\n    // watch(() => props.modelValue, (newValue) => {\n    //   if (newValue) {\n    //     fetchFormStructure()\n    //   }\n    // })\n\n    const closeDialog = () => {\n      dialog.value = false;\n      initializeForm();\n    };\n    const submitForm = async () => {\n      isSubmitting.value = true;\n      errorMessages.value = {};\n      generalError.value = '';\n      console.log('form', form.value);\n      try {\n        let response;\n        if (isEdit.value) {\n          response = await updateTransaction(form.value.id, form.value);\n          emit('transaction-updated', response);\n        } else {\n          response = await addTransaction(form.value);\n          emit('transaction-added', response);\n        }\n        closeDialog();\n      } catch (error) {\n        console.error('Error submitting transaction:', error);\n        if (error && typeof error === 'object') {\n          Object.entries(error).forEach(([key, value]) => {\n            if (key === '__all__') {\n              generalError.value = Array.isArray(value) ? value[0] : value;\n            } else {\n              errorMessages.value[key] = Array.isArray(value) ? value : [value];\n            }\n          });\n        } else {\n          generalError.value = error.message || 'An unexpected error occurred. Please try again.';\n        }\n      } finally {\n        isSubmitting.value = false;\n      }\n    };\n    onMounted(fetchFormStructure);\n    return {\n      dialog,\n      isEdit,\n      form,\n      formFields,\n      errorMessages,\n      generalError,\n      isSubmitting,\n      closeDialog,\n      submitForm\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","onMounted","getTransactionFormStructure","addTransaction","updateTransaction","name","props","modelValue","Boolean","editItem","Object","emits","setup","emit","dialog","get","set","value","isEdit","form","formFields","errorMessages","generalError","isSubmitting","initializeForm","length","reduce","acc","field","fetchFormStructure","response","fields","error","console","newValue","fetchFormS","closeDialog","submitForm","log","id","entries","forEach","key","Array","isArray","message"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\TransactionDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title>\r\n        <span class=\"text-h5\">{{ isEdit ? 'Edit Transaction' : 'Add Transaction' }}</span>\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-form @submit.prevent=\"submitForm\">\r\n          <template v-for=\"field in formFields\" :key=\"field.name\">\r\n            <v-text-field\r\n              v-if=\"field.type === 'datepicker'\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              type=\"date\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errorMessages[field.name]\"\r\n            ></v-text-field>\r\n            <v-autocomplete\r\n              v-else-if=\"field.type === 'select'\"\r\n              v-model=\"form[field.name]\"\r\n              :items=\"field.choices\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              :label=\"field.label\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errorMessages[field.name]\"\r\n            ></v-autocomplete>\r\n            <v-text-field\r\n              v-else-if=\"field.type === 'number'\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              type=\"number\"\r\n              step=\"0.01\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errorMessages[field.name]\"\r\n            ></v-text-field>\r\n            <v-textarea\r\n              v-else-if=\"field.type === 'textarea'\"\r\n              v-model=\"form[field.name]\"\r\n              :label=\"field.label\"\r\n              :required=\"field.required\"\r\n              :error-messages=\"errorMessages[field.name]\"\r\n            ></v-textarea>\r\n          </template>\r\n        </v-form>\r\n        <v-alert\r\n          v-if=\"generalError\"\r\n          type=\"error\"\r\n          class=\"mt-4\"\r\n        >\r\n          {{ generalError }}\r\n        </v-alert>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n        <v-btn color=\"blue darken-1\" text @click=\"submitForm\" :loading=\"isSubmitting\">Save</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch, onMounted } from 'vue'\r\nimport { getTransactionFormStructure, addTransaction, updateTransaction } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'TransactionDialog',\r\n  props: {\r\n    modelValue: Boolean,\r\n    editItem: Object,\r\n  },\r\n  emits: ['update:modelValue', 'transaction-added', 'transaction-updated'],\r\n  setup(props, { emit }) {\r\n    const dialog = computed({\r\n      get: () => props.modelValue,\r\n      set: (value) => emit('update:modelValue', value)\r\n    })\r\n    const isEdit = computed(() => !!props.editItem)\r\n    const form = ref({})\r\n    const formFields = ref([])\r\n    const errorMessages = ref({})\r\n    const generalError = ref('')\r\n    const isSubmitting = ref(false)\r\n\r\n    const initializeForm = () => {\r\n      if (formFields.value && formFields.value.length > 0) {\r\n        form.value = formFields.value.reduce((acc, field) => {\r\n          acc[field.name] = ''\r\n          return acc\r\n        }, {})\r\n        errorMessages.value = formFields.value.reduce((acc, field) => {\r\n          acc[field.name] = []\r\n          return acc\r\n        }, {})\r\n      } else {\r\n        generalError.value = 'Failed to initialize form. Please try again.'\r\n      }\r\n    }\r\n\r\n    const fetchFormStructure = async () => {\r\n      try {\r\n        const response = await getTransactionFormStructure()\r\n        formFields.value = response.fields\r\n        initializeForm()\r\n      } catch (error) {\r\n        console.error('Error fetching form structure:', error)\r\n        generalError.value = 'Failed to load form structure. Please try again.'\r\n      }\r\n    }\r\n\r\n    // const populateForm = (item) => {\r\n    //   formFields.value.forEach(field => {\r\n    //     if (field.name in item) {\r\n    //       form.value[field.name] = item[field.name]\r\n    //     }\r\n    //   })\r\n    // }\r\n\r\n    watch(() => props.editItem, (newValue) => {\r\n      if (newValue) {\r\n        fetchFormStructure()\r\n      } else {\r\n        initializeForm()\r\n      }\r\n    })\r\n\r\n    onMounted(fetchFormS)\r\n\r\n    // watch(() => props.modelValue, (newValue) => {\r\n    //   if (newValue) {\r\n    //     fetchFormStructure()\r\n    //   }\r\n    // })\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      initializeForm()\r\n    }\r\n\r\n    const submitForm = async () => {\r\n      isSubmitting.value = true\r\n      errorMessages.value = {}\r\n      generalError.value = ''\r\n\r\n      console.log('form', form.value)\r\n\r\n      try {\r\n        let response\r\n        if (isEdit.value) {\r\n          response = await updateTransaction(form.value.id, form.value)\r\n          emit('transaction-updated', response)\r\n        } else {\r\n          response = await addTransaction(form.value)\r\n          emit('transaction-added', response)\r\n        }\r\n        closeDialog()\r\n      } catch (error) {\r\n        console.error('Error submitting transaction:', error)\r\n        if (error && typeof error === 'object') {\r\n          Object.entries(error).forEach(([key, value]) => {\r\n            if (key === '__all__') {\r\n              generalError.value = Array.isArray(value) ? value[0] : value\r\n            } else {\r\n              errorMessages.value[key] = Array.isArray(value) ? value : [value]\r\n            }\r\n          })\r\n        } else {\r\n          generalError.value = error.message || 'An unexpected error occurred. Please try again.'\r\n        }\r\n      } finally {\r\n        isSubmitting.value = false\r\n      }\r\n    }\r\n\r\n    onMounted(fetchFormStructure)\r\n\r\n    return {\r\n      dialog,\r\n      isEdit,\r\n      form,\r\n      formFields,\r\n      errorMessages,\r\n      generalError,\r\n      isSubmitting,\r\n      closeDialog,\r\n      submitForm,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA+DA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAK,EAAEC,SAAQ,QAAS,KAAI;AACpD,SAASC,2BAA2B,EAAEC,cAAc,EAAEC,iBAAgB,QAAS,gBAAe;AAE9F,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,KAAK,EAAE;IACLC,UAAU,EAAEC,OAAO;IACnBC,QAAQ,EAAEC;EACZ,CAAC;EACDC,KAAK,EAAE,CAAC,mBAAmB,EAAE,mBAAmB,EAAE,qBAAqB,CAAC;EACxEC,KAAKA,CAACN,KAAK,EAAE;IAAEO;EAAK,CAAC,EAAE;IACrB,MAAMC,MAAK,GAAIf,QAAQ,CAAC;MACtBgB,GAAG,EAAEA,CAAA,KAAMT,KAAK,CAACC,UAAU;MAC3BS,GAAG,EAAGC,KAAK,IAAKJ,IAAI,CAAC,mBAAmB,EAAEI,KAAK;IACjD,CAAC;IACD,MAAMC,MAAK,GAAInB,QAAQ,CAAC,MAAM,CAAC,CAACO,KAAK,CAACG,QAAQ;IAC9C,MAAMU,IAAG,GAAIrB,GAAG,CAAC,CAAC,CAAC;IACnB,MAAMsB,UAAS,GAAItB,GAAG,CAAC,EAAE;IACzB,MAAMuB,aAAY,GAAIvB,GAAG,CAAC,CAAC,CAAC;IAC5B,MAAMwB,YAAW,GAAIxB,GAAG,CAAC,EAAE;IAC3B,MAAMyB,YAAW,GAAIzB,GAAG,CAAC,KAAK;IAE9B,MAAM0B,cAAa,GAAIA,CAAA,KAAM;MAC3B,IAAIJ,UAAU,CAACH,KAAI,IAAKG,UAAU,CAACH,KAAK,CAACQ,MAAK,GAAI,CAAC,EAAE;QACnDN,IAAI,CAACF,KAAI,GAAIG,UAAU,CAACH,KAAK,CAACS,MAAM,CAAC,CAACC,GAAG,EAAEC,KAAK,KAAK;UACnDD,GAAG,CAACC,KAAK,CAACvB,IAAI,IAAI,EAAC;UACnB,OAAOsB,GAAE;QACX,CAAC,EAAE,CAAC,CAAC;QACLN,aAAa,CAACJ,KAAI,GAAIG,UAAU,CAACH,KAAK,CAACS,MAAM,CAAC,CAACC,GAAG,EAAEC,KAAK,KAAK;UAC5DD,GAAG,CAACC,KAAK,CAACvB,IAAI,IAAI,EAAC;UACnB,OAAOsB,GAAE;QACX,CAAC,EAAE,CAAC,CAAC;MACP,OAAO;QACLL,YAAY,CAACL,KAAI,GAAI,8CAA6C;MACpE;IACF;IAEA,MAAMY,kBAAiB,GAAI,MAAAA,CAAA,KAAY;MACrC