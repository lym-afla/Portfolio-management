{"ast":null,"code":"import { ref, computed, onMounted } from 'vue';\n//   import { useStore } from 'vuex'\nimport { getBrokersForDatabase, createBroker, updateBroker, deleteBroker } from '@/services/api';\nexport default {\n  name: 'BrokersPage',\n  setup() {\n    //   const store = useStore()\n    const brokers = ref([]);\n    const loading = ref(true);\n    const dialog = ref(false);\n    const editedIndex = ref(-1);\n    const editedItem = ref({\n      name: '',\n      country: '',\n      comment: '',\n      restricted: false\n    });\n    const defaultItem = {\n      name: '',\n      country: '',\n      comment: '',\n      restricted: false\n    };\n    const headers = [{\n      title: 'Name',\n      key: 'name'\n    }, {\n      title: 'Country',\n      key: 'country'\n    }, {\n      title: 'Restricted',\n      key: 'restricted'\n    }, {\n      title: 'Actions',\n      key: 'actions',\n      sortable: false\n    }];\n    const formTitle = computed(() => {\n      return editedIndex.value === -1 ? 'New Broker' : 'Edit Broker';\n    });\n    const itemsPerPage = ref(10);\n    const currentPage = ref(1);\n    const totalItems = ref(0);\n    const sortBy = ref([]);\n    const itemsPerPageOptions = [5, 10, 25, 50];\n    const fetchBrokers = async () => {\n      loading.value = true;\n      try {\n        const response = await getBrokersForDatabase({\n          page: currentPage.value,\n          itemsPerPage: itemsPerPage.value,\n          sortBy: sortBy.value[0] || {}\n        });\n        brokers.value = response.brokers;\n        totalItems.value = response.total_items;\n      } catch (error) {\n        console.error('Error fetching brokers:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleTableUpdate = options => {\n      currentPage.value = options.page;\n      itemsPerPage.value = options.itemsPerPage;\n      sortBy.value = options.sortBy;\n      fetchBrokers();\n    };\n    const openAddDialog = () => {\n      editedIndex.value = -1;\n      editedItem.value = Object.assign({}, defaultItem);\n      dialog.value = true;\n    };\n    const editBroker = item => {\n      editedIndex.value = brokers.value.indexOf(item);\n      editedItem.value = Object.assign({}, item);\n      dialog.value = true;\n    };\n    const triggerDeleteBroker = async item => {\n      const confirm = window.confirm('Are you sure you want to delete this broker?');\n      if (confirm) {\n        try {\n          await deleteBroker(item.id);\n          fetchBrokers();\n        } catch (error) {\n          console.error('Error deleting broker:', error);\n        }\n      }\n    };\n    const close = () => {\n      dialog.value = false;\n      editedIndex.value = -1;\n      editedItem.value = Object.assign({}, defaultItem);\n    };\n    const save = async () => {\n      try {\n        if (editedIndex.value > -1) {\n          await updateBroker(editedItem.value.id, editedItem.value);\n        } else {\n          await createBroker(editedItem.value);\n        }\n        close();\n        fetchBrokers();\n      } catch (error) {\n        console.error('Error saving broker:', error);\n      }\n    };\n    onMounted(() => {\n      fetchBrokers();\n    });\n    return {\n      brokers,\n      loading,\n      headers,\n      dialog,\n      editedIndex,\n      editedItem,\n      formTitle,\n      itemsPerPage,\n      currentPage,\n      totalItems,\n      sortBy,\n      itemsPerPageOptions,\n      handleTableUpdate,\n      openAddDialog,\n      editBroker,\n      triggerDeleteBroker,\n      close,\n      save\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","getBrokersForDatabase","createBroker","updateBroker","deleteBroker","name","setup","brokers","loading","dialog","editedIndex","editedItem","country","comment","restricted","defaultItem","headers","title","key","sortable","formTitle","value","itemsPerPage","currentPage","totalItems","sortBy","itemsPerPageOptions","fetchBrokers","response","page","total_items","error","console","handleTableUpdate","options","openAddDialog","Object","assign","editBroker","item","indexOf","triggerDeleteBroker","confirm","window","id","close","save"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\BrokersPage.vue"],"sourcesContent":["<template>\r\n    <div>\r\n      <v-data-table\r\n        :headers=\"headers\"\r\n        :items=\"brokers\"\r\n        :loading=\"loading\"\r\n        :items-per-page=\"itemsPerPage\"\r\n        :page=\"currentPage\"\r\n        :items-per-page-options=\"itemsPerPageOptions\"\r\n        :server-items-length=\"totalItems\"\r\n        :sort-by=\"sortBy\"\r\n        @update:options=\"handleTableUpdate\"\r\n      >\r\n        <template v-slot:top>\r\n          <v-toolbar flat>\r\n            <v-toolbar-title>Brokers</v-toolbar-title>\r\n            <v-divider class=\"mx-4\" inset vertical></v-divider>\r\n            <v-spacer></v-spacer>\r\n            <v-btn color=\"primary\" dark class=\"mb-2\" @click=\"openAddDialog\">\r\n              Add Broker\r\n            </v-btn>\r\n          </v-toolbar>\r\n        </template>\r\n        <template v-slot:[`item.actions`]=\"{ item }\">\r\n          <v-icon small class=\"mr-2\" @click=\"editBroker(item)\">\r\n            mdi-pencil\r\n          </v-icon>\r\n          <v-icon small @click=\"triggerDeleteBroker(item)\">\r\n            mdi-delete\r\n          </v-icon>\r\n        </template>\r\n      </v-data-table>\r\n  \r\n      <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n        <v-card>\r\n          <v-card-title>\r\n            <span class=\"text-h5\">{{ formTitle }}</span>\r\n          </v-card-title>\r\n          <v-card-text>\r\n            <v-container>\r\n              <v-row>\r\n                <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                  <v-text-field v-model=\"editedItem.name\" label=\"Name\"></v-text-field>\r\n                </v-col>\r\n                <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                  <v-text-field v-model=\"editedItem.country\" label=\"Country\"></v-text-field>\r\n                </v-col>\r\n                <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                  <v-checkbox v-model=\"editedItem.restricted\" label=\"Restricted\"></v-checkbox>\r\n                </v-col>\r\n                <v-col cols=\"12\">\r\n                  <v-textarea v-model=\"editedItem.comment\" label=\"Comment\"></v-textarea>\r\n                </v-col>\r\n              </v-row>\r\n            </v-container>\r\n          </v-card-text>\r\n          <v-card-actions>\r\n            <v-spacer></v-spacer>\r\n            <v-btn color=\"blue darken-1\" text @click=\"close\">Cancel</v-btn>\r\n            <v-btn color=\"blue darken-1\" text @click=\"save\">Save</v-btn>\r\n          </v-card-actions>\r\n        </v-card>\r\n      </v-dialog>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref, computed, onMounted } from 'vue'\r\n//   import { useStore } from 'vuex'\r\n  import { getBrokersForDatabase, createBroker, updateBroker, deleteBroker } from '@/services/api'\r\n  \r\n  export default {\r\n    name: 'BrokersPage',\r\n    setup() {\r\n    //   const store = useStore()\r\n      const brokers = ref([])\r\n      const loading = ref(true)\r\n      const dialog = ref(false)\r\n      const editedIndex = ref(-1)\r\n      const editedItem = ref({\r\n        name: '',\r\n        country: '',\r\n        comment: '',\r\n        restricted: false\r\n      })\r\n      const defaultItem = {\r\n        name: '',\r\n        country: '',\r\n        comment: '',\r\n        restricted: false\r\n      }\r\n  \r\n      const headers = [\r\n        { title: 'Name', key: 'name' },\r\n        { title: 'Country', key: 'country' },\r\n        { title: 'Restricted', key: 'restricted' },\r\n        { title: 'Actions', key: 'actions', sortable: false }\r\n      ]\r\n  \r\n      const formTitle = computed(() => {\r\n        return editedIndex.value === -1 ? 'New Broker' : 'Edit Broker'\r\n      })\r\n  \r\n      const itemsPerPage = ref(10)\r\n      const currentPage = ref(1)\r\n      const totalItems = ref(0)\r\n      const sortBy = ref([])\r\n      const itemsPerPageOptions = [5, 10, 25, 50]\r\n  \r\n      const fetchBrokers = async () => {\r\n        loading.value = true\r\n        try {\r\n          const response = await getBrokersForDatabase({\r\n            page: currentPage.value,\r\n            itemsPerPage: itemsPerPage.value,\r\n            sortBy: sortBy.value[0] || {}\r\n          })\r\n          brokers.value = response.brokers\r\n          totalItems.value = response.total_items\r\n        } catch (error) {\r\n          console.error('Error fetching brokers:', error)\r\n        } finally {\r\n          loading.value = false\r\n        }\r\n      }\r\n  \r\n      const handleTableUpdate = (options) => {\r\n        currentPage.value = options.page\r\n        itemsPerPage.value = options.itemsPerPage\r\n        sortBy.value = options.sortBy\r\n        fetchBrokers()\r\n      }\r\n  \r\n      const openAddDialog = () => {\r\n        editedIndex.value = -1\r\n        editedItem.value = Object.assign({}, defaultItem)\r\n        dialog.value = true\r\n      }\r\n  \r\n      const editBroker = (item) => {\r\n        editedIndex.value = brokers.value.indexOf(item)\r\n        editedItem.value = Object.assign({}, item)\r\n        dialog.value = true\r\n      }\r\n  \r\n      const triggerDeleteBroker = async (item) => {\r\n        const confirm = window.confirm('Are you sure you want to delete this broker?')\r\n        if (confirm) {\r\n          try {\r\n            await deleteBroker(item.id)\r\n            fetchBrokers()\r\n          } catch (error) {\r\n            console.error('Error deleting broker:', error)\r\n          }\r\n        }\r\n      }\r\n  \r\n      const close = () => {\r\n        dialog.value = false\r\n        editedIndex.value = -1\r\n        editedItem.value = Object.assign({}, defaultItem)\r\n      }\r\n  \r\n      const save = async () => {\r\n        try {\r\n          if (editedIndex.value > -1) {\r\n            await updateBroker(editedItem.value.id, editedItem.value)\r\n          } else {\r\n            await createBroker(editedItem.value)\r\n          }\r\n          close()\r\n          fetchBrokers()\r\n        } catch (error) {\r\n          console.error('Error saving broker:', error)\r\n        }\r\n      }\r\n  \r\n      onMounted(() => {\r\n        fetchBrokers()\r\n      })\r\n  \r\n      return {\r\n        brokers,\r\n        loading,\r\n        headers,\r\n        dialog,\r\n        editedIndex,\r\n        editedItem,\r\n        formTitle,\r\n        itemsPerPage,\r\n        currentPage,\r\n        totalItems,\r\n        sortBy,\r\n        itemsPerPageOptions,\r\n        handleTableUpdate,\r\n        openAddDialog,\r\n        editBroker,\r\n        triggerDeleteBroker,\r\n        close,\r\n        save\r\n      }\r\n    }\r\n  }\r\n  </script>"],"mappings":"AAmEE,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AAC/C;AACE,SAASC,qBAAqB,EAAEC,YAAY,EAAEC,YAAY,EAAEC,YAAW,QAAS,gBAAe;AAE/F,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,KAAKA,CAAA,EAAG;IACR;IACE,MAAMC,OAAM,GAAIT,GAAG,CAAC,EAAE;IACtB,MAAMU,OAAM,GAAIV,GAAG,CAAC,IAAI;IACxB,MAAMW,MAAK,GAAIX,GAAG,CAAC,KAAK;IACxB,MAAMY,WAAU,GAAIZ,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAMa,UAAS,GAAIb,GAAG,CAAC;MACrBO,IAAI,EAAE,EAAE;MACRO,OAAO,EAAE,EAAE;MACXC,OAAO,EAAE,EAAE;MACXC,UAAU,EAAE;IACd,CAAC;IACD,MAAMC,WAAU,GAAI;MAClBV,IAAI,EAAE,EAAE;MACRO,OAAO,EAAE,EAAE;MACXC,OAAO,EAAE,EAAE;MACXC,UAAU,EAAE;IACd;IAEA,MAAME,OAAM,GAAI,CACd;MAAEC,KAAK,EAAE,MAAM;MAAEC,GAAG,EAAE;IAAO,CAAC,EAC9B;MAAED,KAAK,EAAE,SAAS;MAAEC,GAAG,EAAE;IAAU,CAAC,EACpC;MAAED,KAAK,EAAE,YAAY;MAAEC,GAAG,EAAE;IAAa,CAAC,EAC1C;MAAED,KAAK,EAAE,SAAS;MAAEC,GAAG,EAAE,SAAS;MAAEC,QAAQ,EAAE;IAAM,EACtD;IAEA,MAAMC,SAAQ,GAAIrB,QAAQ,CAAC,MAAM;MAC/B,OAAOW,WAAW,CAACW,KAAI,KAAM,CAAC,IAAI,YAAW,GAAI,aAAY;IAC/D,CAAC;IAED,MAAMC,YAAW,GAAIxB,GAAG,CAAC,EAAE;IAC3B,MAAMyB,WAAU,GAAIzB,