{"ast":null,"code":"import { ref, reactive } from 'vue';\nimport { useStore } from 'vuex';\nexport default {\n  setup() {\n    const store = useStore();\n    const dialog = ref(false);\n    const form = ref(null);\n    const formFields = [{\n      name: 'custom_brokers',\n      label: 'Brokers',\n      type: 'select',\n      choices: [{\n        text: 'All brokers',\n        value: 'All brokers'\n      }, {\n        text: 'Broker 1',\n        value: 'Broker 1'\n      }, {\n        text: 'Broker 2',\n        value: 'Broker 2'\n      }\n      // Add more broker options as needed\n      ],\n      rules: [v => !!v || 'Broker is required']\n    }, {\n      name: 'default_currency',\n      label: 'Currency',\n      type: 'select',\n      choices: [{\n        text: 'USD',\n        value: 'USD'\n      }, {\n        text: 'EUR',\n        value: 'EUR'\n      }, {\n        text: 'GBP',\n        value: 'GBP'\n      }\n      // Add more currency options as needed\n      ],\n      rules: [v => !!v || 'Currency is required']\n    }, {\n      name: 'table_date',\n      label: 'Date',\n      type: 'date',\n      rules: [v => !!v || 'Date is required']\n    }, {\n      name: 'digits',\n      label: 'Number of digits',\n      type: 'number',\n      rules: [v => !!v || 'Number of digits is required', v => v && v >= 0 && v <= 6 || 'Number of digits must be between 0 and 6']\n    }];\n    const formData = reactive({\n      custom_brokers: '',\n      default_currency: '',\n      table_date: '',\n      digits: 0\n    });\n    const openDialog = () => {\n      dialog.value = true;\n      document.body.style.overflow = 'hidden';\n    };\n    const closeDialog = () => {\n      dialog.value = false;\n      document.body.style.overflow = '';\n    };\n    const saveSettings = async () => {\n      const isValid = await form.value.validate();\n      if (isValid.valid) {\n        try {\n          await store.dispatch('updateUserSettings', formData);\n          closeDialog();\n          // Trigger a data refresh\n          store.dispatch('triggerDataRefresh');\n        } catch (error) {\n          console.error('Failed to save settings:', error);\n        }\n      }\n    };\n    return {\n      dialog,\n      formFields,\n      formData,\n      form,\n      openDialog,\n      closeDialog,\n      saveSettings\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","useStore","setup","store","dialog","form","formFields","name","label","type","choices","text","value","rules","v","formData","custom_brokers","default_currency","table_date","digits","openDialog","document","body","style","overflow","closeDialog","saveSettings","isValid","validate","valid","dispatch","error","console"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\SettingsDialog.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-btn icon @click=\"openDialog\">\r\n      <v-icon>mdi-cog</v-icon>\r\n    </v-btn>\r\n\r\n    <v-dialog v-model=\"dialog\" max-width=\"600px\" persistent scrollable>\r\n      <v-card>\r\n        <v-card-title class=\"text-h5\">\r\n          Settings\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"saveSettings\" ref=\"form\">\r\n            <v-row>\r\n              <v-col cols=\"12\" sm=\"6\" v-for=\"field in formFields\" :key=\"field.name\">\r\n                <v-select\r\n                  v-if=\"field.type === 'select'\"\r\n                  v-model=\"formData[field.name]\"\r\n                  :items=\"field.choices\"\r\n                  :label=\"field.label\"\r\n                  :rules=\"field.rules\"\r\n                ></v-select>\r\n                <v-text-field\r\n                  v-else-if=\"field.type === 'number'\"\r\n                  v-model.number=\"formData[field.name]\"\r\n                  :label=\"field.label\"\r\n                  type=\"number\"\r\n                  :rules=\"field.rules\"\r\n                ></v-text-field>\r\n                <v-text-field\r\n                  v-else-if=\"field.type === 'date'\"\r\n                  v-model=\"formData[field.name]\"\r\n                  :label=\"field.label\"\r\n                  type=\"date\"\r\n                  :rules=\"field.rules\"\r\n                ></v-text-field>\r\n              </v-col>\r\n            </v-row>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"closeDialog\">Close</v-btn>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"saveSettings\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive } from 'vue'\r\nimport { useStore } from 'vuex'\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore()\r\n    const dialog = ref(false)\r\n    const form = ref(null)\r\n\r\n    const formFields = [\r\n      {\r\n        name: 'custom_brokers',\r\n        label: 'Brokers',\r\n        type: 'select',\r\n        choices: [\r\n          { text: 'All brokers', value: 'All brokers' },\r\n          { text: 'Broker 1', value: 'Broker 1' },\r\n          { text: 'Broker 2', value: 'Broker 2' },\r\n          // Add more broker options as needed\r\n        ],\r\n        rules: [v => !!v || 'Broker is required'],\r\n      },\r\n      {\r\n        name: 'default_currency',\r\n        label: 'Currency',\r\n        type: 'select',\r\n        choices: [\r\n          { text: 'USD', value: 'USD' },\r\n          { text: 'EUR', value: 'EUR' },\r\n          { text: 'GBP', value: 'GBP' },\r\n          // Add more currency options as needed\r\n        ],\r\n        rules: [v => !!v || 'Currency is required'],\r\n      },\r\n      {\r\n        name: 'table_date',\r\n        label: 'Date',\r\n        type: 'date',\r\n        rules: [v => !!v || 'Date is required'],\r\n      },\r\n      {\r\n        name: 'digits',\r\n        label: 'Number of digits',\r\n        type: 'number',\r\n        rules: [\r\n          v => !!v || 'Number of digits is required',\r\n          v => (v && v >= 0 && v <= 6) || 'Number of digits must be between 0 and 6',\r\n        ],\r\n      },\r\n    ]\r\n\r\n    const formData = reactive({\r\n      custom_brokers: '',\r\n      default_currency: '',\r\n      table_date: '',\r\n      digits: 0,\r\n    })\r\n\r\n    const openDialog = () => {\r\n      dialog.value = true\r\n      document.body.style.overflow = 'hidden'\r\n    }\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      document.body.style.overflow = ''\r\n    }\r\n\r\n    const saveSettings = async () => {\r\n      const isValid = await form.value.validate()\r\n      if (isValid.valid) {\r\n        try {\r\n          await store.dispatch('updateUserSettings', formData)\r\n          closeDialog()\r\n          // Trigger a data refresh\r\n          store.dispatch('triggerDataRefresh')\r\n        } catch (error) {\r\n          console.error('Failed to save settings:', error)\r\n        }\r\n      }\r\n    }\r\n\r\n    return {\r\n      dialog,\r\n      formFields,\r\n      formData,\r\n      form,\r\n      openDialog,\r\n      closeDialog,\r\n      saveSettings\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAmDA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIF,QAAQ,CAAC;IACvB,MAAMG,MAAK,GAAIL,GAAG,CAAC,KAAK;IACxB,MAAMM,IAAG,GAAIN,GAAG,CAAC,IAAI;IAErB,MAAMO,UAAS,GAAI,CACjB;MACEC,IAAI,EAAE,gBAAgB;MACtBC,KAAK,EAAE,SAAS;MAChBC,IAAI,EAAE,QAAQ;MACdC,OAAO,EAAE,CACP;QAAEC,IAAI,EAAE,aAAa;QAAEC,KAAK,EAAE;MAAc,CAAC,EAC7C;QAAED,IAAI,EAAE,UAAU;QAAEC,KAAK,EAAE;MAAW,CAAC,EACvC;QAAED,IAAI,EAAE,UAAU;QAAEC,KAAK,EAAE;MAAW;MACtC;MAAA,CACD;MACDC,KAAK,EAAE,CAACC,CAAA,IAAK,CAAC,CAACA,CAAA,IAAK,oBAAoB;IAC1C,CAAC,EACD;MACEP,IAAI,EAAE,kBAAkB;MACxBC,KAAK,EAAE,UAAU;MACjBC,IAAI,EAAE,QAAQ;MACdC,OAAO,EAAE,CACP;QAAEC,IAAI,EAAE,KAAK;QAAEC,KAAK,EAAE;MAA