{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { Pie } from 'vue-chartjs';\nimport { Chart as ChartJS, Title, Tooltip, Legend, ArcElement, CategoryScale } from 'chart.js';\nChartJS.register(Title, Tooltip, Legend, ArcElement, CategoryScale);\nexport default {\n  name: 'BreakdownChart',\n  components: {\n    Pie\n  },\n  props: {\n    title: {\n      type: String,\n      required: true\n    },\n    data: {\n      type: Object,\n      required: true\n    },\n    currency: {\n      type: String,\n      default: 'USD'\n    }\n  },\n  setup(props) {\n    const tab = ref('chart');\n    const sortedData = computed(() => {\n      return Object.entries(props.data).map(([label, value]) => ({\n        label,\n        value: parseFloat(value.amount)\n      })).sort((a, b) => b.value - a.value);\n    });\n    const chartData = computed(() => ({\n      labels: sortedData.value.map(item => item.label),\n      datasets: [{\n        data: sortedData.value.map(item => item.value),\n        backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40']\n      }]\n    }));\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false\n    };\n    const totalAmount = computed(() => sortedData.value.reduce((sum, item) => sum + item.value, 0));\n    const formatCurrency = value => {\n      return new Intl.NumberFormat('en-US', {\n        style: 'currency',\n        currency: props.currency,\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(value);\n    };\n    const formatPercentage = value => {\n      return (value / totalAmount.value * 100).toFixed(2) + '%';\n    };\n    return {\n      tab,\n      chartData,\n      chartOptions,\n      totalAmount,\n      sortedData,\n      formatCurrency,\n      formatPercentage\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","Pie","Chart","ChartJS","Title","Tooltip","Legend","ArcElement","CategoryScale","register","name","components","props","title","type","String","required","data","Object","currency","default","setup","tab","sortedData","entries","map","label","value","parseFloat","amount","sort","a","b","chartData","labels","item","datasets","backgroundColor","chartOptions","responsive","maintainAspectRatio","totalAmount","reduce","sum","formatCurrency","Intl","NumberFormat","style","minimumFractionDigits","maximumFractionDigits","format","formatPercentage","toFixed"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\BreakdownChart.vue"],"sourcesContent":["<template>\r\n  <v-card>\r\n    <v-card-title>{{ title }}</v-card-title>\r\n    <v-card-text class=\"pa-0\">\r\n      <v-tabs v-model=\"tab\">\r\n        <v-tab value=\"chart\">Pie Chart</v-tab>\r\n        <v-tab value=\"table\">Table</v-tab>\r\n      </v-tabs>\r\n\r\n      <v-window v-model=\"tab\">\r\n        <v-window-item value=\"chart\">\r\n          <Pie :data=\"chartData\" :options=\"chartOptions\" />\r\n        </v-window-item>\r\n\r\n        <v-window-item value=\"table\">\r\n          <v-table density=\"compact\">\r\n            <thead>\r\n              <tr>\r\n                <th class=\"text-left category-column\"></th>\r\n                <th class=\"text-right font-weight-bold\">{{ currency }}</th>\r\n                <th class=\"text-right font-weight-bold\">%</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr v-for=\"(item, index) in sortedData\" :key=\"index\">\r\n                <td class=\"text-left category-column\">{{ item.label }}</td>\r\n                <td class=\"text-right\">{{ formatCurrency(item.value) }}</td>\r\n                <td class=\"text-right\">{{ formatPercentage(item.value) }}</td>\r\n              </tr>\r\n              <tr class=\"font-weight-bold\">\r\n                <td class=\"text-left category-column\">Total</td>\r\n                <td class=\"text-right\">{{ formatCurrency(totalAmount) }}</td>\r\n                <td class=\"text-right\">100.00%</td>\r\n              </tr>\r\n            </tbody>\r\n          </v-table>\r\n        </v-window-item>\r\n      </v-window>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport { Pie } from 'vue-chartjs'\r\nimport { Chart as ChartJS, Title, Tooltip, Legend, ArcElement, CategoryScale } from 'chart.js'\r\n\r\nChartJS.register(Title, Tooltip, Legend, ArcElement, CategoryScale)\r\n\r\nexport default {\r\n  name: 'BreakdownChart',\r\n  components: { Pie },\r\n  props: {\r\n    title: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    data: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    currency: {\r\n      type: String,\r\n      default: 'USD'\r\n    }\r\n  },\r\n  setup(props) {\r\n    const tab = ref('chart')\r\n\r\n    const sortedData = computed(() => {\r\n      return Object.entries(props.data)\r\n        .map(([label, value]) => ({ label, value: parseFloat(value.amount) }))\r\n        .sort((a, b) => b.value - a.value)\r\n    })\r\n\r\n    const chartData = computed(() => ({\r\n      labels: sortedData.value.map(item => item.label),\r\n      datasets: [{\r\n        data: sortedData.value.map(item => item.value),\r\n        backgroundColor: [\r\n          '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40',\r\n          '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'\r\n        ]\r\n      }]\r\n    }))\r\n\r\n    const chartOptions = {\r\n      responsive: true,\r\n      maintainAspectRatio: false\r\n    }\r\n\r\n    const totalAmount = computed(() => \r\n      sortedData.value.reduce((sum, item) => sum + item.value, 0)\r\n    )\r\n\r\n    const formatCurrency = (value) => {\r\n      return new Intl.NumberFormat('en-US', {\r\n        style: 'currency',\r\n        currency: props.currency,\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(value)\r\n    }\r\n\r\n    const formatPercentage = (value) => {\r\n      return ((value / totalAmount.value) * 100).toFixed(2) + '%'\r\n    }\r\n\r\n    return {\r\n      tab,\r\n      chartData,\r\n      chartOptions,\r\n      totalAmount,\r\n      sortedData,\r\n      formatCurrency,\r\n      formatPercentage\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.category-column {\r\n  width: 50%;\r\n}\r\n\r\n.v-table :deep(th) {\r\n  font-weight: bold !important;\r\n}\r\n\r\n.v-table :deep(td), .v-table :deep(th) {\r\n  padding: 0 16px !important;\r\n}\r\n</style>"],"mappings":"AA2CA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,GAAE,QAAS,aAAY;AAChC,SAASC,KAAI,IAAKC,OAAO,EAAEC,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,UAAU,EAAEC,aAAY,QAAS,UAAS;AAE7FL,OAAO,CAACM,QAAQ,CAACL,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,UAAU,EAAEC,aAAa;AAElE,eAAe;EACbE,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAEV;EAAI,CAAC;EACnBW,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,IAAI,EAAE;MACJH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ,CAAC;IACDG,QAAQ,EAAE;MACRL,IAAI,EAAEC,MAAM;MACZK,OAAO,EAAE;IACX;EACF,CAAC;EACDC,KAAKA,CAACT,KAAK,EAAE;IACX,MAAMU,GAAE,GAAIvB,GAAG,CAAC,OAAO;IAEvB,MAAMwB,UAAS,GAAIvB,QAAQ,CAAC,MAAM;MAChC,OAAOkB,MAAM,CAACM,OAAO,CAACZ,KAAK,CAACK,IAAI,EAC7BQ,GAAG,CAAC,CAAC,CAACC,KAAK,EAAEC,KAAK,CAAC,MAAM;QAAED,KAAK;QAAEC,KAAK,EAAEC,UAAU,CAACD,KAAK,CAACE,MAAM;MAAE,CAAC,CAAC,EACpEC,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKA,CAAC,CAACL,KAAI,GAAII,CAAC,CAACJ,KAAK;IACrC,CAAC;IAED,MAAMM,SAAQ,GAAIjC,QAAQ,CAAC,OAAO;MAChCkC,MAAM,EAAEX,UAAU,CAACI,KAAK,CAACF,GAAG,CAACU,IAAG,IAAKA,IAAI,CAACT,KAAK,CAAC;MAChDU,QAAQ,EAAE,CAAC;QACTnB,IAAI,EAAEM,UAAU,CAACI,KAAK,CAACF,GAAG,CAACU,IAAG,IAAKA,IAAI,CAACR,KAAK,CAAC;QAC9CU,eAAe,EAAE,CACf,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAChE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAQ;MAEnE,CAAC;IACH,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAI;MACnBC,UAAU,EAAE,IAAI;MAChBC,mBAAmB,EAAE;IACvB;IAEA,MAAMC