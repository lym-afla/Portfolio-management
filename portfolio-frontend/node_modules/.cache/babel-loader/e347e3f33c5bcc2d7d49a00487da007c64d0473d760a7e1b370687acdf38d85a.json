{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport LoginForm from '@/components/LoginForm.vue';\nexport default {\n  name: 'LoginPage',\n  components: {\n    LoginForm\n  },\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const error = ref('');\n    const loading = ref(false);\n    const handleLogin = async credentials => {\n      try {\n        loading.value = true;\n        const result = await store.dispatch('login', credentials);\n        if (result.success) {\n          router.push('/dashboard');\n        } else {\n          error.value = 'Login failed. Please try again.';\n        }\n      } catch (err) {\n        console.error('Login error:', err);\n        error.value = 'An unexpected error occurred. Please try again.';\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      handleLogin,\n      error,\n      loading\n    };\n  }\n};","map":{"version":3,"names":["ref","useStore","useRouter","LoginForm","name","components","setup","store","router","error","loading","handleLogin","credentials","value","result","dispatch","success","push","err","console"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\LoginPage.vue"],"sourcesContent":["<template>\r\n  <v-container class=\"fill-height\" fluid>\r\n    <v-row align=\"center\" justify=\"center\">\r\n      <v-col cols=\"12\" sm=\"8\" md=\"4\">\r\n        <v-card class=\"pa-4\">\r\n          <v-card-title class=\"headline\">Login</v-card-title>\r\n          <v-card-text>\r\n            <LoginForm \r\n              @submit=\"handleLogin\" \r\n              :loading=\"loading\" \r\n            />\r\n            <v-alert v-if=\"error\" type=\"error\" class=\"mt-3\">\r\n              {{ error }}\r\n            </v-alert>\r\n          </v-card-text>\r\n          <v-card-actions>\r\n            <v-spacer></v-spacer>\r\n            <span>Don't have an account? <router-link to=\"/register\">Register</router-link></span>\r\n          </v-card-actions>\r\n        </v-card>\r\n      </v-col>\r\n    </v-row>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { useRouter } from 'vue-router'\r\nimport LoginForm from '@/components/LoginForm.vue'\r\n\r\nexport default {\r\n  name: 'LoginPage',\r\n  components: {\r\n    LoginForm\r\n  },\r\n  setup() {\r\n    const store = useStore()\r\n    const router = useRouter()\r\n    const error = ref('')\r\n    const loading = ref(false)\r\n\r\n    const handleLogin = async (credentials) => {\r\n      try {\r\n        loading.value = true\r\n        const result = await store.dispatch('login', credentials)\r\n        if (result.success) {\r\n          router.push('/dashboard')\r\n        } else {\r\n          error.value = 'Login failed. Please try again.'\r\n        }\r\n      } catch (err) {\r\n        console.error('Login error:', err)\r\n        error.value = 'An unexpected error occurred. Please try again.'\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    return { handleLogin, error, loading }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-card-actions a {\r\n  text-decoration: none;\r\n  color: #1976D2;\r\n}\r\n</style>"],"mappings":";AA0BA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AACrC,OAAOC,SAAQ,MAAO,4BAA2B;AAEjD,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IACvB,MAAMO,MAAK,GAAIN,SAAS,CAAC;IACzB,MAAMO,KAAI,GAAIT,GAAG,CAAC,EAAE;IACpB,MAAMU,OAAM,GAAIV,GAAG,CAAC,KAAK;IAEzB,MAAMW,WAAU,GAAI,MAAOC,WAAW,IAAK;MACzC,IAAI;QACFF,OAAO,CAACG,KAAI,GAAI,IAAG;QACnB,MAAMC,MAAK,GAAI,MAAMP,KAAK,CAACQ,QAAQ,CAAC,OAAO,EAAEH,WAAW;QACxD,IAAIE,MAAM,CAACE,OAAO,EAAE;UAClBR,MAAM,CAACS,IAAI,CAAC,YAAY;QAC1B,OAAO;UACLR,KAAK,CAACI,KAAI,GAAI