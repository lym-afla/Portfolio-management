{"ast":null,"code":"import { ref, watch, onMounted, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { Chart, registerables } from 'chart.js';\nimport { getChartOptions } from '@/config/chartConfig';\nimport DateRangeSelector from '@/components/DateRangeSelector.vue';\n// import { calculateDateRange } from '@/utils/dateRangeUtils'\n\nChart.register(...registerables);\nexport default {\n  name: 'NAVChart',\n  components: {\n    DateRangeSelector\n  },\n  props: {\n    chartData: {\n      type: Object,\n      required: true\n    },\n    loading: {\n      type: Boolean,\n      default: false\n    },\n    initialParams: {\n      type: Object,\n      required: true\n    },\n    effectiveCurrentDate: {\n      type: String,\n      required: true\n    }\n  },\n  emits: ['update-params'],\n  setup(props, {\n    emit\n  }) {\n    const store = useStore();\n    const chartRef = ref(null);\n    const chartInstance = ref(null);\n    const navChartParams = computed(() => store.state.navChartParams);\n    const selectedBreakdown = ref(navChartParams.value.breakdown);\n    const selectedFrequency = ref(navChartParams.value.frequency);\n    const dateRange = ref(navChartParams.value.dateRange);\n    const dateFrom = ref(navChartParams.value.dateFrom);\n    const dateTo = ref(navChartParams.value.dateTo);\n    const breakdownOptions = [{\n      title: 'Broker',\n      value: 'broker'\n    }, {\n      title: 'Asset Type',\n      value: 'asset_type'\n    }, {\n      title: 'Asset Class',\n      value: 'asset_class'\n    }, {\n      title: 'Currency',\n      value: 'currency'\n    }, {\n      title: 'No breakdown',\n      value: 'none'\n    }, {\n      title: 'Value Contributions',\n      value: 'value_contributions'\n    }];\n    const updateParams = () => {\n      const params = {\n        frequency: selectedFrequency.value,\n        dateFrom: dateFrom.value,\n        dateTo: dateTo.value,\n        breakdown: selectedBreakdown.value\n      };\n      store.dispatch('updateNavChartParams', params);\n      emit('update-params', params);\n    };\n    onMounted(() => {\n      initChart();\n    });\n    const initChart = async () => {\n      if (!chartRef.value || !props.chartData) return;\n      const ctx = chartRef.value.getContext('2d');\n      const {\n        navChartOptions,\n        colorPalette\n      } = await getChartOptions(props.chartData.currency);\n      if (chartInstance.value) {\n        chartInstance.value.destroy();\n      }\n      const datasets = props.chartData.datasets.map((dataset, index) => ({\n        ...dataset,\n        backgroundColor: dataset.type === 'bar' ? colorPalette[index % colorPalette.length] : dataset.backgroundColor,\n        // Set order for line charts to be higher (will be drawn last)\n        order: dataset.type === 'line' ? 0 : index + 1\n      }));\n      chartInstance.value = new Chart(ctx, {\n        type: 'bar',\n        data: {\n          ...props.chartData,\n          datasets: datasets\n        },\n        options: {\n          ...navChartOptions,\n          plugins: {\n            ...navChartOptions.plugins,\n            legend: {\n              ...navChartOptions.plugins.legend,\n              reverse: true // This will reverse the order of legend items\n            },\n            tooltip: {\n              ...navChartOptions.plugins.tooltip,\n              itemSort: (a, b) => a.datasetIndex - b.datasetIndex // Sort tooltip items to match visual order\n            }\n          }\n        }\n      });\n    };\n    watch(() => props.chartData, initChart, {\n      deep: true\n    });\n    return {\n      chartRef,\n      selectedBreakdown,\n      selectedFrequency,\n      dateRange,\n      dateFrom,\n      dateTo,\n      breakdownOptions,\n      updateParams\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","onMounted","computed","useStore","Chart","registerables","getChartOptions","DateRangeSelector","register","name","components","props","chartData","type","Object","required","loading","Boolean","default","initialParams","effectiveCurrentDate","String","emits","setup","emit","store","chartRef","chartInstance","navChartParams","state","selectedBreakdown","value","breakdown","selectedFrequency","frequency","dateRange","dateFrom","dateTo","breakdownOptions","title","updateParams","params","dispatch","initChart","ctx","getContext","navChartOptions","colorPalette","currency","destroy","datasets","map","dataset","index","backgroundColor","length","order","data","options","plugins","legend","reverse","tooltip","itemSort","a","b","datasetIndex","deep"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\NAVChart.vue"],"sourcesContent":["<template>\r\n  <v-card>\r\n    <v-card-title>Value and return over time</v-card-title>\r\n    <v-card-text>\r\n      <v-row>\r\n        <v-col cols=\"12\" sm=\"4\">\r\n          <v-select\r\n            v-model=\"selectedBreakdown\"\r\n            :items=\"breakdownOptions\"\r\n            label=\"Breakdown by\"\r\n            @update:model-value=\"updateParams\"\r\n          ></v-select>\r\n        </v-col>\r\n        <v-col cols=\"12\" sm=\"4\">\r\n          <v-btn-toggle v-model=\"selectedFrequency\" mandatory @update:model-value=\"updateParams\">\r\n            <v-btn value=\"D\">D</v-btn>\r\n            <v-btn value=\"W\">W</v-btn>\r\n            <v-btn value=\"M\">M</v-btn>\r\n            <v-btn value=\"Q\">Q</v-btn>\r\n            <v-btn value=\"Y\">Y</v-btn>\r\n          </v-btn-toggle>\r\n        </v-col>\r\n        <v-col cols=\"12\" sm=\"4\">\r\n          <DateRangeSelector v-model=\"dateRange\" @update:model-value=\"updateParams\" />\r\n        </v-col>\r\n      </v-row>\r\n      <div class=\"chart-wrapper\">\r\n        <canvas ref=\"chartRef\"></canvas>\r\n        <div v-if=\"loading\" class=\"chart-overlay\">\r\n          <v-progress-circular indeterminate color=\"primary\" size=\"64\" />\r\n        </div>\r\n      </div>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch, onMounted, computed } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { Chart, registerables } from 'chart.js'\r\nimport { getChartOptions } from '@/config/chartConfig'\r\nimport DateRangeSelector from '@/components/DateRangeSelector.vue'\r\n// import { calculateDateRange } from '@/utils/dateRangeUtils'\r\n\r\nChart.register(...registerables)\r\n\r\nexport default {\r\n  name: 'NAVChart',\r\n  components: { DateRangeSelector },\r\n  props: {\r\n    chartData: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    loading: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    initialParams: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    effectiveCurrentDate: {\r\n      type: String,\r\n      required: true\r\n    }\r\n  },\r\n  emits: ['update-params'],\r\n  setup(props, { emit }) {\r\n    const store = useStore()\r\n    const chartRef = ref(null)\r\n    const chartInstance = ref(null)\r\n\r\n    const navChartParams = computed(() => store.state.navChartParams)\r\n\r\n    const selectedBreakdown = ref(navChartParams.value.breakdown)\r\n    const selectedFrequency = ref(navChartParams.value.frequency)\r\n    const dateRange = ref(navChartParams.value.dateRange)\r\n    const dateFrom = ref(navChartParams.value.dateFrom)\r\n    const dateTo = ref(navChartParams.value.dateTo)\r\n\r\n    const breakdownOptions = [\r\n      { title: 'Broker', value: 'broker' },\r\n      { title: 'Asset Type', value: 'asset_type' },\r\n      { title: 'Asset Class', value: 'asset_class' },\r\n      { title: 'Currency', value: 'currency' },\r\n      { title: 'No breakdown', value: 'none' },\r\n      { title: 'Value Contributions', value: 'value_contributions' }\r\n    ]\r\n\r\n    const updateParams = () => {\r\n      const params = {\r\n        frequency: selectedFrequency.value,\r\n        dateFrom: dateFrom.value,\r\n        dateTo: dateTo.value,\r\n        breakdown: selectedBreakdown.value\r\n      }\r\n      store.dispatch('updateNavChartParams', params)\r\n      emit('update-params', params)\r\n    }\r\n\r\n    onMounted(() => {\r\n      initChart()\r\n    })\r\n\r\n    const initChart = async () => {\r\n      if (!chartRef.value || !props.chartData) return\r\n      const ctx = chartRef.value.getContext('2d')\r\n      const { navChartOptions, colorPalette } = await getChartOptions(props.chartData.currency)\r\n      if (chartInstance.value) {\r\n        chartInstance.value.destroy()\r\n      }\r\n\r\n      const datasets = props.chartData.datasets.map((dataset, index) => ({\r\n        ...dataset,\r\n        backgroundColor: dataset.type === 'bar' ? colorPalette[index % colorPalette.length] : dataset.backgroundColor,\r\n        // Set order for line charts to be higher (will be drawn last)\r\n        order: dataset.type === 'line' ? 0 : index + 1\r\n      }))\r\n\r\n      chartInstance.value = new Chart(ctx, {\r\n        type: 'bar',\r\n        data: {\r\n          ...props.chartData,\r\n          datasets: datasets,\r\n        },\r\n        options: {\r\n          ...navChartOptions,\r\n          plugins: {\r\n            ...navChartOptions.plugins,\r\n            legend: {\r\n              ...navChartOptions.plugins.legend,\r\n              reverse: true, // This will reverse the order of legend items\r\n            },\r\n            tooltip: {\r\n              ...navChartOptions.plugins.tooltip,\r\n              itemSort: (a, b) => a.datasetIndex - b.datasetIndex, // Sort tooltip items to match visual order\r\n            },\r\n          },\r\n        },\r\n      })\r\n    }\r\n\r\n    watch(() => props.chartData, initChart, { deep: true })\r\n\r\n    return {\r\n      chartRef,\r\n      selectedBreakdown,\r\n      selectedFrequency,\r\n      dateRange,\r\n      dateFrom,\r\n      dateTo,\r\n      breakdownOptions,\r\n      updateParams,\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chart-wrapper {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 600px;\r\n}\r\n\r\n.chart-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  background-color: rgba(255, 255, 255, 0.7);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 1;\r\n}\r\n</style>"],"mappings":"AAqCA,SAASA,GAAG,EAAEC,KAAK,EAAEC,SAAS,EAAEC,QAAO,QAAS,KAAI;AACpD,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,KAAK,EAAEC,aAAY,QAAS,UAAS;AAC9C,SAASC,eAAc,QAAS,sBAAqB;AACrD,OAAOC,iBAAgB,MAAO,oCAAmC;AACjE;;AAEAH,KAAK,CAACI,QAAQ,CAAC,GAAGH,aAAa;AAE/B,eAAe;EACbI,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEH;EAAkB,CAAC;EACjCI,KAAK,EAAE;IACLC,SAAS,EAAE;MACTC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,OAAO,EAAE;MACPH,IAAI,EAAEI,OAAO;MACbC,OAAO,EAAE;IACX,CAAC;IACDC,aAAa,EAAE;MACbN,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDK,oBAAoB,EAAE;MACpBP,IAAI,EAAEQ,MAAM;MACZN,QAAQ,EAAE;IACZ;EACF,CAAC;EACDO,KAAK,EAAE,CAAC,eAAe,CAAC;EACxBC,KAAKA,CAACZ,KAAK,EAAE;IAAEa;EAAK,CAAC,EAAE;IACrB,MAAMC,KAAI,GAAItB,QAAQ,CAAC;IACvB,MAAMuB,QAAO,GAAI3B,GAAG,CAAC,IAAI;IACzB,MAAM4B,aAAY,GAAI5B,GAAG,CAAC,IAAI;IAE9B,MAAM6B,cAAa,GAAI1B,QAAQ,CAAC,MAAMuB,KAAK,CAACI,KAAK,CAACD,cAAc;IAEhE,MAAME,iBAAgB,GAAI/B,GAAG,CAAC6B,cAAc,CAACG,KAAK,CAACC,SAAS;IAC5D,MAAMC,iBAAgB,GAAIlC,GAAG,CAAC6B,cAAc,CAACG,KAAK,CAACG,SAAS;IAC5D,MAAMC,SAAQ,GAAIpC,GAAG,CAAC6B,cAAc,CAACG,KAAK,CAACI,SAAS;IACpD,MAAMC,QAAO,GAAIrC,GAAG,CAAC6B,cAAc,CAACG,KAAK,CAACK,QAAQ;IAClD,MAAMC,MAAK,GAAItC,GAAG,CAAC6B,cAAc,CAACG,KAAK,CAACM,MAAM;IAE9C,MAAMC,gBAAe,GAAI,CACvB;MAAEC,KAAK,EAAE,QAAQ;MAAER,KAAK,EAAE;IAAS,CAAC,EACpC;MAAEQ,KAAK,EAAE,YAAY;MAAER,KAAK,EAAE;IAAa,CAAC,EAC5C;MAAEQ,KAAK,EAAE,aAAa;MAAER,KAAK,EAAE;IAAc,CAAC,EAC9C;MAAEQ,KAAK,EAAE,UAAU;MAAER,KAAK,EAAE;IAAW,CAAC,EACxC;MAAEQ,KAAK,EAAE,cAAc;MAAER,KAAK,EAAE;IAAO,CAAC,EACxC;MAAEQ,KAAK,EAAE,qBAAqB;MAAER,KAAK,EAAE;IAAsB,EAC/D;IAEA,MAAMS,YAAW,GAAIA,CAAA,KAAM;MACzB,MAAMC,MAAK,GAAI;QACbP,SAAS,EAAED,iBAAiB,CAACF,KAAK;QAClCK,QAAQ,EAAEA,QAAQ,CAACL,KAAK;QACxBM,MAAM,EAAEA,MAAM,CAACN,KAAK;QACpBC,SAA