ox-btn>\r\n                  </template>\r\n                  <v-list-item-title>Select All</v-list-item-title>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 1\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 1\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedAssetTypes.length - 1 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedBroker\"\r\n              :items=\"brokers\"\r\n              label=\"Brokers\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              chips\r\n              closable-chips\r\n              clearable\r\n            ></v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedSecurities\"\r\n              :items=\"securities\"\r\n              label=\"Securities\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              multiple\r\n              chips\r\n              closable-chips\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item @click=\"toggleSelectAllSecurities\">\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"securitiesAllSelected\"\r\n                      :indeterminate=\"securitiesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                  <v-list-item