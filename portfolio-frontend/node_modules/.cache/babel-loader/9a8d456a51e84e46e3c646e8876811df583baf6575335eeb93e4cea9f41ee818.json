{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { Pie } from 'vue-chartjs';\nimport { Chart as ChartJS, ArcElement, Tooltip, Legend } from 'chart.js';\nChartJS.register(ArcElement, Tooltip, Legend);\nexport default {\n  name: 'BreakdownChart',\n  components: {\n    Pie\n  },\n  props: {\n    title: {\n      type: String,\n      required: true\n    },\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  setup(props) {\n    const tab = ref('chart');\n    const sortedData = computed(() => {\n      return Object.entries(props.data).map(([name, value]) => ({\n        name,\n        value\n      })).sort((a, b) => b.value - a.value);\n    });\n    const total = computed(() => {\n      return sortedData.value.reduce((sum, item) => sum + item.value, 0);\n    });\n    const chartData = computed(() => ({\n      labels: sortedData.value.map(item => item.name),\n      datasets: [{\n        data: sortedData.value.map(item => item.value),\n        backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#FF6384', '#C9CBCF', '#7CFC00', '#00CED1']\n      }]\n    }));\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      plugins: {\n        legend: {\n          position: 'right'\n        }\n      }\n    };\n    const formatValue = value => {\n      return new Intl.NumberFormat('en-US', {\n        style: 'decimal',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(value);\n    };\n    const formatPercentage = value => {\n      return new Intl.NumberFormat('en-US', {\n        style: 'percent',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(value / 100);\n    };\n    return {\n      tab,\n      sortedData,\n      total,\n      chartData,\n      chartOptions,\n      formatValue,\n      formatPercentage\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","Pie","Chart","ChartJS","ArcElement","Tooltip","Legend","register","name","components","props","title","type","String","required","data","Object","setup","tab","sortedData","entries","map","value","sort","a","b","total","reduce","sum","item","chartData","labels","datasets","backgroundColor","chartOptions","responsive","maintainAspectRatio","plugins","legend","position","formatValue","Intl","NumberFormat","style","minimumFractionDigits","maximumFractionDigits","format","formatPercentage"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\BreakdownChart.vue"],"sourcesContent":["<template>\r\n  <v-card class=\"h-100\">\r\n    <v-card-title class=\"text-h6\">{{ title }}</v-card-title>\r\n    <v-card-text class=\"pa-0\">\r\n      <v-tabs v-model=\"tab\" grow>\r\n        <v-tab value=\"chart\">Pie Chart</v-tab>\r\n        <v-tab value=\"table\">Table</v-tab>\r\n      </v-tabs>\r\n\r\n      <v-window v-model=\"tab\" class=\"fill-height\">\r\n        <v-window-item value=\"chart\">\r\n          <div class=\"chart-container\">\r\n            <Pie :data=\"chartData\" :options=\"chartOptions\" />\r\n          </div>\r\n        </v-window-item>\r\n\r\n        <v-window-item value=\"table\">\r\n          <v-table density=\"compact\">\r\n            <thead>\r\n              <tr>\r\n                <th class=\"text-left\">Name</th>\r\n                <th class=\"text-right\">Amount</th>\r\n                <th class=\"text-right\">Percentage</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr v-for=\"(item, index) in sortedData\" :key=\"index\">\r\n                <td class=\"text-left\">{{ item.name }}</td>\r\n                <td class=\"text-right\">{{ formatValue(item.value) }}</td>\r\n                <td class=\"text-right\">{{ formatPercentage(item.percentage) }}</td>\r\n              </tr>\r\n              <tr class=\"font-weight-bold\">\r\n                <td class=\"text-left\">Total</td>\r\n                <td class=\"text-right\">{{ formatValue(total) }}</td>\r\n                <td class=\"text-right\">100%</td>\r\n              </tr>\r\n            </tbody>\r\n          </v-table>\r\n        </v-window-item>\r\n      </v-window>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport { Pie } from 'vue-chartjs'\r\nimport { Chart as ChartJS, ArcElement, Tooltip, Legend } from 'chart.js'\r\n\r\nChartJS.register(ArcElement, Tooltip, Legend)\r\n\r\nexport default {\r\n  name: 'BreakdownChart',\r\n  components: { Pie },\r\n  props: {\r\n    title: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    data: {\r\n      type: Object,\r\n      required: true\r\n    }\r\n  },\r\n  setup(props) {\r\n    const tab = ref('chart')\r\n\r\n    const sortedData = computed(() => {\r\n      return Object.entries(props.data)\r\n        .map(([name, value]) => ({ name, value }))\r\n        .sort((a, b) => b.value - a.value)\r\n    })\r\n\r\n    const total = computed(() => {\r\n      return sortedData.value.reduce((sum, item) => sum + item.value, 0)\r\n    })\r\n\r\n    const chartData = computed(() => ({\r\n      labels: sortedData.value.map(item => item.name),\r\n      datasets: [{\r\n        data: sortedData.value.map(item => item.value),\r\n        backgroundColor: [\r\n          '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',\r\n          '#FF9F40', '#FF6384', '#C9CBCF', '#7CFC00', '#00CED1'\r\n        ]\r\n      }]\r\n    }))\r\n\r\n    const chartOptions = {\r\n      responsive: true,\r\n      maintainAspectRatio: false,\r\n      plugins: {\r\n        legend: {\r\n          position: 'right'\r\n        }\r\n      }\r\n    }\r\n\r\n    const formatValue = (value) => {\r\n      return new Intl.NumberFormat('en-US', {\r\n        style: 'decimal',\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(value)\r\n    }\r\n\r\n    const formatPercentage = (value) => {\r\n      return new Intl.NumberFormat('en-US', {\r\n        style: 'percent',\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(value / 100)\r\n    }\r\n\r\n    return {\r\n      tab,\r\n      sortedData,\r\n      total,\r\n      chartData,\r\n      chartOptions,\r\n      formatValue,\r\n      formatPercentage\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n  height: 300px;\r\n  position: relative;\r\n}\r\n\r\n.v-window {\r\n  height: calc(100% - 48px); /* Adjust for tab height */\r\n}\r\n\r\n.v-window-item {\r\n  height: 100%;\r\n  overflow-y: auto;\r\n}\r\n\r\n.v-table {\r\n  height: 100%;\r\n}\r\n\r\n.font-weight-bold {\r\n  font-weight: bold;\r\n}\r\n</style>"],"mappings":"AA6CA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,GAAE,QAAS,aAAY;AAChC,SAASC,KAAI,IAAKC,OAAO,EAAEC,UAAU,EAAEC,OAAO,EAAEC,MAAK,QAAS,UAAS;AAEvEH,OAAO,CAACI,QAAQ,CAACH,UAAU,EAAEC,OAAO,EAAEC,MAAM;AAE5C,eAAe;EACbE,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAER;EAAI,CAAC;EACnBS,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,IAAI,EAAE;MACJH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ;EACF,CAAC;EACDG,KAAKA,CAACP,KAAK,EAAE;IACX,MAAMQ,GAAE,GAAInB,GAAG,CAAC,OAAO;IAEvB,MAAMoB,UAAS,GAAInB,QAAQ,CAAC,MAAM;MAChC,OAAOgB,MAAM,CAACI,OAAO,CAACV,KAAK,CAACK,IAAI,EAC7BM,GAAG,CAAC,CAAC,CAACb,IAAI,EAAEc,KAAK,CAAC,MAAM;QAAEd,IAAI;QAAEc;MAAM,CAAC,CAAC,EACxCC,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKA,CAAC,CAACH,KAAI,GAAIE,CAAC,CAACF,KAAK;IACrC,CAAC;IAED,MAAMI,KAAI,GAAI1B,QAAQ,CAAC,MAAM;MAC3B,OAAOmB,UAAU,CAACG,KAAK,CAACK,MAAM,CAAC,CAACC,GAAG,EAAEC,IAAI,KAAKD,GAAE,GAAIC,IAAI,CAACP,KAAK,EAAE,CAAC;IACnE,CAAC;IAED,MAAMQ,SAAQ,GAAI9B,QAAQ,CAAC,OAAO;MAChC+B,MAAM,EAAEZ,UAAU,CAACG,KAAK,CAACD,GAAG,CAACQ,IAAG,IAAKA,IAAI,CAACrB,IAAI,CAAC;MAC/CwB,QAAQ,EAAE,CAAC;QACTjB,IAAI,EAAEI,UAAU,CAACG,KAAK,CAACD,GAAG,CAACQ,IAAG,IAAKA,IAAI,CAACP,KAAK,CAAC;QAC9CW,eAAe,EAAE,CACf,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EACrD,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAQ;MAExD,CAAC;