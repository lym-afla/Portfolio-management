ices prop:', this.prices);\r\n\r\n      if (!this.prices || this.prices.length === 0) {\r\n        console.log('No prices available');\r\n        return {\r\n          labels: [],\r\n          datasets: []\r\n        }\r\n      }\r\n\r\n      const labels = this.prices.map(price => price.date);\r\n      const data = this.prices.map(price => parseFloat(price.price));\r\n\r\n      console.log('Labels:', labels);\r\n      console.log('Data:', data);\r\n\r\n      return {\r\n        labels,\r\n        datasets: [\r\n          {\r\n            label: 'Price Series',\r\n            data,\r\n            borderColor: '#42A5F5',\r\n            backgroundColor: 'rgba(66, 165, 245, 0.2)',\r\n            fill: true,\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    chartOptions() {\r\n      return {\r\n        responsive: true,\r\n        maintainAspectRatio: false,\r\n        scales: {\r\n          y: {\r\n            beginAtZero: true\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n  position: relative;\r\n  height: 40vh;\r\n  width: 80vw;\r\n}\r\n</style>"],"mappings":";;;EAAAA,GAAA;AAAA;;;uBACEC,mBAAA,CAGM,cAFQC,IAAA,CAAAC,SAAS,CAACC,QAAQ,CAACC,MAAM,Q,cAArCC,YAAA,CAAuFC,eAAA;IAF3FP,GAAA;IAEgDQ,IAAI,EAAEN,IAAA,CAAAC,SAAS;IAAGM,OAAO,EAAEP,IAAA,CAAAQ;iEACvET,mBAAA,CAA8C,KAHlDU,UAAA,EAGc,kCAAgC,G","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}