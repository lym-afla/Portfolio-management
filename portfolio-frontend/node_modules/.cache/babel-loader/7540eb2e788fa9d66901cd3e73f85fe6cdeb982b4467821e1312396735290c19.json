{"ast":null,"code":"import { onMounted, onUnmounted, ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nexport default {\n  name: \"TransactionsPage\",\n  emits: ['update-page-title'],\n  setup(props, {\n    emit\n  }) {\n    const store = useStore();\n    const dateFrom = ref('');\n    const dateTo = ref('');\n    const loading = computed(() => store.state.loading);\n    const transactions = ref([]);\n    const totalItems = ref(0);\n    const currentPage = computed({\n      get: () => store.state.tableSettings.page,\n      set: value => store.dispatch('updateTableSettings', {\n        page: value\n      })\n    });\n    const itemsPerPage = computed({\n      get: () => store.state.tableSettings.itemsPerPage,\n      set: value => store.dispatch('updateTableSettings', {\n        itemsPerPage: value\n      })\n    });\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value));\n    onMounted(() => {\n      emit('update-page-title', 'Transactions');\n    });\n    onUnmounted(() => {\n      emit('update-page-title', '');\n    });\n    return {\n      dateFrom,\n      dateTo,\n      loading,\n      transactions,\n      totalItems,\n      currentPage,\n      itemsPerPage,\n      pageCount\n    };\n  }\n};","map":{"version":3,"names":["onMounted","onUnmounted","ref","computed","useStore","name","emits","setup","props","emit","store","dateFrom","dateTo","loading","state","transactions","totalItems","currentPage","get","tableSettings","page","set","value","dispatch","itemsPerPage","pageCount","Math","ceil"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\TransactionsPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid class=\"pa-0\">\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular\r\n        color=\"primary\"\r\n        indeterminate\r\n        size=\"64\"\r\n      ></v-progress-circular>\r\n\r\n      <v-row no-gutters>\r\n  