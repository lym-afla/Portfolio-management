temsPerPage,\r\n        set: (value) => store.dispatch('updateTableSettings', { itemsPerPage: value })\r\n      })\r\n\r\n      const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value))\r\n\r\n      onMounted(()=>{\r\n        emit('update-page-title','Transactions')\r\n      })\r\n      onUnmounted(()=>{\r\n        emit('update-page-title','')\r\n      })\r\n\r\n      return {\r\n        dateFrom,\r\n        dateTo,\r\n        loading,\r\n        transactions,\r\n        totalItems,\r\n        currentPage,\r\n        itemsPerPage,\r\n        pageCount\r\n      }\r\n    }\r\n    \r\n}\r\n\r\n</script>"],"mappings":"AA8IA,SAAQA,SAAS,EAACC,WAAW,EAACC,GAAG,EAACC,QAAQ,QAAO,KAAI;AACrD,SAAQC,QAAQ,QAAO,MAAK;AAE5B,eAAe;EACXC,IAAI,EAAC,kBAAkB;EACvBC,KAAK,EAAC,CAAC,mBAAmB,CAAC;EAC3BC,KAAKA,CAACC,KAAK,EAAC;IAACC;EAAI,CAAC,EAAC;IACjB,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IAEvB,MAAMO,QAAO,GAAIT,GAAG,CAAC,EAAE;IACvB,MAAMU,MAAK,GAAIV,GAAG,CAAC,EAAE;IACrB,MAAMW,OAAM,GAAIV,QAAQ,CAAC,MAAKO,KAAK,CAACI,KAAK,CAACD,OAAO;IACjD,MAAME,YAAW,GAAIb,GAAG,CAAC,EAAE;IAC3B,MAAMc,UAAS,GAAId,GAAG,CAAC,CAAC;IAExB,MAAMe,WAAU,GAAId,QAAQ,CAAC;MAC3Be,GAAG,EAAEA,CAAA,KAAMR,KAAK,CAACI,KAAK,CAACK,aAAa,CAACC,IAAI;MACzCC,GAAG,EAAGC,KAAK,IAAKZ,KAAK,CAACa,QAAQ,CAAC,qBAAqB,EAAE;QAAEH,IAAI,EAAEE;MAAM,CAAC;IACvE,CAAC;IAED,MAAME,YAAW,GAAIrB,QAAQ,CAAC;MAC5Be,GAAG,EAAEA,CAAA,KAAMR,KAAK,CAACI,KAAK,CAACK,aAAa,CAACK,YAAY;MACjDH,GAAG,EAAGC,KAAK,IAAKZ,KAAK,CAACa,QAAQ,CAAC,qBAAqB,EAAE;QAAEC,YAAY,EAAEF;MAAM,CAAC;IAC/E,CAAC;IAED,MAAMG,SAAQ,GAAItB,QAAQ,CAAC,MAAMuB,IAAI,CAACC,IAAI,CAACX,UAAU,CAACM,KAAI,GAAIE,YAAY,CAACF,KAAK,CAAC;IAEjFtB,SAAS,CAAC,MAAI;MACZS,IAAI,CAAC,mBAAmB,EAAC,cAAc;IACzC,CAAC;IACDR,WAAW,CAAC,MAAI;MACdQ,IAAI,CAAC,mBAAmB,EAAC,EAAE;IAC7B,CAAC;IAED,OAAO;MACLE,QAAQ;MACRC,MAAM;MACNC,OAAO;MACPE,YAAY;MACZC,UAAU;MACVC,WAAW;MACXO,YAAY;MACZC;IACF;EACF;AAEJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}