{"ast":null,"code":"import { ref, watch } from 'vue';\nimport { getSecurities } from '@/services/api';\nexport default {\n  name: 'SecurityMappingDialog',\n  props: {\n    showSecurityMapping: {\n      type: Boolean,\n      default: false\n    },\n    security: String,\n    bestMatch: Object,\n    brokerId: Number\n  },\n  emits: ['security-selected'],\n  setup(props, {\n    emit\n  }) {\n    console.log('SecurityMappingDialog setup called');\n    const selectedSecurity = ref(null);\n    const securityOptions = ref([]);\n    const loadingSecurities = ref(false);\n    const securityError = ref(null);\n    const fetchSecurities = async () => {\n      loadingSecurities.value = true;\n      securityError.value = null;\n      try {\n        console.log('Fetching securities for brokerId:', props.brokerId);\n        const securities = await getSecurities([], props.brokerId);\n        console.log('Fetched securities:', securities);\n        if (Array.isArray(securities)) {\n          securityOptions.value = securities.map(security => ({\n            id: security.id,\n            name: security.name\n          }));\n          selectedSecurity.value = props.bestMatch.match_id;\n          console.log(\"Assigning value to Select\", props.bestMatch.match_id, props.bestMatch.match_name, selectedSecurity.value);\n        } else {\n          console.error('Fetched securities is not an array:', securities);\n          securityError.value = 'Invalid data received from server';\n        }\n      } catch (error) {\n        console.error('Error fetching securities:', error);\n        securityError.value = 'Failed to fetch securities';\n      } finally {\n        loadingSecurities.value = false;\n      }\n    };\n    watch(() => props.brokerId, newValue => {\n      console.log('brokerId changed:', newValue);\n      if (newValue) {\n        fetchSecurities();\n      }\n    }, {\n      immediate: true\n    });\n    watch(() => selectedSecurity.value, newValue => {\n      emit('security-selected', newValue);\n    });\n\n    // const mapSecurity = () => {\n    //   console.log('mapSecurity called, selectedSecurity:', selectedSecurity.value)\n    //   emit('security-mapped', {\n    //     action: 'map',\n    //     security_id: selectedSecurity.value\n    //   })\n    // }\n\n    // const skipSecurity = () => {\n    //   console.log('skipSecurity called')\n    //   emit('security-mapped', {\n    //     action: 'skip',¬\n    //     security_id: null\n    //   })\n    // }\n\n    return {\n      selectedSecurity,\n      securityOptions,\n      loadingSecurities,\n      securityError\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","getSecurities","name","props","showSecurityMapping","type","Boolean","default","security","String","bestMatch","Object","brokerId","Number","emits","setup","emit","console","log","selectedSecurity","securityOptions","loadingSecurities","securityError","fetchSecurities","value","securities","Array","isArray","map","id","match_id","match_name","error","newValue","immediate"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\SecurityMappingDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-if=\"showSecurityMapping\" persistent max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5 bg-primary text-white\">\r\n        Map Security\r\n      </v-card-title>\r\n      <v-card-text class=\"pt-4\">\r\n        <v-alert type=\"info\" variant=\"tonal\" class=\"mb-4\">\r\n          <v-row align=\"center\">\r\n            <v-col cols=\"12\" sm=\"4\">\r\n              <strong>Unrecognized security:</strong>\r\n            </v-col>\r\n            <v-col cols=\"12\" sm=\"8\">\r\n              {{ security }}\r\n            </v-col>\r\n          </v-row>\r\n        </v-alert>\r\n\r\n        <v-alert v-if=\"bestMatch\" type=\"info\" variant=\"tonal\" class=\"mb-4\">\r\n          <v-row align=\"center\">\r\n            <v-col cols=\"12\" sm=\"4\">\r\n              <strong>Best match:</strong>\r\n            </v-col>\r\n            <v-col cols=\"12\" sm=\"8\">\r\n              {{ bestMatch.match_name }} (Score: {{ bestMatch.match_score }})\r\n            </v-col>\r\n          </v-row>\r\n        </v-alert>\r\n\r\n        <v-autocomplete\r\n          v-model=\"selectedSecurity\"\r\n          :items=\"securityOptions\"\r\n          label=\"Select Security\"\r\n          item-title=\"name\"\r\n          item-value=\"id\"\r\n          :loading=\"loadingSecurities\"\r\n          :disabled=\"loadingSecurities\"\r\n          :error-messages=\"securityError\"\r\n          variant=\"outlined\"\r\n          class=\"mt-4\"\r\n        ></v-autocomplete>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"mapSecurity\" :disabled=\"!selectedSecurity\">\r\n          Map Security\r\n        </v-btn>\r\n        <v-btn color=\"error\" @click=\"skipSecurity\">\r\n          Skip\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch } from 'vue'\r\nimport { getSecurities } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'SecurityMappingDialog',\r\n  props: {\r\n    showSecurityMapping: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    security: String,\r\n    bestMatch: Object,\r\n    brokerId: Number\r\n  },\r\n  emits: ['security-selected'],\r\n  setup(props, { emit }) {\r\n    console.log('SecurityMappingDialog setup called')\r\n    \r\n    const selectedSecurity = ref(null)\r\n    const securityOptions = ref([])\r\n    const loadingSecurities = ref(false)\r\n    const securityError = ref(null)\r\n\r\n    const fetchSecurities = async () => {\r\n      loadingSecurities.value = true\r\n      securityError.value = null\r\n      try {\r\n        console.log('Fetching securities for brokerId:', props.brokerId)\r\n        const securities = await getSecurities([], props.brokerId)\r\n        console.log('Fetched securities:', securities)\r\n        if (Array.isArray(securities)) {\r\n          securityOptions.value = securities.map(security => ({\r\n            id: security.id,\r\n            name: security.name\r\n          }))\r\n          selectedSecurity.value = props.bestMatch.match_id\r\n          console.log(\"Assigning value to Select\", props.bestMatch.match_id, props.bestMatch.match_name, selectedSecurity.value)\r\n        } else {\r\n          console.error('Fetched securities is not an array:', securities)\r\n          securityError.value = 'Invalid data received from server'\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching securities:', error)\r\n        securityError.value = 'Failed to fetch securities'\r\n      } finally {\r\n        loadingSecurities.value = false\r\n      }\r\n    }\r\n\r\n    watch(() => props.brokerId, (newValue) => {\r\n      console.log('brokerId changed:', newValue)\r\n      if (newValue) {\r\n        fetchSecurities()\r\n      }\r\n    }, { immediate: true })\r\n\r\n    watch(() => selectedSecurity.value, (newValue) => {\r\n      emit('security-selected', newValue)\r\n    })\r\n\r\n    // const mapSecurity = () => {\r\n    //   console.log('mapSecurity called, selectedSecurity:', selectedSecurity.value)\r\n    //   emit('security-mapped', {\r\n    //     action: 'map',\r\n    //     security_id: selectedSecurity.value\r\n    //   })\r\n    // }\r\n\r\n    // const skipSecurity = () => {\r\n    //   console.log('skipSecurity called')\r\n    //   emit('security-mapped', {\r\n    //     action: 'skip',¬\r\n    //     security_id: null\r\n    //   })\r\n    // }\r\n\r\n    return {\r\n      selectedSecurity,\r\n      securityOptions,\r\n      loadingSecurities,\r\n      securityError,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAwDA,SAASA,GAAG,EAAEC,KAAI,QAAS,KAAI;AAC/B,SAASC,aAAY,QAAS,gBAAe;AAE7C,eAAe;EACbC,IAAI,EAAE,uBAAuB;EAC7BC,KAAK,EAAE;IACLC,mBAAmB,EAAE