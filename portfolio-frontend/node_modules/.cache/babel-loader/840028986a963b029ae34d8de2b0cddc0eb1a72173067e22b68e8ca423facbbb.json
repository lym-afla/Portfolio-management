{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { getSecurities } from '@/services/api';\nexport default {\n  props: {\n    // modelValue: Boolean,\n    showSecurityMapping: {\n      type: Boolean,\n      default: false\n    },\n    security: String,\n    bestMatch: Array,\n    brokerId: Number\n  },\n  emits: ['update:modelValue', 'security-mapped'],\n  setup(props, {\n    emit\n  }) {\n    // const dialog = ref(props.modelValue)\n    const selectedSecurity = ref(null);\n    const securityOptions = computed(() => {\n      const securities = getSecurities([], props.brokerId);\n      return securities.map(security => ({\n        id: security.id,\n        name: security.name\n      }));\n    });\n\n    // watch(() => props.modelValue, (newValue) => {\n    //   dialog.value = newValue\n    // })\n\n    // watch(dialog, (newValue) => {\n    //   emit('update:modelValue', newValue)\n    // })\n\n    const mapSecurity = () => {\n      emit('security-mapped', {\n        action: 'map',\n        security_id: selectedSecurity.value\n      });\n    };\n    const skipSecurity = () => {\n      emit('security-mapped', {\n        action: 'skip',\n        security_id: null\n      });\n    };\n    return {\n      selectedSecurity,\n      securityOptions,\n      mapSecurity,\n      skipSecurity\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","getSecurities","props","showSecurityMapping","type","Boolean","default","security","String","bestMatch","Array","brokerId","Number","emits","setup","emit","selectedSecurity","securityOptions","securities","map","id","name","mapSecurity","action","security_id","value","skipSecurity"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\SecurityMappingDialog.vue"],"sourcesContent":["<template>\r\n  <!-- <v-dialog v-model=\"dialog\" persistent max-width=\"500px\"> -->\r\n  <div v-if=\"showSecurityMapping\">\r\n    <v-card>\r\n      <v-card-title>Map Security</v-card-title>\r\n      <v-card-text>\r\n        <p>Unrecognized security: {{ security }}</p>\r\n        <p v-if=\"bestMatch\">Best match: {{ bestMatch[0] }} (Score: {{ bestMatch[1] }})</p>\r\n        <v-select\r\n          v-model=\"selectedSecurity\"\r\n          :items=\"securityOptions\"\r\n          label=\"Select Security\"\r\n          item-text=\"name\"\r\n          item-value=\"id\"\r\n        ></v-select>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"mapSecurity\">Map</v-btn>\r\n        <v-btn color=\"error\" @click=\"skipSecurity\">Skip</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport { getSecurities } from '@/services/api'\r\n\r\nexport default {\r\n  props: {\r\n    // modelValue: Boolean,\r\n    showSecurityMapping: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    security: String,\r\n    bestMatch: Array,\r\n    brokerId: Number\r\n  },\r\n  emits: ['update:modelValue', 'security-mapped'],\r\n  setup(props, { emit }) {\r\n    // const dialog = ref(props.modelValue)\r\n    const selectedSecurity = ref(null)\r\n    const securityOptions = computed(() => {\r\n      const securities = getSecurities([], props.brokerId)\r\n      return securities.map(security => ({\r\n        id: security.id,\r\n        name: security.name\r\n      }))\r\n    })\r\n\r\n    // watch(() => props.modelValue, (newValue) => {\r\n    //   dialog.value = newValue\r\n    // })\r\n\r\n    // watch(dialog, (newValue) => {\r\n    //   emit('update:modelValue', newValue)\r\n    // })\r\n\r\n    const mapSecurity = () => {\r\n      emit('security-mapped', {\r\n        action: 'map',\r\n        security_id: selectedSecurity.value\r\n      })\r\n    }\r\n\r\n    const skipSecurity = () => {\r\n      emit('security-mapped', {\r\n        action: 'skip',\r\n        security_id: null\r\n      })\r\n    }\r\n\r\n    return {\r\n      selectedSecurity,\r\n      securityOptions,\r\n      mapSecurity,\r\n      skipSecurity,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA0BA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,aAAY,QAAS,gBAAe;AAE7C,eAAe;EACbC,KAAK,EAAE;IACL;IACAC,mBAAmB,EAAE;MACnBC,IAAI,EAAEC,OAAO;MACbC,OAAO,EAAE;IACX,CAAC;IACDC,QAAQ,EAAEC,MAAM;IAChBC,SAAS,EAAEC,KAAK;IAChBC,QAAQ,EAAEC;EACZ,CAAC;EACDC,KAAK,EAAE,CAAC,mBAAmB,EAAE,iBAAiB,CAAC;EAC/CC,KAAKA,CAACZ,KAAK,EAAE;IAAEa;EAAK,CAAC,EAAE;IACrB;IACA,MAAMC,gBAAe,GAAIjB,GAAG,CAAC,IAAI;IACjC,MAAMkB,eAAc,GAAIjB,QAAQ,CAAC,MAAM;MACrC,MAAMkB,UAAS,GAAIjB,aAAa,CAAC,EAAE,EAAEC,KAAK,CAACS,QAAQ;MACnD,OAAOO,UAAU,CAACC,GAAG,CAACZ,QAAO,KAAM;QACjCa,EAAE,EAAEb,QAAQ,CAACa,EAAE;QACfC,IAAI,EAAEd,QAAQ,CAACc;MACjB,CAAC,CAAC;IACJ,CAAC;;IAED;IACA;IACA;;IAEA;IACA;IACA;;IAEA,MAAMC,WAAU,GAAIA,CAAA,KAAM;MACxBP,IAAI,CAAC,iBAAiB,EAAE;QACtBQ,MAAM,EAAE,KAAK;QACbC,WAAW,EAAER,gBAAgB,CAACS;MAChC,CAAC;IACH;IAEA,MAAMC,YAAW,GAAIA,CAAA,KAAM;MACzBX,IAAI,CAAC,iBAAiB,EAAE;QACtBQ,MAAM,EAAE,MAAM;QACdC,WAAW,EAAE;MACf,CAAC;IACH;IAEA,OAAO;MACLR,gBAAgB;MAChBC,eAAe;MACfK,WAAW;MACXI;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}