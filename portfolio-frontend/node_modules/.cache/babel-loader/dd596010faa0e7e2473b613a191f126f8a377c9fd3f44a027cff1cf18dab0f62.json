{"ast":null,"code":"import { ref } from 'vue';\nimport UpdateBrokerPerformanceDialog from '@/components/dialogs/UpdateBrokerPerformanceDialog.vue';\nexport default {\n  name: 'SummaryOverTimeTable',\n  components: {\n    UpdateBrokerPerformanceDialog\n  },\n  props: {\n    lines: {\n      type: Array,\n      default: () => []\n    },\n    years: {\n      type: Array,\n      default: () => []\n    },\n    currentYear: {\n      type: String,\n      default: ''\n    },\n    error: {\n      type: String,\n      default: ''\n    }\n  },\n  emits: ['refresh-data'],\n  setup(props, {\n    emit\n  }) {\n    const showDialog = ref(false);\n    const showUpdateDialog = () => {\n      showDialog.value = true;\n    };\n    const handleUpdateStarted = () => {\n      console.log('Update started');\n    };\n    const handleUpdateProgress = data => {\n      console.log('Update progress:', data);\n    };\n    const handleUpdateCompleted = () => {\n      console.log('Update completed');\n      emit('refresh-data');\n    };\n    const handleUpdateError = error => {\n      console.error('Update error:', error);\n    };\n    return {\n      showDialog,\n      showUpdateDialog,\n      handleUpdateStarted,\n      handleUpdateProgress,\n      handleUpdateCompleted,\n      handleUpdateError\n    };\n  }\n};","map":{"version":3,"names":["ref","UpdateBrokerPerformanceDialog","name","components","props","lines","type","Array","default","years","currentYear","String","error","emits","setup","emit","showDialog","showUpdateDialog","value","handleUpdateStarted","console","log","handleUpdateProgress","data","handleUpdateCompleted","handleUpdateError"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\SummaryOverTimeTable.vue"],"sourcesContent":["<template>\r\n  <v-card v-if=\"lines && years && currentYear\">\r\n    <v-card-title>Summary Over Time</v-card-title>\r\n    <v-card-text>\r\n      <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n        {{ error }}\r\n      </v-alert>\r\n      <v-table v-if=\"!error\" density=\"compact\">\r\n        <thead>\r\n          <tr>\r\n            <th></th>\r\n            <th v-for=\"year in years\" :key=\"year\" class=\"text-center font-weight-bold\">{{ year }}</th>\r\n            <th class=\"text-center highlight font-weight-bold\">{{ currentYear }}YTD</th>\r\n            <th class=\"text-center highlight font-weight-bold\">All-time</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"line in lines\" :key=\"line.name\" :class=\"{ 'font-weight-bold': line.name === 'BoP NAV' || line.name === 'EoP NAV', 'font-italic': line.name === 'TSR' }\">\r\n            <td>\r\n              {{ line.name }}\r\n            </td>\r\n            <td v-for=\"year in years\" :key=\"`${line.name}-${year}`\" class=\"text-center\">\r\n              {{ line.data[year] }}\r\n            </td>\r\n            <td class=\"text-center highlight\">{{ line.data['YTD'] }}</td>\r\n            <td class=\"text-center font-weight-bold highlight\">{{ line.data['All-time'] }}</td>\r\n          </tr>\r\n        </tbody>\r\n      </v-table>\r\n      <v-btn @click=\"showUpdateDialog\" color=\"primary\" class=\"mt-4\">Update Broker Performance</v-btn>\r\n    </v-card-text>\r\n  </v-card>\r\n  <v-card v-else>\r\n    <v-card-title>Summary Over Time</v-card-title>\r\n    <v-card-text>\r\n      <v-alert type=\"info\">\r\n        No data available for the selected broker.\r\n      </v-alert>\r\n      <v-btn @click=\"showUpdateDialog\" color=\"primary\" class=\"mt-4\">Update Broker Performance</v-btn>\r\n    </v-card-text>\r\n  </v-card>\r\n\r\n  <UpdateBrokerPerformanceDialog\r\n    v-model=\"showDialog\"\r\n    @update-started=\"handleUpdateStarted\"\r\n    @update-progress=\"handleUpdateProgress\"\r\n    @update-completed=\"handleUpdateCompleted\"\r\n    @update-error=\"handleUpdateError\"\r\n  />\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport UpdateBrokerPerformanceDialog from '@/components/dialogs/UpdateBrokerPerformanceDialog.vue'\r\n\r\nexport default {\r\n  name: 'SummaryOverTimeTable',\r\n  components: {\r\n    UpdateBrokerPerformanceDialog\r\n  },\r\n  props: {\r\n    lines: {\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    years: {\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    currentYear: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    error: {\r\n      type: String,\r\n      default: ''\r\n    }\r\n  },\r\n  emits: ['refresh-data'],\r\n  setup(props, { emit }) {\r\n    const showDialog = ref(false)\r\n\r\n    const showUpdateDialog = () => {\r\n      showDialog.value = true\r\n    }\r\n\r\n    const handleUpdateStarted = () => {\r\n      console.log('Update started')\r\n    }\r\n\r\n    const handleUpdateProgress = (data) => {\r\n      console.log('Update progress:', data)\r\n    }\r\n\r\n    const handleUpdateCompleted = () => {\r\n      console.log('Update completed')\r\n      emit('refresh-data')\r\n    }\r\n\r\n    const handleUpdateError = (error) => {\r\n      console.error('Update error:', error)\r\n    }\r\n\r\n    return {\r\n      showDialog,\r\n      showUpdateDialog,\r\n      handleUpdateStarted,\r\n      handleUpdateProgress,\r\n      handleUpdateCompleted,\r\n      handleUpdateError\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.highlight {\r\n  background-color: rgba(0, 0, 0, 0.05);\r\n}\r\n</style>\r\n"],"mappings":"AAoDA,SAASA,GAAE,QAAS,KAAI;AACxB,OAAOC,6BAA4B,MAAO,wDAAuD;AAEjG,eAAe;EACbC,IAAI,EAAE,sBAAsB;EAC5BC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB,CAAC;IACDE,WAAW,EAAE;MACXJ,IAAI,EAAEK,MAAM;MACZH,OAAO,EAAE;IACX,CAAC;IACDI,KAAK,EAAE;MACLN,IAAI,EAAEK,MAAM;MACZH,OAAO,EAAE;IACX;EACF,CAAC;EACDK,KAAK,EAAE,CAAC,cAAc,CAAC;EACvBC,KAAKA,CAACV,KAAK,EAAE;IAAEW;EAAK,CAAC,EAAE;IACrB,MAAMC,