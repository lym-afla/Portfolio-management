{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onBeforeUnmount } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport RegisterForm from '@/components/RegisterForm.vue';\nexport default {\n  name: 'RegisterPage',\n  components: {\n    RegisterForm\n  },\n  setup() {\n    const loading = ref(false);\n    const router = useRouter();\n    const store = useStore();\n    const handleRegister = async credentials => {\n      loading.value = true;\n      try {\n        const response = await store.dispatch('register', credentials);\n        if (response.success) {\n          router.push('/dashboard');\n        } else {\n          registerForm.value.setErrors(response.error);\n        }\n      } catch (err) {\n        console.error('Registration error:', err);\n        registerForm.value.setErrors('An error occurred during registration.');\n      } finally {\n        loading.value = false;\n      }\n    };\n    onBeforeUnmount(() => {\n      if (registerForm.value) {\n        registerForm.value.setErrors({});\n      }\n    });\n    return {\n      loading,\n      handleRegister,\n      registerForm\n    };\n  }\n};","map":{"version":3,"names":["ref","onBeforeUnmount","useRouter","useStore","RegisterForm","name","components","setup","loading","router","store","handleRegister","credentials","value","response","dispatch","success","push","registerForm","setErrors","error","err","console"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\RegisterPage.vue"],"sourcesContent":["<template>\r\n  <v-container class=\"fill-height\" fluid>\r\n    <v-row align=\"center\" justify=\"center\">\r\n      <v-col cols=\"12\" sm=\"8\" md=\"4\">\r\n        <v-card class=\"pa-4\">\r\n          <v-card-title class=\"headline\">Register</v-card-title>\r\n          <v-card-text>\r\n            <RegisterForm \r\n              ref=\"registerForm\"\r\n              @register=\"handleRegister\" \r\n              :loading=\"loading\" \r\n            />\r\n          </v-card-text>\r\n          <v-card-actions>\r\n            <v-spacer></v-spacer>\r\n            <span>Already have an account? <router-link to=\"/login\">Login</router-link></span>\r\n          </v-card-actions>\r\n        </v-card>\r\n      </v-col>\r\n    </v-row>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onBeforeUnmount } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport RegisterForm from '@/components/RegisterForm.vue'\r\n\r\nexport default {\r\n  name: 'RegisterPage',\r\n  components: {\r\n    RegisterForm\r\n  },\r\n  setup() {\r\n    const loading = ref(false)\r\n    const router = useRouter()\r\n    const store = useStore()\r\n\r\n    const handleRegister = async (credentials) => {\r\n      loading.value = true\r\n\r\n      try {\r\n        const response = await store.dispatch('register', credentials)\r\n        if (response.success) {\r\n          router.push('/dashboard')\r\n        } else {\r\n          registerForm.value.setErrors(response.error)\r\n        }\r\n      } catch (err) {\r\n        console.error('Registration error:', err)\r\n        registerForm.value.setErrors('An error occurred during registration.')\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    onBeforeUnmount(() => {\r\n      if (registerForm.value) {\r\n        registerForm.value.setErrors({})\r\n      }\r\n    })\r\n\r\n    return { loading, handleRegister, registerForm }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-card-actions a {\r\n  text-decoration: none;\r\n  color: #1976D2;\r\n}\r\n</style>"],"mappings":";AAwBA,SAASA,GAAG,EAAEC,eAAc,QAAS,KAAI;AACzC,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,YAAW,MAAO,+BAA8B;AAEvD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,MAAK,GAAIP,SAAS,CAAC;IACzB,MAAMQ,