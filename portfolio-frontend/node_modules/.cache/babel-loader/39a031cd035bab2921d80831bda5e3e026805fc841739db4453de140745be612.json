{"ast":null,"code":"import { use } from 'echarts/core';\nimport { CanvasRenderer } from 'echarts/renderers';\nimport { PieChart } from 'echarts/charts';\nimport { TitleComponent, TooltipComponent, LegendComponent } from 'echarts/components';\nimport VChart from 'vue-echarts';\nuse([CanvasRenderer, PieChart, TitleComponent, TooltipComponent, LegendComponent]);\nexport default {\n  name: 'BreakdownChart',\n  components: {\n    VChart\n  },\n  props: {\n    title: {\n      type: String,\n      required: true\n    },\n    data: {\n      type: Object,\n      required: true\n    },\n    currency: {\n      type: String,\n      required: true\n    }\n  },\n  data() {\n    return {\n      tab: 'chart'\n    };\n  },\n  computed: {\n    chartOption() {\n      return {\n        title: {\n          text: this.title,\n          left: 'center'\n        },\n        tooltip: {\n          trigger: 'item',\n          formatter: '{a} <br/>{b}: {c} ({d}%)'\n        },\n        legend: {\n          orient: 'vertical',\n          left: 'left'\n        },\n        series: [{\n          name: this.title,\n          type: 'pie',\n          radius: '50%',\n          data: Object.entries(this.data).map(([name, value]) => ({\n            name,\n            value: value.amount\n          })),\n          emphasis: {\n            itemStyle: {\n              shadowBlur: 10,\n              shadowOffsetX: 0,\n              shadowColor: 'rgba(0, 0, 0, 0.5)'\n            }\n          }\n        }]\n      };\n    },\n    totalAmount() {\n      return Object.values(this.data).reduce((sum, item) => sum + parseFloat(item.amount), 0).toFixed(2);\n    }\n  }\n};","map":{"version":3,"names":["use","CanvasRenderer","PieChart","TitleComponent","TooltipComponent","LegendComponent","VChart","name","components","props","title","type","String","required","data","Object","currency","tab","computed","chartOption","text","left","tooltip","trigger","formatter","legend","orient","series","radius","entries","map","value","amount","emphasis","itemStyle","shadowBlur","shadowOffsetX","shadowColor","totalAmount","values","reduce","sum","item","parseFloat","toFixed"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\BreakdownChart.vue"],"sourcesContent":["<template>\r\n  <v-card>\r\n    <v-card-title>{{ title }}</v-card-title>\r\n    <v-card-text>\r\n      <v-tabs v-model=\"tab\">\r\n        <v-tab value=\"chart\">Pie Chart</v-tab>\r\n        <v-tab value=\"table\">Table</v-tab>\r\n      </v-tabs>\r\n\r\n      <v-window v-model=\"tab\">\r\n        <v-window-item value=\"chart\">\r\n          <v-chart :option=\"chartOption\" autoresize />\r\n        </v-window-item>\r\n\r\n        <v-window-item value=\"table\">\r\n          <v-table>\r\n            <thead>\r\n              <tr>\r\n                <th></th>\r\n                <th class=\"text-end\">{{ currency }}</th>\r\n                <th class=\"text-end\">%</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr v-for=\"(value, key) in data\" :key=\"key\">\r\n                <td>{{ key }}</td>\r\n                <td class=\"text-end\">{{ value.amount }}</td>\r\n                <td class=\"text-end\">{{ value.percentage }}</td>\r\n              </tr>\r\n            </tbody>\r\n            <tfoot>\r\n              <tr>\r\n                <td class=\"font-weight-bold\">Total</td>\r\n                <td class=\"text-end font-weight-bold\">{{ totalAmount }}</td>\r\n                <td class=\"text-end font-weight-bold\">100%</td>\r\n              </tr>\r\n            </tfoot>\r\n          </v-table>\r\n        </v-window-item>\r\n      </v-window>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { use } from 'echarts/core'\r\nimport { CanvasRenderer } from 'echarts/renderers'\r\nimport { PieChart } from 'echarts/charts'\r\nimport { TitleComponent, TooltipComponent, LegendComponent } from 'echarts/components'\r\nimport VChart from 'vue-echarts'\r\n\r\nuse([CanvasRenderer, PieChart, TitleComponent, TooltipComponent, LegendComponent])\r\n\r\nexport default {\r\n  name: 'BreakdownChart',\r\n  components: {\r\n    VChart\r\n  },\r\n  props: {\r\n    title: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    data: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    currency: {\r\n      type: String,\r\n      required: true\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      tab: 'chart'\r\n    }\r\n  },\r\n  computed: {\r\n    chartOption() {\r\n      return {\r\n        title: {\r\n          text: this.title,\r\n          left: 'center'\r\n        },\r\n        tooltip: {\r\n          trigger: 'item',\r\n          formatter: '{a} <br/>{b}: {c} ({d}%)'\r\n        },\r\n        legend: {\r\n          orient: 'vertical',\r\n          left: 'left'\r\n        },\r\n        series: [\r\n          {\r\n            name: this.title,\r\n            type: 'pie',\r\n            radius: '50%',\r\n            data: Object.entries(this.data).map(([name, value]) => ({\r\n              name,\r\n              value: value.amount\r\n            })),\r\n            emphasis: {\r\n              itemStyle: {\r\n                shadowBlur: 10,\r\n                shadowOffsetX: 0,\r\n                shadowColor: 'rgba(0, 0, 0, 0.5)'\r\n              }\r\n            }\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    totalAmount() {\r\n      return Object.values(this.data).reduce((sum, item) => sum + parseFloat(item.amount), 0).toFixed(2)\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AA6CA,SAASA,GAAE,QAAS,cAAa;AACjC,SAASC,cAAa,QAAS,mBAAkB;AACjD,SAASC,QAAO,QAAS,gBAAe;AACxC,SAASC,cAAc,EAAEC,gBAAgB,EAAEC,eAAc,QAAS,oBAAmB;AACrF,OAAOC,MAAK,MAAO,aAAY;AAE/BN,GAAG,CAAC,CAACC,cAAc,EAAEC,QAAQ,EAAEC,cAAc,EAAEC,gBAAgB,EAAEC,eAAe,CAAC;AAEjF,eAAe;EACbE,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;I