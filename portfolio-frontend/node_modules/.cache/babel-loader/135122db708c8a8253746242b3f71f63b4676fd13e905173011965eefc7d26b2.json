{"ast":null,"code":"import { ref, watch, computed, onMounted } from 'vue';\nimport { getAssetTypes, getBrokers, getSecurities, getPrices } from '@/services/api';\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue';\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue';\nimport debounce from 'lodash/debounce';\nimport { useTableSettings } from '@/composables/useTableSettings';\nimport { useStore } from 'vuex';\nexport default {\n  name: 'PricesPage',\n  components: {\n    AddSecurityButton,\n    AddPriceEntryButton\n  },\n  setup() {\n    const assetTypes = ref([]);\n    const brokers = ref([]);\n    const securities = ref([]);\n    const selectedAssetTypes = ref([]);\n    const selectedBroker = ref(null);\n    const selectedSecurities = ref([]);\n    const startDate = ref('');\n    const endDate = ref('');\n    const priceData = ref([]);\n    const loading = ref(false);\n    const totalItems = ref(0);\n    const editDialog = ref(false);\n    const deleteDialog = ref(false);\n    const editedItem = ref({});\n    const deletedItem = ref({});\n    const store = useStore();\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions);\n    const {\n      itemsPerPage,\n      currentPage,\n      sortBy,\n      search,\n      handlePageChange,\n      handleItemsPerPageChange,\n      handleSortChange\n    } = useTableSettings();\n    const headers = [{\n      title: 'Date',\n      key: 'date'\n    }, {\n      title: 'Security',\n      key: 'security__name'\n    }, {\n      title: 'Asset Type',\n      key: 'security__type'\n    }, {\n      title: 'Currency',\n      key: 'security__currency'\n    }, {\n      title: 'Price',\n      key: 'price'\n    }, {\n      title: 'Actions',\n      key: 'actions',\n      sortable: false\n    }];\n    const assetTypesAllSelected = computed(() => {\n      return selectedAssetTypes.value.length === assetTypes.value.length;\n    });\n    const assetTypesIndeterminate = computed(() => {\n      return selectedAssetTypes.value.length > 0 && !assetTypesAllSelected.value;\n    });\n    const securitiesAllSelected = computed(() => {\n      return selectedSecurities.value.length === securities.value.length;\n    });\n    const securitiesIndeterminate = computed(() => {\n      return selectedSecurities.value.length > 0 && !securitiesAllSelected.value;\n    });\n    const toggleSelectAllAssetTypes = () => {\n      if (assetTypesAllSelected.value) {\n        selectedAssetTypes.value = [];\n      } else {\n        selectedAssetTypes.value = assetTypes.value.map(item => item.value);\n      }\n    };\n    const toggleSelectAllSecurities = () => {\n      if (securitiesAllSelected.value) {\n        selectedSecurities.value = [];\n      } else {\n        selectedSecurities.value = securities.value.map(item => item.id);\n      }\n    };\n    onMounted(async () => {\n      try {\n        const [assetTypesData, brokersData, securitiesData] = await Promise.all([getAssetTypes(), getBrokers(), getSecurities()]);\n        console.log('brokersData', brokersData);\n        console.log('securitiesData', securitiesData);\n        console.log('assetTypesData', assetTypesData);\n        assetTypes.value = assetTypesData;\n        brokers.value = brokersData;\n        securities.value = securitiesData;\n        // await fetchPriceData()\n      } catch (error) {\n        console.error('Error fetching initial data:', error);\n      }\n    });\n    const fetchSecurities = debounce(async () => {\n      try {\n        securities.value = await getSecurities(selectedAssetTypes.value, selectedBroker.value);\n        // Reset securities if they are no longer in the list\n        selectedSecurities.value = selectedSecurities.value.filter(id => securities.value.some(security => security.id === id));\n        // Automatically select all securities if a broker is selected\n        if (selectedBroker.value) {\n          selectedSecurities.value = securities.value.map(item => item.id);\n          // } else {\n          //   // Reset selected securities if no broker is selected\n          //   selectedSecurities.value = [];\n        }\n      } catch (error) {\n        console.error('Error fetching securities:', error);\n      }\n    }, 300); // 300ms debounce\n\n    watch([selectedAssetTypes, selectedBroker], () => {\n      fetchSecurities();\n    });\n    const fetchPriceData = async () => {\n      loading.value = true;\n      console.log('[PricesPage] fetchPriceData called with:', {\n        dateFrom: startDate.value,\n        dateTo: endDate.value,\n        currentPage: currentPage.value,\n        itemsPerPage: itemsPerPage.value,\n        search: search.value,\n        sortBy: sortBy.value\n      });\n      try {\n        const response = await getPrices({\n          assetTypes: selectedAssetTypes.value,\n          broker: selectedBroker.value,\n          securities: selectedSecurities.value,\n          startDate: startDate.value,\n          endDate: endDate.value,\n          page: currentPage.value,\n          itemsPerPage: itemsPerPage.value,\n          search: search.value,\n          sortBy: sortBy.value[0] || {}\n        });\n        console.log('Fetched price data:', response);\n        priceData.value = response.prices;\n        totalItems.value = response.total_items;\n      } catch (error) {\n        console.error('Error fetching price data:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const applyFilters = () => {\n      fetchPriceData();\n    };\n    const showImportModal = () => {\n      // TODO: Implement import modal logic\n      console.log('Showing import modal');\n    };\n    const editPrice = item => {\n      editedItem.value = {\n        ...item\n      };\n      editDialog.value = true;\n    };\n    const closeEditDialog = () => {\n      editDialog.value = false;\n      editedItem.value = {};\n    };\n    const updatePrice = async () => {\n      // TODO: Implement actual API call to update price\n      console.log('Updating price:', editedItem.value);\n      closeEditDialog();\n      await fetchPriceData();\n    };\n    const deletePrice = item => {\n      deletedItem.value = item;\n      deleteDialog.value = true;\n    };\n    const closeDeleteDialog = () => {\n      deleteDialog.value = false;\n      deletedItem.value = {};\n    };\n    const confirmDelete = async () => {\n      // TODO: Implement actual API call to delete price\n      console.log('Deleting price:', deletedItem.value);\n      closeDeleteDialog();\n      await fetchPriceData();\n    };\n    watch([itemsPerPage, currentPage, sortBy, search], () => {\n      fetchPriceData();\n    });\n    return {\n      assetTypes,\n      brokers,\n      securities,\n      selectedAssetTypes,\n      selectedBroker,\n      selectedSecurities,\n      startDate,\n      endDate,\n      applyFilters,\n      showImportModal,\n      headers,\n      priceData,\n      loading,\n      totalItems,\n      itemsPerPage,\n      currentPage,\n      sortBy,\n      search,\n      editDialog,\n      deleteDialog,\n      editedItem,\n      handlePageChange,\n      handleItemsPerPageChange,\n      handleSortChange,\n      fetchPriceData,\n      editPrice,\n      closeEditDialog,\n      updatePrice,\n      deletePrice,\n      closeDeleteDialog,\n      confirmDelete,\n      assetTypesAllSelected,\n      assetTypesIndeterminate,\n      securitiesAllSelected,\n      securitiesIndeterminate,\n      toggleSelectAllAssetTypes,\n      toggleSelectAllSecurities,\n      fetchSecurities,\n      itemsPerPageOptions\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","computed","onMounted","getAssetTypes","getBrokers","getSecurities","getPrices","AddSecurityButton","AddPriceEntryButton","debounce","useTableSettings","useStore","name","components","setup","assetTypes","brokers","securities","selectedAssetTypes","selectedBroker","selectedSecurities","startDate","endDate","priceData","loading","totalItems","editDialog","deleteDialog","editedItem","deletedItem","store","itemsPerPageOptions","state","itemsPerPage","currentPage","sortBy","search","handlePageChange","handleItemsPerPageChange","handleSortChange","headers","title","key","sortable","assetTypesAllSelected","value","length","assetTypesIndeterminate","securitiesAllSelected","securitiesIndeterminate","toggleSelectAllAssetTypes","map","item","toggleSelectAllSecurities","id","assetTypesData","brokersData","securitiesData","Promise","all","console","log","error","fetchSecurities","filter","some","security","fetchPriceData","dateFrom","dateTo","response","broker","page","prices","total_items","applyFilters","showImportModal","editPrice","closeEditDialog","updatePrice","deletePrice","closeDeleteDialog","confirmDelete"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\PricesPage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text class=\"pa-4\">\r\n        <v-row>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedAssetTypes\"\r\n              :items=\"assetTypes\"\r\n              label=\"Asset Types\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              multiple\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item\r\n                title=\"Select All\"\r\n                @click=\"toggleSelectAllAssetTypes\"\r\n                >\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"assetTypesAllSelected\"\r\n                      :indeterminate=\"assetTypesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 3\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 3\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedAssetTypes.length - 3 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedBroker\"\r\n              :items=\"brokers\"\r\n              label=\"Brokers\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              clearable\r\n            ></v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedSecurities\"\r\n              :items=\"securities\"\r\n              label=\"Securities\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              multiple\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item\r\n                title=\"Select All\"\r\n                @click=\"toggleSelectAllSecurities\"\r\n                >\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"securitiesAllSelected\"\r\n                      :indeterminate=\"securitiesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 1\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 1\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedSecurities.length - 1 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n        </v-row>\r\n        <v-row class=\"mt-2\">\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-text-field\r\n              v-model=\"startDate\"\r\n              label=\"Start Date\"\r\n              type=\"date\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-text-field\r\n              v-model=\"endDate\"\r\n              label=\"End Date\"\r\n              type=\"date\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\" class=\"d-flex align-center\">\r\n            <v-btn color=\"primary\" @click=\"applyFilters\" block>\r\n              Apply Filters\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\" justify=\"space-between\">\r\n          <v-col cols=\"auto\">\r\n            <v-row>\r\n              <v-col cols=\"auto\">\r\n                <AddSecurityButton />\r\n              </v-col>\r\n              <v-col cols=\"auto\">\r\n                <AddPriceEntryButton />\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n          <v-col cols=\"auto\">\r\n            <v-btn color=\"success\" @click=\"showImportModal\">\r\n              Import Prices\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card>\r\n      <v-data-table\r\n        :headers=\"headers\"\r\n        :items=\"priceData\"\r\n        :loading=\"loading\"\r\n        :items-per-page=\"itemsPerPage\"\r\n        :page=\"currentPage\"\r\n        :sort-by=\"sortBy\"\r\n        :search=\"search\"\r\n        :server-items-length=\"totalItems\"\r\n        @update:options=\"fetchPriceData\"\r\n        disable-sort\r\n      >\r\n        <template #[`item.price`]=\"{ item }\">\r\n          <span class=\"editable\" @click=\"editPrice(item)\">{{ item.price }}</span>\r\n        </template>\r\n        <template #[`item.actions`]=\"{ item }\">\r\n          <v-btn small color=\"primary\" class=\"mr-2\" @click=\"editPrice(item)\">Edit</v-btn>\r\n          <v-btn small color=\"error\" @click=\"deletePrice(item)\">Delete</v-btn>\r\n        </template>\r\n      </v-data-table>\r\n    </v-card>\r\n\r\n    <v-dialog v-model=\"editDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Edit Price</v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"updatePrice\">\r\n            <v-text-field\r\n              v-model=\"editedItem.price\"\r\n              label=\"Price\"\r\n              type=\"number\"\r\n              step=\"0.01\"\r\n              required\r\n            ></v-text-field>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeEditDialog\">Cancel</v-btn>\r\n          <v-btn color=\"blue darken-1\" text @click=\"updatePrice\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n\r\n    <v-dialog v-model=\"deleteDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Delete Price Entry</v-card-title>\r\n        <v-card-text>Are you sure you want to delete this price entry?</v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeDeleteDialog\">Cancel</v-btn>\r\n          <v-btn color=\"red darken-1\" text @click=\"confirmDelete\">Delete</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch, computed, onMounted } from 'vue'\r\nimport { getAssetTypes, getBrokers, getSecurities, getPrices } from '@/services/api'\r\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue'\r\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue'\r\nimport debounce from 'lodash/debounce'\r\nimport { useTableSettings } from '@/composables/useTableSettings'\r\nimport { useStore } from 'vuex'\r\n\r\nexport default {\r\n  name: 'PricesPage',\r\n  components: {\r\n    AddSecurityButton,\r\n    AddPriceEntryButton,\r\n  },\r\n  setup() {\r\n    const assetTypes = ref([])\r\n    const brokers = ref([])\r\n    const securities = ref([])\r\n    const selectedAssetTypes = ref([])\r\n    const selectedBroker = ref(null)\r\n    const selectedSecurities = ref([])\r\n    const startDate = ref('')\r\n    const endDate = ref('')\r\n    const priceData = ref([])\r\n    const loading = ref(false)\r\n    const totalItems = ref(0)\r\n    const editDialog = ref(false)\r\n    const deleteDialog = ref(false)\r\n    const editedItem = ref({})\r\n    const deletedItem = ref({})\r\n\r\n    const store = useStore()\r\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions)\r\n\r\n    const {\r\n      itemsPerPage,\r\n      currentPage,\r\n      sortBy,\r\n      search,\r\n      handlePageChange,\r\n      handleItemsPerPageChange,\r\n      handleSortChange,\r\n    } = useTableSettings()\r\n\r\n    const headers = [\r\n      { title: 'Date', key: 'date' },\r\n      { title: 'Security', key: 'security__name' },\r\n      { title: 'Asset Type', key: 'security__type' },\r\n      { title: 'Currency', key: 'security__currency' },\r\n      { title: 'Price', key: 'price' },\r\n      { title: 'Actions', key: 'actions', sortable: false },\r\n    ]\r\n\r\n    const assetTypesAllSelected = computed(() => {\r\n      return selectedAssetTypes.value.length === assetTypes.value.length\r\n    })\r\n\r\n    const assetTypesIndeterminate = computed(() => {\r\n      return selectedAssetTypes.value.length > 0 && !assetTypesAllSelected.value\r\n    })\r\n\r\n    const securitiesAllSelected = computed(() => {\r\n      return selectedSecurities.value.length === securities.value.length\r\n    })\r\n\r\n    const securitiesIndeterminate = computed(() => {\r\n      return selectedSecurities.value.length > 0 && !securitiesAllSelected.value\r\n    })\r\n\r\n    const toggleSelectAllAssetTypes = () => {\r\n      if (assetTypesAllSelected.value) {\r\n        selectedAssetTypes.value = []\r\n      } else {\r\n        selectedAssetTypes.value = assetTypes.value.map(item => item.value)\r\n      }\r\n    }\r\n\r\n    const toggleSelectAllSecurities = () => {\r\n      if (securitiesAllSelected.value) {\r\n        selectedSecurities.value = []\r\n      } else {\r\n        selectedSecurities.value = securities.value.map(item => item.id)\r\n      }\r\n    }\r\n\r\n    onMounted(async () => {\r\n      try {\r\n        const [assetTypesData, brokersData, securitiesData] = await Promise.all([\r\n          getAssetTypes(),\r\n          getBrokers(),\r\n          getSecurities(),\r\n        ])\r\n        console.log('brokersData', brokersData)\r\n        console.log('securitiesData', securitiesData)\r\n        console.log('assetTypesData', assetTypesData)\r\n        assetTypes.value = assetTypesData\r\n        brokers.value = brokersData\r\n        securities.value = securitiesData\r\n        // await fetchPriceData()\r\n      } catch (error) {\r\n        console.error('Error fetching initial data:', error)\r\n      }\r\n    })\r\n\r\n    const fetchSecurities = debounce(async () => {\r\n      try {\r\n        securities.value = await getSecurities(selectedAssetTypes.value, selectedBroker.value)\r\n        // Reset securities if they are no longer in the list\r\n        selectedSecurities.value = selectedSecurities.value.filter(id =>\r\n          securities.value.some(security => security.id === id)\r\n        )\r\n        // Automatically select all securities if a broker is selected\r\n        if (selectedBroker.value) {\r\n          selectedSecurities.value = securities.value.map(item => item.id);\r\n        // } else {\r\n        //   // Reset selected securities if no broker is selected\r\n        //   selectedSecurities.value = [];\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching securities:', error)\r\n      }\r\n    }, 300) // 300ms debounce\r\n\r\n    watch([selectedAssetTypes, selectedBroker], () => {\r\n      fetchSecurities()\r\n    })\r\n\r\n    const fetchPriceData = async () => {\r\n      loading.value = true\r\n      console.log('[PricesPage] fetchPriceData called with:', {\r\n        dateFrom: startDate.value,\r\n        dateTo: endDate.value,\r\n        currentPage: currentPage.value,\r\n        itemsPerPage: itemsPerPage.value,\r\n        search: search.value,\r\n        sortBy: sortBy.value,\r\n      })\r\n      try {\r\n        const response = await getPrices({\r\n          assetTypes: selectedAssetTypes.value,\r\n          broker: selectedBroker.value,\r\n          securities: selectedSecurities.value,\r\n          startDate: startDate.value,\r\n          endDate: endDate.value,\r\n          page: currentPage.value,\r\n          itemsPerPage: itemsPerPage.value,\r\n          search: search.value,\r\n          sortBy: sortBy.value[0] || {},\r\n        })\r\n        console.log('Fetched price data:', response)\r\n        priceData.value = response.prices\r\n        totalItems.value = response.total_items\r\n      } catch (error) {\r\n        console.error('Error fetching price data:', error)\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    const applyFilters = () => {\r\n      fetchPriceData()\r\n    }\r\n\r\n    const showImportModal = () => {\r\n      // TODO: Implement import modal logic\r\n      console.log('Showing import modal')\r\n    }\r\n\r\n    const editPrice = (item) => {\r\n      editedItem.value = { ...item }\r\n      editDialog.value = true\r\n    }\r\n\r\n    const closeEditDialog = () => {\r\n      editDialog.value = false\r\n      editedItem.value = {}\r\n    }\r\n\r\n    const updatePrice = async () => {\r\n      // TODO: Implement actual API call to update price\r\n      console.log('Updating price:', editedItem.value)\r\n      closeEditDialog()\r\n      await fetchPriceData()\r\n    }\r\n\r\n    const deletePrice = (item) => {\r\n      deletedItem.value = item\r\n      deleteDialog.value = true\r\n    }\r\n\r\n    const closeDeleteDialog = () => {\r\n      deleteDialog.value = false\r\n      deletedItem.value = {}\r\n    }\r\n\r\n    const confirmDelete = async () => {\r\n      // TODO: Implement actual API call to delete price\r\n      console.log('Deleting price:', deletedItem.value)\r\n      closeDeleteDialog()\r\n      await fetchPriceData()\r\n    }\r\n\r\n    watch([itemsPerPage, currentPage, sortBy, search], () => {\r\n      fetchPriceData()\r\n    })\r\n\r\n    return {\r\n      assetTypes,\r\n      brokers,\r\n      securities,\r\n      selectedAssetTypes,\r\n      selectedBroker,\r\n      selectedSecurities,\r\n      startDate,\r\n      endDate,\r\n      applyFilters,\r\n      showImportModal,\r\n      headers,\r\n      priceData,\r\n      loading,\r\n      totalItems,\r\n      itemsPerPage,\r\n      currentPage,\r\n      sortBy,\r\n      search,\r\n      editDialog,\r\n      deleteDialog,\r\n      editedItem,\r\n      handlePageChange,\r\n      handleItemsPerPageChange,\r\n      handleSortChange,\r\n      fetchPriceData,\r\n      editPrice,\r\n      closeEditDialog,\r\n      updatePrice,\r\n      deletePrice,\r\n      closeDeleteDialog,\r\n      confirmDelete,\r\n      assetTypesAllSelected,\r\n      assetTypesIndeterminate,\r\n      securitiesAllSelected,\r\n      securitiesIndeterminate,\r\n      toggleSelectAllAssetTypes,\r\n      toggleSelectAllSecurities,\r\n      fetchSecurities,\r\n      itemsPerPageOpt