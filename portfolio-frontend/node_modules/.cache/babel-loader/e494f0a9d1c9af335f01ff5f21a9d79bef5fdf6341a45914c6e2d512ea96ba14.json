{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { provide, ref, onMounted, watch } from 'vue';\nimport Navigation from './components/Navigation.vue';\nimport { checkAuth } from './utils/auth';\nimport { useRouter } from 'vue-router';\nimport { loading } from './router';\nexport default {\n  name: 'App',\n  components: {\n    Navigation\n  },\n  setup() {\n    const router = useRouter();\n    const user = ref(null);\n    const isAuthenticated = ref(false);\n    const pageTitle = ref('');\n    const setUser = userData => {\n      user.value = userData;\n    };\n    const updateAuthStatus = async () => {\n      loading.value = true;\n      isAuthenticated.value = await checkAuth();\n      if (!isAuthenticated.value && router.currentRoute.value.meta.requiresAuth) {\n        router.push('/login');\n      }\n      loading.value = false;\n    };\n    const handleLogout = () => {\n      setUser(null);\n      isAuthenticated.value = false;\n      router.push('/login');\n    };\n    const updatePageTitle = title => {\n      pageTitle.value = title;\n    };\n    const onPageLoaded = () => {\n      loading.value = false;\n    };\n    onMounted(updateAuthStatus);\n    watch(() => router.currentRoute.value, updateAuthStatus);\n\n    // Reset page title when authentication status changes\n    watch(() => isAuthenticated.value, newValue => {\n      if (!newValue) {\n        pageTitle.value = '';\n      }\n    });\n\n    // Reset page title on route change for non-authenticated routes\n    watch(() => router.currentRoute.value.path, () => {\n      if (!isAuthenticated.value) {\n        pageTitle.value = '';\n      }\n    });\n    provide('user', user);\n    provide('setUser', setUser);\n    provide('isAuthenticated', isAuthenticated);\n    return {\n      user,\n      setUser,\n      router,\n      isAuthenticated,\n      loading,\n      pageTitle,\n      handleLogout,\n      updatePageTitle,\n      onPageLoaded\n    };\n  }\n};","map":{"version":3,"names":["provide","ref","onMounted","watch","Navigation","checkAuth","useRouter","loading","name","components","setup","router","user","isAuthenticated","pageTitle","setUser","userData","value","updateAuthStatus","currentRoute","meta","requiresAuth","push","handleLogout","updatePageTitle","title","onPageLoaded","newValue","path"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <v-app>\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\n    </v-overlay>\n\n    <template v-if=\"isAuthenticated\">\n      <Navigation @logout=\"handleLogout\" />\n      <v-main>\n        <v-container fluid>\n          <v-row v-if=\"pageTitle\">\n            <v-col>\n              <h2 class=\"text-h4 mb-4\">{{ pageTitle }}</h2>\n              <v-divider class=\"mb-4\"></v-divider>\n            </v-col>\n          </v-row>\n          <router-view @update-page-title=\"updatePageTitle\" @page-loaded=\"onPageLoaded\"></router-view>\n        </v-container>\n      </v-main>\n    </template>\n    <template v-else>\n      <v-main>\n        <router-view @page-loaded=\"onPageLoaded\"></router-view>\n      </v-main>\n    </template>\n  </v-app>\n</template>\n\n<script>\nimport { provide, ref, onMounted, watch } from 'vue'\nimport Navigation from './components/Navigation.vue'\nimport { checkAuth } from './utils/auth'\nimport { useRouter } from 'vue-router'\nimport { loading } from './router'\n\nexport default {\n  name: 'App',\n  components: {\n    Navigation,\n  },\n  setup() {\n    const router = useRouter();\n    const user = ref(null);\n    const isAuthenticated = ref(false);\n    const pageTitle = ref('');\n\n    const setUser = (userData) => {\n      user.value = userData\n    }\n\n    const updateAuthStatus = async () => {\n      loading.value = true;\n      isAuthenticated.value = await checkAuth();\n      if (!isAuthenticated.value && router.currentRoute.value.meta.requiresAuth) {\n        router.push('/login');\n      }\n      loading.value = false;\n    };\n\n    const handleLogout = () => {\n      setUser(null);\n      isAuthenticated.value = false;\n      router.push('/login');\n    };\n\n    const updatePageTitle = (title) => {\n      pageTitle.value = title;\n    };\n\n    const onPageLoaded = () => {\n      loading.value = false;\n    };\n\n    onMounted(updateAuthStatus);\n    watch(() => router.currentRoute.value, updateAuthStatus);\n\n    // Reset page title when authentication status changes\n    watch(() => isAuthenticated.value, (newValue) => {\n      if (!newValue) {\n        pageTitle.value = '';\n      }\n    });\n\n    // Reset page title on route change for non-authenticated routes\n    watch(() => router.currentRoute.value.path, () => {\n      if (!isAuthenticated.value) {\n        pageTitle.value = '';\n      }\n    });\n\n    provide('user', user)\n    provide('setUser', setUser)\n    provide('isAuthenticated', isAuthenticated)\n\n    return { \n      user, \n      setUser, \n      router, \n      isAuthenticated, \n      loading, \n      pageTitle, \n      handleLogout, \n      updatePageTitle, \n      onPageLoaded \n    };\n  },\n}\n</script>\n\n<style>\nhtml, body {\n  overflow-y: auto;\n}\n</style>"],"mappings":";AA6BA,SAASA,OAAO,EAAEC,GAAG,EAAEC,SAAS,EAAEC,KAAI,QAAS,KAAI;AACnD,OAAOC,UAAS,MAAO,6BAA4B;AACnD,SAASC,SAAQ,QAAS,cAAa;AACvC,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,OAAM,QAAS,UAAS;AAEjC,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IACVL;EACF,CAAC;EACDM,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIL,SAAS,CAAC,CAAC;IAC1B,MAAMM,IAAG,GAAIX,GAAG,CAAC,IAAI,CAAC;IACtB,MAAMY,eAAc,GAAIZ,GAAG,CAAC,KAAK,CAAC;IAClC,MAAMa,SAAQ,GAAIb,GAAG,CAAC,EAAE,CAAC;IAEzB,MAAMc,OAAM,GAAKC,QAAQ,IAAK;MAC5BJ,IAAI,CAACK,KAAI,GAAID,QAAO;IACtB;IAEA,MAAME,gBAAe,GAAI,MAAAA,CAAA,KAAY;MACnCX,OAAO,CAACU,KAAI,GAAI,IAAI;MACpBJ,eAAe,CAACI,KAAI,GAAI,MAAMZ,SAAS,CAAC,CAAC;MACzC,IAAI,CAACQ,eAAe,CAACI,K