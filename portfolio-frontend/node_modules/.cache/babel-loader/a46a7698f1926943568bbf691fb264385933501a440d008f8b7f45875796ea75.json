{"ast":null,"code":"import { ref, computed, onMounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport AddBrokerButton from '@/components/buttons/AddBroker.vue';\nimport { getBrokersForDatabase, createBroker, updateBroker, deleteBroker } from '@/services/api';\nimport { useTableSettings } from '@/composables/useTableSettings';\nimport debounce from 'lodash/debounce';\nexport default {\n  name: 'BrokersPage',\n  components: {\n    AddBrokerButton\n  },\n  setup() {\n    const store = useStore();\n    const {\n      itemsPerPage,\n      currentPage,\n      sortBy,\n      search,\n      handlePageChange,\n      handleItemsPerPageChange,\n      handleSortChange\n    } = useTableSettings();\n    const brokers = ref([]);\n    const loading = ref(trfalseue);\n    const tableLoading = ref(false);\n    const dialog = ref(false);\n    const editedIndex = ref(-1);\n    const editedItem = ref({\n      name: '',\n      country: '',\n      comment: '',\n      restricted: false\n    });\n    const defaultItem = {\n      name: '',\n      country: '',\n      comment: '',\n      restricted: false\n    };\n    const headers = [{\n      title: 'Name',\n      key: 'name'\n    }, {\n      title: 'Country',\n      key: 'country'\n    }, {\n      title: 'Currencies',\n      key: 'currencies'\n    }, {\n      title: 'Number of securities',\n      key: 'no_of_securities'\n    }, {\n      title: 'First investment',\n      key: 'first_investment'\n    }, {\n      title: 'Current NAV',\n      key: 'NAV'\n    }, {\n      title: 'Cash balance',\n      key: 'cash'\n    }, {\n      title: 'Return to date',\n      key: 'irr'\n    }, {\n      title: 'Actions',\n      key: 'actions',\n      sortable: false\n    }];\n    const formTitle = computed(() => {\n      return editedIndex.value === -1 ? 'New Broker' : 'Edit Broker';\n    });\n    const totalItems = ref(0);\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions);\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value));\n    const fetchBrokers = async () => {\n      tableLoading.value = true;\n      try {\n        const response = await getBrokersForDatabase({\n          page: currentPage.value,\n          itemsPerPage: itemsPerPage.value,\n          sortBy: sortBy.value[0] || {},\n          search: search.value\n        });\n        brokers.value = response.brokers;\n        totalItems.value = response.total_items;\n      } catch (error) {\n        console.error('Error fetching brokers:', error);\n      } finally {\n        tableLoading.value = false;\n      }\n    };\n    const handleTableUpdate = options => {\n      currentPage.value = options.page;\n      itemsPerPage.value = options.itemsPerPage;\n      handleSortChange(options.sortBy);\n      fetchBrokers();\n    };\n    const openAddDialog = () => {\n      editedIndex.value = -1;\n      editedItem.value = Object.assign({}, defaultItem);\n      dialog.value = true;\n    };\n    const editBroker = item => {\n      editedIndex.value = brokers.value.indexOf(item);\n      editedItem.value = Object.assign({}, item);\n      dialog.value = true;\n    };\n    const processDeleteBroker = async item => {\n      const confirm = window.confirm('Are you sure you want to delete this broker?');\n      if (confirm) {\n        try {\n          await deleteBroker(item.id);\n          fetchBrokers();\n        } catch (error) {\n          console.error('Error deleting broker:', error);\n        }\n      }\n    };\n    const close = () => {\n      dialog.value = false;\n      editedIndex.value = -1;\n      editedItem.value = Object.assign({}, defaultItem);\n    };\n    const save = async () => {\n      try {\n        if (editedIndex.value > -1) {\n          await updateBroker(editedItem.value.id, editedItem.value);\n        } else {\n          await createBroker(editedItem.value);\n        }\n        close();\n        fetchBrokers();\n      } catch (error) {\n        console.error('Error saving broker:', error);\n      }\n    };\n    onMounted(() => {\n      fetchBrokers();\n    });\n    watch(() => store.state.dataRefreshTrigger, fetchBrokers);\n    watch([search, itemsPerPage, currentPage, sortBy], () => {\n      fetchBrokers();\n    }, {\n      deep: true\n    });\n    return {\n      brokers,\n      loading,\n      tableLoading,\n      dialog,\n      editedIndex,\n      editedItem,\n      defaultItem,\n      headers,\n      formTitle,\n      itemsPerPage,\n      currentPage,\n      totalItems,\n      sortBy,\n      search,\n      itemsPerPageOptions,\n      pageCount,\n      handleTableUpdate,\n      handlePageChange,\n      handleItemsPerPageChange,\n      openAddDialog,\n      editBroker,\n      processDeleteBroker,\n      close,\n      save\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","watch","useStore","AddBrokerButton","getBrokersForDatabase","createBroker","updateBroker","deleteBroker","useTableSettings","debounce","name","components","setup","store","itemsPerPage","currentPage","sortBy","search","handlePageChange","handleItemsPerPageChange","handleSortChange","brokers","loading","trfalseue","tableLoading","dialog","editedIndex","editedItem","country","comment","restricted","defaultItem","headers","title","key","sortable","formTitle","value","totalItems","itemsPerPageOptions","state","pageCount","Math","ceil","fetchBrokers","response","page","total_items","error","console","handleTableUpdate","options","openAddDialog","Object","assign","editBroker","item","indexOf","processDeleteBroker","confirm","window","id","close","save","dataRefreshTrigger","deep"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\BrokersPage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\" justify=\"space-between\">\r\n          <v-col cols=\"auto\">\r\n            <AddBrokerButton @add-broker=\"openAddDialog\" />\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-data-table\r\n      :headers=\"headers\"\r\n      :items=\"brokers\"\r\n      :loading=\"tableLoading\"\r\n      :items-per-page=\"itemsPerPage\"\r\n      :page=\"currentPage\"\r\n      :server-items-length=\"totalItems\"\r\n      :sort-by=\"sortBy\"\r\n      @update:sort-by=\"handleSortChange\"\r\n      density=\"compact\"\r\n      disable-sort\r\n    >\r\n      <template #top>\r\n        <v-toolbar flat class=\"bg-grey-lighten-4 border-b\">\r\n          <v-col cols=\"12\" sm=\"6\" md=\"7\" lg=\"8\">\r\n            <v-text-field\r\n              v-model=\"search\"\r\n              append-icon=\"mdi-magnify\"\r\n              label=\"Search\"\r\n              single-line\r\n              hide-details\r\n              density=\"compact\"\r\n              bg-color=\"white\"\r\n              class=\"rounded-lg\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"5\" lg=\"4\">\r\n            <v-select\r\n              v-model=\"itemsPerPage\"\r\n              :items=\"itemsPerPageOptions\"\r\n              label=\"Rows per page\"\r\n              density=\"compact\"\r\n              hide-details\r\n              class=\"rows-per-page-select\"\r\n              @update:model-value=\"handleItemsPerPageChange\"\r\n              bg-color=\"white\"\r\n            ></v-select>\r\n          </v-col>\r\n        </v-toolbar>\r\n      </template>\r\n\r\n      <template #[`item.actions`]=\"{ item }\">\r\n        <v-icon small class=\"mr-2\" @click=\"editBroker(item)\">\r\n          mdi-pencil\r\n        </v-icon>\r\n        <v-icon small @click=\"processDeleteBroker(item)\">\r\n          mdi-delete\r\n        </v-icon>\r\n      </template>\r\n\r\n      <template #bottom>\r\n        <div class=\"d-flex align-center justify-space-between pa-4\">\r\n          <span class=\"text-caption mr-4\">\r\n            Showing {{ (currentPage - 1) * itemsPerPage + 1 }}-{{\r\n              Math.min(currentPage * itemsPerPage, totalItems)\r\n            }}\r\n            of {{ totalItems }} entries\r\n          </span>\r\n          <v-pagination\r\n            v-model=\"currentPage\"\r\n            :length=\"pageCount\"\r\n            :total-visible=\"7\"\r\n            rounded=\"circle\"\r\n            @update:model-value=\"handlePageChange\"\r\n          ></v-pagination>\r\n        </div>\r\n      </template>\r\n    </v-data-table>\r\n\r\n    <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>\r\n          <span class=\"text-h5\">{{ formTitle }}</span>\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-container>\r\n            <v-row>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-text-field v-model=\"editedItem.name\" label=\"Name\"></v-text-field>\r\n              </v-col>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-text-field v-model=\"editedItem.country\" label=\"Country\"></v-text-field>\r\n              </v-col>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-checkbox v-model=\"editedItem.restricted\" label=\"Restricted\"></v-checkbox>\r\n              </v-col>\r\n              <v-col cols=\"12\">\r\n                <v-textarea v-model=\"editedItem.comment\" label=\"Comment\"></v-textarea>\r\n              </v-col>\r\n            </v-row>\r\n          </v-container>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"close\">Cancel</v-btn>\r\n          <v-btn color=\"blue darken-1\" text @click=\"save\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, watch } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport AddBrokerButton from '@/components/buttons/AddBroker.vue'\r\nimport { getBrokersForDatabase, createBroker, updateBroker, deleteBroker } from '@/services/api'\r\nimport { useTableSettings } from '@/composables/useTableSettings'\r\nimport debounce from 'lodash/debounce'\r\n\r\nexport default {\r\n  name: 'BrokersPage',\r\n  components: {\r\n    AddBrokerButton\r\n  },\r\n  setup() {\r\n    const store = useStore()\r\n    const {\r\n      itemsPerPage,\r\n      currentPage,\r\n      sortBy,\r\n      search,\r\n      handlePageChange,\r\n      handleItemsPerPageChange,\r\n      handleSortChange,\r\n    } = useTableSettings()\r\n\r\n    const brokers = ref([])\r\n    const loading = ref(trfalseue)\r\n    const tableLoading = ref(false)\r\n    const dialog = ref(false)\r\n    const editedIndex = ref(-1)\r\n    const editedItem = ref({\r\n      name: '',\r\n      country: '',\r\n      comment: '',\r\n      restricted: false\r\n    })\r\n    const defaultItem = {\r\n      name: '',\r\n      country: '',\r\n      comment: '',\r\n      restricted: false\r\n    }\r\n\r\n    const headers = [\r\n      { title: 'Name', key: 'name' },\r\n      { title: 'Country', key: 'country' },\r\n      { title: 'Currencies', key: 'currencies' },\r\n      { title: 'Number of securities', key: 'no_of_securities' },\r\n      { title: 'First investment', key: 'first_investment' },\r\n      { title: 'Current NAV', key: 'NAV' },\r\n      { title: 'Cash balance', key: 'cash' },\r\n      { title: 'Return to date', key: 'irr' },\r\n      { title: 'Actions', key: 'actions', sortable: false }\r\n    ]\r\n\r\n    const formTitle = computed(() => {\r\n      return editedIndex.value === -1 ? 'New Broker' : 'Edit Broker'\r\n    })\r\n\r\n    const totalItems = ref(0)\r\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions)\r\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value))\r\n\r\n    const fetchBrokers = async () => {\r\n      tableLoading.value = true\r\n      try {\r\n        const response = await getBrokersForDatabase({\r\n          page: currentPage.value,\r\n          itemsPerPage: itemsPerPage.value,\r\n          sortBy: sortBy.value[0] || {},\r\n          search: search.value\r\n        })\r\n        brokers.value = response.brokers\r\n        totalItems.value = response.total_items\r\n      } catch (error) {\r\n        console.error('Error fetching brokers:', error)\r\n      } finally {\r\n        tableLoading.value = false\r\n      }\r\n    }\r\n\r\n    const handleTableUpdate = (options) => {\r\n      currentPage.value = options.page\r\n      itemsPerPage.value = options.itemsPerPage\r\n      handleSortChange(options.sortBy)\r\n      fetchBrokers()\r\n    }\r\n\r\n    const openAddDialog = () => {\r\n      editedIndex.value = -1\r\n      editedItem.value = Object.assign({}, defaultItem)\r\n      dialog.value = true\r\n    }\r\n\r\n    const editBroker = (item) => {\r\n      editedIndex.value = brokers.value.indexOf(item)\r\n      editedItem.value = Object.assign({}, item)\r\n      dialog.value = true\r\n    }\r\n\r\n    const processDeleteBroker = async (item) => {\r\n      const confirm = window.confirm('Are you sure you want to delete this broker?')\r\n      if (confirm) {\r\n        try {\r\n          await deleteBroker(item.id)\r\n          fetchBrokers()\r\n        } catch (error) {\r\n          console.error('Error deleting broker:', error)\r\n        }\r\n      }\r\n    }\r\n\r\n    const close = () => {\r\n      dialog.value = false\r\n      editedIndex.value = -1\r\n      editedItem.value = Object.assign({}, defaultItem)\r\n    }\r\n\r\n    const save = async () => {\r\n      try {\r\n        if (editedIndex.value > -1) {\r\n          await updateBroker(editedItem.value.id, editedItem.value)\r\n        } else {\r\n          await createBroker(editedItem.value)\r\n        }\r\n        close()\r\n        fetchBrokers()\r\n      } catch (error) {\r\n        console.error('Error saving broker:', error)\r\n      }\r\n    }\r\n\r\n    onMounted(() => {\r\n      fetchBrokers()\r\n    })\r\n\r\n    watch(() => store.state.dataRefreshTrigger, fetchBrokers)\r\n\r\n    watch([search, itemsPerPage, currentPage, sortBy], () => {\r\n      fetchBrokers()\r\n    }, { deep: true })\r\n\r\n    return {\r\n      brokers,\r\n      loading,\r\n      tableLoading,\r\n      dialog,\r\n      editedIndex,\r\n      editedItem,\r\n      defaultItem,\r\n      headers,\r\n      formTitle,\r\n      itemsPerPage,\r\n      currentPage,\r\n      totalItems,\r\n      sortBy,\r\n      search,\r\n      itemsPerPageOptions,\r\n      pageCount,\r\n      handleTableUpdate,\r\n      handlePageChange,\r\n      handleItemsPerPageChange,\r\n      openAddDialog,\r\n      editBroker,\r\n      processDeleteBroker,\r\n      close,\r\n      save\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.nowrap-table :deep(td) {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.rows-per-page-select {\r\n  min-width: 180px;\r\n  max-width: 200px;\r\n}\r\n</style>"],"mappings":"AAuHA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,KAAI,QAAS,KAAI;AACpD,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,eAAc,MAAO,oCAAmC;AAC/D,SAASC,qBAAqB,EAAEC,YAAY,EAAEC,YAAY,EAAEC,YAAW,QAAS,gBAAe;AAC/F,SAASC,gBAAe,QAAS,gCAA+B;AAChE,OAAOC,QAAO,MAAO,iBAAgB;AAErC,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IACVR;EACF,CAAC;EACDS,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIX,QAAQ,CAAC;IACvB,MAAM;MACJY,YAAY;MACZC,WAAW;MACXC,MAAM;MACNC,MAAM;MACNC,gBAAgB;MAChBC,wBAAwB;MACxBC;IACF,IAAIZ,gBAAgB,CAAC;IAErB,MAAMa,OAAM,GAAIvB,GAAG,CAAC,EAAE;IACtB,MAAMwB,OAAM,GAAIxB,GAAG,CAACyB,SAAS;IAC7B,MAAMC,YAAW,GAAI1B,GAAG,CAAC,KAAK;IAC9B,MAAM2B,MAAK,GAAI3B,GAAG,CAAC,KAAK;IACxB,MAAM4B,WAAU,GAAI5B,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAM6B,UAAS,GAAI7B,GAAG,CAAC;MACrBY,IAAI,EAAE,EAAE;MACRkB,