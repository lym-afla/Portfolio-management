=== 'DELETE' || 'Please type DELETE to confirm']\"\r\n          ></v-text-field>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"primary\" text @click=\"showDeleteConfirmation = false\">Cancel</v-btn>\r\n          <v-btn\r\n            color=\"error\"\r\n            :disabled=\"confirmationText !== 'DELETE'\"\r\n            @click=\"deleteAccount\"\r\n          >\r\n            Delete Account\r\n          </v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue';\r\nimport { useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter();\r\n    const store = useStore();\r\n    const showDeleteConfirmation = ref(false);\r\n    const confirmationText = ref('');\r\n\r\n    return { router, store, showDeleteConfirmation, confirmationText };\r\n  },\r\n  data() {\r\n    return {\r\n      menuItems: [\r\n        { title: 'User details', to: '/profile' },\r\n        { title: 'Settings', to: '/profile/settings' },\r\n      ],\r\n    }\r\n  },\r\n  methods: {\r\n    async logout() {\r\n      try {\r\n        // Call the logout API endpoint\r\n        await axios.post('/users/api/logout/');\r\n        \r\n        // Clear the authentication token from local storage\r\n        localStorage.removeItem('token');\r\n        \r\n        // Redirect to login page\r\n        this.router.push('/login');\r\n      } catch (error) {\r\n        console.error('Logout failed:', error);\r\n        // Even if the API call fails, clear the token and redirect\r\n        localStorage.removeItem('token');\r\n        this.router.push('/login');\r\n      }\r\n    },\r\n    isActive(route) {\r\n      return this.$route.path === route;\r\n    },\r\n    async deleteAccount() {\r\n      if (this.confirmationText !== 'DELETE') {\r\n        return;\r\n      }\r\n      try {\r\n        const response = await this.store.dispatch('deleteAccount');\r\n        if (response.success) {\r\n          this.router.push('/login');\r\n        } else {\r\n          // Handle error (e.g., show error message to user)\r\n          console.error('Account deletion failed:', response.error);\r\n        }\r\n      } finally {\r\n        this.showDeleteConfirmation = false;\r\n        this.confirmationText = '';\r\n      }\r\n    },\r\n  },\r\n  mounted() {\r\n    this.$emit('update-page-title', 'User Profile');\r\n  }\r\n}\r\n</script>"],"mappings":";AA6DA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,SAAQ,QAAS,YAAY;AACtC,SAASC,QAAO,QAAS,MAAM;AAE/B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIH,SAAS,CAAC,CAAC;IAC1B,MAAMI,KAAI,GAAIH,QAAQ,CAAC,CAAC;IACxB,MAAMI,sBAAqB,GAAIN,GAAG,CAAC,KAAK,CAAC;IACzC,MAAMO,gBAAe,GAAIP,GAAG,CAAC,EAAE,CAAC;IAEhC,OAAO;MAAEI,MAAM;MAAEC,KAAK;MAAEC,sBAAsB;MAAEC;IAAiB,CAAC;EACpE,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,CACT;QAAEC,KAAK,EAAE,cAAc;QAAEC,EAAE,EAAE;MAAW,CAAC,EACzC;QAAED,KAAK,EAAE,UAAU;QAAEC,EAAE,EAAE;MAAoB,CAAC;IAElD;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,MAAMA,CAAA,EAAG;MACb,IAAI;QACF;QACA,MAAMC,KAAK,CAACC,IAAI,CAAC,oBAAoB,CAAC;;QAEtC;QACAC,YAAY,CAACC,UAAU,CAAC,OAAO,CAAC;;QAEhC;QACA,IAAI,CAACb,MAAM,CAACc,IAAI,CAAC,QAAQ,CAAC;MAC5B,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,gBAAgB,EAAEA,KAAK,CAAC;QACtC;QACAH,YAAY,CAACC,UAAU,CAAC,OAAO,CAAC;QAChC,IAAI,CAACb,MAAM,CAACc,IAAI,CAAC,QAAQ,CAAC;MAC5B;IACF,CAAC;IACDG,QAAQA,CAACC,KAAK,EAAE;MACd,OAAO,IAAI,CAACC,MAAM,CAACC,IAAG,KAAMF,KAAK;IACnC,CAAC;IACD,MAAMG,aAAaA,CAAA,EAAG;MACpB,IAAI,IAAI,CAAClB,gBAAe,KAAM,QAAQ,EAAE;QACtC;MACF;MACA,IAAI;QACF,MAAMmB,QAAO,GAAI,MAAM,IAAI,CAACrB,KAAK,CAACsB,QAAQ,CAAC,eAAe,CAAC;QAC3D,IAAID,QAAQ,CAACE,OAAO,EAAE;UACpB,IAAI,CAACxB,MAAM,CAACc,IAAI,CAAC,QAAQ,CAAC;QAC5B,OAAO;UACL;UACAE,OAAO,CAACD,KAAK,CAAC,0BAA0B,EAAEO,QAAQ,CAACP,KAAK,CAAC;QAC3D;MACF,UAAU;QACR,IAAI,CAACb,sBAAqB,GAAI,KAAK;QACnC,IAAI,CAACC,gBAAe,GAAI,EAAE;MAC5B;IACF;EACF,CAAC;EACD