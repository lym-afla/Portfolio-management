{"ast":null,"code":"import { ref, reactive } from 'vue';\nimport { useStore } from 'vuex';\nexport default {\n  setup() {\n    const store = useStore();\n    const dialog = ref(false);\n    const settings = reactive({\n      default_currency: 'USD',\n      digits: 0,\n      table_date: new Date().toISOString().substr(0, 10)\n    });\n    const currencyOptions = ['USD', 'EUR', 'GBP', 'JPY']; // Add more as needed\n\n    const saveSettings = async () => {\n      try {\n        await store.dispatch('updateUserSettings', settings);\n        dialog.value = false;\n        // Trigger a data refresh\n        store.dispatch('triggerDataRefresh');\n      } catch (error) {\n        console.error('Failed to save settings:', error);\n      }\n    };\n    return {\n      dialog,\n      settings,\n      currencyOptions,\n      saveSettings\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","useStore","setup","store","dialog","settings","default_currency","digits","table_date","Date","toISOString","substr","currencyOptions","saveSettings","dispatch","value","error","console"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\SettingsDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title>\r\n        <span class=\"text-h5\">Settings</span>\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-form @submit.prevent=\"saveSettings\">\r\n          <v-select\r\n            v-model=\"settings.default_currency\"\r\n            :items=\"currencyOptions\"\r\n            label=\"Default Currency\"\r\n          ></v-select>\r\n          <v-text-field\r\n            v-model.number=\"settings.digits\"\r\n            type=\"number\"\r\n            label=\"Number of Digits\"\r\n            min=\"0\"\r\n            max=\"6\"\r\n          ></v-text-field>\r\n          <v-date-picker v-model=\"settings.table_date\"></v-date-picker>\r\n        </v-form>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"dialog = false\">Close</v-btn>\r\n        <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"saveSettings\">Save</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive } from 'vue'\r\nimport { useStore } from 'vuex'\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore()\r\n    const dialog = ref(false)\r\n    const settings = reactive({\r\n      default_currency: 'USD',\r\n      digits: 0,\r\n      table_date: new Date().toISOString().substr(0, 10)\r\n    })\r\n\r\n    const currencyOptions = ['USD', 'EUR', 'GBP', 'JPY'] // Add more as needed\r\n\r\n    const saveSettings = async () => {\r\n      try {\r\n        await store.dispatch('updateUserSettings', settings)\r\n        dialog.value = false\r\n        // Trigger a data refresh\r\n        store.dispatch('triggerDataRefresh')\r\n      } catch (error) {\r\n        console.error('Failed to save settings:', error)\r\n      }\r\n    }\r\n\r\n    return {\r\n      dialog,\r\n      settings,\r\n      currencyOptions,\r\n      saveSettings\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAiCA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIF,QAAQ,CAAC;IACvB,MAAMG,MAAK,GAAIL,GAAG,CAAC,KAAK;IACxB,MAAMM,QAAO,GAAIL,QAAQ,CAAC;MACxBM,gBAAgB,EAAE,KAAK;MACvBC,MAAM,EAAE,CAAC;MACTC,UAAU,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,MAAM,CAAC,CAAC,EAAE,EAAE;IACnD,CAAC;IAED,MAAMC,eAAc,GAAI,CAAC,KAAK,EAAE,KAAK,EAAE,KAAK,EAAE,KAAK,GAAE;;IAErD,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF,MAAMV,KAAK,CAACW,QAAQ,CAAC,oBAAoB,EAAET,QAAQ;QACnDD,MAAM,CAACW,KAAI,GAAI,KAAI;QACnB;QACAZ,KAAK,CAACW,QAAQ,CAAC,oBAAoB;MACrC,EAAE,OAAOE,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,0BAA0B,EAAEA,KAAK;MACjD;IACF;IAEA,OAAO;MACLZ,MAAM;MACNC,QAAQ;MACRO,eAAe;MACf