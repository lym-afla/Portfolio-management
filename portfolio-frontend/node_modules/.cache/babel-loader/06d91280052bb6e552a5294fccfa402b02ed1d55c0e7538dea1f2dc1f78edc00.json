{"ast":null,"code":"import { ref, reactive, onMounted } from 'vue';\nimport { getUserSettings, updateUserSettings, getSettingsChoices } from '@/services/api';\nexport default {\n  setup() {\n    const dialog = ref(false);\n    const form = ref(null);\n    const errors = ref({});\n    const currencyChoices = ref([]);\n    const formData = reactive({\n      default_currency: '',\n      digits: 0,\n      effective_current_date: ''\n    });\n    const fetchSettingsData = async () => {\n      try {\n        const [settings, choices] = await Promise.all([getUserSettings(), getSettingsChoices()]);\n        console.log('Fetched settings:', settings);\n        console.log('Fetched choices:', choices);\n\n        // Update formData with fetched settings\n        Object.keys(formData).forEach(key => {\n          if (settings[key] !== undefined) {\n            formData[key] = settings[key];\n          }\n        });\n\n        // Update currency choices\n        currencyChoices.value = choices.currency_choices.map(choice => ({\n          text: choice[1],\n          value: choice[0]\n        }));\n        console.log('Updated formData:', formData);\n        console.log('Updated currencyChoices:', currencyChoices.value);\n      } catch (error) {\n        console.error('Failed to fetch settings data:', error);\n      }\n    };\n    const openDialog = () => {\n      dialog.value = true;\n      document.body.style.overflow = 'hidden';\n      fetchSettingsData();\n    };\n    const closeDialog = () => {\n      dialog.value = false;\n      document.body.style.overflow = '';\n      errors.value = {};\n    };\n    const saveSettings = async () => {\n      try {\n        await updateUserSettings(formData);\n        closeDialog();\n        // Trigger a data refresh if needed\n        // You might want to emit an event or use a store action for this\n      } catch (error) {\n        console.error('Failed to save settings:', error);\n        if (error.response && error.response.data) {\n          errors.value = error.response.data;\n        }\n      }\n    };\n    onMounted(fetchSettingsData);\n    return {\n      dialog,\n      form,\n      errors,\n      currencyChoices,\n      formData,\n      openDialog,\n      closeDialog,\n      saveSettings\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","getUserSettings","updateUserSettings","getSettingsChoices","setup","dialog","form","errors","currencyChoices","formData","default_currency","digits","effective_current_date","fetchSettingsData","settings","choices","Promise","all","console","log","Object","keys","forEach","key","undefined","value","currency_choices","map","choice","text","error","openDialog","document","body","style","overflow","closeDialog","saveSettings","response","data"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\SettingsDialog.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-btn icon @click=\"openDialog\">\r\n      <v-icon>mdi-cog</v-icon>\r\n    </v-btn>\r\n\r\n    <v-dialog v-model=\"dialog\" max-width=\"400px\" persistent>\r\n      <v-card>\r\n        <v-card-title class=\"text-h5\">\r\n          Settings\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"saveSettings\" ref=\"form\">\r\n            <v-select\r\n              v-model=\"formData.default_currency\"\r\n              :items=\"currencyChoices\"\r\n              label=\"Default Currency\"\r\n              :error-messages=\"errors.default_currency\"\r\n            ></v-select>\r\n            <v-text-field\r\n              v-model.number=\"formData.digits\"\r\n              label=\"Number of Digits\"\r\n              type=\"number\"\r\n              :error-messages=\"errors.digits\"\r\n            ></v-text-field>\r\n            <v-text-field\r\n              v-model=\"formData.effective_current_date\"\r\n              label=\"Effective Current Date\"\r\n              type=\"date\"\r\n              :error-messages=\"errors.effective_current_date\"\r\n            ></v-text-field>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"closeDialog\">Close</v-btn>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"saveSettings\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive, onMounted } from 'vue'\r\nimport { getUserSettings, updateUserSettings, getSettingsChoices } from '@/services/api'\r\n\r\nexport default {\r\n  setup() {\r\n    const dialog = ref(false)\r\n    const form = ref(null)\r\n    const errors = ref({})\r\n    const currencyChoices = ref([])\r\n\r\n    const formData = reactive({\r\n      default_currency: '',\r\n      digits: 0,\r\n      effective_current_date: '',\r\n    })\r\n\r\n    const fetchSettingsData = async () => {\r\n      try {\r\n        const [settings, choices] = await Promise.all([\r\n          getUserSettings(),\r\n          getSettingsChoices()\r\n        ])\r\n\r\n        console.log('Fetched settings:', settings)\r\n        console.log('Fetched choices:', choices)\r\n\r\n        // Update formData with fetched settings\r\n        Object.keys(formData).forEach(key => {\r\n          if (settings[key] !== undefined) {\r\n            formData[key] = settings[key]\r\n          }\r\n        })\r\n\r\n        // Update currency choices\r\n        currencyChoices.value = choices.currency_choices.map(choice => ({\r\n          text: choice[1],\r\n          value: choice[0]\r\n        }))\r\n\r\n        console.log('Updated formData:', formData)\r\n        console.log('Updated currencyChoices:', currencyChoices.value)\r\n      } catch (error) {\r\n        console.error('Failed to fetch settings data:', error)\r\n      }\r\n    }\r\n\r\n    const openDialog = () => {\r\n      dialog.value = true\r\n      document.body.style.overflow = 'hidden'\r\n      fetchSettingsData()\r\n    }\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      document.body.style.overflow = ''\r\n      errors.value = {}\r\n    }\r\n\r\n    const saveSettings = async () => {\r\n      try {\r\n        await updateUserSettings(formData)\r\n        closeDialog()\r\n        // Trigger a data refresh if needed\r\n        // You might want to emit an event or use a store action for this\r\n      } catch (error) {\r\n        console.error('Failed to save settings:', error)\r\n        if (error.response && error.response.data) {\r\n          errors.value = error.response.data\r\n        }\r\n      }\r\n    }\r\n\r\n    onMounted(fetchSettingsData)\r\n\r\n    return {\r\n      dialog,\r\n      form,\r\n      errors,\r\n      currencyChoices,\r\n      formData,\r\n      openDialog,\r\n      closeDialog,\r\n      saveSettings\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA4CA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AAC7C,SAASC,eAAe,EAAEC,kBAAkB,EAAEC,kBAAiB,QAAS,gBAAe;AAEvF,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIP,GAAG,CAAC,KAAK;IACxB,MAAMQ,IAAG,GAAIR,GAAG,CAAC,IAAI;IACrB,MAAMS,MAAK,GAAIT,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMU,eAAc,GAAIV,GAAG,CAAC,EAAE;IAE9B,MAAMW,QAAO,GAAIV,QAAQ,CAAC;MACxBW,gBAAgB,EAAE,EAAE;MACpBC,MAAM,EAAE,CAAC;MACTC,sBAAsB,EAAE;IAC1B,CAAC;IAED,MAAMC,iBAAgB,GAAI,MAAAA,CAAA,KAAY;MACpC,IAAI;QACF,MAAM,CAACC,QAAQ,EAAEC,OAAO,IAAI,MAAMC,OAAO,CAACC,GAAG,CAAC,CAC5ChB,eAAe,CAAC,CAAC,EACjBE,kBAAkB,CAAC,EACpB;QAEDe,OAAO,CAACC,GAAG,CAAC,mBAAmB,EAAEL,QAAQ;QACzCI,OAAO,CAACC,GAAG,CAAC,kBAAkB,EAAEJ,OAAO;;QAEvC;QACAK,MAAM,CAACC,IAAI,CAACZ,QAAQ,CAAC,CAACa,OAAO,CAACC,GAAE,IAAK;UACnC,IAAIT,QAAQ,CAACS,GAAG,MAAMC,SAAS,EAAE;YAC/Bf,QAAQ,CAACc,GAAG,IAAIT,QAAQ,CAACS,GAAG;UAC9B;QACF,CAAC;;QAED;QACAf,eAAe,CAACiB,KAAI,GAAIV,OAAO,CAACW,gBAAgB,CAACC,GAAG,CAACC,MAAK,KAAM;UAC9DC,IAAI,EAAED,MAAM,CAAC,CAAC,CAAC;UACfH,KAAK,EAAEG,MAAM,CAAC,CAAC;QACjB,CAAC,CAAC;QAEFV,OAAO,CAACC,GAAG,CAAC,mBAAmB,