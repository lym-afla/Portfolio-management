{"ast":null,"code":"import { ref, watch, computed } from 'vue';\nimport { getSecurities } from '@/services/api';\nexport default {\n  props: {\n    modelValue: Boolean,\n    security: String,\n    bestMatch: Array\n  },\n  emits: ['update:modelValue', 'security-mapped'],\n  setup(props, {\n    emit\n  }) {\n    const dialog = ref(props.modelValue);\n    const selectedSecurity = ref(null);\n    const securityOptions = computed(() => {\n      return getSecurities().then(securities => {\n        return securities.map(security => ({\n          id: security.id,\n          name: security.name\n        }));\n      });\n    });\n    watch(() => props.modelValue, newValue => {\n      dialog.value = newValue;\n    });\n    watch(dialog, newValue => {\n      emit('update:modelValue', newValue);\n    });\n    const mapSecurity = () => {\n      emit('security-mapped', selectedSecurity.value);\n    };\n    const skipSecurity = () => {\n      emit('security-mapped', null);\n    };\n    return {\n      dialog,\n      selectedSecurity,\n      securityOptions,\n      mapSecurity,\n      skipSecurity\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","computed","getSecurities","props","modelValue","Boolean","security","String","bestMatch","Array","emits","setup","emit","dialog","selectedSecurity","securityOptions","then","securities","map","id","name","newValue","value","mapSecurity","skipSecurity"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\SecurityMappingDialog.vue"],"sourcesContent":["<template>\r\n    <v-dialog v-model=\"dialog\" persistent max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Map Security</v-card-title>\r\n        <v-card-text>\r\n          <p>Unrecognized security: {{ security }}</p>\r\n          <p v-if=\"bestMatch\">Best match: {{ bestMatch[0] }} (Score: {{ bestMatch[1] }})</p>\r\n          <v-select\r\n            v-model=\"selectedSecurity\"\r\n            :items=\"securityOptions\"\r\n            label=\"Select Security\"\r\n            item-text=\"name\"\r\n            item-value=\"id\"\r\n          ></v-select>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"primary\" @click=\"mapSecurity\">Map</v-btn>\r\n          <v-btn color=\"error\" @click=\"skipSecurity\">Skip</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref, watch, computed } from 'vue'\r\n  import { getSecurities } from '@/services/api'\r\n  \r\n  export default {\r\n    props: {\r\n      modelValue: Boolean,\r\n      security: String,\r\n      bestMatch: Array,\r\n    },\r\n    emits: ['update:modelValue', 'security-mapped'],\r\n    setup(props, { emit }) {\r\n      const dialog = ref(props.modelValue)\r\n      const selectedSecurity = ref(null)\r\n      const securityOptions = (computed(() => {\r\n        return getSecurities().then(securities => {\r\n          return securities.map(security => ({\r\n            id: security.id,\r\n            name: security.name\r\n          }))\r\n        })\r\n      }))\r\n  \r\n      watch(() => props.modelValue, (newValue) => {\r\n        dialog.value = newValue\r\n      })\r\n  \r\n      watch(dialog, (newValue) => {\r\n        emit('update:modelValue', newValue)\r\n      })\r\n  \r\n      const mapSecurity = () => {\r\n        emit('security-mapped', selectedSecurity.value)\r\n      }\r\n  \r\n      const skipSecurity = () => {\r\n        emit('security-mapped', null)\r\n      }\r\n  \r\n      return {\r\n        dialog,\r\n        selectedSecurity,\r\n        securityOptions,\r\n        mapSecurity,\r\n        skipSecurity,\r\n      }\r\n    }\r\n  }\r\n  </script>"],"mappings":"AAyBE,SAASA,GAAG,EAAEC,KAAK,EAAEC,QAAO,QAAS,KAAI;AACzC,SAASC,aAAY,QAAS,gBAAe;AAE7C,eAAe;EACbC,KAAK,EAAE;IACLC,UAAU,EAAEC,OAAO;IACnBC,QAAQ,EAAEC,MAAM;IAChBC,SAAS,EAAEC;EACb,CAAC;EACDC,KAAK,EAAE,CAAC,mBAAmB,EAAE,iBAAiB,CAAC