{"ast":null,"code":"export default {\n  name: 'SummaryOverTimeTable',\n  props: {\n    lines: {\n      type: Array,\n      required: true\n    },\n    years: {\n      type: Array,\n      required: true\n    },\n    currentYear: {\n      type: String,\n      required: true\n    }\n  },\n  methods: {\n    formatValue(value) {\n      if (typeof value === 'number') {\n        return value.toFixed(2);\n      }\n      return value;\n    }\n  }\n};","map":{"version":3,"names":["name","props","lines","type","Array","required","years","currentYear","String","methods","formatValue","value","toFixed"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\SummaryOverTimeTable.vue"],"sourcesContent":["<template>\r\n  <v-card v-if=\"lines && years && currentYear\">\r\n    <v-card-title>Summary Over Time</v-card-title>\r\n    <v-card-text>\r\n      <v-table>\r\n        <thead>\r\n          <tr>\r\n            <th></th>\r\n            <th v-for=\"year in years\" :key=\"year\" class=\"text-center font-weight-bold\">{{ year }}</th>\r\n            <th class=\"text-center highlight font-weight-bold\">{{ currentYear }}YTD</th>\r\n            <th class=\"text-center highlight font-weight-bold\">All-time</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"line in lines\" :key=\"line.name\" :class=\"{ 'font-weight-bold': line.name === 'BoP NAV' || line.name === 'EoP NAV', 'font-italic': line.name === 'TSR' }\">\r\n            <td :class=\"{ 'font-weight-bold': line.name === 'BoP NAV' || line.name === 'EoP NAV', 'font-italic': line.name === 'TSR' }\">\r\n              {{ line.name }}\r\n            </td>\r\n            <td v-for=\"year in years\" :key=\"`${line.name}-${year}`\" class=\"text-center\">\r\n              {{ formatValue(line.values[year]) }}\r\n            </td>\r\n            <td class=\"text-center highlight\">{{ formatValue(line.values[currentYear + 'YTD']) }}</td>\r\n            <td class=\"text-center highlight\">{{ formatValue(line.values['All-time']) }}</td>\r\n          </tr>\r\n        </tbody>\r\n      </v-table>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'SummaryOverTimeTable',\r\n  props: {\r\n    lines: {\r\n      type: Array,\r\n      required: true\r\n    },\r\n    years: {\r\n      type: Array,\r\n      required: true\r\n    },\r\n    currentYear: {\r\n      type: String,\r\n      required: true\r\n    }\r\n  },\r\n  methods: {\r\n    formatValue(value) {\r\n      if (typeof value === 'number') {\r\n        return value.toFixed(2)\r\n      }\r\n      return value\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.highlight {\r\n  background-color: rgba(0, 0, 0, 0.05);\r\n}\r\n</style>"],"mappings":"AA+BA,eAAe;EACbA,IAAI,EAAE,sBAAsB;EAC5BC,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE;IACZ,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE;IACZ,CAAC;IACDE,WAAW,EAAE;MACXJ,IAAI,EAAEK,MAAM;MACZH,QAAQ,EAAE;IACZ;EACF,CAAC;EACDI,OAAO,EAAE;IACPC,WAAWA,CAACC,KAAK,EAAE;MACjB,IAAI,OAAOA,KAAI,KAAM,QAAQ,EAAE;QAC7B,OAAOA,KAAK,CAACC,OAAO,CAAC,CAAC;MACxB;MACA,OAAOD,KAAI;IACb;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}