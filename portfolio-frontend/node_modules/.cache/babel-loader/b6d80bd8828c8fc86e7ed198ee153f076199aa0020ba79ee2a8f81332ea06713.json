{"ast":null,"code":"import { ref, watch } from 'vue';\nimport { getSecurities } from '@/services/api';\nexport default {\n  name: 'SecurityMappingDialog',\n  props: {\n    showSecurityMapping: {\n      type: Boolean,\n      default: false\n    },\n    security: String,\n    bestMatch: Object,\n    brokerId: Number\n  },\n  emits: ['security-mapped'],\n  setup(props, {\n    emit\n  }) {\n    console.log('SecurityMappingDialog setup called');\n    const selectedSecurity = ref(null);\n    const securityOptions = ref([]);\n    const loadingSecurities = ref(false);\n    const securityError = ref(null);\n    const fetchSecurities = async () => {\n      loadingSecurities.value = true;\n      securityError.value = null;\n      try {\n        console.log('Fetching securities for brokerId:', props.brokerId);\n        const securities = await getSecurities([], props.brokerId);\n        console.log('Fetched securities:', securities);\n        if (Array.isArray(securities)) {\n          securityOptions.value = securities.map(security => ({\n            id: security.id,\n            name: security.name\n          }));\n          selectedSecurity.value = props.bestMatch.id;\n          console.log(\"Assigning value to Select\", props.bestMatch.match_id, props.bestMatch.match_name, selectedSecurity.value);\n        } else {\n          console.error('Fetched securities is not an array:', securities);\n          securityError.value = 'Invalid data received from server';\n        }\n      } catch (error) {\n        console.error('Error fetching securities:', error);\n        securityError.value = 'Failed to fetch securities';\n      } finally {\n        loadingSecurities.value = false;\n      }\n    };\n    watch(() => props.brokerId, newValue => {\n      console.log('brokerId changed:', newValue);\n      if (newValue) {\n        fetchSecurities();\n      }\n    }, {\n      immediate: true\n    });\n    const mapSecurity = () => {\n      console.log('mapSecurity called, selectedSecurity:', selectedSecurity.value);\n      emit('security-mapped', {\n        action: 'map',\n        security_id: selectedSecurity.value\n      });\n    };\n    const skipSecurity = () => {\n      console.log('skipSecurity called');\n      emit('security-mapped', {\n        action: 'skip',\n        security_id: null\n      });\n    };\n    return {\n      selectedSecurity,\n      securityOptions,\n      loadingSecurities,\n      securityError,\n      mapSecurity,\n      skipSecurity\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","getSecurities","name","props","showSecurityMapping","type","Boolean","default","security","String","bestMatch","Object","brokerId","Number","emits","setup","emit","console","log","selectedSecurity","securityOptions","loadingSecurities","securityError","fetchSecurities","value","securities","Array","isArray","map","id","match_id","match_name","error","newValue","immediate","mapSecurity","action","security_id","skipSecurity"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\SecurityMappingDialog.vue"],"sourcesContent":["<template>\r\n  <div class=\"mt-4\">\r\n    <v-card v-if=\"showSecurityMapping\">\r\n      <v-card-title>Map Security</v-card-title>\r\n      <v-card-text>\r\n        <p>Unrecognized security: {{ security }}</p>\r\n        <p v-if=\"bestMatch\">Best match: {{ bestMatch.match_name }} (Score: {{ bestMatch.match_score }})</p>\r\n        <v-autocomplete\r\n          v-model=\"selectedSecurity\"\r\n          :items=\"securityOptions\"\r\n          label=\"Select Security\"\r\n          item-title=\"name\"\r\n          item-value=\"id\"\r\n          :loading=\"loadingSecurities\"\r\n          :disabled=\"loadingSecurities\"\r\n          :error-messages=\"securityError\"\r\n        ></v-autocomplete>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"mapSecurity\" :disabled=\"loadingSecurities || !!securityError\">Map</v-btn>\r\n        <v-btn color=\"error\" @click=\"skipSecurity\" :disabled=\"loadingSecurities\">Skip</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch } from 'vue'\r\nimport { getSecurities } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'SecurityMappingDialog',\r\n  props: {\r\n    showSecurityMapping: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    security: String,\r\n    bestMatch: Object,\r\n    brokerId: Number\r\n  },\r\n  emits: ['security-mapped'],\r\n  setup(props, { emit }) {\r\n    console.log('SecurityMappingDialog setup called')\r\n    \r\n    const selectedSecurity = ref(null)\r\n    const securityOptions = ref([])\r\n    const loadingSecurities = ref(false)\r\n    const securityError = ref(null)\r\n\r\n    const fetchSecurities = async () => {\r\n      loadingSecurities.value = true\r\n      securityError.value = null\r\n      try {\r\n        console.log('Fetching securities for brokerId:', props.brokerId)\r\n        const securities = await getSecurities([], props.brokerId)\r\n        console.log('Fetched securities:', securities)\r\n        if (Array.isArray(securities)) {\r\n          securityOptions.value = securities.map(security => ({\r\n            id: security.id,\r\n            name: security.name\r\n          }))\r\n          selectedSecurity.value = props.bestMatch.id\r\n          console.log(\"Assigning value to Select\", props.bestMatch.match_id, props.bestMatch.match_name, selectedSecurity.value)\r\n        } else {\r\n          console.error('Fetched securities is not an array:', securities)\r\n          securityError.value = 'Invalid data received from server'\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching securities:', error)\r\n        securityError.value = 'Failed to fetch securities'\r\n      } finally {\r\n        loadingSecurities.value = false\r\n      }\r\n    }\r\n\r\n    watch(() => props.brokerId, (newValue) => {\r\n      console.log('brokerId changed:', newValue)\r\n      if (newValue) {\r\n        fetchSecurities()\r\n      }\r\n    }, { immediate: true })\r\n\r\n    const mapSecurity = () => {\r\n      console.log('mapSecurity called, selectedSecurity:', selectedSecurity.value)\r\n      emit('security-mapped', {\r\n        action: 'map',\r\n        security_id: selectedSecurity.value\r\n      })\r\n    }\r\n\r\n    const skipSecurity = () => {\r\n      console.log('skipSecurity called')\r\n      emit('security-mapped', {\r\n        action: 'skip',\r\n        security_id: null\r\n      })\r\n    }\r\n\r\n    return {\r\n      selectedSecurity,\r\n      securityOptions,\r\n      loadingSecurities,\r\n      securityError,\r\n      mapSecurity,\r\n      skipSecurity,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA4BA,SAASA,GAAG,EAAEC,KAAI,QAAS,KAAI;AAC/B,SAASC,aAAY,QAAS,gBAAe;AAE7C,eAAe;EACbC,IAAI,EAAE,uBAAuB;EAC7BC,KAAK,EAAE;IACLC,mBAAmB,EAAE;MACnBC,IAAI,EAAEC,OAAO;MACbC,OAAO,EAAE;IACX,CAAC;IACDC,QAAQ,EAAEC,MAAM;IAChBC,SAAS,EAAEC,MAAM;IACjBC,QAAQ,EAAEC;EACZ,CAAC;EACDC,KAAK,EAAE,CAAC,iBAAiB,CAAC;EAC1BC,KAAKA,CAACZ,KAAK,EAAE;IAAEa;EAAK,CAAC,EAAE;IACrBC,OAAO,CAACC,GAAG,CAAC,oCAAoC;IAEhD,MAAMC,gBAAe,GAAIpB,GAAG,CAAC,IAAI;IACjC,MAAMqB,eAAc,GAAIrB,GAAG,CAAC,EAAE;IAC9B,MAAMsB,iBAAgB,GAAItB,GAAG,CAAC,KAAK;IACnC,MAAMuB,aAAY,GAAIvB,GAAG,CAAC,IAAI;IAE9B,MAAMwB,eAAc,GAAI,MAAAA,CAAA,KAAY;MAClCF,iBAAiB,CAACG,KAAI,GAAI,IAAG;MAC7BF,aAAa,CAACE,KAAI,GAAI,IAAG;MACzB,IAAI;QACFP,OAAO,CAACC,GAAG,CAAC,mCAAmC,EAAEf,KAAK,CAACS,QAAQ;QAC/D,MAAMa,UAAS,GAAI,MAAMxB,aAAa,CAAC,EAAE,EAAEE,KAAK,CAACS,QAAQ;QACzDK,OAAO,CAACC,GAAG,CAAC,qBAAqB,EAAEO,UAAU;QAC7C,IAAIC,KAAK,CAACC,OAAO,CAACF,UAAU,CAAC,EAAE;UAC7BL,eAAe,CAACI,KAAI,GAAIC,UAAU,CAACG,GAAG,CAACpB,QAAO,KAAM;YAClDqB,EAAE,EAAErB,QAAQ,CAACqB,EAAE;YACf3B,IAAI,EAAEM,QAAQ,CAACN;UACjB,CAAC,CAAC;UACFiB,gBAAgB,CAACK,KAAI,GAAIrB,KAAK,CAACO,SAAS,CAACmB,EAAC;UAC1CZ,OAAO,CAACC,GAAG,CAAC,2BAA2B,EAAEf,KAAK,CAACO,SAAS,CAACoB,QAAQ,