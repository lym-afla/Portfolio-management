{"ast":null,"code":"import { computed } from 'vue';\nexport default {\n  name: 'BreakdownChart',\n  props: {\n    title: {\n      type: String,\n      required: true\n    },\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  setup(props) {\n    const sortedData = computed(() => {\n      return Object.entries(props.data).map(([name, value]) => ({\n        name,\n        value\n      })).sort((a, b) => b.value - a.value);\n    });\n    const total = computed(() => {\n      return sortedData.value.reduce((sum, item) => sum + item.value, 0);\n    });\n    const formatValue = value => {\n      return new Intl.NumberFormat('en-US', {\n        style: 'decimal',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(value);\n    };\n    const formatPercentage = value => {\n      return new Intl.NumberFormat('en-US', {\n        style: 'percent',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(value / 100);\n    };\n    return {\n      sortedData,\n      total,\n      formatValue,\n      formatPercentage\n    };\n  }\n};","map":{"version":3,"names":["computed","name","props","title","type","String","required","data","Object","setup","sortedData","entries","map","value","sort","a","b","total","reduce","sum","item","formatValue","Intl","NumberFormat","style","minimumFractionDigits","maximumFractionDigits","format","formatPercentage"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\BreakdownChart.vue"],"sourcesContent":["<template>\r\n  <v-card class=\"h-100\">\r\n    <v-card-title class=\"text-h6\">{{ title }}</v-card-title>\r\n    <v-card-text class=\"pa-0\">\r\n      <v-table density=\"compact\">\r\n        <thead>\r\n          <tr>\r\n            <th class=\"text-left font-weight-bold\" style=\"width: 50%;\">Name</th>\r\n            <th class=\"text-right font-weight-bold\" style=\"width: 25%;\">Value</th>\r\n            <th class=\"text-right font-weight-bold\" style=\"width: 25%;\">%</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"(item, index) in sortedData\" :key=\"index\">\r\n            <td class=\"text-left\">{{ item.name }}</td>\r\n            <td class=\"text-right\">{{ formatValue(item.value) }}</td>\r\n            <td class=\"text-right\">{{ formatPercentage(item.percentage) }}</td>\r\n          </tr>\r\n          <tr class=\"font-weight-bold\">\r\n            <td class=\"text-left\">Total</td>\r\n            <td class=\"text-right\">{{ formatValue(total) }}</td>\r\n            <td class=\"text-right\">100%</td>\r\n          </tr>\r\n        </tbody>\r\n      </v-table>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { computed } from 'vue'\r\n\r\nexport default {\r\n  name: 'BreakdownChart',\r\n  props: {\r\n    title: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    data: {\r\n      type: Object,\r\n      required: true\r\n    }\r\n  },\r\n  setup(props) {\r\n    const sortedData = computed(() => {\r\n      return Object.entries(props.data)\r\n        .map(([name, value]) => ({ name, value }))\r\n        .sort((a, b) => b.value - a.value)\r\n    })\r\n\r\n    const total = computed(() => {\r\n      return sortedData.value.reduce((sum, item) => sum + item.value, 0)\r\n    })\r\n\r\n    const formatValue = (value) => {\r\n      return new Intl.NumberFormat('en-US', {\r\n        style: 'decimal',\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(value)\r\n    }\r\n\r\n    const formatPercentage = (value) => {\r\n      return new Intl.NumberFormat('en-US', {\r\n        style: 'percent',\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(value / 100)\r\n    }\r\n\r\n    return {\r\n      sortedData,\r\n      total,\r\n      formatValue,\r\n      formatPercentage\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-table {\r\n  width: 100%;\r\n}\r\n\r\n.v-table th, .v-table td {\r\n  padding: 8px 16px;\r\n}\r\n\r\n.font-weight-bold {\r\n  font-weight: bold;\r\n}\r\n</style>"],"mappings":"AA8BA,SAASA,QAAO,QAAS,KAAI;AAE7B,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,IAAI,EAAE;MACJH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ;EACF,CAAC;EACDG,KAAKA,CAACP,KAAK,EAAE;IACX,MAAMQ,UAAS,GAAIV,QAAQ,CAAC,MAAM;MAChC,OAAOQ,MAAM,CAACG,OAAO,CAACT,KAAK,CAACK,IAAI,EAC7BK,GAAG,CAAC,CAAC,CAACX,IAAI,EAAEY,KAAK,CAAC,MAAM;QAAEZ,IAAI;QAAEY;MAAM,CAAC,CAAC,EACxCC,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKA,CAAC,CAACH,KAAI,GAAIE,CAAC,CAACF,KAAK;IACrC,CAAC;IAED,MAAMI,KAAI,GAAIjB,QAAQ,CAAC,MAAM;MAC3B,OAAOU,UAAU,CAACG,KAAK,CAACK,MAAM,CAAC,CAACC,GAAG,EAAEC,IAAI,KAAKD,GAAE,GAAIC,IAAI,CAACP,KAAK,EAAE,CAAC;IACnE,CAAC;IAED,MAAMQ,WAAU,GAAKR,KAAK,IAAK;MAC7B,OAAO,IAAIS,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,SAAS;QAChBC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACd,KAAK;IACjB;IAEA,MAAMe,gBAAe,GAAKf,KAAK,IAAK;MAClC,OAAO,IAAIS,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,SAAS;QAChBC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACd,KAAI,GAAI,GAAG;IACvB;IAEA,OAAO;MACLH,UAAU;MACVO,KAAK;MACLI,WAAW;MACXO;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}