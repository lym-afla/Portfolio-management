{"ast":null,"code":"import { ref, reactive, toRefs } from 'vue';\nimport { useStore } from 'vuex';\nexport default {\n  setup() {\n    const store = useStore();\n    const dialogOpen = ref(false);\n    const localSettings = reactive({\n      default_currency: 'USD',\n      digits: 0,\n      table_date: new Date().toISOString().substr(0, 10)\n    });\n    const currencyOptions = ['USD', 'EUR', 'GBP', 'JPY']; // Add more as needed\n\n    const openDialog = () => {\n      dialogOpen.value = true;\n    };\n    const closeDialog = () => {\n      dialogOpen.value = false;\n    };\n    const saveSettings = async () => {\n      try {\n        await store.dispatch('updateUserSettings', toRefs(localSettings));\n        closeDialog();\n        store.dispatch('triggerDataRefresh');\n      } catch (error) {\n        console.error('Failed to save settings:', error);\n      }\n    };\n    return {\n      dialogOpen,\n      localSettings,\n      currencyOptions,\n      openDialog,\n      closeDialog,\n      saveSettings\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","toRefs","useStore","setup","store","dialogOpen","localSettings","default_currency","digits","table_date","Date","toISOString","substr","currencyOptions","openDialog","value","closeDialog","saveSettings","dispatch","error","console"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\SettingsDialog.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-btn icon @click=\"openDialog\">\r\n      <v-icon>mdi-cog</v-icon>\r\n    </v-btn>\r\n\r\n    <v-dialog v-model=\"dialogOpen\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>\r\n          <span class=\"text-h5\">Settings</span>\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-select\r\n            v-model=\"localSettings.default_currency\"\r\n            :items=\"currencyOptions\"\r\n            label=\"Default Currency\"\r\n          ></v-select>\r\n          <v-text-field\r\n            v-model.number=\"localSettings.digits\"\r\n            type=\"number\"\r\n            label=\"Number of Digits\"\r\n            min=\"0\"\r\n            max=\"6\"\r\n          ></v-text-field>\r\n          <v-date-picker v-model=\"localSettings.table_date\"></v-date-picker>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"closeDialog\">Close</v-btn>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"saveSettings\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive, toRefs } from 'vue'\r\nimport { useStore } from 'vuex'\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore()\r\n    const dialogOpen = ref(false)\r\n    const localSettings = reactive({\r\n      default_currency: 'USD',\r\n      digits: 0,\r\n      table_date: new Date().toISOString().substr(0, 10)\r\n    })\r\n\r\n    const currencyOptions = ['USD', 'EUR', 'GBP', 'JPY'] // Add more as needed\r\n\r\n    const openDialog = () => {\r\n      dialogOpen.value = true\r\n    }\r\n\r\n    const closeDialog = () => {\r\n      dialogOpen.value = false\r\n    }\r\n\r\n    const saveSettings = async () => {\r\n      try {\r\n        await store.dispatch('updateUserSettings', toRefs(localSettings))\r\n        closeDialog()\r\n        store.dispatch('triggerDataRefresh')\r\n      } catch (error) {\r\n        console.error('Failed to save settings:', error)\r\n      }\r\n    }\r\n\r\n    return {\r\n      dialogOpen,\r\n      localSettings,\r\n      currencyOptions,\r\n      openDialog,\r\n      closeDialog,\r\n      saveSettings\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAqCA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,MAAK,QAAS,KAAI;AAC1C,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIF,QAAQ,CAAC;IACvB,MAAMG,UAAS,GAAIN,GAAG,CAAC,KAAK;IAC5B,MAAMO,aAAY,GAAI