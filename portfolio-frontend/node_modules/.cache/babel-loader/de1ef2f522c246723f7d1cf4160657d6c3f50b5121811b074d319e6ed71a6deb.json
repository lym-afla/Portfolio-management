{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onBeforeUnmount } from 'vue';\nimport { useRouter } from 'vue-router';\nimport axios from 'axios';\nimport LoginForm from '@/components/LoginForm.vue';\nexport default {\n  name: 'LoginPage',\n  components: {\n    LoginForm\n  },\n  setup() {\n    const loading = ref(false);\n    const router = useRouter();\n    const loginForm = ref(null);\n    const handleLogin = async credentials => {\n      console.log('Handling login with credentials:', credentials);\n      loading.value = true;\n      try {\n        const response = await axios.post('/users/api/login/', credentials);\n        console.log('Login response:', response.data);\n        if (response.data.token) {\n          localStorage.setItem('token', response.data.token);\n          router.push('/dashboard');\n        } else {\n          console.log('Login failed, no token received');\n          loginForm.value.setErrors('Login failed. Please try again.');\n        }\n      } catch (err) {\n        console.error('Login error:', err);\n        console.error('Error response:', err.response?.data);\n        if (err.response?.data?.non_field_errors) {\n          console.log('Non-field errors:', err.response.data.non_field_errors);\n          loginForm.value.setErrors(err.response.data.non_field_errors[0]);\n        } else if (err.response?.data) {\n          console.log('Field errors:', err.response.data);\n          loginForm.value.setErrors(err.response.data);\n        } else {\n          console.log('Unknown error');\n          loginForm.value.setErrors('An unknown error occurred. Please try again.');\n        }\n      } finally {\n        loading.value = false;\n      }\n    };\n    onBeforeUnmount(() => {\n      if (loginForm.value) {\n        loginForm.value.setErrors({});\n      }\n    });\n    return {\n      loading,\n      handleLogin,\n      loginForm\n    };\n  },\n  mounted() {\n    this.$emit('update-page-title', ''); // Clear the page title for login page\n  }\n};","map":{"version":3,"names":["ref","onBeforeUnmount","useRouter","axios","LoginForm","name","components","setup","loading","router","loginForm","handleLogin","credentials","console","log","value","response","post","data","token","localStorage","setItem","push","setErrors","err","error","non_field_errors","mounted","$emit"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\LoginPage.vue"],"sourcesContent":["<template>\r\n  <v-container class=\"fill-height\" fluid>\r\n    <v-row align=\"center\" justify=\"center\">\r\n      <v-col cols=\"12\" sm=\"8\" md=\"4\">\r\n        <v-card class=\"pa-4\">\r\n          <v-card-title class=\"headline\">Login</v-card-title>\r\n          <v-card-text>\r\n            <LoginForm \r\n              ref=\"loginForm\"\r\n              @submit=\"handleLogin\" \r\n              :loading=\"loading\" \r\n            />\r\n          </v-card-text>\r\n          <v-card-actions>\r\n            <v-spacer></v-spacer>\r\n            <span>Don't have an account? <router-link to=\"/register\">Register</router-link></span>\r\n          </v-card-actions>\r\n        </v-card>\r\n      </v-col>\r\n    </v-row>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onBeforeUnmount } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport axios from 'axios'\r\nimport LoginForm from '@/components/LoginForm.vue'\r\n\r\nexport default {\r\n  name: 'LoginPage',\r\n  components: {\r\n    LoginForm\r\n  },\r\n  setup() {\r\n    const loading = ref(false)\r\n    const router = useRouter()\r\n    const loginForm = ref(null)\r\n\r\n    const handleLogin = async (credentials) => {\r\n      console.log('Handling login with credentials:', credentials)\r\n      loading.value = true\r\n\r\n      try {\r\n        const response = await axios.post('/users/api/login/', credentials)\r\n        console.log('Login response:', response.data)\r\n        if (response.data.token) {\r\n          localStorage.setItem('token', response.data.token)\r\n          router.push('/dashboard')\r\n        } else {\r\n          console.log('Login failed, no token received')\r\n          loginForm.value.setErrors('Login failed. Please try again.')\r\n        }\r\n      } catch (err) {\r\n        console.error('Login error:', err)\r\n        console.error('Error response:', err.response?.data)\r\n        if (err.response?.data?.non_field_errors) {\r\n          console.log('Non-field errors:', err.response.data.non_field_errors)\r\n          loginForm.value.setErrors(err.response.data.non_field_errors[0])\r\n        } else if (err.response?.data) {\r\n          console.log('Field errors:', err.response.data)\r\n          loginForm.value.setErrors(err.response.data)\r\n        } else {\r\n          console.log('Unknown error')\r\n          loginForm.value.setErrors('An unknown error occurred. Please try again.')\r\n        }\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    onBeforeUnmount(() => {\r\n      if (loginForm.value) {\r\n        loginForm.value.setErrors({})\r\n      }\r\n    })\r\n\r\n    return { loading, handleLogin, loginForm }\r\n  },\r\n  mounted() {\r\n    this.$emit('update-page-title', ''); // Clear the page title for login page\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-card-actions a {\r\n  text-decoration: none;\r\n  color: #1976D2;\r\n}\r\n</style>"],"mappings":";AAwBA,SAASA,GAAG,EAAEC,eAAc,QAAS,KAAI;AACzC,SAASC,SAAQ,QAAS,YAAW;AACrC,OAAOC,KAAI,MAAO,OAAM;AACxB,OAAOC,SAAQ,MAAO,4BAA2B;AAEjD,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,MAAK,GAAIP,SAAS,CAAC;IACzB,MAAMQ,SAAQ,GAAIV,GAAG,CAAC,IAAI;IAE1B,MAAMW,WAAU,GAAI,MAAOC,WAAW,IAAK;MACzCC,OAAO,CAACC,GAAG,CAAC,kCAAkC,EAAEF,WAAW;MAC3DJ,OAAO,CAACO,KAAI,GAAI,IAAG;MAEnB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMb,KAAK,CAACc,IAAI,CAAC,mBAAmB,EAAEL,WAAW;QAClEC,OAAO,CAACC,GAAG,CAAC,iBAA