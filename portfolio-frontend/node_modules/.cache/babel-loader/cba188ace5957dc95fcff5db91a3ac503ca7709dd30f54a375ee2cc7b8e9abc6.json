{"ast":null,"code":"export default {\n  name: 'SummaryCard',\n  props: {\n    summary: {\n      type: Object,\n      required: true\n    },\n    currency: {\n      type: String,\n      default: 'USD'\n    }\n  },\n  setup(props) {\n    const formatKey = key => {\n      return key.replace(/_/g, ' ').replace(/\\b\\w/g, l => l.toUpperCase());\n    };\n    const formatValue = value => {\n      if (typeof value === 'number') {\n        return new Intl.NumberFormat('en-US', {\n          style: 'decimal',\n          minimumFractionDigits: 2,\n          maximumFractionDigits: 2\n        }).format(value);\n      } else if (typeof value === 'string' && value.endsWith('%')) {\n        return value;\n      } else {\n        return value;\n      }\n    };\n    return {\n      formatKey,\n      formatValue,\n      props // Return props to make them accessible in the template\n    };\n  }\n};","map":{"version":3,"names":["name","props","summary","type","Object","required","currency","String","default","setup","formatKey","key","replace","l","toUpperCase","formatValue","value","Intl","NumberFormat","style","minimumFractionDigits","maximumFractionDigits","format","endsWith"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\SummaryCard.vue"],"sourcesContent":["<template>\r\n  <v-card>\r\n    <v-card-title class=\"text-h6\">Portfolio Summary</v-card-title>\r\n    <v-card-text>\r\n      <v-table density=\"compact\" no-gutters>\r\n        <thead>\r\n          <tr>\r\n            <th></th>\r\n            <th class=\"text-right\">{{ props.currency }}</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"(value, key) in props.summary\" :key=\"key\">\r\n            <td>{{ formatKey(key) }}</td>\r\n            <td class=\"text-right\">{{ formatValue(value) }}</td>\r\n          </tr>\r\n        </tbody>\r\n      </v-table>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'SummaryCard',\r\n  props: {\r\n    summary: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    currency: {\r\n      type: String,\r\n      default: 'USD'\r\n    }\r\n  },\r\n  setup(props) {\r\n    const formatKey = (key) => {\r\n      return key.replace(/_/g, ' ').replace(/\\b\\w/g, l => l.toUpperCase())\r\n    }\r\n\r\n    const formatValue = (value) => {\r\n      if (typeof value === 'number') {\r\n        return new Intl.NumberFormat('en-US', {\r\n          style: 'decimal',\r\n          minimumFractionDigits: 2,\r\n          maximumFractionDigits: 2\r\n        }).format(value)\r\n      } else if (typeof value === 'string' && value.endsWith('%')) {\r\n        return value\r\n      } else {\r\n        return value\r\n      }\r\n    }\r\n\r\n    return {\r\n      formatKey,\r\n      formatValue,\r\n      props // Return props to make them accessible in the template\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAuBA,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE;IACLC,OAAO,EAAE;MACPC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,QAAQ,EAAE;MACRH,IAAI,EAAEI,MAAM;MACZC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,KAAKA,CAACR,KAAK,EAAE;IACX,MAAMS,SAAQ,GAAKC,GAAG,IAAK;MACzB,OAAOA,GAAG,CAACC,OAAO,CAAC,IAAI,EAAE,GAAG,CAAC,CAACA,OAAO,CAAC,OAAO,EAAEC,CAAA,IAAKA,CAAC,CAACC,WAAW,CAAC,CAAC;IACrE;IAEA,MAAMC,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,OAAOA,KAAI,KAAM,QAAQ,EAAE;QAC7B,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;UACpCC,KAAK,EAAE,SAAS;UAChBC,qBAAqB,EAAE,CAAC;UACxBC,qBAAqB,EAAE;QACzB,CAAC,CAAC,CAACC,MAAM,CAACN,KAAK;MACjB,OAAO,IAAI,OAAOA,KAAI,KAAM,QAAO,IAAKA,KAAK,CAACO,QAAQ,CAAC,GAAG,CAAC,EAAE;QAC3D,OAAOP,KAAI;MACb,OAAO;QACL,OAAOA,KAAI;MACb;IACF;IAEA,OAAO;MACLN,SAAS;MACTK,WAAW;MACXd,KAAI,CAAE;IACR;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}