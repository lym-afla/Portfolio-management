{"ast":null,"code":"import { ref, computed, onMounted } from 'vue';\nimport { useForm } from 'vee-validate';\nimport { importPrices, getPriceImportFormStructure } from '@/services/api';\nimport { format } from 'date-fns';\nimport DatePicker from '@/components/DatePicker.vue';\nexport default {\n  name: 'PriceImportDialog',\n  components: {\n    DatePicker\n  },\n  props: {\n    modelValue: Boolean\n  },\n  emits: ['update:modelValue', 'prices-imported'],\n  setup(props, {\n    emit\n  }) {\n    const dialog = computed({\n      get: () => props.modelValue,\n      set: value => emit('update:modelValue', value)\n    });\n    const {\n      handleSubmit,\n      errors\n    } = useForm({\n      initialValues: {\n        securities: [],\n        brokers: [],\n        startDate: null,\n        endDate: null,\n        frequency: null,\n        singleDate: null,\n        additionalDate: ''\n      },\n      validate: values => {\n        const errors = {};\n        if (values.securities.length === 0 && values.brokers.length === 0) {\n          errors.securities = 'Either securities or brokers must be selected';\n          errors.brokers = 'Either securities or brokers must be selected';\n        }\n        if (values.dateType === 'range') {\n          if (!values.startDate) errors.startDate = 'Start date is required for date range';\n          if (!values.endDate) errors.endDate = 'End date is required for date range';\n          if (!values.frequency) errors.frequency = 'Frequency is required for date range';\n        } else if (values.dateType === 'single') {\n          if (!values.singleDate) errors.singleDate = 'Date is required for single date import';\n        }\n        if (!values.additionalDate) {\n          errors.additionalDate = 'Additional date is required';\n        }\n        return errors;\n      }\n    });\n    const securities = ref([]);\n    const brokers = ref([]);\n    const dateType = ref('range');\n    const startDate = ref(null);\n    const endDate = ref(null);\n    const frequency = ref(null);\n    const singleDate = ref(null);\n    const additionalDate = ref('');\n    const securitiesList = ref([]);\n    const brokersList = ref([]);\n    const frequencyChoices = ref([]);\n    const generalError = ref('');\n    const isSubmitting = ref(false);\n    const fetchFormStructure = async () => {\n      try {\n        const structure = await getPriceImportFormStructure();\n        securitiesList.value = structure.securities;\n        brokersList.value = structure.brokers;\n        frequencyChoices.value = structure.frequency_choices;\n      } catch (error) {\n        console.error('Error fetching form structure:', error);\n        generalError.value = 'Failed to load form structure. Please try again.';\n      }\n    };\n    onMounted(() => {\n      fetchFormStructure();\n    });\n    const securitiesAllSelected = computed(() => {\n      return securities.value.length === securitiesList.value.length;\n    });\n    const securitiesIndeterminate = computed(() => {\n      return securities.value.length > 0 && !securitiesAllSelected.value;\n    });\n    const brokersAllSelected = computed(() => {\n      return brokers.value.length === brokersList.value.length;\n    });\n    const brokersIndeterminate = computed(() => {\n      return brokers.value.length > 0 && !brokersAllSelected.value;\n    });\n    const toggleSelectAllSecurities = () => {\n      if (securitiesAllSelected.value) {\n        securities.value = [];\n      } else {\n        securities.value = securitiesList.value.map(s => s.id);\n      }\n    };\n    const toggleSelectAllBrokers = () => {\n      if (brokersAllSelected.value) {\n        brokers.value = [];\n      } else {\n        brokers.value = brokersList.value.map(b => b.id);\n      }\n    };\n    const submitForm = handleSubmit(async values => {\n      console.log('Submitting form with values:', values);\n      console.log('Current errors:', errors.value);\n      isSubmitting.value = true;\n      generalError.value = '';\n      try {\n        const submitData = {\n          ...values\n        };\n        if (dateType.value === 'single') {\n          delete submitData.startDate;\n          delete submitData.endDate;\n          delete submitData.frequency;\n          if (submitData.singleDate) {\n            submitData.single_date = format(new Date(submitData.singleDate), 'yyyy-MM-dd');\n          }\n        } else {\n          delete submitData.singleDate;\n          if (submitData.startDate) {\n            submitData.start_date = format(new Date(submitData.startDate), 'yyyy-MM-dd');\n          }\n          if (submitData.endDate) {\n            submitData.end_date = format(new Date(submitData.endDate), 'yyyy-MM-dd');\n          }\n        }\n        if (additionalDate.value) {\n          submitData.additional_date = additionalDate.value;\n        }\n        console.log('Submitting data:', submitData);\n        const response = await importPrices(submitData);\n        emit('prices-imported', response);\n        dialog.value = false;\n        resetForm();\n      } catch (error) {\n        console.error('Error importing prices:', error);\n        if (typeof error === 'object') {\n          if (error.non_field_errors) {\n            generalError.value = error.non_field_errors[0];\n          } else {\n            Object.keys(error).forEach(key => {\n              if (Array.isArray(error[key])) {\n                errors.value[key] = error[key][0];\n              } else {\n                errors.value[key] = error[key];\n              }\n            });\n          }\n        } else {\n          generalError.value = error.toString();\n        }\n      } finally {\n        isSubmitting.value = false;\n      }\n    });\n    return {\n      dialog,\n      securities,\n      brokers,\n      dateType,\n      startDate,\n      endDate,\n      frequency,\n      singleDate,\n      securitiesList,\n      brokersList,\n      frequencyChoices,\n      securitiesError,\n      brokersError,\n      startDateError,\n      endDateError,\n      frequencyError,\n      singleDateError,\n      generalError,\n      isSubmitting,\n      securitiesAllSelected,\n      securitiesIndeterminate,\n      brokersAllSelected,\n      brokersIndeterminate,\n      toggleSelectAllSecurities,\n      toggleSelectAllBrokers,\n      submitForm,\n      errors,\n      additionalDate,\n      additionalDateError\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","useForm","importPrices","getPriceImportFormStructure","format","DatePicker","name","components","props","modelValue","Boolean","emits","setup","emit","dialog","get","set","value","handleSubmit","errors","initialValues","securities","brokers","startDate","endDate","frequency","singleDate","additionalDate","validate","values","length","dateType","securitiesList","brokersList","frequencyChoices","generalError","isSubmitting","fetchFormStructure","structure","frequency_choices","error","console","securitiesAllSelected","securitiesIndeterminate","brokersAllSelected","brokersIndeterminate","toggleSelectAllSecurities","map","s","id","toggleSelectAllBrokers","b","submitForm","log","submitData","single_date","Date","start_date","end_date","additional_date","response","resetForm","non_field_errors","Object","keys","forEach","key","Array","isArray","toString","securitiesError","brokersError","startDateError","endDateError","frequencyError","singleDateError","additionalDateError"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\PriceImportDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"800px\">\r\n    <v-card>\r\n      <v-card-title>\r\n        <span class=\"text-h5\">Import Prices</span>\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-form @submit.prevent=\"submitForm\">\r\n          <v-autocomplete\r\n            v-model=\"securities\"\r\n            :items=\"securitiesList\"\r\n            label=\"Securities\"\r\n            item-title=\"name\"\r\n            item-value=\"id\"\r\n            multiple\r\n            clearable\r\n            :disabled=\"brokers.length > 0\"\r\n            :error-messages=\"errors.securities\"\r\n            >\r\n            <template v-slot:prepend-item>\r\n              <v-list-item title=\"Select All\" @click=\"toggleSelectAllSecurities\">\r\n                <template v-slot:prepend>\r\n                  <v-checkbox-btn\r\n                    :model-value=\"securitiesAllSelected\"\r\n                    :indeterminate=\"securitiesIndeterminate\"\r\n                  ></v-checkbox-btn>\r\n                </template>\r\n              </v-list-item>\r\n              <v-divider class=\"mt-2\"></v-divider>\r\n            </template>\r\n          </v-autocomplete>\r\n\r\n          <v-autocomplete\r\n            v-model=\"brokers\"\r\n            :items=\"brokersList\"\r\n            label=\"Brokers\"\r\n            item-title=\"name\"\r\n            item-value=\"id\"\r\n            multiple\r\n            clearable\r\n            :disabled=\"securities.length > 0\"\r\n            :error-messages=\"errors.brokers\"\r\n            >\r\n            <template v-slot:prepend-item>\r\n              <v-list-item title=\"Select All\" @click=\"toggleSelectAllBrokers\">\r\n                <template v-slot:prepend>\r\n                  <v-checkbox-btn\r\n                    :model-value=\"brokersAllSelected\"\r\n                    :indeterminate=\"brokersIndeterminate\"\r\n                  ></v-checkbox-btn>\r\n                </template>\r\n              </v-list-item>\r\n              <v-divider class=\"mt-2\"></v-divider>\r\n            </template>\r\n          </v-autocomplete>\r\n\r\n          <v-radio-group v-model=\"dateType\" row>\r\n            <v-radio label=\"Date Range\" value=\"range\"></v-radio>\r\n            <v-radio label=\"Single Date\" value=\"single\"></v-radio>\r\n          </v-radio-group>\r\n\r\n          <template v-if=\"dateType === 'range'\">\r\n            <v-row>\r\n              <v-col cols=\"12\" sm=\"6\">\r\n                <div v-if=\"errors.startDate\" class=\"text-caption text-error pl-6\">\r\n                  {{ errors.startDate }}\r\n                </div>\r\n                <v-date-picker \r\n                  v-model=\"startDate\" \r\n                  label=\"Start Date\"\r\n                  :error-messages=\"errors.startDate\"\r\n                ></v-date-picker>\r\n              </v-col>\r\n              <v-col cols=\"12\" sm=\"6\">\r\n                <div v-if=\"errors.endDate\" class=\"text-caption text-error pl-6\">\r\n                  {{ errors.endDate }}\r\n                </div>\r\n                <v-date-picker \r\n                  v-model=\"endDate\" \r\n                  label=\"End Date\"\r\n                  :error-messages=\"errors.endDate\"\r\n                ></v-date-picker>\r\n              </v-col>\r\n            </v-row>\r\n            <v-select\r\n              v-model=\"frequency\"\r\n              :items=\"frequencyChoices\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              label=\"Frequency\"\r\n              :error-messages=\"errors.frequency\"\r\n            ></v-select>\r\n          </template>\r\n\r\n          <template v-else>\r\n            <div v-if=\"errors.singleDate\" class=\"text-caption text-error pl-6\">\r\n                {{ errors.singleDate }}\r\n            </div>\r\n            <v-date-picker \r\n              v-model=\"singleDate\" \r\n                label=\"Date\"\r\n                :error=\"!!errors.singleDate\"\r\n              ></v-date-picker>\r\n          </template>\r\n\r\n          <DatePicker\r\n            v-model=\"additionalDate\"\r\n            label=\"Additional Date\"\r\n            :error-message=\"errors.additionalDate\"\r\n          />\r\n\r\n          <v-btn type=\"submit\" color=\"primary\" class=\"mt-4\" :loading=\"isSubmitting\">\r\n            Import Prices