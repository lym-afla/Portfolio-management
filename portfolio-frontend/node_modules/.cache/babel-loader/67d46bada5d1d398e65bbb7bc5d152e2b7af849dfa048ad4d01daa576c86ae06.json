{"ast":null,"code":"import { ref, computed, onMounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport debounce from 'lodash/debounce';\nimport { getTransactionsTable } from '@/services/api';\nexport default {\n  name: 'TransactionsPage',\n  setup() {\n    const store = useStore();\n    const transactions = ref([]);\n    const loading = ref(true);\n    const totalItems = ref(0);\n    const itemsPerPage = ref(25);\n    const page = ref(1);\n    const search = ref('');\n    const selectedTransactions = ref([]);\n    const currencies = computed(() => store.state.currencies);\n    const selectedBroker = computed(() => store.state.selectedBroker);\n    const headers = computed(() => [{\n      text: '',\n      value: 'actions',\n      sortable: false\n    }, {\n      text: 'Date',\n      value: 'date'\n    }, {\n      text: 'Transaction',\n      value: 'transaction'\n    }, {\n      text: 'Type',\n      value: 'type'\n    }, ...currencies.value.map(currency => ({\n      text: currency,\n      value: `cash_flow_${currency}`\n    })), {\n      text: '',\n      value: 'spacer',\n      sortable: false\n    }, ...currencies.value.map(currency => ({\n      text: currency,\n      value: `balance_${currency}`\n    }))]);\n    const fetchTransactions = async () => {\n      loading.value = true;\n      try {\n        const response = await getTransactionsTable({\n          timespan: store.state.tableSettings.timespan,\n          page: page.value,\n          items_per_page: itemsPerPage.value,\n          search: search.value\n        });\n        transactions.value = response.transactions;\n        totalItems.value = response.total_items;\n      } catch (error) {\n        console.error('Error fetching transactions:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const updatePage = newPage => {\n      page.value = newPage;\n      fetchTransactions();\n    };\n    const updateItemsPerPage = newItemsPerPage => {\n      itemsPerPage.value = newItemsPerPage;\n      fetchTransactions();\n    };\n    const debouncedSearch = debounce(() => {\n      page.value = 1;\n      fetchTransactions();\n    }, 300);\n    const getCashFlow = (item, currency) => {\n      if (item.currency === currency) {\n        if (['Dividend', 'Tax', 'Interest income', 'Cash deposit', 'Cash withdrawal'].includes(item.type)) {\n          return item.cash_flow;\n        } else if (item.type === 'Broker commission') {\n          return `(${item.commission})`;\n        } else {\n          return item.value;\n        }\n      } else if (item.from_currency === currency) {\n        return item.from_amount;\n      } else if (item.to_currency === currency) {\n        return item.to_amount;\n      } else {\n        return '–';\n      }\n    };\n    onMounted(fetchTransactions);\n    watch(() => store.state.tableSettings.timespan, fetchTransactions);\n    watch(() => store.state.refreshTrigger, fetchTransactions);\n    return {\n      transactions,\n      headers,\n      loading,\n      totalItems,\n      itemsPerPage,\n      page,\n      search,\n      selectedTransactions,\n      currencies,\n      selectedBroker,\n      updatePage,\n      updateItemsPerPage,\n      debouncedSearch,\n      getCashFlow\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","watch","useStore","debounce","getTransactionsTable","name","setup","store","transactions","loading","totalItems","itemsPerPage","page","search","selectedTransactions","currencies","state","selectedBroker","headers","text","value","sortable","map","currency","fetchTransactions","response","timespan","tableSettings","items_per_page","total_items","error","console","updatePage","newPage","updateItemsPerPage","newItemsPerPage","debouncedSearch","getCashFlow","item","includes","type","cash_flow","commission","from_currency","from_amount","to_currency","to_amount","refreshTrigger"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\TransactionsPage.vue"],"sourcesContent":["<template>\r\n    <div>\r\n      <h2>Transactions — <span id=\"brokerNameHeader\">{{ selectedBroker }}</span></h2>\r\n  \r\n      <div class=\"content-header\">\r\n        <!-- Add buttons for settings, etc. -->\r\n      </div>\r\n  \r\n      <div class=\"content-body\">\r\n        <v-data-table\r\n          :headers=\"headers\"\r\n          :items=\"transactions\"\r\n          :items-per-page=\"itemsPerPage\"\r\n          :page=\"page\"\r\n          :server-items-length=\"totalItems\"\r\n          @update:page=\"updatePage\"\r\n          @update:items-per-page=\"updateItemsPerPage\"\r\n          class=\"elevation-1\"\r\n        >\r\n          <template v-slot:top>\r\n            <v-text-field\r\n              v-model=\"search\"\r\n              label=\"Search\"\r\n              class=\"mx-4\"\r\n              @input=\"debouncedSearch\"\r\n            ></v-text-field>\r\n          </template>\r\n  \r\n          <template v-slot:item=\"{ item }\">\r\n            <tr>\r\n              <td>\r\n                <v-checkbox v-model=\"selectedTransactions\" :value=\"item.id\"></v-checkbox>\r\n              </td>\r\n              <td>{{ item.date }}</td>\r\n              <td>\r\n                {{ item.type }}\r\n                <template v-if=\"item.type === 'Cash' || item.type === 'Dividend'\">\r\n                  {{ item.cash_flow }}\r\n                </template>\r\n                <template v-else-if=\"item.type === 'Close'\">\r\n                  {{ item.quantity }} of {{ item.security }}\r\n                </template>\r\n                <template v-else-if=\"item.type === 'FX'\">\r\n                  : {{ item.from_currency }} to {{ item.to_currency }} @ {{ item.exchange_rate }}\r\n                  <span class=\"text-caption\"> || Fee: {{ item.commission }}</span>\r\n                </template>\r\n                <template v-else>\r\n                  {{ item.quantity }} @ {{ item.price }} of {{ item.security }}\r\n                  <span class=\"text-caption\"> || Fee: {{ item.commission }}</span>\r\n                </template>\r\n              </td>\r\n              <td>{{ item.type }}</td>\r\n              <td v-for=\"currency in currencies\" :key=\"currency\">\r\n                {{ getCashFlow(item, currency) }}\r\n              </td>\r\n              <td></td>\r\n              <td v-for=\"currency in currencies\" :key=\"currency\">\r\n                {{ item.balances[currency] }}\r\n              </td>\r\n            </tr>\r\n          </template>\r\n        </v-data-table>\r\n      </div>\r\n  \r\n      <v-overlay :value=\"loading\">\r\n        <v-progress-circular indeterminate size=\"64\"></v-progress-circular>\r\n      </v-overlay>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref, computed, onMounted, watch } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import debounce from 'lodash/debounce'\r\n  import { getTransactionsTable } from '@/services/api'\r\n  \r\n  export default {\r\n    name: 'TransactionsPage',\r\n    setup() {\r\n      const store = useStore()\r\n      const transactions = ref([])\r\n      const loading = ref(true)\r\n      const totalItems = ref(0)\r\n      const itemsPerPage = ref(25)\r\n      const page = ref(1)\r\n      const search = ref('')\r\n      const selectedTransactions = ref([])\r\n      const currencies = computed(() => store.state.currencies)\r\n      const selectedBroker = computed(() => store.state.selectedBroker)\r\n  \r\n      const headers = computed(() => [\r\n        { text: '', value: 'actions', sortable: false },\r\n        { text: 'Date', value: 'date' },\r\n        { text: 'Transaction', value: 'transaction' },\r\n        { text: 'Type', value: 'type' },\r\n        ...currencies.value.map(currency => ({ text: currency, value: `cash_flow_${currency}` })),\r\n        { text: '', value: 'spacer', sortable: false },\r\n        ...currencies.value.map(currency => ({ text: currency, value: `balance_${currency}` })),\r\n      ])\r\n  \r\n      const fetchTransactions = async () => {\r\n        loading.value = true\r\n        try {\r\n          const response = await getTransactionsTable({\r\n            timespan: store.state.tableSettings.timespan,\r\n            page: page.value,\r\n            items_per_page: itemsPerPage.value,\r\n            search: search.value,\r\n          })\r\n          transactions.value = response.transactions\r\n          totalItems.value = response.total_items\r\n        } catch (error) {\r\n          console.error('Error fetching transactions:', error)\r\n        } finally {\r\n          loading.value = false\r\n        }\r\n      }\r\n  \r\n      const updatePage = (newPage) => {\r\n        page.value = newPage\r\n        fetchTransactions()\r\n      }\r\n  \r\n      const updateItemsPerPage = (newItemsPerPage) => {\r\n        itemsPerPage.value = newItemsPerPage\r\n        fetchTransactions()\r\n      }\r\n  \r\n      const debouncedSearch = debounce(() => {\r\n        page.value = 1\r\n        fetchTransactions()\r\n      }, 300)\r\n  \r\n      const getCashFlow = (item, currency) => {\r\n        if (item.currency === currency) {\r\n          if (['Dividend', 'Tax', 'Interest income', 'Cash deposit', 'Cash withdrawal'].includes(item.type)) {\r\n            return item.cash_flow\r\n          } else if (item.type === 'Broker commission') {\r\n            return `(${item.commission})`\r\n          } else {\r\n            return item.value\r\n          }\r\n        } else if (item.from_currency === currency) {\r\n          return item.from_amount\r\n        } else if (item.to_currency === currency) {\r\n          return item.to_amount\r\n        } else {\r\n          return '–'\r\n        }\r\n      }\r\n  \r\n      onMounted(fetchTransactions)\r\n  \r\n      watch(() => store.state.tableSettings.timespan, fetchTransactions)\r\n      watch(() => store.state.refreshTrigger, fetchTransactions)\r\n  \r\n      return {\r\n        transactions,\r\n        headers,\r\n        loading,\r\n        totalItems,\r\n        itemsPerPage,\r\n        page,\r\n        search,\r\n        selectedTransactions,\r\n        currencies,\r\n        selectedBroker,\r\n        updatePage,\r\n        updateItemsPerPage,\r\n        debouncedSearch,\r\n        getCashFlow,\r\n      }\r\n    },\r\n  }\r\n  </script>"],"mappings":"AAuEE,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,KAAI,QAAS,KAAI;AACpD,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,QAAO,MAAO,iBAAgB;AACrC,SAASC,oBAAmB,QAAS,gBAAe;AAEpD,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC;IACvB,MAAMM,YAAW,GAAIV,GAAG,CAAC,EAAE;IAC3B,MAAMW,OAAM,GAAIX,GAAG,CAAC,IAAI;IACxB,MAAMY,UAAS,GAAIZ,GAAG,CAAC,CAAC;IACxB,MAAMa,YAAW,GAAIb,GAAG,CAAC,EAAE;IAC3B,MAAMc,IAAG,GAAId,GAAG,CAAC,CAAC;IAClB,MAAMe,MAAK,GAAIf,GAAG,CAAC,EAAE;IACrB,MAAMgB,oBAAmB,GAAIhB,GAAG,CAAC,EAAE;IACnC,MAAMiB,UAAS,GAAIhB,QAAQ,CAAC,MAAMQ,KAAK,CAACS,KAAK,CAACD,UAAU;IACxD,MAAME,cAAa,GAAIlB,QAAQ,CAAC,MAAMQ,KAAK,CAACS,KAAK,CAACC,cAAc;IAEhE,MAAMC,OAAM,GAAInB,QAAQ,CAAC,MAAM,CAC7B;MAAEoB,IAAI,EAAE,EAAE;MAAEC,KAAK,EAAE,SAAS;MAAEC,QAAQ,EAAE;IAAM,CAAC,EAC/C;MAAEF,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAO,CAAC,EAC/B;MAAED,IAAI,EAAE,aAAa;MAAEC,KAAK,EAAE;IAAc,CAAC,EAC7C;MAAED,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAO,CAAC,EAC/B,GAAGL,UAAU,CAACK,KAAK,CAACE,GAAG,CAACC,QAAO,KAAM;MAAEJ,IAAI,EAAEI,QAAQ;MAAEH,KAAK,EAAE,aAAaG,QAAQ;IAAG,CAAC,CAAC,CAAC,EACzF;MAAEJ,IAAI,EAAE,EAAE;MAAEC,KAAK,EAAE,QAAQ;MAAEC,QAAQ,EAAE;IAAM,CAAC,EAC9C,GAAGN,UAAU,CAACK,KAAK,CAACE,GAAG,CAACC,QAAO,KAAM;MAAEJ,IAAI,EAAEI,QAAQ;MAAEH,KAAK,EAAE,WAAWG,QAAQ;IAAG,CAAC,CAAC,CAAC,CACxF;IAED,MAAMC,iBAAgB,GAAI,MAAAA,CAAA,KAAY;MACpCf,OAAO,CAACW,KAAI,GAAI,IAAG;MACnB,IAAI;QACF,MAAMK,QAAO,GAAI,MAAMrB,oBAAoB,CAAC;UAC1CsB,QAAQ,EAAEnB,KAAK,CAACS,KAAK,CAACW,aAAa,CAACD,QAAQ;UAC5Cd,IAAI,EAAEA,IAAI,CAACQ,KAAK;UAChBQ,cAAc,EAAEjB,YAAY,CAACS,KAAK;UAClCP,MAAM,EAAEA,MAAM,CAACO;QACjB,CAAC;QACDZ,YAAY,CAACY,KAAI,GAAIK,QAAQ,CAACjB,YAAW;QACzCE,UAAU,CAACU,KAAI,GAAIK,QAAQ,CAACI,WAAU;MACxC,EAAE,OAAOC,KAAK,E