{"ast":null,"code":"import { ref, computed, watch } from 'vue';\nimport { analyzeFile, getBrokers, importTransactions } from '@/services/api';\nimport { useErrorHandler } from '@/composables/useErrorHandler';\nimport { useWebSocket } from '@/composables/useWebSocket';\nimport { useImportState } from '@/composables/useImportState';\nimport ProgressDialog from '@/components/dialogs/ProgressDialog.vue';\nimport SecurityMappingDialog from '@/components/dialogs/SecurityMappingDialog.vue';\nexport default {\n  name: 'TransactionImportDialog',\n  components: {\n    ProgressDialog,\n    SecurityMappingDialog\n  },\n  props: {\n    modelValue: Boolean\n  },\n  emits: ['update:modelValue', 'import-completed'],\n  setup(props, {\n    emit\n  }) {\n    const {\n      handleApiError\n    } = useErrorHandler();\n    const {\n      isConnected,\n      lastMessage,\n      sendMessage\n    } = useWebSocket('/ws/transactions/');\n    const importState = useImportState();\n    const dialog = computed({\n      get: () => props.modelValue,\n      set: value => {\n        emit('update:modelValue', value);\n        if (!value) {\n          resetDialogPartial();\n        }\n      }\n    });\n    const file = ref(null);\n    const isLoading = ref(false);\n    const isAnalyzed = ref(false);\n    const selectedBroker = ref(null);\n    const brokers = ref([]);\n    const fileId = ref(null);\n    const brokerIdentified = ref(false);\n    const identifiedBroker = ref(null);\n    const brokerIdentificationComplete = ref(false);\n    const showSuccessDialog = ref(false);\n    const importStats = ref({\n      totalTransactions: 0,\n      importedTransactions: 0,\n      skippedTransactions: 0,\n      newSecurities: 0,\n      unrecognizedSecurities: []\n    });\n    const unrecognizedSecurities = ref([]);\n    const securityMappings = ref({});\n    const showUnrecognizedSecuritiesDialog = ref(false);\n    const existingSecurities = ref([]);\n    const error = ref(null);\n    const handleFileChange = event => {\n      file.value = event.target.files[0];\n      isAnalyzed.value = false;\n      brokerIdentified.value = false;\n      selectedBroker.value = null;\n      identifiedBroker.value = null;\n      brokerIdentificationComplete.value = false;\n      fileId.value = null;\n      console.log('File changed:', file.value);\n    };\n    const closeDialog = () => {\n      dialog.value = false;\n      resetDialogPartial();\n    };\n    const submitFile = async () => {\n      if (file.value) {\n        isLoading.value = true;\n        try {\n          const formData = new FormData();\n          formData.append('file', file.value);\n          console.log('Submitting file:', file.value);\n          const result = await analyzeFile(formData);\n          isAnalyzed.value = true;\n          fileId.value = result.fileId;\n          brokers.value = await getBrokers();\n          if (result.status === 'broker_identified') {\n            brokerIdentified.value = true;\n            identifiedBroker.value = result.identifiedBroker;\n            selectedBroker.value = result.identifiedBroker.id;\n          }\n        } catch (error) {\n          handleApiError(error);\n        } finally {\n          isLoading.value = false;\n          brokerIdentificationComplete.value = true;\n        }\n      } else {\n        console.error('No file selected');\n      }\n    };\n    const startImport = () => {\n      error.value = null; // Clear any previous errors\n      if (isConnected.value) {\n        sendMessage({\n          type: 'start_import',\n          file_id: fileId.value,\n          broker_id: selectedBroker.value\n        });\n      } else {\n        console.error('WebSocket not connected');\n      }\n    };\n    const handleWebSocketMessage = message => {\n      console.log('Received WebSocket message:', message);\n      if (message.type === 'import_error') {\n        error.value = message.data.error;\n      } else if (message.type === 'import_update') {\n        handleImportUpdate(message.data);\n      }\n    };\n    const handleImportUpdate = update => {\n      if (update.status === 'progress') {\n        importState.setProgress(update.progress);\n        importState.setState('importing', update.message);\n      } else if (update.status === 'security_mapping') {\n        importState.setSecurityToMap(update.security);\n      } else if (update.status === 'complete') {\n        handleImportSuccess(update.data);\n      }\n    };\n    const handleSecurityMapped = securityId => {\n      if (isConnected.value) {\n        sendMessage({\n          type: 'security_mapped',\n          security_id: securityId\n        });\n      }\n    };\n    const confirmSecurityMappings = async () => {\n      try {\n        const result = await importTransactions(fileId.value, selectedBroker.value, securityMappings.value);\n        handleImportSuccess(result);\n      } catch (error) {\n        handleApiError(error);\n      } finally {\n        showUnrecognizedSecuritiesDialog.value = false;\n      }\n    };\n    const createNewSecurity = async securityName => {\n      console.log('Creating new security:', securityName);\n      // Implement logic to create a new security\n      // This could open a new dialog or navigate to a new security creation page\n      // After creation, update the securityMappings\n    };\n    const handleImportSuccess = result => {\n      importStats.value = result.importResults;\n      showSuccessDialog.value = true;\n      emit('import-completed', result.importResults);\n    };\n    const stopImport = () => {\n      // Implement stop import logic here\n      if (isConnected.value) {\n        sendMessage({\n          type: 'stop_import'\n        });\n      }\n    };\n    const closeSuccessDialog = () => {\n      showSuccessDialog.value = false;\n      resetDialogFull();\n      closeDialog();\n    };\n    const resetDialogPartial = () => {\n      file.value = null;\n      isAnalyzed.value = false;\n      brokerIdentified.value = false;\n      identifiedBroker.value = null;\n      brokerIdentificationComplete.value = false;\n      importState.setState('idle');\n    };\n    const resetDialogFull = () => {\n      resetDialogPartial();\n      fileId.value = null;\n      selectedBroker.value = null;\n    };\n    watch(lastMessage, newMessage => {\n      if (newMessage) {\n        handleWebSocketMessage(newMessage);\n      }\n    });\n    watch(() => props.modelValue, newValue => {\n      if (!newValue) {\n        resetDialogPartial();\n      }\n    });\n    return {\n      dialog,\n      file,\n      isLoading,\n      isAnalyzed,\n      selectedBroker,\n      brokers,\n      brokerIdentified,\n      identifiedBroker,\n      brokerIdentificationComplete,\n      showSuccessDialog,\n      importStats,\n      unrecognizedSecurities,\n      securityMappings,\n      showUnrecognizedSecuritiesDialog,\n      existingSecurities,\n      error,\n      importState,\n      handleFileChange,\n      closeDialog,\n      submitFile,\n      startImport,\n      confirmSecurityMappings,\n      createNewSecurity,\n      stopImport,\n      closeSuccessDialog,\n      handleSecurityMapped\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","analyzeFile","getBrokers","importTransactions","useErrorHandler","useWebSocket","useImportState","ProgressDialog","SecurityMappingDialog","name","components","props","modelValue","Boolean","emits","setup","emit","handleApiError","isConnected","lastMessage","sendMessage","importState","dialog","get","set","value","resetDialogPartial","file","isLoading","isAnalyzed","selectedBroker","brokers","fileId","brokerIdentified","identifiedBroker","brokerIdentificationComplete","showSuccessDialog","importStats","totalTransactions","importedTransactions","skippedTransactions","newSecurities","unrecognizedSecurities","securityMappings","showUnrecognizedSecuritiesDialog","existingSecurities","error","handleFileChange","event","target","files","console","log","closeDialog","submitFile","formData","FormData","append","result","status","id","startImport","type","file_id","broker_id","handleWebSocketMessage","message","data","handleImportUpdate","update","setProgress","progress","setState","setSecurityToMap","security","handleImportSuccess","handleSecurityMapped","securityId","security_id","confirmSecurityMappings","createNewSecurity","securityName","importResults","stopImport","closeSuccessDialog","resetDialogFull","newMessage","newValue"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\TransactionImportDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5\">Import Transactions</v-card-title>\r\n      <v-card-text>\r\n        <v-file-input\r\n          v-model=\"file\"\r\n          label=\"Select Excel or CSV file to import\"\r\n          accept=\".csv, .xlsx, .xls\"\r\n          :rules=\"[v => !!v || 'File is required']\"\r\n          @change=\"handleFileChange\"\r\n          :disabled=\"isAnalyzed\"\r\n        ></v-file-input>\r\n        <v-alert\r\n          v-if=\"isAnalyzed && brokerIdentificationComplete\"\r\n          :type=\"brokerIdentified ? 'success' : 'info'\"\r\n          class=\"mt-4 mb-4\"\r\n        >\r\n          {{ brokerIdentified \r\n            ? `Broker \"${identifiedBroker.name}\" was automatically identified. Please confirm or select a different broker.` \r\n            : 'Broker could not be automatically identified. Please select a broker below.' }}\r\n        </v-alert>\r\n        <v-autocomplete\r\n          v-if=\"isAnalyzed\"\r\n          v-model=\"selectedBroker\"\r\n          :items=\"brokers\"\r\n          item-title=\"name\"\r\n          item-value=\"id\"\r\n          label=\"Select Broker\"\r\n          class=\"mt-4\"\r\n        ></v-autocomplete>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n        <v-btn \r\n          v-if=\"!isAnalyzed\" \r\n          color=\"blue darken-1\" \r\n          text \r\n          @click=\"submitFile\" \r\n          :disabled=\"!file || isLoading\"\r\n          :loading=\"isLoading\"\r\n        >\r\n          Analyze File\r\n        </v-btn>\r\n        <v-btn\r\n          v-if=\"isAnalyzed\"\r\n          color=\"blue darken-1\"\r\n          text\r\n          @click=\"startImport\"\r\n          :disabled=\"!selectedBroker\"\r\n        >\r\n          Import Transactions\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n    <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n      {{ error }}\r\n    </v-alert>\r\n  </v-dialog>\r\n\r\n  <ProgressDialog\r\n    v-if=\"importState.isImporting || importState.isComplete || importState.isError\"\r\n    :progress=\"importState.progress\"\r\n    :message=\"importState.currentMessage\"\r\n    :is-complete=\"importState.isComplete\"\r\n    :is-error=\"importState.isError\"\r\n    @stop-import=\"stopImport\"\r\n  />\r\n\r\n  <SecurityMappingDialog\r\n    v-if=\"importState.isMapping\"\r\n    :security=\"importState.securityToMap\"\r\n    @mapped=\"handleSecurityMapped\"\r\n  />\r\n\r\n  <v-dialog v-model=\"showSuccessDialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5 pb-2\">\r\n        <v-icon color=\"success\" class=\"mr-2\">mdi-check-circle</v-icon>\r\n        Import Completed\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"primary\" size=\"40\">\r\n                    <v-icon dark>mdi-database-import</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.totalTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Total transactions processed</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"success\" size=\"40\">\r\n                    <v-icon dark>mdi-check-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.importedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Successfully imported</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"error\" size=\"40\">\r\n                    <v-icon dark>mdi-alert-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.skippedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Skipped transactions</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"info\" size=\"40\">\r\n                    <v-icon dark>mdi-plus-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.newSecurities }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>New securities added</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"warning\" size=\"40\">\r\n                    <v-icon dark>mdi-help-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.unrecognizedSecurities.length }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Unrecognized securities</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"closeSuccessDialog\">Close</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <v-dialog v-model=\"showUnrecognizedSecuritiesDialog\" max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title>Unrecognized Securities</v-card-title>\r\n      <v-card-text>\r\n        <p>The following securities were not recognized. Please map them to existing securities or create new ones:</p>\r\n        <v-list>\r\n          <v-list-item v-for=\"security in unrecognizedSecurities\" :key=\"security\">\r\n            <v-list-item-title>{{ security }}</v-list-item-title>\r\n            <template v-slot:append>\r\n              <v-autocomplete\r\n                v-model=\"securityMappings[security]\"\r\n                :items=\"existingSecurities\"\r\n                item-title=\"name\"\r\n                item-value=\"id\"\r\n                label=\"Select existing security\"\r\n                clearable\r\n                style=\"max-width: 300px;\"\r\n              ></v-autocomplete>\r\n              <v-btn v-if=\"!securityMappings[security]\" @click=\"createNewSecurity(security)\" color=\"primary\" text>\r\n                Create New Security\r\n              </v-btn>\r\n            </template>\r\n          </v-list-item>\r\n        </v-list>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"confirmSecurityMappings\">Confirm and Import</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n\r\n    <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n      {{ error }}\r\n    </v-alert>\r\n\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch } from 'vue'\r\nimport { analyzeFile, getBrokers, importTransactions } from '@/services/api'\r\nimport { useErrorHandler } from '@/composables/useErrorHandler'\r\nimport { useWebSocket } from '@/composables/useWebSocket'\r\nimport { useImportState } from '@/composables/useImportState'\r\nimport ProgressDialog from '@/components/dialogs/ProgressDialog.vue'\r\nimport SecurityMappingDialog from '@/components/dialogs/SecurityMappingDialog.vue'\r\n\r\nexport default {\r\n  name: 'TransactionImportDialog',\r\n  components: {\r\n    ProgressDialog,\r\n    SecurityMappingDialog,\r\n  },\r\n  props: {\r\n    modelValue: Boolean,\r\n  },\r\n  emits: ['update:modelValue', 'import-completed'],\r\n  setup(props, { emit }) {\r\n    const { handleApiError } = useErrorHandler()\r\n    const { isConnected, lastMessage, sendMessage } = useWebSocket('/ws/transactions/')\r\n    const importState = useImportState()\r\n\r\n    const dialog = computed({\r\n      get: () => props.modelValue,\r\n      set: (value) => {\r\n        emit('update:modelValue', value)\r\n        if (!value) {\r\n          resetDialogPartial()\r\n        }\r\n      }\r\n    })\r\n\r\n    const file = ref(null)\r\n    const isLoading = ref(false)\r\n    const isAnalyzed = ref(false)\r\n    const selectedBroker = ref(null)\r\n    const brokers = ref([])\r\n    const fileId = ref(null)\r\n    const brokerIdentified = ref(false)\r\n    const identifiedBroker = ref(null)\r\n    const brokerIdentificationComplete = ref(false)\r\n\r\n    const showSuccessDialog = ref(false)\r\n    const importStats = ref({\r\n      totalTransactions: 0,\r\n      importedTransactions: 0,\r\n      skippedTransactions: 0,\r\n      newSecurities: 0,\r\n      unrecognizedSecurities: []\r\n    })\r\n    const unrecognizedSecurities = ref([])\r\n    const securityMappings = ref({})\r\n    const showUnrecognizedSecuritiesDialog = ref(false)\r\n    const existingSecurities = ref([])\r\n\r\n    const error = ref(null)\r\n\r\n    const handleFileChange = (event) => {\r\n      file.value = event.target.files[0]\r\n      isAnalyzed.value = false\r\n      brokerIdentified.value = false\r\n      selectedBroker.value = null\r\n      identifiedBroker.value = null\r\n      brokerIdentificationComplete.value = false\r\n      fileId.value = null\r\n      console.log('File changed:', file.value)\r\n    }\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      resetDialogPartial()\r\n    }\r\n\r\n    const submitFile = async () => {\r\n      if (file.value) {\r\n        isLoading.value = true\r\n        try {\r\n          const formData = new FormData()\r\n          formData.append('file', file.value)\r\n          console.log('Submitting file:', file.value)\r\n          const result = await analyzeFile(formData)\r\n          isAnalyzed.value = true\r\n          fileId.value = result.fileId\r\n          brokers.value = await getBrokers()\r\n          \r\n          if (result.status === 'broker_identified') {\r\n            brokerIdentified.value = true\r\n            identifiedBroker.value = result.identifiedBroker\r\n            selectedBroker.value = result.identifiedBroker.id\r\n          }\r\n        } catch (error) {\r\n          handleApiError(error)\r\n        } finally {\r\n          isLoading.value = false\r\n          brokerIdentificationComplete.value = true\r\n        }\r\n      } else {\r\n        console.error('No file selected')\r\n      }\r\n    }\r\n\r\n    const startImport = () => {\r\n      error.value = null  // Clear any previous errors\r\n      if (isConnected.value) {\r\n        sendMessage({\r\n          type: 'start_import',\r\n          file_id: fileId.value,\r\n          broker_id: selectedBroker.value\r\n        })\r\n      } else {\r\n        console.error('WebSocket not connected')\r\n      }\r\n    }\r\n\r\n    const handleWebSocketMessage = (message) => {\r\n      console.log('Received WebSocket message:', message)\r\n      if (message.type === 'import_error') {\r\n        error.value = message.data.error\r\n      } else if (message.type === 'import_update') {\r\n        handleImportUpdate(message.data)\r\n      }\r\n    }\r\n\r\n    const handleImportUpdate = (update) => {\r\n      if (update.status === 'progress') {\r\n        importState.setProgress(update.progress)\r\n        importState.setState('importing', update.message)\r\n      } else if (update.status === 'security_mapping') {\r\n        importState.setSecurityToMap(update.security)\r\n      } else if (update.status === 'complete') {\r\n        handleImportSuccess(update.data)\r\n      }\r\n    }\r\n\r\n    const handleSecurityMapped = (securityId) => {\r\n      if (isConnected.value) {\r\n        sendMessage({\r\n          type: 'security_mapped',\r\n          security_id: securityId\r\n        })\r\n      }\r\n    }\r\n\r\n    const confirmSecurityMappings = async () => {\r\n      try {\r\n        const result = await importTransactions(fileId.value, selectedBroker.value, securityMappings.value)\r\n        handleImportSuccess(result)\r\n      } catch (error) {\r\n        handleApiError(error)\r\n      } finally {\r\n        showUnrecognizedSecuritiesDialog.value = false\r\n      }\r\n    }\r\n\r\n    const createNewSecurity = async (securityName) => {\r\n      console.log('Creating new security:', securityName)\r\n      // Implement logic to create a new security\r\n      // This could open a new dialog or navigate to a new security creation page\r\n      // After creation, update the securityMappings\r\n    }\r\n\r\n    const handleImportSuccess = (result) => {\r\n      importStats.value = result.importResults\r\n      showSuccessDialog.value = true\r\n      emit('import-completed', result.importResults)\r\n    }\r\n\r\n    const stopImport = () => {\r\n      // Implement stop import logic here\r\n      if (isConnected.value) {\r\n        sendMessage({\r\n          type: 'stop_import'\r\n        })\r\n      }\r\n    }\r\n\r\n    const closeSuccessDialog = () => {\r\n      showSuccessDialog.value = false\r\n      resetDialogFull()\r\n      closeDialog()\r\n    }\r\n\r\n    const resetDialogPartial = () => {\r\n      file.value = null\r\n      isAnalyzed.value = false\r\n      brokerIdentified.value = false\r\n      identifiedBroker.value = null\r\n      brokerIdentificationComplete.value = false\r\n      importState.setState('idle')\r\n    }\r\n\r\n    const resetDialogFull = () => {\r\n      resetDialogPartial()\r\n      fileId.value = null\r\n      selectedBroker.value = null\r\n    }\r\n\r\n    watch(lastMessage, (newMessage) => {\r\n      if (newMessage) {\r\n        handleWebSocketMessage(newMessage)\r\n      }\r\n    })\r\n\r\n    watch(() => props.modelValue, (newValue) => {\r\n      if (!newValue) {\r\n        resetDialogPartial()\r\n      }\r\n    })\r\n\r\n    return {\r\n      dialog,\r\n      file,\r\n      isLoading,\r\n      isAnalyzed,\r\n      selectedBroker,\r\n      brokers,\r\n      brokerIdentified,\r\n      identifiedBroker,\r\n      brokerIdentificationComplete,\r\n      showSuccessDialog,\r\n      importStats,\r\n      unrecognizedSecurities,\r\n      securityMappings,\r\n      showUnrecognizedSecuritiesDialog,\r\n      existingSecurities,\r\n      error,\r\n      importState,\r\n      handleFileChange,\r\n      closeDialog,\r\n      submitFile,\r\n      startImport,\r\n     