{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport axios from 'axios';\nexport default {\n  name: 'RegisterPage',\n  setup() {\n    const username = ref('');\n    const email = ref('');\n    const password = ref('');\n    const error = ref('');\n    const router = useRouter();\n    const register = async () => {\n      try {\n        await axios.post('/users/api/register/', {\n          username: username.value,\n          email: email.value,\n          password: password.value\n        });\n        router.push('/login');\n      } catch (err) {\n        error.value = 'Registration failed. Please try again.';\n      }\n    };\n    return {\n      username,\n      email,\n      password,\n      error,\n      register\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","axios","name","setup","username","email","password","error","router","register","post","value","push","err"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\RegisterPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-page\">\r\n    <h1>Register</h1>\r\n    <form @submit.prevent=\"register\">\r\n      <div>\r\n        <label for=\"username\">Username:</label>\r\n        <input type=\"text\" id=\"username\" v-model=\"username\" required />\r\n      </div>\r\n      <div>\r\n        <label for=\"email\">Email:</label>\r\n        <input type=\"email\" id=\"email\" v-model=\"email\" required />\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">Password:</label>\r\n        <input type=\"password\" id=\"password\" v-model=\"password\" required />\r\n      </div>\r\n      <button type=\"submit\">Register</button>\r\n    </form>\r\n    <p v-if=\"error\" class=\"error\">{{ error }}</p>\r\n    <p>Already have an account? <router-link to=\"/login\">Login</router-link></p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'RegisterPage',\r\n  setup() {\r\n    const username = ref('')\r\n    const email = ref('')\r\n    const password = ref('')\r\n    const error = ref('')\r\n    const router = useRouter()\r\n\r\n    const register = async () => {\r\n      try {\r\n        await axios.post('/users/api/register/', {\r\n          username: username.value,\r\n          email: email.value,\r\n          password: password.value,\r\n        })\r\n        router.push('/login')\r\n      } catch (err) {\r\n        error.value = 'Registration failed. Please try again.'\r\n      }\r\n    }\r\n\r\n    return { username, email, password, error, register }\r\n  },\r\n}\r\n</script>\r\n"],"mappings":";AAwBA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,OAAOC,KAAI,MAAO,OAAM;AAExB,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,KAAKA,CAAA,EAAG;IACN,MAAMC,QAAO,GAAIL,GAAG,CAAC,EAAE;IACvB,MAAMM,KAAI,GAAIN,GAAG,CAAC,EAAE;IACpB,MAAMO,QAAO,GAAIP,GAAG,CAAC,EAAE;IACvB,MAAMQ,KAAI,GAAIR,GAAG,CAAC,EAAE;IACpB,MAAMS,MAAK,GAAIR,SAAS,CAAC;IAEzB,MAAMS,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,IAAI;QACF,MAAMR,KAAK,CAACS,IAAI,CAAC,sBAAsB,EAAE;UACvCN,QAAQ,EAAEA,QAAQ,CAACO,KAAK;UACxBN,KAAK,EAAEA,KAAK,CAACM,KAAK;UAClBL,QAAQ,EAAEA,QAAQ,CAACK;QACrB,CAAC;QACDH,MAAM,CAACI,IAAI,CAAC,QAAQ;MACtB,EAAE,OAAOC,GAAG,EAAE;QACZN,KAAK,CAACI,KAAI,GAAI,wCAAuC;MACvD;IACF;IAEA,OAAO;MAAEP,QAAQ;MAAEC,KAAK;MAAEC,QAAQ;MAAEC,KAAK;MAAEE;IAAS;EACtD;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}