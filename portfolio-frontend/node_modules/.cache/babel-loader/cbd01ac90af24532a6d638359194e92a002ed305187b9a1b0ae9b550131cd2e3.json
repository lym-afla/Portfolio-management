{"ast":null,"code":"import { ref, watch, computed, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { getAssetTypes, getBrokers, getSecurities, getPrices } from '@/services/api';\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue';\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue';\nimport debounce from 'lodash/debounce';\nimport { useTableSettings } from '@/composables/useTableSettings';\nexport default {\n  name: 'PricesPage',\n  components: {\n    AddSecurityButton,\n    AddPriceEntryButton\n  },\n  setup() {\n    const store = useStore();\n    const {\n      dateFrom,\n      dateTo,\n      itemsPerPage,\n      currentPage,\n      sortBy,\n      search,\n      handlePageChange,\n      handleItemsPerPageChange,\n      handleSortChange\n    } = useTableSettings();\n    const assetTypes = ref([]);\n    const brokers = ref([]);\n    const securities = ref([]);\n    const selectedAssetTypes = ref([]);\n    const selectedBroker = ref(null);\n    const selectedSecurities = ref([]);\n    const priceData = ref([]);\n    const loading = ref(false);\n    const totalItems = ref(0);\n    const editDialog = ref(false);\n    const deleteDialog = ref(false);\n    const editedItem = ref({});\n    const deletedItem = ref({});\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions);\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value));\n    const headers = [{\n      title: 'Date',\n      key: 'date'\n    }, {\n      title: 'Security',\n      key: 'security__name'\n    }, {\n      title: 'Asset Type',\n      key: 'security__type'\n    }, {\n      title: 'Currency',\n      key: 'security__currency'\n    }, {\n      title: 'Price',\n      key: 'price'\n    }, {\n      title: 'Actions',\n      key: 'actions',\n      sortable: false\n    }];\n    const assetTypesAllSelected = computed(() => {\n      return selectedAssetTypes.value.length === assetTypes.value.length;\n    });\n    const assetTypesIndeterminate = computed(() => {\n      return selectedAssetTypes.value.length > 0 && !assetTypesAllSelected.value;\n    });\n    const securitiesAllSelected = computed(() => {\n      return selectedSecurities.value.length === securities.value.length;\n    });\n    const securitiesIndeterminate = computed(() => {\n      return selectedSecurities.value.length > 0 && !securitiesAllSelected.value;\n    });\n    const toggleSelectAllAssetTypes = () => {\n      if (assetTypesAllSelected.value) {\n        selectedAssetTypes.value = [];\n      } else {\n        selectedAssetTypes.value = assetTypes.value.map(item => item.value);\n      }\n    };\n    const toggleSelectAllSecurities = () => {\n      if (securitiesAllSelected.value) {\n        selectedSecurities.value = [];\n      } else {\n        selectedSecurities.value = securities.value.map(item => item.id);\n      }\n    };\n    onMounted(async () => {\n      try {\n        const [assetTypesData, brokersData, securitiesData] = await Promise.all([getAssetTypes(), getBrokers(), getSecurities()]);\n        console.log('brokersData', brokersData);\n        console.log('securitiesData', securitiesData);\n        console.log('assetTypesData', assetTypesData);\n        assetTypes.value = assetTypesData;\n        brokers.value = brokersData;\n        securities.value = securitiesData;\n        fetchPriceData();\n      } catch (error) {\n        console.error('Error fetching initial data:', error);\n      }\n    });\n    const fetchSecurities = debounce(async () => {\n      try {\n        securities.value = await getSecurities(selectedAssetTypes.value, selectedBroker.value);\n        // Reset securities if they are no longer in the list\n        selectedSecurities.value = selectedSecurities.value.filter(id => securities.value.some(security => security.id === id));\n        // Automatically select all securities if a broker is selected\n        if (selectedBroker.value) {\n          selectedSecurities.value = securities.value.map(item => item.id);\n        }\n      } catch (error) {\n        console.error('Error fetching securities:', error);\n      }\n    }, 300); // 300ms debounce\n\n    watch([selectedAssetTypes, selectedBroker], () => {\n      fetchSecurities();\n    });\n    const fetchPriceData = async () => {\n      loading.value = true;\n      console.log('[PricesPage] fetchPriceData called with:', {\n        dateFrom: dateFrom.value,\n        dateTo: dateTo.value,\n        currentPage: currentPage.value,\n        itemsPerPage: itemsPerPage.value,\n        search: search.value,\n        sortBy: sortBy.value\n      });\n      try {\n        const response = await getPrices({\n          assetTypes: selectedAssetTypes.value,\n          broker: selectedBroker.value,\n          securities: selectedSecurities.value,\n          startDate: dateFrom.value,\n          endDate: dateTo.value,\n          page: currentPage.value,\n          itemsPerPage: itemsPerPage.value,\n          search: search.value,\n          sortBy: sortBy.value[0] || {}\n        });\n        console.log('Fetched price data:', response);\n        priceData.value = response.prices;\n        totalItems.value = response.total_items;\n        console.log('Total items:', totalItems.value);\n      } catch (error) {\n        console.error('Error fetching price data:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const applyFilters = () => {\n      fetchPriceData();\n    };\n    const showImportModal = () => {\n      // TODO: Implement import modal logic\n      console.log('Showing import modal');\n    };\n    const editPrice = item => {\n      editedItem.value = {\n        ...item\n      };\n      editDialog.value = true;\n    };\n    const closeEditDialog = () => {\n      editDialog.value = false;\n      editedItem.value = {};\n    };\n    const updatePrice = async () => {\n      // TODO: Implement actual API call to update price\n      console.log('Updating price:', editedItem.value);\n      closeEditDialog();\n      await fetchPriceData();\n    };\n    const deletePrice = item => {\n      deletedItem.value = item;\n      deleteDialog.value = true;\n    };\n    const closeDeleteDialog = () => {\n      deleteDialog.value = false;\n      deletedItem.value = {};\n    };\n    const confirmDelete = async () => {\n      // TODO: Implement actual API call to delete price\n      console.log('Deleting price:', deletedItem.value);\n      closeDeleteDialog();\n      await fetchPriceData();\n    };\n    const handleTableUpdate = options => {\n      console.log('Table options updated:', options);\n      if (options.itemsPerPage !== itemsPerPage.value) {\n        handleItemsPerPageChange(options.itemsPerPage);\n      }\n      if (options.page !== currentPage.value) {\n        handlePageChange(options.page);\n      }\n      if (options.sortBy !== sortBy.value) {\n        handleSortChange(options.sortBy);\n      }\n      console.log('After update:', {\n        itemsPerPage: itemsPerPage.value,\n        currentPage: currentPage.value,\n        sortBy: sortBy.value\n      });\n    };\n    watch([() => store.state.dataRefreshTrigger, itemsPerPage, currentPage, sortBy, search, dateFrom, dateTo], () => {\n      fetchPriceData();\n    }, {\n      deep: true\n    });\n    return {\n      assetTypes,\n      brokers,\n      securities,\n      selectedAssetTypes,\n      selectedBroker,\n      selectedSecurities,\n      dateFrom,\n      dateTo,\n      applyFilters,\n      showImportModal,\n      headers,\n      priceData,\n      loading,\n      totalItems,\n      itemsPerPage,\n      currentPage,\n      sortBy,\n      search,\n      editDialog,\n      deleteDialog,\n      editedItem,\n      handlePageChange,\n      handleItemsPerPageChange,\n      handleSortChange,\n      fetchPriceData,\n      editPrice,\n      closeEditDialog,\n      updatePrice,\n      deletePrice,\n      closeDeleteDialog,\n      confirmDelete,\n      assetTypesAllSelected,\n      assetTypesIndeterminate,\n      securitiesAllSelected,\n      securitiesIndeterminate,\n      toggleSelectAllAssetTypes,\n      toggleSelectAllSecurities,\n      fetchSecurities,\n      itemsPerPageOptions,\n      pageCount,\n      handleTableUpdate\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","computed","onMounted","useStore","getAssetTypes","getBrokers","getSecurities","getPrices","AddSecurityButton","AddPriceEntryButton","debounce","useTableSettings","name","components","setup","store","dateFrom","dateTo","itemsPerPage","currentPage","sortBy","search","handlePageChange","handleItemsPerPageChange","handleSortChange","assetTypes","brokers","securities","selectedAssetTypes","selectedBroker","selectedSecurities","priceData","loading","totalItems","editDialog","deleteDialog","editedItem","deletedItem","itemsPerPageOptions","state","pageCount","Math","ceil","value","headers","title","key","sortable","assetTypesAllSelected","length","assetTypesIndeterminate","securitiesAllSelected","securitiesIndeterminate","toggleSelectAllAssetTypes","map","item","toggleSelectAllSecurities","id","assetTypesData","brokersData","securitiesData","Promise","all","console","log","fetchPriceData","error","fetchSecurities","filter","some","security","response","broker","startDate","endDate","page","prices","total_items","applyFilters","showImportModal","editPrice","closeEditDialog","updatePrice","deletePrice","closeDeleteDialog","confirmDelete","handleTableUpdate","options","dataRefreshTrigger","deep"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\PricesPage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text class=\"pa-4\">\r\n        <v-row>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedAssetTypes\"\r\n              :items=\"assetTypes\"\r\n              label=\"Asset Types\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              multiple\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item\r\n                title=\"Select All\"\r\n                @click=\"toggleSelectAllAssetTypes\"\r\n                >\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"assetTypesAllSelected\"\r\n                      :indeterminate=\"assetTypesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 3\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 3\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedAssetTypes.length - 3 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedBroker\"\r\n              :items=\"brokers\"\r\n              label=\"Brokers\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              clearable\r\n            ></v-autocomplete>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-autocomplete\r\n              v-model=\"selectedSecurities\"\r\n              :items=\"securities\"\r\n              label=\"Securities\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              multiple\r\n              clearable\r\n            >\r\n              <template v-slot:prepend-item>\r\n                <v-list-item\r\n                title=\"Select All\"\r\n                @click=\"toggleSelectAllSecurities\"\r\n                >\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      :model-value=\"securitiesAllSelected\"\r\n                      :indeterminate=\"securitiesIndeterminate\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                </v-list-item>\r\n                <v-divider class=\"mt-2\"></v-divider>\r\n              </template>\r\n              <template v-slot:selection=\"{ item, index }\">\r\n                <v-chip v-if=\"index < 1\">\r\n                  <span>{{ item.title }}</span>\r\n                </v-chip>\r\n                <span\r\n                  v-if=\"index === 1\"\r\n                  class=\"text-grey text-caption align-self-center\"\r\n                >\r\n                  (+{{ selectedSecurities.length - 1 }} others)\r\n                </span>\r\n              </template>\r\n            </v-autocomplete>\r\n          </v-col>\r\n        </v-row>\r\n        <v-row class=\"mt-n6\">\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-text-field\r\n              v-model=\"dateFrom\"\r\n              label=\"Start Date\"\r\n              type=\"date\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\">\r\n            <v-text-field\r\n              v-model=\"dateTo\"\r\n              label=\"End Date\"\r\n              type=\"date\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" md=\"4\" class=\"d-flex align-center\">\r\n            <v-btn color=\"primary\" @click=\"applyFilters\" block>\r\n              Apply Filters\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\" justify=\"space-between\">\r\n          <v-col cols=\"auto\">\r\n            <v-row>\r\n              <v-col cols=\"auto\">\r\n                <AddSecurityButton />\r\n              </v-col>\r\n              <v-col cols=\"auto\">\r\n                <AddPriceEntryButton />\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n          <v-col cols=\"auto\">\r\n            <v-btn color=\"success\" @click=\"showImportModal\">\r\n              Import Prices\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card>\r\n      <v-data-table\r\n        :headers=\"headers\"\r\n        :items=\"priceData\"\r\n        :loading=\"loading\"\r\n        :items-per-page=\"itemsPerPage\"\r\n        :page=\"currentPage\"\r\n        :items-per-page-options=\"itemsPerPageOptions\"\r\n        :server-items-length=\"totalItems\"\r\n        :sort-by=\"sortBy\"\r\n        :search=\"search\"\r\n        @update:options=\"handleTableUpdate\"\r\n        disable-sort\r\n      >\r\n        <template #[`item.price`]=\"{ item }\">\r\n          <span class=\"editable\" @click=\"editPrice(item)\">{{ item.price }}</span>\r\n        </template>\r\n        <template #[`item.actions`]=\"{ item }\">\r\n          <v-btn small color=\"primary\" class=\"mr-2\" @click=\"editPrice(item)\">Edit</v-btn>\r\n          <v-btn small color=\"error\" @click=\"deletePrice(item)\">Delete</v-btn>\r\n        </template>\r\n        <template #bottom>\r\n          <div class=\"d-flex align-center justify-space-between pa-4\">\r\n            <v-select\r\n              v-model=\"itemsPerPage\"\r\n              :items=\"itemsPerPageOptions\"\r\n              label=\"Rows per page\"\r\n              density=\"compact\"\r\n              variant=\"outlined\"\r\n              hide-details\r\n              class=\"rows-per-page-select\"\r\n              @update:model-value=\"handleItemsPerPageChange\"\r\n              bg-color=\"white\"\r\n              style=\"max-width: 150px;\" <!-- Adjusted width for better spacing -->\r\n            ></v-select>\r\n            <span class=\"text-caption mr-4\">\r\n              Showing {{ (currentPage - 1) * itemsPerPage + 1 }}-{{\r\n                Math.min(currentPage * itemsPerPage, totalItems)\r\n              }} of {{ totalItems }} entries\r\n            </span>\r\n            <v-pagination\r\n              v-model=\"currentPage\"\r\n              :length=\"pageCount\"\r\n              :total-visible=\"7\"\r\n              @update:model-value=\"handlePageChange\"\r\n            ></v-pagination>\r\n          </div>\r\n        </template>\r\n      </v-data-table>\r\n    </v-card>\r\n\r\n    <v-dialog v-model=\"editDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Edit Price</v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"updatePrice\">\r\n            <v-text-field\r\n              v-model=\"editedItem.price\"\r\n              label=\"Price\"\r\n              type=\"number\"\r\n              step=\"0.01\"\r\n              required\r\n            ></v-text-field>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeEditDialog\">Cancel</v-btn>\r\n          <v-btn color=\"blue darken-1\" text @click=\"updatePrice\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n\r\n    <v-dialog v-model=\"deleteDialog\" max-width=\"500px\">\r\n      <v-card>\r\n        <v-card-title>Delete Price Entry</v-card-title>\r\n        <v-card-text>Are you sure you want to delete this price entry?</v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue darken-1\" text @click=\"closeDeleteDialog\">Cancel</v-btn>\r\n          <v-btn color=\"red darken-1\" text @click=\"confirmDelete\">Delete</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch, computed, onMounted } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { getAssetTypes, getBrokers, getSecurities, getPrices } from '@/services/api'\r\nimport AddSecurityButton from '@/components/buttons/AddSecurity.vue'\r\nimport AddPriceEntryButton from '@/components/buttons/AddPrice.vue'\r\nimport debounce from 'lodash/debounce'\r\nimport { useTableSettings } from '@/composables/useTableSettings'\r\n\r\nexport default {\r\n  name: 'PricesPage',\r\n  components: {\r\n    AddSecurityButton,\r\n    AddPriceEntryButton,\r\n  },\r\n  setup() {\r\n    const store = useStore()\r\n    const {\r\n      dateFrom,\r\n      dateTo,\r\n      itemsPerPage,\r\n      currentPage,\r\n      sortBy,\r\n      search,\r\n      handlePageChange,\r\n      handleItemsPerPageChange,\r\n      handleSortChange\r\n    } = useTableSettings()\r\n\r\n    const assetTypes = ref([])\r\n    const brokers = ref([])\r\n    const securities = ref([])\r\n    const selectedAssetTypes = ref([])\r\n    const selectedBroker = ref(null)\r\n    const selectedSecurities = ref([])\r\n    const priceData = ref([])\r\n    const loading = ref(false)\r\n    const totalItems = ref(0)\r\n    const editDialog = ref(false)\r\n    const deleteDialog = ref(false)\r\n    const editedItem = ref({})\r\n    const deletedItem = ref({})\r\n\r\n    const itemsPerPageOptions = computed(() => store.state.itemsPerPageOptions)\r\n    const pageCount = computed(() => Math.ceil(totalItems.value / itemsPerPage.value))\r\n\r\n    const headers = [\r\n      { title: 'Date', key: 'date' },\r\n      { title: 'Security', key: 'security__name' },\r\n      { title: 'Asset Type', key: 'security__type' },\r\n      { title: 'Currency', key: 'security__currency' },\r\n      { title: 'Price', key: 'price' },\r\n      { title: 'Actions', key: 'actions', sortable: false },\r\n    ]\r\n\r\n    const assetTypesAllSelected = computed(() => {\r\n      return selectedAssetTypes.value.length === assetTypes.value.length\r\n    })\r\n\r\n    const assetTypesIndeterminate = computed(() => {\r\n      return selectedAssetTypes.value.length > 0 && !assetTypesAllSelected.value\r\n    })\r\n\r\n    const securitiesAllSelected = computed(() => {\r\n      return selectedSecurities.value.length === securities.value.length\r\n    })\r\n\r\n    const securitiesIndeterminate = computed(() => {\r\n      return selectedSecurities.value.length > 0 && !securitiesAllSelected.value\r\n    })\r\n\r\n    const toggleSelectAllAssetTypes = () => {\r\n      if (assetTypesAllSelected.value) {\r\n        selectedAssetTypes.value = []\r\n      } else {\r\n        selectedAssetTypes.value = assetTypes.value.map(item => item.value)\r\n      }\r\n    }\r\n\r\n    const toggleSelectAllSecurities = () => {\r\n      if (securitiesAllSelected.value) {\r\n        selectedSecurities.value = []\r\n      } else {\r\n        selectedSecurities.value = securities.value.map(item => item.id)\r\n      }\r\n    }\r\n\r\n    onMounted(async () => {\r\n      try {\r\n        const [assetTypesData, brokersData, securitiesData] = await Promise.all([\r\n          getAssetTypes(),\r\n          getBrokers(),\r\n          getSecurities(),\r\n        ])\r\n        console.log('brokersData', brokersData)\r\n        console.log('securitiesData', securitiesData)\r\n        console.log('assetTypesData', assetTypesData)\r\n        assetTypes.value = assetTypesData\r\n        brokers.value = brokersData\r\n        securities.value = securitiesData\r\n\r\n        fetchPriceData()\r\n\r\n      } catch (error) {\r\n        console.error('Error fetching initial data:', error)\r\n      }\r\n    })\r\n\r\n    const fetchSecurities = debounce(async () => {\r\n      try {\r\n        securities.value = await getSecurities(selectedAssetTypes.value, selectedBroker.value)\r\n        // Reset securities if they are no longer in the list\r\n        selectedSecurities.value = selectedSecurities.value.filter(id =>\r\n          securities.value.some(security => security.id === id)\r\n        )\r\n        // Automatically select all securities if a broker is selected\r\n        if (selectedBroker.value) {\r\n          selectedSecurities.value = securities.value.map(item => item.id);\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching securities:', error)\r\n      }\r\n    }, 300) // 300ms debounce\r\n\r\n    watch([selectedAssetTypes, selectedBroker], () => {\r\n      fetchSecurities()\r\n    })\r\n\r\n    const fetchPriceData = async () => {\r\n      loading.value = true\r\n      console.log('[PricesPage] fetchPriceData called with:', {\r\n        dateFrom: dateFrom.value,\r\n        dateTo: dateTo.value,\r\n        currentPage: currentPage.value,\r\n        itemsPerPage: itemsPerPage.value,\r\n        search: search.value,\r\n        sortBy: sortBy.value\r\n      })\r\n      try {\r\n        const response = await getPrices({\r\n          assetTypes: selectedAssetTypes.value,\r\n          broker: selectedBroker.value,\r\n          securities: selectedSecurities.value,\r\n          startDate: dateFrom.value,\r\n          endDate: dateTo.value,\r\n          page: currentPage.value,\r\n          itemsPerPage: itemsPerPage.value,\r\n          search: search.value,\r\n          sortBy: sortBy.value[0] || {}\r\n        })\r\n        console.log('Fetched price data:', response)\r\n        priceData.value = response.prices\r\n        totalItems.value = response.total_items\r\n        console.log('Total items:', totalItems.value)\r\n      } catch (error) {\r\n        console.error('Error fetching price data:', error)\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    const applyFilters = () => {\r\n      fetchPriceData()\r\n    }\r\n\r\n    const showImportModal = () => {\r\n      // TODO: Implement import modal logic\r\n      console.log('Showing import modal')\r\n    }\r\n\r\n    const editPrice = (item) => {\r\n      editedItem.value = { ...item }\r\n      editDialog.value = true\r\n    }\r\n\r\n    const closeEditDialog = () => {\r\n      editDialog.value = false\r\n      editedItem.value = {}\r\n    }\r\n\r\n    const updatePrice = async () => {\r\n      // TODO: Implement actual API call to update price\r\n      console.log('Updating price:', editedItem.value)\r\n      closeEditDialog()\r\n      await fetchPriceData()\r\n    }\r\n\r\n    const deletePrice = (item) => {\r\n      deletedItem.value = item\r\n      deleteDialog.value = true\r\n    }\r\n\r\n    const closeDeleteDialog = () => {\r\n      deleteDialog.value = false\r\n      deletedItem.value = {}\r\n    }\r\n\r\n    const confirmDelete = async () => {\r\n      // TODO: Implement actual API call to delete price\r\n      console.log('Deleting price:', deletedItem.value)\r\n      closeDeleteDialog()\r\n      await fetchPriceData()\r\n    }\r\n\r\n    const handleTableUpdate = (options) => {\r\n      console.log('Table options updated:', options)\r\n      if (options.itemsPerPage !== itemsPerPage.value) {\r\n        handleItemsPerPageChange(options.itemsPerPage)\r\n      }\r\n      if (options.page !== currentPage.value) {\r\n        handlePageChange(options.page)\r\n      }\r\n      if (options.sortBy !== sortBy.value) {\r\n        handleSortChange(options.sortBy)\r\n      }\r\n      console.log('After update:', { \r\n        itemsPerPage: itemsPerPage.value, \r\n        currentPage: currentPage.value, \r\n        sortBy: sortBy.value \r\n      })\r\n    }\r\n\r\n    watch(\r\n      [\r\n        () => store.state.dataRefreshTrigger,\r\n        itemsPerPage,\r\n        currentPage,\r\n        sortBy,\r\n        search,\r\n        dateFrom,\r\n        dateTo\r\n      ],\r\n      () => {\r\n        fetchPriceData()\r\n      },\r\n      { deep: true }\r\n    )\r\n\r\n    return {\r\n      assetTypes,\r\n      brokers,\r\n      securities,\r\n      selectedAssetTypes,\r\n      selectedBroker,\r\n      selectedSecurities,\r\n      dateFrom,\r