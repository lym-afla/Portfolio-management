{"ast":null,"code":"import { ref, computed, watch, onMounted, onUnmounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { getOpenPositions, getOpenPositionsYearOptions } from '@/services/api';\nimport { formatDate } from '@/utils/formatters';\nimport BrokerSelection from '@/components/BrokerSelection.vue';\nexport default {\n  name: 'OpenPositions',\n  emits: ['update-page-title'],\n  setup(props, {\n    emit\n  }) {\n    const store = useStore();\n    const openPositions = ref([]);\n    const totals = ref({});\n    const tableLoading = ref(true);\n    const selectedYear = ref('All-time');\n    const yearOptions = ref([]);\n    const search = ref('');\n    const itemsPerPage = ref(25);\n    const currentPage = ref(1);\n    const totalItems = ref(0);\n    const sortBy = ref([]);\n\n    // ... implement other necessary refs and computed properties ...\n\n    const fetchOpenPositions = async () => {\n      tableLoading.value = true;\n      try {\n        const data = await getOpenPositions(selectedYear.value, currentPage.value, itemsPerPage.value, search.value, sortBy.value[0] || {});\n        openPositions.value = data.portfolio_open;\n        totals.value = data.portfolio_open_totals;\n        totalItems.value = data.total_items;\n      } catch (error) {\n        store.dispatch('setError', error);\n        console.error('Error in fetchOpenPositions:', error);\n      } finally {\n        tableLoading.value = false;\n      }\n    };\n    const fetchYearOptions = async () => {\n      try {\n        const years = await getOpenPositionsYearOptions();\n        yearOptions.value = years;\n      } catch (error) {\n        store.dispatch('setError', error);\n      }\n    };\n\n    // ... implement other necessary methods ...\n\n    onMounted(() => {\n      fetchYearOptions();\n      fetchOpenPositions();\n      emit('update-page-title', 'Open Positions');\n    });\n    onUnmounted(() => {\n      emit('update-page-title', '');\n    });\n    return {\n      openPositions,\n      totals,\n      tableLoading,\n      selectedYear,\n      yearOptions,\n      search,\n      itemsPerPage,\n      currentPage,\n      sortBy\n      // ... return other necessary properties and methods ...\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","onMounted","onUnmounted","useStore","getOpenPositions","getOpenPositionsYearOptions","formatDate","BrokerSelection","name","emits","setup","props","emit","store","openPositions","totals","tableLoading","selectedYear","yearOptions","search","itemsPerPage","currentPage","totalItems","sortBy","fetchOpenPositions","value","data","portfolio_open","portfolio_open_totals","total_items","error","dispatch","console","fetchYearOptions","years"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\OpenPositionsPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid class=\"pa-0\">\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular\r\n        color=\"primary\"\r\n        indeterminate\r\n        size=\"64\"\r\n      ></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\" md=\"3\" lg=\"2\">\r\n        <v-select\r\n          v-model=\"selectedYear\"\r\n          :items=\"yearOptions\"\r\n          item-title=\"text\"\r\n          item-value=\"value\"\r\n          label=\"Year\"\r\n          density=\"compact\"\r\n        >\r\n          <template #item=\"{ props, item }\">\r\n            <v-list-item\r\n              v-if=\"!item.raw.divider\"\r\n              v-bind=\"props\"\r\n              :title=\"item.title\"\r\n            ></v-list-item>\r\n            <v-divider v-else class=\"my-2\"></v-divider>\r\n          </template>\r\n        </v-select>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <v-row no-gutters>\r\n      <v-col cols=\"12\">\r\n        <v-data-table\r\n          :headers=\"headers\"\r\n          :items=\"openPositions\"\r\n          :loading=\"tableLoading\"\r\n          :search=\"search\"\r\n          :items-per-page=\"-1\"\r\n          class=\"elevation-1\"\r\n          density=\"compact\"\r\n          :sort-by=\"sortBy\"\r\n          @update:sort-by=\"handleSortChange\"\r\n          :server-items-length=\"totalItems\"\r\n          :items-length=\"totalItems\"\r\n          must-sort\r\n          disable-sort\r\n        >\r\n        <template #top>\r\n            <v-toolbar flat class=\"bg-grey-lighten-4\">\r\n              <v-col cols=\"12\" md=\"4\" lg=\"4\">\r\n                <v-text-field\r\n                  v-model=\"search\"\r\n                  append-icon=\"mdi-magnify\"\r\n                  label=\"Search\"\r\n                  single-line\r\n                  hide-details\r\n                  density=\"compact\"\r\n                  bg-color=\"white\"\r\n                  class=\"rounded-lg\"\r\n                ></v-text-field>\r\n              </v-col>\r\n              <v-spacer></v-spacer>\r\n              <v-col cols=\"auto\">\r\n                <v-select\r\n                  v-model=\"itemsPerPage\"\r\n                  :items=\"itemsPerPageOptions\"\r\n                  label=\"Rows per page\"\r\n                  density=\"compact\"\r\n                  variant=\"outlined\"\r\n                  hide-details\r\n                  class=\"mr-2 rows-per-page-select\"\r\n                  @update:model-value=\"handleItemsPerPageChange\"\r\n                  bg-color=\"white\"\r\n                ></v-select>\r\n              </v-col>\r\n            </v-toolbar>\r\n          </template>\r\n          \r\n          <template #[`item.investment_date`]=\"{ item }\">\r\n            {{ formatDate(item.investment_date) }}\r\n          </template>\r\n          \r\n          <template #[`item.exit_date`]=\"{ item }\">\r\n            {{ formatDate(item.exit_date) }}\r\n          </template>\r\n          \r\n          <template v-for=\"key in percentageColumns\" :key=\"key\" #[`item.${key}`]=\"{ item }\">\r\n            <span v-if=\"item && item[key] !== undefined\" class=\"font-italic\">{{ item[key] }}</span>\r\n            <span v-else>-</span>\r\n          </template>\r\n\r\n          <template #bottom>\r\n            <div class=\"d-flex align-center justify-space-between pa-4\">\r\n              <span class=\"text-caption mr-4\">\r\n                Showing {{ (currentPage - 1) * itemsPerPage + 1 }}-{{ Math.min(currentPage * itemsPerPage, totalItems) }} of {{ totalItems }} entries\r\n              </span>\r\n              <v-pagination\r\n                v-model=\"currentPage\"\r\n                :length=\"pageCount\"\r\n                :total-visible=\"7\"\r\n                rounded=\"circle\"\r\n                @update:model-value=\"handlePageChange\"\r\n              ></v-pagination>\r\n            </div>\r\n          </template>\r\n\r\n          <template #tfoot>\r\n            <tfoot>\r\n              <tr class=\"font-weight-bold\">\r\n                <td v-for=\"header in flattenedHeaders\" :key=\"header.key\" :class=\"header.align\">\r\n                  <template v-if=\"header.key === 'type'\">\r\n                    TOTAL\r\n                  </template>\r\n                  <template v-else-if=\"header.key === 'currency'\">\r\n                    {{ totals[header.key] }}\r\n                  </template>\r\n                  <template v-else-if=\"['investment_date', 'exit_date'].includes(header.key)\">\r\n                    {{ formatDate(totals[header.key]) }}\r\n                  </template>\r\n                  <template v-else-if=\"percentageColumns.includes(header.key)\">\r\n                    <span class=\"font-italic\">{{ totals[header.key] }}</span>\r\n                  </template>\r\n                  <template v-else>\r\n                    {{ totals[header.key] }}\r\n                  </template>\r\n                </td>\r\n              </tr>\r\n            </tfoot>\r\n          </template>\r\n        </v-data-table>\r\n      </v-col>\r\n    </v-row>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch, onMounted, onUnmounted } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { getOpenPositions, getOpenPositionsYearOptions } from '@/services/api'\r\nimport { formatDate } from '@/utils/formatters'\r\nimport BrokerSelection from '@/components/BrokerSelection.vue'\r\n\r\nexport default {\r\n  name: 'OpenPositions',\r\n  emits: ['update-page-title'],\r\n  setup(props, { emit }) {\r\n    const store = useStore()\r\n    const openPositions = ref([])\r\n    const totals = ref({})\r\n    const tableLoading = ref(true)\r\n    const selectedYear = ref('All-time')\r\n    const yearOptions = ref([])\r\n    const search = ref('')\r\n    const itemsPerPage = ref(25)\r\n    const currentPage = ref(1)\r\n    const totalItems = ref(0)\r\n    const sortBy = ref([])\r\n\r\n    // ... implement other necessary refs and computed properties ...\r\n\r\n    const fetchOpenPositions = async () => {\r\n      tableLoading.value = true\r\n      try {\r\n        const data = await getOpenPositions(\r\n          selectedYear.value,\r\n          currentPage.value,\r\n          itemsPerPage.value,\r\n          search.value,\r\n          sortBy.value[0] || {}\r\n        )\r\n        openPositions.value = data.portfolio_open\r\n        totals.value = data.portfolio_open_totals\r\n        totalItems.value = data.total_items\r\n      } catch (error) {\r\n        store.dispatch('setError', error)\r\n        console.error('Error in fetchOpenPositions:', error)\r\n      } finally {\r\n        tableLoading.value = false\r\n      }\r\n    }\r\n\r\n    const fetchYearOptions = async () => {\r\n      try {\r\n        const years = await getOpenPositionsYearOptions()\r\n        yearOptions.value = years\r\n      } catch (error) {\r\n        store.dispatch('setError', error)\r\n      }\r\n    }\r\n\r\n    // ... implement other necessary methods ...\r\n\r\n    onMounted(() => {\r\n      fetchYearOptions()\r\n      fetchOpenPositions()\r\n      emit('update-page-title', 'Open Positions')\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      emit('update-page-title', '')\r\n    })\r\n\r\n    return {\r\n      openPositions,\r\n      totals,\r\n      tableLoading,\r\n      selectedYear,\r\n      yearOptions,\r\n      search,\r\n      itemsPerPage,\r\n      currentPage,\r\n      sortBy,\r\n      // ... return other necessary properties and methods ...\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Add necessary styles */\r\n</style>"],"mappings":"AA0IA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAK,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AACjE,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,gBAAgB,EAAEC,2BAA0B,QAAS,gBAAe;AAC7E,SAASC,UAAS,QAAS,oBAAmB;AAC9C,OAAOC,eAAc,MAAO,kCAAiC;AAE7D,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IACrB,MAAMC,KAAI,GAAIV,QAAQ,CAAC;IACvB,MAAMW,aAAY,GAAIhB,GAAG,CAAC,EAAE;IAC5B,MAAMiB,MAAK,GAAIjB,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMkB,YAAW,GAAIlB,GAAG,CAAC,IAAI;IAC7B,MAAMmB,YAAW,GAAInB,GAAG,CAAC,UAAU;IACnC,MAAMoB,WAAU,GAAIpB,GAAG,CAAC,EAAE;IAC1B,MAAMqB,MAAK,GAAIrB,GAAG,CAAC,EAAE;IACrB,MAAMsB,YAAW,GAAItB,GAAG,CAAC,EAAE;IAC3B,MAAMuB,WAAU,GAAIvB,GAAG,CAAC,CAAC;IACzB,MAAMwB,UAAS,GAAIxB,GAAG,CAAC,CAAC;IACxB,MAAMyB,MAAK,GAAIzB,GAAG,CAAC,EAAE;;IAErB;;IAEA,MAAM0B,kBAAiB,GAAI,MAAAA,CAAA,KAAY;MACrCR,YAAY,CAACS,KAAI,GAAI,IAAG;MACxB,IAAI;QACF,MAAMC,IAAG,GAAI,MAAMtB,gBAAgB,CACjCa,YAAY,CAACQ,KAAK,EAClBJ,WAAW,CAACI,KAAK,EACjBL,YAAY,CAACK,KAAK,EAClBN,MAAM,CAACM,KAAK,EACZF,MAAM,CAACE,KAAK,CAAC,CAAC,KAAK,CAAC,CACtB;QACAX,aAAa,CAACW,KAAI,GAAIC,IAAI,CAACC,cAAa;QACxCZ,MAAM,CAACU,KAAI,GAAIC,IAAI,CAACE,qBAAoB;QACxCN,UAAU,CAACG,KAAI,GAAIC,IAAI,CAACG,WAAU;MACpC,EAAE,OAAOC,KAAK,EAAE;QACdjB,KAAK,CAACkB,QAAQ,CAAC,UAAU,EAAED,KAAK;QAChCE,OAAO,CAACF,KAAK,CAAC,8BAA8B,EAAEA,KAAK;MACrD,UAAU;QACRd,YAAY,CAACS,KAAI,GAAI,KAAI;MAC3B;IACF;IAEA,MAAMQ,gBAAe,GAAI,MAAAA,CAAA,KAAY;MACnC,IAAI;QACF,MAAMC,KAAI,GAAI,MAAM7B,2BAA2B,CAAC;QAChDa,WAAW,CAACO,KAAI,GAAIS,K