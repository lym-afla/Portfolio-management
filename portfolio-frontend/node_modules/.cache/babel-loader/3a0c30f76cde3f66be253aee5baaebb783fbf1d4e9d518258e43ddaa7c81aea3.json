{"ast":null,"code":"import { ref, computed, watch, onMounted, onUnmounted } from 'vue';\nimport { useWebSocket } from '@/composables/useWebSocket';\nimport { useImportState } from '@/composables/useImportState';\nimport { useErrorHandler } from '@/composables/useErrorHandler';\nimport ProgressDialog from './ProgressDialog.vue';\nimport SecurityMappingDialog from './SecurityMappingDialog.vue';\nimport { analyzeFile, importTransactions } from '@/services/api';\nexport default {\n  name: 'TransactionImportDialog',\n  components: {\n    ProgressDialog,\n    SecurityMappingDialog\n  },\n  props: {\n    modelValue: Boolean\n  },\n  emits: ['update:modelValue', 'import-completed'],\n  setup(props, {\n    emit\n  }) {\n    const {\n      handleApiError\n    } = useErrorHandler();\n    const importState = useImportState();\n    const dialog = computed({\n      get: () => props.modelValue,\n      set: value => emit('update:modelValue', value)\n    });\n    const file = ref(null);\n    const isAnalyzed = ref(false);\n    const brokers = ref([]);\n    const selectedBroker = ref(null);\n    const identifiedBroker = ref(null);\n    const brokerIdentified = computed(() => !!identifiedBroker.value);\n    const brokerIdentificationComplete = ref(false);\n    const showProgressDialog = ref(false);\n    const showSecurityMappingDialog = ref(false);\n    const securityToMap = ref(null);\n    const bestMatch = ref(null);\n    const importProgress = computed(() => importState.progress);\n    const currentImported = computed(() => importState.current);\n    const totalToImport = computed(() => importState.total);\n    const currentImportMessage = computed(() => importState.currentMessage);\n    const importError = computed(() => importState.error);\n    const canStopImport = computed(() => importState.isImporting);\n    const wsUrl = computed(() => {\n      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';\n      const host = window.location.hostname;\n      const port = window.location.port ? `:${window.location.port}` : '';\n      return `${protocol}//${host}${port}/ws/transactions/`;\n    });\n    const {\n      isConnected,\n      lastMessage,\n      sendMessage\n    } = useWebSocket(wsUrl);\n    const handleFileChange = newFile => {\n      file.value = newFile;\n      isAnalyzed.value = false;\n      brokerIdentificationComplete.value = false;\n      identifiedBroker.value = null;\n      selectedBroker.value = null;\n    };\n    const submitFile = async () => {\n      if (!file.value) return;\n      try {\n        importState.setState('analyzing');\n        const result = await analyzeFile(file.value);\n        brokers.value = result.brokers;\n        identifiedBroker.value = result.identified_broker;\n        brokerIdentificationComplete.value = true;\n        isAnalyzed.value = true;\n        if (identifiedBroker.value) {\n          selectedBroker.value = identifiedBroker.value.id;\n        }\n        importState.setState('idle');\n      } catch (error) {\n        handleApiError(error);\n        importState.setState('error', error.message);\n      }\n    };\n    const startImport = async () => {\n      if (!selectedBroker.value) return;\n      try {\n        importState.setState('importing');\n        showProgressDialog.value = true;\n        dialog.value = false;\n        await importTransactions(file.value.id, selectedBroker.value);\n      } catch (error) {\n        handleApiError(error);\n        importState.setState('error', error.message);\n      }\n    };\n    const stopImport = () => {\n      sendMessage({\n        action: 'stop_import'\n      });\n    };\n    const resetProgressDialog = () => {\n      importState.reset();\n      showProgressDialog.value = false;\n    };\n    const handleSecurityMapped = mappedSecurity => {\n      sendMessage({\n        action: 'map_security',\n        security: securityToMap.value,\n        mapped_to: mappedSecurity\n      });\n      showSecurityMappingDialog.value = false;\n    };\n    const closeDialog = () => {\n      dialog.value = false;\n      resetProgressDialog();\n    };\n    const handleWebSocketMessage = message => {\n      console.log('Received WebSocket message:', message);\n      if (message.status === 'progress') {\n        importState.setProgress(message.progress);\n        importState.setState('importing', message.message);\n      } else if (message.status === 'security_mapping') {\n        securityToMap.value = message.security;\n        bestMatch.value = message.best_match;\n        showSecurityMappingDialog.value = true;\n      } else if (message.status === 'complete') {\n        importState.setState('complete', 'Import completed successfully');\n        emit('import-completed', message.import_results);\n      } else if (message.error) {\n        importState.setState('error', message.error);\n      }\n    };\n    onMounted(() => {\n      if (isConnected.value) {\n        console.log('WebSocket connected');\n      }\n    });\n    onUnmounted(() => {\n      resetProgressDialog();\n    });\n    watch(lastMessage, newMessage => {\n      if (newMessage) {\n        handleWebSocketMessage(JSON.parse(newMessage));\n      }\n    });\n    return {\n      dialog,\n      file,\n      isAnalyzed,\n      brokers,\n      selectedBroker,\n      identifiedBroker,\n      brokerIdentified,\n      brokerIdentificationComplete,\n      showProgressDialog,\n      showSecurityMappingDialog,\n      securityToMap,\n      bestMatch,\n      importProgress,\n      currentImported,\n      totalToImport,\n      currentImportMessage,\n      importError,\n      canStopImport,\n      handleFileChange,\n      submitFile,\n      startImport,\n      stopImport,\n      resetProgressDialog,\n      handleSecurityMapped,\n      closeDialog\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","onMounted","onUnmounted","useWebSocket","useImportState","useErrorHandler","ProgressDialog","SecurityMappingDialog","analyzeFile","importTransactions","name","components","props","modelValue","Boolean","emits","setup","emit","handleApiError","importState","dialog","get","set","value","file","isAnalyzed","brokers","selectedBroker","identifiedBroker","brokerIdentified","brokerIdentificationComplete","showProgressDialog","showSecurityMappingDialog","securityToMap","bestMatch","importProgress","progress","currentImported","current","totalToImport","total","currentImportMessage","currentMessage","importError","error","canStopImport","isImporting","wsUrl","protocol","window","location","host","hostname","port","isConnected","lastMessage","sendMessage","handleFileChange","newFile","submitFile","setState","result","identified_broker","id","message","startImport","stopImport","action","resetProgressDialog","reset","handleSecurityMapped","mappedSecurity","security","mapped_to","closeDialog","handleWebSocketMessage","console","log","status","setProgress","best_match","import_results","newMessage","JSON","parse"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\TransactionImportDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5\">Import Transactions</v-card-title>\r\n      <v-card-text>\r\n        <v-file-input\r\n          v-model=\"file\"\r\n          label=\"Select Excel or CSV file to import\"\r\n          accept=\".csv, .xlsx, .xls\"\r\n          :rules=\"[v => !!v || 'File is required']\"\r\n          @change=\"handleFileChange\"\r\n          :disabled=\"isAnalyzed\"\r\n        ></v-file-input>\r\n        <v-alert\r\n          v-if=\"isAnalyzed && brokerIdentificationComplete\"\r\n          :type=\"brokerIdentified ? 'success' : 'info'\"\r\n          class=\"mt-4 mb-4\"\r\n        >\r\n          {{ brokerIdentified \r\n            ? `Broker \"${identifiedBroker.name}\" was automatically identified. Please confirm or select a different broker.` \r\n            : 'Broker could not be automatically identified. Please select a broker below.' }}\r\n        </v-alert>\r\n        <v-autocomplete\r\n          v-if=\"isAnalyzed\"\r\n          v-model=\"selectedBroker\"\r\n          :items=\"brokers\"\r\n          item-title=\"name\"\r\n          item-value=\"id\"\r\n          label=\"Select Broker\"\r\n          class=\"mt-4\"\r\n        ></v-autocomplete>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n        <v-btn \r\n          v-if=\"!isAnalyzed\" \r\n          color=\"blue darken-1\" \r\n          text \r\n          @click=\"submitFile\" \r\n          :disabled=\"!file || isLoading\"\r\n          :loading=\"isLoading\"\r\n        >\r\n          Analyze File\r\n        </v-btn>\r\n        <v-btn\r\n          v-if=\"isAnalyzed\"\r\n          color=\"blue darken-1\"\r\n          text\r\n          @click=\"startImport\"\r\n          :disabled=\"!selectedBroker\"\r\n        >\r\n          Import Transactions\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n    <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n      {{ error }}\r\n    </v-alert>\r\n  </v-dialog>\r\n\r\n  <ProgressDialog\r\n    v-model=\"showProgressDialog\"\r\n    :title=\"'Importing Transactions'\"\r\n    :progress=\"importProgress\"\r\n    :current=\"currentImported\"\r\n    :total=\"totalToImport\"\r\n    :current-message=\"currentImportMessage\"\r\n    :error=\"importError\"\r\n    :can-stop=\"canStopImport\"\r\n    @stop-import=\"stopImport\"\r\n    @reset=\"resetProgressDialog\"\r\n  />\r\n\r\n  <SecurityMappingDialog\r\n    v-model=\"showSecurityMappingDialog\"\r\n    :security=\"securityToMap\"\r\n    :best-match=\"bestMatch\"\r\n    @security-mapped=\"handleSecurityMapped\"\r\n  />\r\n\r\n  <v-dialog v-model=\"showSuccessDialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h5 pb-2\">\r\n        <v-icon color=\"success\" class=\"mr-2\">mdi-check-circle</v-icon>\r\n        Import Completed\r\n      </v-card-title>\r\n      <v-card-text>\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"primary\" size=\"40\">\r\n                    <v-icon dark>mdi-database-import</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.totalTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Total transactions processed</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"success\" size=\"40\">\r\n                    <v-icon dark>mdi-check-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.importedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Successfully imported</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"error\" size=\"40\">\r\n                    <v-icon dark>mdi-alert-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.skippedTransactions }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Skipped transactions</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"info\" size=\"40\">\r\n                    <v-icon dark>mdi-plus-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.newSecurities }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>New securities added</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-card outlined>\r\n              <v-list-item>\r\n                <template v-slot:prepend>\r\n                  <v-avatar color=\"warning\" size=\"40\">\r\n                    <v-icon dark>mdi-help-circle</v-icon>\r\n                  </v-avatar>\r\n                </template>\r\n                <v-list-item-title class=\"text-h6\">\r\n                  {{ importStats.unrecognizedSecurities.length }}\r\n                </v-list-item-title>\r\n                <v-list-item-subtitle>Unrecognized securities</v-list-item-subtitle>\r\n              </v-list-item>\r\n            </v-card>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"closeSuccessDialog\">Close</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <v-dialog v-model=\"showUnrecognizedSecuritiesDialog\" max-width=\"600px\">\r\n    <v-card>\r\n      <v-card-title>Unrecognized Securities</v-card-title>\r\n      <v-card-text>\r\n        <p>The following securities were not recognized. Please map them to existing securities or create new ones:</p>\r\n        <v-list>\r\n          <v-list-item v-for=\"security in unrecognizedSecurities\" :key=\"security\">\r\n            <v-list-item-title>{{ security }}</v-list-item-title>\r\n            <template v-slot:append>\r\n              <v-autocomplete\r\n                v-model=\"securityMappings[security]\"\r\n                :items=\"existingSecurities\"\r\n                item-title=\"name\"\r\n                item-value=\"id\"\r\n                label=\"Select existing security\"\r\n                clearable\r\n                style=\"max-width: 300px;\"\r\n              ></v-autocomplete>\r\n              <v-btn v-if=\"!securityMappings[security]\" @click=\"createNewSecurity(security)\" color=\"primary\" text>\r\n                Create New Security\r\n              </v-btn>\r\n            </template>\r\n          </v-list-item>\r\n        </v-list>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"confirmSecurityMappings\">Confirm and Import</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n\r\n    <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n      {{ error }}\r\n    </v-alert>\r\n\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch, onMounted, onUnmounted } from 'vue'\r\nimport { useWebSocket } from '@/composables/useWebSocket'\r\nimport { useImportState } from '@/composables/useImportState'\r\nimport { useErrorHandler } from '@/composables/useErrorHandler'\r\nimport ProgressDialog from './ProgressDialog.vue'\r\nimport SecurityMappingDialog from './SecurityMappingDialog.vue'\r\nimport { analyzeFile, importTransactions } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'TransactionImportDialog',\r\n  components: {\r\n    ProgressDialog,\r\n    SecurityMappingDialog,\r\n  },\r\n  props: {\r\n    modelValue: Boolean,\r\n  },\r\n  emits: ['update:modelValue', 'import-completed'],\r\n  setup(props, { emit }) {\r\n    const { handleApiError } = useErrorHandler()\r\n    const importState = useImportState()\r\n    const dialog = computed({\r\n      get: () => props.modelValue,\r\n      set: (value) => emit('update:modelValue', value)\r\n    })\r\n\r\n    const file = ref(null)\r\n    const isAnalyzed = ref(false)\r\n    const brokers = ref([])\r\n    const selectedBroker = ref(null)\r\n    const identifiedBroker = ref(null)\r\n    const brokerIdentified = computed(() => !!identifiedBroker.value)\r\n    const brokerIdentificationComplete = ref(false)\r\n\r\n    const showProgressDialog = ref(false)\r\n    const showSecurityMappingDialog = ref(false)\r\n    const securityToMap = ref(null)\r\n    const bestMatch = ref(null)\r\n\r\n    const importProgress = computed(() => importState.progress)\r\n    const currentImported = computed(() => importState.current)\r\n    const totalToImport = computed(() => importState.total)\r\n    const currentImportMessage = computed(() => importState.currentMessage)\r\n    const importError = computed(() => importState.error)\r\n    const canStopImport = computed(() => importState.isImporting)\r\n\r\n    const wsUrl = computed(() => {\r\n      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:'\r\n      const host = window.location.hostname\r\n      const port = window.location.port ? `:${window.location.port}` : ''\r\n      return `${protocol}//${host}${port}/ws/transactions/`\r\n    })\r\n\r\n    const { isConnected, lastMessage, sendMessage } = useWebSocket(wsUrl)\r\n\r\n    const handleFileChange = (newFile) => {\r\n      file.value = newFile\r\n      isAnalyzed.value = false\r\n      brokerIdentificationComplete.value = false\r\n      identifiedBroker.value = null\r\n      selectedBroker.value = null\r\n    }\r\n\r\n    const submitFile = async () => {\r\n      if (!file.value) return\r\n      try {\r\n        importState.setState('analyzing')\r\n        const result = await analyzeFile(file.value)\r\n        brokers.value = result.brokers\r\n        identifiedBroker.value = result.identified_broker\r\n        brokerIdentificationComplete.value = true\r\n        isAnalyzed.value = true\r\n        if (identifiedBroker.value) {\r\n          selectedBroker.value = identifiedBroker.value.id\r\n        }\r\n        importState.setState('idle')\r\n      } catch (error) {\r\n        handleApiError(error)\r\n        importState.setState('error', error.message)\r\n      }\r\n    }\r\n\r\n    const startImport = async () => {\r\n      if (!selectedBroker.value) return\r\n      try {\r\n        importState.setState('importing')\r\n        showProgressDialog.value = true\r\n        dialog.value = false\r\n        await importTransactions(file.value.id, selectedBroker.value)\r\n      } catch (error) {\r\n        handleApiError(error)\r\n        importState.setState('error', error.message)\r\n      }\r\n    }\r\n\r\n    const stopImport = () => {\r\n      sendMessage({ action: 'stop_import' })\r\n    }\r\n\r\n    const resetProgressDialog = () => {\r\n      importState.reset()\r\n      showProgressDialog.value = false\r\n    }\r\n\r\n    const handleSecurityMapped = (mappedSecurity) => {\r\n      sendMessage({ action: 'map_security', security: securityToMap.value, mapped_to: mappedSecurity })\r\n      showSecurityMappingDialog.value = false\r\n    }\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      resetProgressDialog()\r\n    }\r\n\r\n    const handleWebSocketMessage = (message) => {\r\n      console.log('Received WebSocket message:', message)\r\n      if (message.status === 'progress') {\r\n        importState.setProgress(message.progress)\r\n        importState.setState('importing', message.message)\r\n      } else if (message.status === 'security_mapping') {\r\n        securityToMap.value = message.security\r\n        bestMatch.value = message.best_match\r\n        showSecurityMappingDialog.value = true\r\n      } else if (message.status === 'complete') {\r\n        importState.setState('complete', 'Import completed successfully')\r\n        emit('import-completed', message.import_results)\r\n      } else if (message.error) {\r\n        importState.setState('error', message.error)\r\n      }\r\n    }\r\n\r\n    onMounted(() => {\r\n      if (isConnected.value) {\r\n        console.log('WebSocket connected')\r\n      }\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      resetProgressDialog()\r\n    })\r\n\r\n    watch(lastMessage, (newMessage) => {\r\n      if (newMessage) {\r\n        handleWebSocketMessage(JSON.parse(newMessage))\r\n      }\r\n    })\r\n\r\n    return {\r\n      dialog,\r\n      file,\r\n      isAnalyzed,\r\n      brokers,\r\n      selectedBroker,\r\n      identifiedBroker,\r\n      brokerIdentified,\r\n      brokerIdentificationComplete,\r\n      showProgressDialog,\r\n      showSecurityMappingDialog,\r\n      securityToMap,\r\n      bestMatch,\r\n      importProgress,\r\n      currentImported,\r\n      totalToImport,\r\n      currentImportMessage,\r\n      importError,\r\n      canStopImport,\r\n      handleFileChange,\r\n      submitFile,\r\n      startImport,\r\n      stopImport,\r\n      resetProgressDialog,\r\n      handleSecurityMapped,\r\n      closeDialog,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAoNA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAK,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AACjE,SAASC,YAAW,QAAS,4BAA2B;AACxD,SAASC,cAAa,QAAS,8BAA6B;AAC5D,SAASC,eAAc,QAAS,+BAA8B;AAC9D,OAAOC,cAAa,MAAO,sBAAqB;AAChD,OAAOC,qBAAoB,MAAO,6BAA4B;AAC9D,SAASC,WAAW,EAAEC,kBAAiB,QAAS,gBAAe;AAE/D,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVL,cAAc;IACdC;EACF,CAAC;EACDK,KAAK,EAAE;IACLC,UAAU,EAAEC;EACd,CAAC;EACDC,KAAK,EAAE,CAAC,mBAAmB,EAAE,kBAAkB,CAAC;EAChDC,KAAKA,CAACJ,KAAK,EAAE;IAAEK;EAAK,CAAC,EAAE;IACrB,MAAM;MAAEC;IAAe,IAAIb,eAAe,CAAC;IAC3C,MAAMc,WAAU,GAAIf,cAAc,CAAC;IACnC,MAAMgB,MAAK,GAAIrB,QAAQ,CAAC;MACtBsB,GAAG,EAAEA,CAAA,KAAMT,KAAK,CAACC,UAAU;MAC3BS,GAAG,EAAGC,KAAK,IAAKN,IAAI,CAAC,mBAAmB,EAAEM,KAAK;IACjD,CAAC;IAED,MAAMC,IAAG,GAAI1B,GAAG,CAAC,IAAI;IACrB,MAAM2B,UAAS,GAAI3B,GA