{"ast":null,"code":"import { computed, watch } from 'vue';\nexport default {\n  name: 'ProgressDialog',\n  props: {\n    modelValue: Boolean,\n    title: {\n      type: String,\n      default: 'Progress'\n    },\n    progress: {\n      type: Number,\n      default: 0\n    },\n    error: {\n      type: String,\n      default: ''\n    }\n  },\n  emits: ['update:modelValue'],\n  setup(props, {\n    emit\n  }) {\n    const dialogModel = computed({\n      get: () => props.modelValue,\n      set: value => emit('update:modelValue', value)\n    });\n    watch(() => props.progress, newValue => {\n      console.log('ProgressDialog: progress prop changed to', newValue);\n    });\n    return {\n      dialogModel\n    };\n  }\n};","map":{"version":3,"names":["computed","watch","name","props","modelValue","Boolean","title","type","String","default","progress","Number","error","emits","setup","emit","dialogModel","get","set","value","newValue","console","log"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\ProgressDialog.vue"],"sourcesContent":["<template>\r\n  <v-dialog v-model=\"dialogModel\" persistent max-width=\"400px\">\r\n    <v-card>\r\n      <v-card-title>{{ title }}</v-card-title>\r\n      <v-card-text>\r\n        <v-progress-linear\r\n          :model-value=\"progress\"\r\n          height=\"25\"\r\n          color=\"primary\"\r\n        >\r\n          <template v-slot:default=\"{ value }\">\r\n            <strong>{{ Math.ceil(value) }}%</strong>\r\n          </template>\r\n        </v-progress-linear>\r\n        <v-alert v-if=\"error\" type=\"error\" class=\"mt-4\">\r\n          {{ error }}\r\n        </v-alert>\r\n      </v-card-text>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { computed, watch } from 'vue'\r\n  export default {\r\n    name: 'ProgressDialog',\r\n    props: {\r\n      modelValue: Boolean,\r\n      title: {\r\n        type: String,\r\n        default: 'Progress'\r\n      },\r\n      progress: {\r\n        type: Number,\r\n        default: 0\r\n      },\r\n      error: {\r\n        type: String,\r\n        default: ''\r\n      }\r\n    },\r\n    emits: ['update:modelValue'],\r\n    setup(props, { emit }) {\r\n      const dialogModel = computed({\r\n        get: () => props.modelValue,\r\n        set: (value) => emit('update:modelValue', value)\r\n      })\r\n\r\n      watch(() => props.progress, (newValue) => {\r\n        console.log('ProgressDialog: progress prop changed to', newValue)\r\n      })\r\n\r\n      return {\r\n        dialogModel\r\n      }\r\n    }\r\n  }\r\n  </script>"],"mappings":"AAuBA,SAASA,QAAQ,EAAEC,KAAI,QAAS,KAAI;AAClC,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,KAAK,EAAE;IACLC,UAAU,EAAEC,OAAO;IACnBC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,QAAQ,EAAE;MACRH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDG,KAAK,EAAE;MACLL,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX;EACF,CAAC;EACDI,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,KAAKA,CAACX,KAAK,EAAE;IAAEY;EAAK,CAAC,EAAE;IACrB,MAAMC,WAAU,GAAIhB,QAAQ,CAAC;MAC3BiB,GAAG,EAAEA,CAAA,KAAMd,KAAK,CAACC,UAAU;MAC3Bc,GAAG,EAAGC,KAAK,IAAKJ,IAAI,CAAC,mBAAmB,EAAEI,KAAK;IACjD,CAAC;IAEDlB,KAAK,CAAC,MAAME,KAAK,CAACO,QAAQ,EAAGU,QAAQ,IAAK;MACxCC,OAAO,CAACC,GAAG,CAAC,0CAA0C,EAAEF,QAAQ;IAClE,CAAC;IAED,OAAO;MACLJ;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}