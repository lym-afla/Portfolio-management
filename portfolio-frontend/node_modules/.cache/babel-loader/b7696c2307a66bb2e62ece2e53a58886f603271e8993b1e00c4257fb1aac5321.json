{"ast":null,"code":"import { ref, reactive, onMounted } from 'vue';\nimport { getUserSettings, updateUserSettings, getSettingsChoices } from '@/services/api';\nexport default {\n  setup() {\n    const dialog = ref(false);\n    const form = ref(null);\n    const formFields = ref([{\n      name: 'default_currency',\n      label: 'Currency',\n      type: 'select',\n      choices: [],\n      rules: [v => !!v || 'Currency is required']\n    }, {\n      name: 'table_date',\n      label: 'Date',\n      type: 'date',\n      rules: [v => !!v || 'Date is required']\n    }, {\n      name: 'digits',\n      label: 'Number of digits',\n      type: 'number',\n      rules: [v => !!v || 'Number of digits is required', v => v && v >= 0 && v <= 6 || 'Number of digits must be between 0 and 6']\n    }]);\n    const formData = reactive({\n      default_currency: '',\n      table_date: '',\n      digits: 0\n    });\n    const fetchSettingsData = async () => {\n      try {\n        const [settings, choices] = await Promise.all([getUserSettings(), getSettingsChoices()]);\n\n        // Update formData with fetched settings\n        Object.keys(formData).forEach(key => {\n          if (settings[key] !== undefined) {\n            formData[key] = settings[key];\n          }\n        });\n\n        // Update choices for select fields\n        formFields.value.forEach(field => {\n          if (field.type === 'select' && choices[`${field.name}_choices`]) {\n            field.choices = choices[`${field.name}_choices`].map(choice => ({\n              text: choice[1],\n              value: choice[0]\n            }));\n          }\n        });\n      } catch (error) {\n        console.error('Failed to fetch settings data:', error);\n      }\n    };\n    const openDialog = () => {\n      dialog.value = true;\n      document.body.style.overflow = 'hidden';\n      fetchSettingsData();\n    };\n    const closeDialog = () => {\n      dialog.value = false;\n      document.body.style.overflow = '';\n    };\n    const saveSettings = async () => {\n      const isValid = await form.value.validate();\n      if (isValid.valid) {\n        try {\n          await updateUserSettings(formData);\n          closeDialog();\n          // Trigger a data refresh if needed\n          // You might want to emit an event or use a store action for this\n        } catch (error) {\n          console.error('Failed to save settings:', error);\n        }\n      }\n    };\n    onMounted(fetchSettingsData);\n    return {\n      dialog,\n      formFields,\n      formData,\n      form,\n      openDialog,\n      closeDialog,\n      saveSettings\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","getUserSettings","updateUserSettings","getSettingsChoices","setup","dialog","form","formFields","name","label","type","choices","rules","v","formData","default_currency","table_date","digits","fetchSettingsData","settings","Promise","all","Object","keys","forEach","key","undefined","value","field","map","choice","text","error","console","openDialog","document","body","style","overflow","closeDialog","saveSettings","isValid","validate","valid"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\SettingsDialog.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-btn icon @click=\"openDialog\">\r\n      <v-icon>mdi-cog</v-icon>\r\n    </v-btn>\r\n\r\n    <v-dialog v-model=\"dialog\" max-width=\"600px\" persistent scrollable>\r\n      <v-card>\r\n        <v-card-title class=\"text-h5\">\r\n          Settings\r\n        </v-card-title>\r\n        <v-card-text>\r\n          <v-form @submit.prevent=\"saveSettings\" ref=\"form\">\r\n            <v-row>\r\n              <v-col cols=\"12\" sm=\"6\" v-for=\"field in formFields\" :key=\"field.name\">\r\n                <v-select\r\n                  v-if=\"field.type === 'select'\"\r\n                  v-model=\"formData[field.name]\"\r\n                  :items=\"field.choices\"\r\n                  :label=\"field.label\"\r\n                  :error-messages=\"errors[field.name]\"\r\n                ></v-select>\r\n                <v-text-field\r\n                  v-else-if=\"field.type === 'number'\"\r\n                  v-model.number=\"formData[field.name]\"\r\n                  :label=\"field.label\"\r\n                  type=\"number\"\r\n                  :error-messages=\"errors[field.name]\"\r\n                ></v-text-field>\r\n                <v-text-field\r\n                  v-else-if=\"field.type === 'date'\"\r\n                  v-model=\"formData[field.name]\"\r\n                  :label=\"field.label\"\r\n                  type=\"date\"\r\n                  :error-messages=\"errors[field.name]\"\r\n                ></v-text-field>\r\n                <v-checkbox\r\n                  v-else-if=\"field.type === 'checkbox'\"\r\n                  v-model=\"formData[field.name]\"\r\n                  :label=\"field.label\"\r\n                  :error-messages=\"errors[field.name]\"\r\n                ></v-checkbox>\r\n              </v-col>\r\n            </v-row>\r\n          </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"closeDialog\">Close</v-btn>\r\n          <v-btn color=\"blue-darken-1\" variant=\"text\" @click=\"saveSettings\">Save</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive, onMounted } from 'vue'\r\nimport { getUserSettings, updateUserSettings, getSettingsChoices } from '@/services/api'\r\n\r\nexport default {\r\n  setup() {\r\n    const dialog = ref(false)\r\n    const form = ref(null)\r\n\r\n    const formFields = ref([\r\n      {\r\n        name: 'default_currency',\r\n        label: 'Currency',\r\n        type: 'select',\r\n        choices: [],\r\n        rules: [v => !!v || 'Currency is required'],\r\n      },\r\n      {\r\n        name: 'table_date',\r\n        label: 'Date',\r\n        type: 'date',\r\n        rules: [v => !!v || 'Date is required'],\r\n      },\r\n      {\r\n        name: 'digits',\r\n        label: 'Number of digits',\r\n        type: 'number',\r\n        rules: [\r\n          v => !!v || 'Number of digits is required',\r\n          v => (v && v >= 0 && v <= 6) || 'Number of digits must be between 0 and 6',\r\n        ],\r\n      },\r\n    ])\r\n\r\n    const formData = reactive({\r\n      default_currency: '',\r\n      table_date: '',\r\n      digits: 0,\r\n    })\r\n\r\n    const fetchSettingsData = async () => {\r\n      try {\r\n        const [settings, choices] = await Promise.all([\r\n          getUserSettings(),\r\n          getSettingsChoices()\r\n        ])\r\n\r\n        // Update formData with fetched settings\r\n        Object.keys(formData).forEach(key => {\r\n          if (settings[key] !== undefined) {\r\n            formData[key] = settings[key]\r\n          }\r\n        })\r\n\r\n        // Update choices for select fields\r\n        formFields.value.forEach(field => {\r\n          if (field.type === 'select' && choices[`${field.name}_choices`]) {\r\n            field.choices = choices[`${field.name}_choices`].map(choice => ({\r\n              text: choice[1],\r\n              value: choice[0]\r\n            }))\r\n          }\r\n        })\r\n      } catch (error) {\r\n        console.error('Failed to fetch settings data:', error)\r\n      }\r\n    }\r\n\r\n    const openDialog = () => {\r\n      dialog.value = true\r\n      document.body.style.overflow = 'hidden'\r\n      fetchSettingsData()\r\n    }\r\n\r\n    const closeDialog = () => {\r\n      dialog.value = false\r\n      document.body.style.overflow = ''\r\n    }\r\n\r\n    const saveSettings = async () => {\r\n      const isValid = await form.value.validate()\r\n      if (isValid.valid) {\r\n        try {\r\n          await updateUserSettings(formData)\r\n          closeDialog()\r\n          // Trigger a data refresh if needed\r\n          // You might want to emit an event or use a store action for this\r\n        } catch (error) {\r\n          console.error('Failed to save settings:', error)\r\n        }\r\n      }\r\n    }\r\n\r\n    onMounted(fetchSettingsData)\r\n\r\n    return {\r\n      dialog,\r\n      formFields,\r\n      formData,\r\n      form,\r\n      openDialog,\r\n      closeDialog,\r\n      saveSettings\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAyDA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AAC7C,SAASC,eAAe,EAAEC,kBAAkB,EAAEC,kBAAiB,QAAS,gBAAe;AAEvF,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIP,GAAG,CAAC,KAAK;IACxB,MAAMQ,IAAG,GAAIR,GAAG,CAAC,IAAI;IAErB,MAAMS,UAAS,GAAIT,GAAG,CAAC,CACrB;MACEU,IAAI,EAAE,kBAAkB;MACxBC,KAAK,EAAE,UAAU;MACjBC,IAAI,EAAE,QAAQ;MACdC,OAAO,EAAE,EAAE;MACXC,KAAK,EAAE,CAACC,CAAA,IAAK,CAAC,CAACA,CAAA,IAAK,sBAAsB;IAC5C,CAAC,EACD;MACEL,IAAI,EAAE,YAAY;MAClBC,KAAK,EAAE,MAAM;MACbC,IAAI,EAAE,MAAM;MACZE,KAAK,EAAE,CAACC,CAAA,IAAK,CAAC,CAACA,CAAA,IAAK,kBAAkB;IACxC,CAAC,EACD;MACEL,IAAI,EAAE,QAAQ;MACdC,KAAK,EAAE,kBAAkB;MACzBC,IAAI,EAAE,QAAQ;MACdE,KAAK,EAAE,CACLC,CAAA,IAAK,CAAC,CAACA,CAAA,IAAK,8BAA8B,EAC1CA,CAAA,IAAMA,CAAA,IAAKA,CAAA,IAAK,KAAKA,CAAA,IAAK,CAAC,IAAK,0CAA0C;IAE9E,CAAC,CACF;IAED,MAAMC,QAAO,GAAIf,QAAQ,CAAC;MACxBgB,gBAAgB,EAAE,EAAE;MACpBC,UAAU,EAAE,EAAE;MACdC,MAAM,EAAE;IACV,CAAC;IAED,MAAMC,iBAAgB,GAAI,MAAAA,CAAA,KAAY;MACpC,IAAI;QACF,MAAM,CAACC,QAAQ,EAAER,OAAO,IAAI,MAAMS,OAAO,CAACC,GAAG,CAAC,CAC5CpB,eAAe,CAAC,CAAC,EACjBE,kBAAkB,CAAC,EACpB;;QAED;QACAmB,MAAM,CAACC,IAAI,CAACT,QAAQ,CAAC,CAACU,OAAO,CAACC,GAAE,IAAK;UACnC,IAAIN,QAAQ,CAACM,GAAG,MAAMC,SAAS,EAAE;YAC/BZ,QAAQ,CAACW,GAAG,IAAIN,QAAQ,CAACM,GAAG;UAC9B;QACF,CAAC;;QAED;QACAlB,UAAU,CAACoB,KAAK,CAACH,OAAO,CAACI,KAAI,IAAK;UAChC,IAAIA,KAAK,CAAClB,IAAG,KAAM,QAAO,IAAKC,OAAO,CAAC,GAAGiB,KAAK,CAACpB,IAAI,UAAU,CAAC,EAAE;YAC/DoB,KAAK,CAACjB,OAAM,GAAIA,OAAO,CAAC,GAAGiB,KAAK,CAACpB,IAAI,UAAU,CAAC,CAACqB,GAAG,CAACC,MAAK,KAAM;cAC9DC,IAAI,EAAED,MAAM,CAAC,CAAC,CAAC;cACfH,K