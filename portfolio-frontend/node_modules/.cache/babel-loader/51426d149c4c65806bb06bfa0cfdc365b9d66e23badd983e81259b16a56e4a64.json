{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport store from '@/store';\nimport { deleteAccount } from '@/services/api';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const showDeleteConfirmation = ref(false);\n    const confirmationText = ref('');\n    const isLoading = ref(false);\n    const processDeleteAccount = async () => {\n      if (confirmationText.value !== 'DELETE') {\n        return;\n      }\n      isLoading.value = true;\n      try {\n        await deleteAccount();\n        // Clear authentication state\n        store.dispatch('logout');\n        // Redirect to register page\n        router.push('/register');\n      } catch (error) {\n        console.error('Error deleting account:', error);\n        // Handle error (e.g., show error message to user)\n      } finally {\n        isLoading.value = false;\n        showDeleteConfirmation.value = false;\n        confirmationText.value = '';\n      }\n    };\n    return {\n      router,\n      store,\n      showDeleteConfirmation,\n      confirmationText,\n      isLoading,\n      processDeleteAccount\n    };\n  },\n  data() {\n    return {\n      menuItems: [{\n        title: 'User details',\n        to: '/profile'\n      }, {\n        title: 'Settings',\n        to: '/profile/settings'\n      }]\n    };\n  },\n  methods: {\n    async logout() {\n      try {\n        await store.dispatch('logout');\n        // if (response.success) {\n        //   this.$emit('update-page-title', '') // Clear the page title\n        //   this.router.push('/login')\n        // } else {\n        //   console.error('Logout failed:', response.error)\n        // }\n      } catch (error) {\n        console.error('Logout error:', error);\n      }\n    },\n    isActive(route) {\n      return this.$route.path === route;\n    }\n  },\n  mounted() {\n    this.$emit('update-page-title', 'User Profile');\n  },\n  beforeUnmount() {\n    this.$emit('update-page-title', ''); // Clear the page title when component is unmounted\n  }\n};","map":{"version":3,"names":["ref","useRouter","useStore","store","deleteAccount","setup","router","showDeleteConfirmation","confirmationText","isLoading","processDeleteAccount","value","dispatch","push","error","console","data","menuItems","title","to","methods","logout","isActive","route","$route","path","mounted","$emit","beforeUnmount"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\profile\\ProfileLayout.vue"],"sourcesContent":["<template>\r\n  <v-container fluid class=\"mt-4\">\r\n    <v-row>\r\n      <v-col cols=\"12\" md=\"4\">\r\n        <!-- Side Navigation -->\r\n        <v-card class=\"mb-4\">\r\n          <v-list>\r\n            <v-list-item\r\n              v-for=\"(item, i) in menuItems\"\r\n              :key=\"i\"\r\n              :to=\"item.to\"\r\n              :active=\"isActive(item.to)\"\r\n              active-class=\"primary white--text\"\r\n            >\r\n              <v-list-item-title>{{ item.title }}</v-list-item-title>\r\n            </v-list-item>\r\n          </v-list>\r\n          <v-divider></v-divider>\r\n          <v-list-item @click=\"logout\">\r\n            <v-list-item-title>Logout</v-list-item-title>\r\n          </v-list-item>\r\n        </v-card>\r\n        \r\n        <!-- Delete Account Button -->\r\n        <v-card flat class=\"pa-0\">\r\n          <v-btn\r\n            @click=\"showDeleteConfirmation = true\"\r\n            color=\"error\"\r\n            outlined\r\n            block\r\n            class=\"mt-2\"\r\n          >\r\n            <v-icon left>mdi-delete</v-icon>\r\n            Delete Account\r\n          </v-btn>\r\n        </v-card>\r\n      </v-col>\r\n      <v-col cols=\"12\" md=\"8\">\r\n        <!-- Tab Content -->\r\n        <router-view></router-view>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <!-- Delete Account Confirmation Dialog -->\r\n    <v-dialog v-model=\"showDeleteConfirmation\" max-width=\"400\">\r\n      <v-card>\r\n        <v-card-title class=\"text-h5 error--text\">Delete Account</v-card-title>\r\n        <v-card-text>\r\n          <p>\r\n            Are you sure you want to delete your account? This action cannot be\r\n            undone.\r\n          </p>\r\n          <v-text-field\r\n            v-model=\"confirmationText\"\r\n            label=\"Type 'DELETE' to confirm\"\r\n            :rules=\"[(v) => v === 'DELETE' || 'Please type DELETE to confirm']\"\r\n          ></v-text-field>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n          <v-spacer></v-spacer>\r\n          <v-btn color=\"primary\" text @click=\"showDeleteConfirmation = false\"\r\n            >Cancel</v-btn\r\n          >\r\n          <v-btn\r\n            color=\"error\"\r\n            :disabled=\"confirmationText !== 'DELETE'\"\r\n            @click=\"processDeleteAccount\"\r\n          >\r\n            Delete Account\r\n          </v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport store from '@/store'\r\nimport { deleteAccount } from '@/services/api'\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const showDeleteConfirmation = ref(false)\r\n    const confirmationText = ref('')\r\n    const isLoading = ref(false)\r\n\r\n    const processDeleteAccount = async () => {\r\n      if (confirmationText.value !== 'DELETE') {\r\n        return\r\n      }\r\n      isLoading.value = true\r\n      try {\r\n        await deleteAccount()\r\n        // Clear authentication state\r\n        store.dispatch('logout')\r\n        // Redirect to register page\r\n        router.push('/register')\r\n      } catch (error) {\r\n        console.error('Error deleting account:', error)\r\n        // Handle error (e.g., show error message to user)\r\n      } finally {\r\n        isLoading.value = false\r\n        showDeleteConfirmation.value = false\r\n        confirmationText.value = ''\r\n      }\r\n    }\r\n\r\n    return {\r\n      router,\r\n      store,\r\n      showDeleteConfirmation,\r\n      confirmationText,\r\n      isLoading,\r\n      processDeleteAccount,\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      menuItems: [\r\n        { title: 'User details', to: '/profile' },\r\n        { title: 'Settings', to: '/profile/settings' },\r\n      ],\r\n    }\r\n  },\r\n  methods: {\r\n    async logout() {\r\n      try {\r\n        await store.dispatch('logout')\r\n        // if (response.success) {\r\n        //   this.$emit('update-page-title', '') // Clear the page title\r\n        //   this.router.push('/login')\r\n        // } else {\r\n        //   console.error('Logout failed:', response.error)\r\n        // }\r\n      } catch (error) {\r\n        console.error('Logout error:', error)\r\n      }\r\n    },\r\n    isActive(route) {\r\n      return this.$route.path === route\r\n    },\r\n  },\r\n  mounted() {\r\n    this.$emit('update-page-title', 'User Profile')\r\n  },\r\n  beforeUnmount() {\r\n    this.$emit('update-page-title', '') // Clear the page title when component is unmounted\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-btn.error--text {\r\n  border-color: currentColor;\r\n}\r\n</style>"],"mappings":";AA6EA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,KAAI,MAAO,SAAQ;AAC1B,SAASC,aAAY,QAAS,gBAAe;AAE7C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIL,SAAS,CAAC;IACzB,MAAME,KAAI,GAAID,QAAQ,CAAC;IACvB,MAAMK,sBAAqB,GAAIP,GAAG,CAAC,KAAK;IACxC,MAAMQ,gBAAe,GAAIR,GAAG,CAAC,EAAE;IAC/B,MAAMS,SAAQ,GAAIT,GAAG,CAAC,KAAK;IAE3B,MAAMU,oBAAmB,GAAI,MAAAA,CAAA,KAAY;MACvC,IAAIF,gBAAgB,CAACG,KAAI,KAAM,QAAQ,EAAE;QACvC;MACF;MACAF,SAAS,CAACE,KAAI,G