{"ast":null,"code":"import { ref, computed, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport { addPrice, updatePrice } from '@/services/api';\nexport default {\n  name: 'PriceFormDialog',\n  props: {\n    modelValue: Boolean,\n    editItem: Object,\n    securities: Array\n  },\n  emits: ['update:modelValue', 'price-added', 'price-updated'],\n  setup(props, {\n    emit\n  }) {\n    const dialog = computed({\n      get: () => props.modelValue,\n      set: value => emit('update:modelValue', value)\n    });\n    const isEdit = computed(() => !!props.editItem);\n    const form = ref({\n      date: '',\n      security: null,\n      price: null\n    });\n    const closeDialog = () => {\n      dialog.value = false;\n      form.value = {\n        date: '',\n        security: null,\n        price: null\n      };\n    };\n    const submitForm = async () => {\n      try {\n        let response;\n        if (isEdit.value) {\n          response = await updatePrice(props.editItem.id, form.value);\n          emit('price-updated', response);\n        } else {\n          response = await addPrice(form.value);\n          emit('price-added', response);\n        }\n        closeDialog();\n      } catch (error) {\n        console.error('Error submitting price:', error);\n        // Handle error (e.g., show error message to user)\n      }\n    };\n    watch(() => props.securities, newValue => {\n      if (newVlue) {\n        form.value = {\n          ...newValue\n        };\n      } else {}\n    });\n    return {\n      dialog,\n      isEdit,\n      form,\n      securities,\n      closeDialog,\n      submitForm\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","useStore","addPrice","updatePrice","name","props","modelValue","Boolean","editItem","Object","securities","Array","emits","setup","emit","dialog","get","set","value","isEdit","form","date","security","price","closeDialog","submitForm","response","id","error","console","newValue","newVlue"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\PriceFormDialog.vue"],"sourcesContent":["<template>\r\n    <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n        <v-card>\r\n        <v-card-title>\r\n            <span class=\"text-h5\">{{ isEdit ? 'Edit Price' : 'Add Price' }}</span>\r\n        </v-card-title>\r\n        <v-card-text>\r\n            <v-form @submit.prevent=\"submitForm\">\r\n            <v-text-field\r\n                v-model=\"form.date\"\r\n                label=\"Date\"\r\n                type=\"date\"\r\n                required\r\n            ></v-text-field>\r\n            <v-select\r\n                v-model=\"form.security\"\r\n                :items=\"securities\"\r\n                item-title=\"name\"\r\n                item-value=\"id\"\r\n                label=\"Security\"\r\n                required\r\n            ></v-select>\r\n            <v-text-field\r\n                v-model=\"form.price\"\r\n                label=\"Price\"\r\n                type=\"number\"\r\n                step=\"0.01\"\r\n                required\r\n            ></v-text-field>\r\n            </v-form>\r\n        </v-card-text>\r\n        <v-card-actions>\r\n            <v-spacer></v-spacer>\r\n            <v-btn color=\"blue darken-1\" text @click=\"closeDialog\">Cancel</v-btn>\r\n            <v-btn color=\"blue darken-1\" text @click=\"submitForm\">Save</v-btn>\r\n        </v-card-actions>\r\n        </v-card>\r\n    </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { addPrice, updatePrice } from '@/services/api'\r\n\r\nexport default {\r\n    name: 'PriceFormDialog',\r\n    props: {\r\n        modelValue: Boolean,\r\n        editItem: Object,\r\n        securities: Array\r\n    },\r\n    emits: ['update:modelValue', 'price-added', 'price-updated'],\r\n    setup(props, { emit }) {\r\n        const dialog = computed({\r\n            get: () => props.modelValue,\r\n            set: (value) => emit('update:modelValue', value)\r\n        })\r\n        const isEdit = computed(() => !!props.editItem)\r\n        const form = ref({\r\n            date: '',\r\n            security: null,\r\n            price: null,\r\n        })\r\n\r\n        const closeDialog = () => {\r\n        dialog.value = false\r\n        form.value = { date: '', security: null, price: null }\r\n        }\r\n\r\n        const submitForm = async () => {\r\n            try {\r\n                let response\r\n                if (isEdit.value) {\r\n                    response = await updatePrice(props.editItem.id, form.value)\r\n                    emit('price-updated', response)\r\n                } else {\r\n                    response = await addPrice(form.value)\r\n                    emit('price-added', response)\r\n                }\r\n                closeDialog()\r\n            } catch (error) {\r\n                console.error('Error submitting price:', error)\r\n                // Handle error (e.g., show error message to user)\r\n            }\r\n        }\r\n\r\n        watch(() => props.securities, (newValue) => {\r\n            if (newVlue) {\r\n                form.value = { ...newValue }\r\n            } else {\r\n                \r\n            }\r\n        })\r\n\r\n        return {\r\n            dialog,\r\n            isEdit,\r\n            form,\r\n            securities,\r\n            closeDialog,\r\n            submitForm,\r\n        }\r\n    }\r\n}\r\n</script>"],"mappings":"AAyCA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAI,QAAS,KAAI;AACzC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,QAAQ,EAAEC,WAAU,QAAS,gBAAe;AAErD,eAAe;EACXC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE;IACHC,UAAU,EAAEC,OAAO;IACnBC,QAAQ,EAAEC,MAAM;IAChBC,UAAU,EAAEC;EAChB,CAAC;EACDC,KAAK,EAAE,CAAC,mBAAmB,EAAE,aAAa,EAAE,eAAe,CAAC;EAC5DC,KAAKA,CAACR,KAAK,EAAE;IAAES;EAAK,CAAC,EAAE;IACnB,MAAMC,MAAK,GAAIhB,QAAQ,CAAC;MACpBiB,GAAG,EAAEA,CAAA,KAAMX,KAAK,CAACC,UAAU;MAC3BW,G