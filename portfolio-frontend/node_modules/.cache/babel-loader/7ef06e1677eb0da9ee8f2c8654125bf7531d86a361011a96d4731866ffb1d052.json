{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, inject, watch } from 'vue';\nimport Navigation from './Navigation.vue';\nimport { useRouter } from 'vue-router';\nexport default {\n  components: {\n    Navigation\n  },\n  props: {\n    isAuthenticated: {\n      type: Boolean,\n      required: true\n    }\n  },\n  setup(props) {\n    const router = useRouter();\n    const setUser = inject('setUser');\n    const pageTitle = ref('');\n    const handleLogout = () => {\n      setUser(null);\n      router.push('/login');\n    };\n    const updatePageTitle = title => {\n      pageTitle.value = title;\n    };\n\n    // Reset page title when authentication status changes\n    watch(() => props.isAuthenticated, newValue => {\n      if (!newValue) {\n        pageTitle.value = '';\n      }\n    });\n\n    // Reset page title on route change for non-authenticated routes\n    watch(() => router.currentRoute.value.path, () => {\n      if (!props.isAuthenticated) {\n        pageTitle.value = '';\n      }\n    });\n    return {\n      handleLogout,\n      pageTitle,\n      updatePageTitle\n    };\n  }\n};","map":{"version":3,"names":["ref","inject","watch","Navigation","useRouter","components","props","isAuthenticated","type","Boolean","required","setup","router","setUser","pageTitle","handleLogout","push","updatePageTitle","title","value","newValue","currentRoute","path"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\AppLayout.vue"],"sourcesContent":["<template>\r\n  <v-app>\r\n    <template v-if=\"isAuthenticated\">\r\n      <Navigation @logout=\"handleLogout\" />\r\n      <v-main>\r\n        <v-container fluid>\r\n          <v-row v-if=\"pageTitle\">\r\n            <v-col>\r\n              <h2 class=\"text-h4 mb-4\">{{ pageTitle }}</h2>\r\n              <v-divider class=\"mb-4\"></v-divider>\r\n            </v-col>\r\n          </v-row>\r\n          <router-view @update-page-title=\"updatePageTitle\"></router-view>\r\n        </v-container>\r\n      </v-main>\r\n    </template>\r\n    <template v-else>\r\n      <v-main>\r\n        <router-view></router-view>\r\n      </v-main>\r\n    </template>\r\n  </v-app>\r\n</template>\r\n\r\n<script>\r\nimport { ref, inject, watch } from 'vue'\r\nimport Navigation from './Navigation.vue'\r\nimport { useRouter } from 'vue-router'\r\n\r\nexport default {\r\n  components: {\r\n    Navigation,\r\n  },\r\n  props: {\r\n    isAuthenticated: {\r\n      type: Boolean,\r\n      required: true\r\n    }\r\n  },\r\n  setup(props) {\r\n    const router = useRouter();\r\n    const setUser = inject('setUser');\r\n    const pageTitle = ref('');\r\n\r\n    const handleLogout = () => {\r\n      setUser(null);\r\n      router.push('/login');\r\n    };\r\n\r\n    const updatePageTitle = (title) => {\r\n      pageTitle.value = title;\r\n    };\r\n\r\n    // Reset page title when authentication status changes\r\n    watch(() => props.isAuthenticated, (newValue) => {\r\n      if (!newValue) {\r\n        pageTitle.value = '';\r\n      }\r\n    });\r\n\r\n    // Reset page title on route change for non-authenticated routes\r\n    watch(() => router.currentRoute.value.path, () => {\r\n      if (!props.isAuthenticated) {\r\n        pageTitle.value = '';\r\n      }\r\n    });\r\n\r\n    return { handleLogout, pageTitle, updatePageTitle };\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.fixed-title {\r\n  position: fixed;\r\n  top: 64px;\r\n  left: 0;\r\n  right: 0;\r\n  background-color: white;\r\n  z-index: 1;\r\n  padding-top: 16px;\r\n  padding-bottom: 16px;\r\n}\r\n\r\n.content-container {\r\n  padding-top: 80px;\r\n}\r\n</style>"],"mappings":";AAyBA,SAASA,GAAG,EAAEC,MAAM,EAAEC,KAAI,QAAS,KAAI;AACvC,OAAOC,UAAS,MAAO,kBAAiB;AACxC,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAK,EAAE;IACLC,eAAe,EAAE;MACfC,IAAI,EAAEC,OAAO;MACbC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,KAAKA,CAACL,KAAK,EAAE;IACX,MAAMM,MAAK,GAAIR,SAAS,CAAC,CAAC;IAC1B,MAAMS,O