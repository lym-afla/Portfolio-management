{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nexport default {\n  name: 'ClosedPositions',\n  emits: ['update-page-title'],\n  setup(props, {\n    emit\n  }) {\n    const closedPositions = ref([]);\n    const totals = ref({});\n    const loading = ref(true);\n    const tableLoading = ref(true);\n    const selectedYear = ref('YTD');\n    const yearOptions = ref([]);\n    const search = ref('');\n    const itemsPerPage = ref(25);\n    const itemsPerPageOptions = [10, 25, 50, 100];\n    const pagination = ref({});\n    const headers = computed(() => [{\n      title: 'Type',\n      key: 'type',\n      align: 'start',\n      sortable: false\n    }, {\n      title: 'Name',\n      key: 'name',\n      align: 'start',\n      sortable: false\n    }, {\n      title: 'Currency',\n      key: 'currency',\n      align: 'center',\n      sortable: false\n    }, {\n      title: 'Max position',\n      key: 'max_position',\n      align: 'center',\n      sortable: false\n    }, {\n      title: 'Entry',\n      key: 'entry',\n      align: 'center',\n      sortable: false,\n      children: [{\n        title: 'Date',\n        key: 'investment_date',\n        align: 'center'\n      }, {\n        title: 'Value',\n        key: 'entry_value',\n        align: 'center'\n      }]\n    }, {\n      title: 'Exit',\n      key: 'exit',\n      align: 'center',\n      children: [{\n        title: 'Date',\n        key: 'exit_date',\n        align: 'center'\n      }, {\n        title: 'Value',\n        key: 'exit_value',\n        align: 'center'\n      }]\n    }, {\n      title: 'Realized gain/(loss)',\n      key: 'realized',\n      align: 'center',\n      children: [{\n        title: 'Amount',\n        key: 'realized_gl',\n        align: 'center'\n      }, {\n        title: '%',\n        key: 'price_change_percentage',\n        align: 'center'\n      }]\n    }, {\n      title: 'Capital distribution',\n      key: 'capital',\n      align: 'center',\n      children: [{\n        title: 'Amount',\n        key: 'capital_distribution',\n        align: 'center'\n      }, {\n        title: '%',\n        key: 'capital_distribution_percentage',\n        align: 'center'\n      }]\n    }, {\n      title: 'Commission',\n      key: 'commission',\n      align: 'center',\n      children: [{\n        title: 'Amount',\n        key: 'commission',\n        align: 'center'\n      }, {\n        title: '%',\n        key: 'commission_percentage',\n        align: 'center'\n      }]\n    }, {\n      title: 'Total return',\n      key: 'total',\n      align: 'center',\n      children: [{\n        title: 'Amount',\n        key: 'total_return_amount',\n        align: 'center'\n      }, {\n        title: '%',\n        key: 'total_return_percentage',\n        align: 'center'\n      }, {\n        title: 'IRR',\n        key: 'irr',\n        align: 'center'\n      }]\n    }]);\n    const updateOptions = newOptions => {\n      pagination.value = newOptions;\n    };\n    const fetchClosedPositions = async () => {\n      tableLoading.value = true;\n      try {\n        const response = await axios.post('/closed_positions/api/get_closed_positions_table/', {\n          timespan: selectedYear.value\n        });\n        closedPositions.value = response.data.portfolio_closed;\n        totals.value = response.data.portfolio_closed_totals;\n      } catch (error) {\n        console.error('Error fetching closed positions:', error);\n      } finally {\n        tableLoading.value = false;\n      }\n    };\n    const handleYearChange = newValue => {\n      selectedYear.value = newValue;\n      fetchClosedPositions();\n    };\n    const fetchYearOptions = async () => {\n      try {\n        const response = await axios.get('/closed_positions/api/get_year_options/');\n        yearOptions.value = response.data.closed_table_years.map(year => {\n          if (typeof year === 'string') {\n            return {\n              text: year,\n              value: year\n            };\n          }\n          return year; // For divider and special options\n        });\n      } catch (error) {\n        console.error('Error fetching year options:', error);\n      }\n    };\n    const fetchData = async () => {\n      loading.value = true;\n      await Promise.all([fetchYearOptions(), fetchClosedPositions()]);\n      loading.value = false;\n    };\n    const totalRowValues = computed(() => {\n      return Object.entries(totals.value).filter(([key]) => key !== 'type').map(([key, value]) => ({\n        key,\n        value\n      }));\n    });\n    onMounted(() => {\n      fetchData();\n      emit('update-page-title', 'Closed Positions');\n    });\n    onUnmounted(() => {\n      emit('update-page-title', '');\n    });\n    return {\n      closedPositions,\n      totals,\n      loading,\n      tableLoading,\n      headers,\n      selectedYear,\n      yearOptions,\n      handleYearChange,\n      search,\n      itemsPerPage,\n      itemsPerPageOptions,\n      pagination,\n      updateOptions,\n      totalRowValues\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","axios","name","emits","setup","props","emit","closedPositions","totals","loading","tableLoading","selectedYear","yearOptions","search","itemsPerPage","itemsPerPageOptions","pagination","headers","title","key","align","sortable","children","updateOptions","newOptions","value","fetchClosedPositions","response","post","timespan","data","portfolio_closed","portfolio_closed_totals","error","console","handleYearChange","newValue","fetchYearOptions","get","closed_table_years","map","year","text","fetchData","Promise","all","totalRowValues","Object","entries","filter"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\ClosedPositionsPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid>\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\" md=\"3\" lg=\"2\">\r\n        <v-select\r\n          v-model=\"selectedYear\"\r\n          :items=\"yearOptions\"\r\n          item-title=\"text\"\r\n          item-value=\"value\"\r\n          label=\"Year\"\r\n          @update:model-value=\"handleYearChange\"\r\n          density=\"compact\"\r\n        >\r\n          <template #item=\"{ props, item }\">\r\n            <v-list-item v-if=\"!item.raw.divider\" v-bind=\"props\" :title=\"item.title\"></v-list-item>\r\n            <v-divider v-else class=\"my-2\"></v-divider>\r\n          </template>\r\n        </v-select>\r\n      </v-col>\r\n      <v-col cols=\"12\" md=\"3\" lg=\"2\">\r\n        <v-text-field\r\n          v-model=\"search\"\r\n          append-icon=\"mdi-magnify\"\r\n          label=\"Search\"\r\n          single-line\r\n          hide-details\r\n          density=\"compact\"\r\n        ></v-text-field>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\">\r\n        <v-data-table\r\n          :headers=\"headers\"\r\n          :items=\"closedPositions\"\r\n          :loading=\"tableLoading\"\r\n          :search=\"search\"\r\n          :items-per-page=\"itemsPerPage\"\r\n          class=\"elevation-1\"\r\n          density=\"compact\"\r\n        >\r\n          <template #top>\r\n            <v-toolbar flat>\r\n              <v-toolbar-title>Closed Positions</v-toolbar-title>\r\n            </v-toolbar>\r\n          </template>\r\n\r\n          <template #bottom>\r\n            <v-row>\r\n              <v-col cols=\"12\">\r\n                <v-data-table-footer\r\n                  :pagination=\"pagination\"\r\n                  :items-per-page-options=\"itemsPerPageOptions\"\r\n                  @update:options=\"updateOptions\"\r\n                ></v-data-table-footer>\r\n              </v-col>\r\n            </v-row>\r\n            <v-row>\r\n              <v-col cols=\"12\">\r\n                <v-table density=\"compact\">\r\n                  <tbody>\r\n                    <tr>\r\n                      <td class=\"font-weight-bold\">TOTAL</td>\r\n                      <td v-for=\"value in totalRowValues\" :key=\"value.key\">\r\n                        {{ value.value }}\r\n                      </td>\r\n                    </tr>\r\n                  </tbody>\r\n                </v-table>\r\n              </v-col>\r\n            </v-row>\r\n          </template>\r\n        </v-data-table>\r\n      </v-col>\r\n    </v-row>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue'\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'ClosedPositions',\r\n  emits: ['update-page-title'],\r\n  setup(props, { emit }) {\r\n    const closedPositions = ref([])\r\n    const totals = ref({})\r\n    const loading = ref(true)\r\n    const tableLoading = ref(true)\r\n    const selectedYear = ref('YTD')\r\n    const yearOptions = ref([])\r\n    const search = ref('')\r\n    const itemsPerPage = ref(25)\r\n    const itemsPerPageOptions = [10, 25, 50, 100]\r\n    const pagination = ref({})\r\n\r\n    const headers = computed(() => [\r\n      {\r\n        title: 'Type',\r\n        key: 'type',\r\n        align: 'start',\r\n        sortable: false,\r\n      },\r\n      { title: 'Name', key: 'name', align: 'start', sortable: false },\r\n      { title: 'Currency', key: 'currency', align: 'center', sortable: false },\r\n      { title: 'Max position', key: 'max_position', align: 'center', sortable: false },\r\n      {\r\n        title: 'Entry',\r\n        key: 'entry',\r\n        align: 'center',\r\n        sortable: false,\r\n        children: [\r\n          { title: 'Date', key: 'investment_date', align: 'center' },\r\n          { title: 'Value', key: 'entry_value', align: 'center' },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Exit',\r\n        key: 'exit',\r\n        align: 'center',\r\n        children: [\r\n          { title: 'Date', key: 'exit_date', align: 'center' },\r\n          { title: 'Value', key: 'exit_value', align: 'center' },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Realized gain/(loss)',\r\n        key: 'realized',\r\n        align: 'center',\r\n        children: [\r\n          { title: 'Amount', key: 'realized_gl', align: 'center' },\r\n          { title: '%', key: 'price_change_percentage', align: 'center' },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Capital distribution',\r\n        key: 'capital',\r\n        align: 'center',\r\n        children: [\r\n          { title: 'Amount', key: 'capital_distribution', align: 'center' },\r\n          { title: '%', key: 'capital_distribution_percentage', align: 'center' },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Commission',\r\n        key: 'commission',\r\n        align: 'center',\r\n        children: [\r\n          { title: 'Amount', key: 'commission', align: 'center' },\r\n          { title: '%', key: 'commission_percentage', align: 'center' },\r\n        ],\r\n      },\r\n      {\r\n        title: 'Total return',\r\n        key: 'total',\r\n        align: 'center',\r\n        children: [\r\n          { title: 'Amount', key: 'total_return_amount', align: 'center' },\r\n          { title: '%', key: 'total_return_percentage', align: 'center' },\r\n          { title: 'IRR', key: 'irr', align: 'center' },\r\n        ],\r\n      },\r\n    ])\r\n\r\n    const updateOptions = (newOptions) => {\r\n      pagination.value = newOptions\r\n    }\r\n\r\n    const fetchClosedPositions = async () => {\r\n      tableLoading.value = true\r\n      try {\r\n        const response = await axios.post(\r\n          '/closed_positions/api/get_closed_positions_table/',\r\n          {\r\n            timespan: selectedYear.value,\r\n          }\r\n        )\r\n        closedPositions.value = response.data.portfolio_closed\r\n        totals.value = response.data.portfolio_closed_totals\r\n      } catch (error) {\r\n        console.error('Error fetching closed positions:', error)\r\n      } finally {\r\n        tableLoading.value = false\r\n      }\r\n    }\r\n\r\n    const handleYearChange = (newValue) => {\r\n      selectedYear.value = newValue\r\n      fetchClosedPositions()\r\n    }\r\n\r\n    const fetchYearOptions = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          '/closed_positions/api/get_year_options/'\r\n        )\r\n        yearOptions.value = response.data.closed_table_years.map(year => {\r\n          if (typeof year === 'string') {\r\n            return { text: year, value: year }\r\n          }\r\n          return year  // For divider and special options\r\n        })\r\n      } catch (error) {\r\n        console.error('Error fetching year options:', error)\r\n      }\r\n    }\r\n\r\n    const fetchData = async () => {\r\n      loading.value = true\r\n      await Promise.all([fetchYearOptions(), fetchClosedPositions()])\r\n      loading.value = false\r\n    }\r\n\r\n    const totalRowValues = computed(() => {\r\n      return Object.entries(totals.value)\r\n        .filter(([key]) => key !== 'type')\r\n        .map(([key, value]) => ({ key, value }))\r\n    })\r\n\r\n    onMounted(() => {\r\n      fetchData()\r\n      emit('update-page-title', 'Closed Positions')\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      emit('update-page-title', '')\r\n    })\r\n\r\n    return {\r\n      closedPositions,\r\n      totals,\r\n      loading,\r\n      tableLoading,\r\n      headers,\r\n      selectedYear,\r\n      yearOptions,\r\n      handleYearChange,\r\n      search,\r\n      itemsPerPage,\r\n      itemsPerPageOptions,\r\n      pagination,\r\n      updateOptions,\r\n      totalRowValues,\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-data-table :deep(.v-data-table__wrapper) {\r\n  overflow-x: auto;\r\n}\r\n\r\n.v-data-table :deep(tabl