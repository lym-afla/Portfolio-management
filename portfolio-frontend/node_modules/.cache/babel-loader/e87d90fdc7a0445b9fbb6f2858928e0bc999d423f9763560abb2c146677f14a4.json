{"ast":null,"code":"import { ref, onMounted, onUnmounted, watch } from 'vue';\nimport axios from 'axios';\nexport default {\n  name: 'ClosedPositions',\n  emits: ['update-page-title'],\n  setup(props, {\n    emit\n  }) {\n    const closedPositions = ref([]);\n    const totals = ref({});\n    const loading = ref(false);\n    const selectedYear = ref('YTD'); // Set default to YTD\n    const yearOptions = ref([]);\n    const headers = [{\n      text: 'Type',\n      value: 'type',\n      align: 'start'\n    }, {\n      text: 'Name',\n      value: 'name',\n      align: 'start'\n    }, {\n      text: 'Currency',\n      value: 'currency',\n      align: 'center'\n    }, {\n      text: 'Max position',\n      value: 'max_position',\n      align: 'center'\n    }, {\n      text: 'Entry Date',\n      value: 'investment_date',\n      align: 'center'\n    }, {\n      text: 'Entry Value',\n      value: 'entry_value',\n      align: 'center'\n    }, {\n      text: '',\n      value: 'spacer1',\n      sortable: false\n    }, {\n      text: 'Exit Date',\n      value: 'exit_date',\n      align: 'center'\n    }, {\n      text: 'Exit Value',\n      value: 'exit_value',\n      align: 'center'\n    }, {\n      text: '',\n      value: 'spacer2',\n      sortable: false\n    }, {\n      text: 'Realized G/L',\n      value: 'realized_gl',\n      align: 'center'\n    }, {\n      text: 'Realized G/L %',\n      value: 'price_change_percentage',\n      align: 'center'\n    }, {\n      text: '',\n      value: 'spacer3',\n      sortable: false\n    }, {\n      text: 'Capital Distribution',\n      value: 'capital_distribution',\n      align: 'center'\n    }, {\n      text: 'Capital Distribution %',\n      value: 'capital_distribution_percentage',\n      align: 'center'\n    }, {\n      text: '',\n      value: 'spacer4',\n      sortable: false\n    }, {\n      text: 'Commission',\n      value: 'commission',\n      align: 'center'\n    }, {\n      text: 'Commission %',\n      value: 'commission_percentage',\n      align: 'center'\n    }, {\n      text: '',\n      value: 'spacer5',\n      sortable: false\n    }, {\n      text: 'Total Return',\n      value: 'total_return_amount',\n      align: 'center'\n    }, {\n      text: 'Total Return %',\n      value: 'total_return_percentage',\n      align: 'center'\n    }, {\n      text: 'IRR',\n      value: 'irr',\n      align: 'center'\n    }];\n    const fetchClosedPositions = async () => {\n      loading.value = true;\n      try {\n        const response = await axios.post('/closed_positions/api/get_closed_positions_table/', {\n          timespan: selectedYear.value\n        });\n        closedPositions.value = response.data.portfolio_closed;\n        totals.value = response.data.portfolio_closed_totals;\n      } catch (error) {\n        console.error('Error fetching closed positions:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const fetchYearOptions = async () => {\n      try {\n        const response = await axios.get('/closed_positions/api/get_year_options/');\n        console.log('API response:', response.data);\n        yearOptions.value = response.data.closed_table_years.map(year => {\n          if (typeof year === 'string') {\n            return {\n              text: year,\n              value: year\n            };\n          }\n          return year; // For divider and special options\n        });\n        console.log('Mapped year options:', yearOptions.value);\n      } catch (error) {\n        console.error('Error fetching year options:', error);\n      }\n    };\n    onMounted(() => {\n      fetchYearOptions();\n      fetchClosedPositions();\n      emit('update-page-title', 'Closed Positions');\n    });\n    onUnmounted(() => {\n      emit('update-page-title', ''); // Clear the page title when component is unmounted\n    });\n    return {\n      closedPositions,\n      totals,\n      loading,\n      headers,\n      selectedYear,\n      yearOptions,\n      fetchClosedPositions\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","watch","axios","name","emits","setup","props","emit","closedPositions","totals","loading","selectedYear","yearOptions","headers","text","value","align","sortable","fetchClosedPositions","response","post","timespan","data","portfolio_closed","portfolio_closed_totals","error","console","fetchYearOptions","get","log","closed_table_years","map","year"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\ClosedPositionsPage.vue"],"sourcesContent":["<template>\r\n  <v-container>\r\n    <v-row>\r\n      <v-col cols=\"3\">\r\n        <v-select\r\n          v-model=\"selectedYear\"\r\n          :items=\"yearOptions\"\r\n          item-title=\"text\"\r\n          item-value=\"value\"\r\n          label=\"Year\"\r\n          @update:model-value=\"handleYearChange\"\r\n        >\r\n          <template v-slot:item=\"{ item, props }\">\r\n            <v-list-item\r\n              v-if=\"!item.raw.divider\"\r\n              v-bind=\"props\"\r\n              :title=\"item.title\"\r\n            ></v-list-item>\r\n            <v-divider v-else class=\"my-2\"></v-divider>\r\n          </template>\r\n        </v-select>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <v-data-table\r\n      :headers=\"headers\"\r\n      :items=\"closedPositions\"\r\n      :loading=\"loading\"\r\n      class=\"elevation-1\"\r\n    >\r\n      <template v-slot:top>\r\n        <v-toolbar flat>\r\n          <v-toolbar-title>Closed Positions</v-toolbar-title>\r\n        </v-toolbar>\r\n      </template>\r\n\r\n      <template v-slot:footer>\r\n        <tr>\r\n          <td colspan=\"2\" class=\"text-right font-weight-bold\">TOTAL</td>\r\n          <td></td>\r\n          <td></td>\r\n          <td></td>\r\n          <td class=\"text-center font-weight-bold\">{{ totals.entry_value }}</td>\r\n          <td></td>\r\n          <td></td>\r\n          <td class=\"text-center font-weight-bold\">{{ totals.exit_value }}</td>\r\n          <td></td>\r\n          <td class=\"text-center font-weight-bold\">{{ totals.realized_gl }}</td>\r\n          <td class=\"text-center font-weight-bold font-italic\">\r\n            {{ totals.price_change_percentage }}\r\n          </td>\r\n          <td></td>\r\n          <td class=\"text-center font-weight-bold\">\r\n            {{ totals.capital_distribution }}\r\n          </td>\r\n          <td class=\"text-center font-weight-bold font-italic\">\r\n            {{ totals.capital_distribution_percentage }}\r\n          </td>\r\n          <td></td>\r\n          <td class=\"text-center font-weight-bold\">{{ totals.commission }}</td>\r\n          <td class=\"text-center font-weight-bold font-italic\">\r\n            {{ totals.commission_percentage }}\r\n          </td>\r\n          <td></td>\r\n          <td class=\"text-center font-weight-bold\">\r\n            {{ totals.total_return_amount }}\r\n          </td>\r\n          <td class=\"text-center font-weight-bold font-italic\">\r\n            {{ totals.total_return_percentage }}\r\n          </td>\r\n        </tr>\r\n      </template>\r\n    </v-data-table>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted, watch } from 'vue'\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'ClosedPositions',\r\n  emits: ['update-page-title'],\r\n  setup(props, { emit }) {\r\n    const closedPositions = ref([])\r\n    const totals = ref({})\r\n    const loading = ref(false)\r\n    const selectedYear = ref('YTD')  // Set default to YTD\r\n    const yearOptions = ref([])\r\n\r\n    const headers = [\r\n      { text: 'Type', value: 'type', align: 'start' },\r\n      { text: 'Name', value: 'name', align: 'start' },\r\n      { text: 'Currency', value: 'currency', align: 'center' },\r\n      { text: 'Max position', value: 'max_position', align: 'center' },\r\n      { text: 'Entry Date', value: 'investment_date', align: 'center' },\r\n      { text: 'Entry Value', value: 'entry_value', align: 'center' },\r\n      { text: '', value: 'spacer1', sortable: false },\r\n      { text: 'Exit Date', value: 'exit_date', align: 'center' },\r\n      { text: 'Exit Value', value: 'exit_value', align: 'center' },\r\n      { text: '', value: 'spacer2', sortable: false },\r\n      { text: 'Realized G/L', value: 'realized_gl', align: 'center' },\r\n      {\r\n        text: 'Realized G/L %',\r\n        value: 'price_change_percentage',\r\n        align: 'center',\r\n      },\r\n      { text: '', value: 'spacer3', sortable: false },\r\n      {\r\n        text: 'Capital Distribution',\r\n        value: 'capital_distribution',\r\n        align: 'center',\r\n      },\r\n      {\r\n        text: 'Capital Distribution %',\r\n        value: 'capital_distribution_percentage',\r\n        align: 'center',\r\n      },\r\n      { text: '', value: 'spacer4', sortable: false },\r\n      { text: 'Commission', value: 'commission', align: 'center' },\r\n      { text: 'Commission %', value: 'commission_percentage', align: 'center' },\r\n      { text: '', value: 'spacer5', sortable: false },\r\n      { text: 'Total Return', value: 'total_return_amount', align: 'center' },\r\n      {\r\n        text: 'Total Return %',\r\n        value: 'total_return_percentage',\r\n        align: 'center',\r\n      },\r\n      { text: 'IRR', value: 'irr', align: 'center' },\r\n    ]\r\n\r\n    const fetchClosedPositions = async () => {\r\n      loading.value = true\r\n      try {\r\n        const response = await axios.post(\r\n          '/closed_positions/api/get_closed_positions_table/',\r\n          {\r\n            timespan: selectedYear.value,\r\n          }\r\n        )\r\n        closedPositions.value = response.data.portfolio_closed\r\n        totals.value = response.data.portfolio_closed_totals\r\n      } catch (error) {\r\n        console.error('Error fetching closed positions:', error)\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    const fetchYearOptions = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          '/closed_positions/api/get_year_options/'\r\n        )\r\n        console.log('API response:', response.data)\r\n        yearOptions.value = response.data.closed_table_years.map(year => {\r\n          if (typeof year === 'string') {\r\n            return { text: year, value: year }\r\n          }\r\n          return year  // For divider and special options\r\n        })\r\n        console.log('Mapped year options:', yearOptions.value)\r\n      } catch (error) {\r\n        console.error('Error fetching year options:', error)\r\n      }\r\n    }\r\n\r\n    onMounted(() => {\r\n      fetchYearOptions()\r\n      fetchClosedPositions()\r\n      emit('update-page-title', 'Closed Positions')\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      emit('update-page-title', '') // Clear the page title when component is unmounted\r\n    })\r\n\r\n    return {\r\n      closedPositions,\r\n      totals,\r\n      loading,\r\n      headers,\r\n      selectedYear,\r\n      yearOptions,\r\n      fetchClosedPositions,\r\n    }\r\n  },\r\n}\r\n</script>"],"mappings":"AA6EA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAW,EAAEC,KAAI,QAAS,KAAI;AACvD,OAAOC,KAAI,MAAO,OAAM;AAExB,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IACrB,MAAMC,eAAc,GAAIV,GAAG,CAAC,EAAE;IAC9B,MAAMW,MAAK,GAAIX,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMY,OAAM,GAAIZ,GAAG,CAAC,KAAK;IACzB,MAAMa,YAAW,GAAIb,GAAG,CAAC,KAAK,GAAG;IACjC,MAAMc,WAAU,GAAId,GAAG,CAAC,EAAE;IAE1B,MAAMe,OAAM,GAAI,CACd;MAAEC,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAQ,CAAC,EAC/C;MAAEF,IAAI,EAAE,MAAM;MAAEC,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAQ,CAAC,EAC/C;MAAEF,IAAI,EAAE,UAAU;MAAEC,KAAK,EAAE,UAAU;MAAEC,KAAK,EAAE;IAAS,CAAC,EACxD;MAAEF,IAAI,EAAE,cAAc;MAAEC,KAAK,EAAE,cAAc;MAAEC,KAAK,EAAE;IAAS,CAAC,EAChE;MAAEF,IAAI,EAAE,YAAY;MAAEC,KAAK,EAAE,iBAAiB;MAAEC,KAAK,EAAE;IAAS,CAAC,EACjE;MAAEF,IAAI,EAAE,