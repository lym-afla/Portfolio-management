{"ast":null,"code":"import { Line } from 'vue-chartjs';\nimport { Chart as ChartJS, Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale } from 'chart.js';\nChartJS.register(Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale);\nexport default {\n  name: 'PriceChart',\n  components: {\n    Line\n  },\n  props: {\n    prices: {\n      type: Array,\n      required: true\n    }\n  },\n  computed: {\n    chartData() {\n      // Check if prices are available\n      if (!this.prices || this.prices.length === 0) {\n        return {\n          labels: [],\n          datasets: []\n        };\n      }\n      return {\n        labels: this.prices.map(price => price.date),\n        // Ensure price has a date field\n        datasets: [{\n          label: 'Price Series',\n          data: this.prices.map(price => parseFloat(price.price)),\n          // Ensure price is a number\n          borderColor: '#42A5F5',\n          backgroundColor: 'rgba(66, 165, 245, 0.2)',\n          fill: true\n        }]\n      };\n    },\n    chartOptions() {\n      return {\n        responsive: true,\n        maintainAspectRatio: false,\n        scales: {\n          y: {\n            beginAtZero: true\n          }\n        }\n      };\n    }\n  }\n};","map":{"version":3,"names":["Line","Chart","ChartJS","Title","Tooltip","Legend","LineElement","PointElement","LinearScale","CategoryScale","register","name","components","props","prices","type","Array","required","computed","chartData","length","labels","datasets","map","price","date","label","data","parseFloat","borderColor","backgroundColor","fill","chartOptions","responsive","maintainAspectRatio","scales","y","beginAtZero"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\charts\\PriceChart.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <Line v-if=\"chartData.labels.length > 0\" :chart-data=\"chartData\" :options=\"chartOptions\" />\r\n    <p v-else>No data available for the chart.</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Line } from 'vue-chartjs'\r\nimport { Chart as ChartJS, Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale } from 'chart.js'\r\n\r\nChartJS.register(Title, Tooltip, Legend, LineElement, PointElement, LinearScale, CategoryScale)\r\n\r\nexport default {\r\n  name: 'PriceChart',\r\n  components: {\r\n    Line\r\n  },\r\n  props: {\r\n    prices: {\r\n      type: Array,\r\n      required: true\r\n    }\r\n  },\r\n  computed: {\r\n    chartData() {\r\n      // Check if prices are available\r\n      if (!this.prices || this.prices.length === 0) {\r\n        return {\r\n          labels: [],\r\n          datasets: []\r\n        }\r\n      }\r\n      return {\r\n        labels: this.prices.map(price => price.date), // Ensure price has a date field\r\n        datasets: [\r\n          {\r\n            label: 'Price Series',\r\n            data: this.prices.map(price => parseFloat(price.price)), // Ensure price is a number\r\n            borderColor: '#42A5F5',\r\n            backgroundColor: 'rgba(66, 165, 245, 0.2)',\r\n            fill: true,\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    chartOptions() {\r\n      return {\r\n        responsive: true,\r\n        maintainAspectRatio: false,\r\n        scales: {\r\n          y: {\r\n            beginAtZero: true\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n  position: relative;\r\n  height: 40vh;\r\n  width: 80vw;\r\n}\r\n</style>"],"mappings":"AAQA,SAASA,IAAG,QAAS,aAAY;AACjC,SAASC,KAAI,IAAKC,OAAO,EAAEC,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,WAAW,EAAEC,YAAY,EAAEC,WAAW,EAAEC,aAAY,QAAS,UAAS;AAEzHP,OAAO,CAACQ,QAAQ,CAACP,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,WAAW,EAAEC,YAAY,EAAEC,WAAW,EAAEC,aAAa;AAE9F,eAAe;EACbE,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IACVZ;EACF,CAAC;EACDa,KAAK,EAAE;IACLC,MAAM,EAAE;MACNC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE;IACZ;EACF,CAAC;EACD