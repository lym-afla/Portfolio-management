{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { Pie } from 'vue-chartjs';\nimport { Chart as ChartJS, Title, Tooltip, Legend, ArcElement, CategoryScale } from 'chart.js';\nChartJS.register(Title, Tooltip, Legend, ArcElement, CategoryScale);\nexport default {\n  name: 'BreakdownChart',\n  components: {\n    Pie\n  },\n  props: {\n    title: {\n      type: String,\n      required: true\n    },\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  setup(props) {\n    const tab = ref('chart');\n    const chartData = computed(() => ({\n      labels: Object.keys(props.data),\n      datasets: [{\n        data: Object.values(props.data).map(item => parseFloat(item.amount)),\n        backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40']\n      }]\n    }));\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false\n    };\n    const totalAmount = computed(() => Object.values(props.data).reduce((sum, item) => sum + parseFloat(item.amount), 0));\n    return {\n      tab,\n      chartData,\n      chartOptions,\n      totalAmount\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","Pie","Chart","ChartJS","Title","Tooltip","Legend","ArcElement","CategoryScale","register","name","components","props","title","type","String","required","data","Object","setup","tab","chartData","labels","keys","datasets","values","map","item","parseFloat","amount","backgroundColor","chartOptions","responsive","maintainAspectRatio","totalAmount","reduce","sum"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\BreakdownChart.vue"],"sourcesContent":["<template>\r\n  <v-card>\r\n    <v-card-title>{{ title }}</v-card-title>\r\n    <v-card-text>\r\n      <v-tabs v-model=\"tab\">\r\n        <v-tab value=\"chart\">Pie Chart</v-tab>\r\n        <v-tab value=\"table\">Table</v-tab>\r\n      </v-tabs>\r\n\r\n      <v-window v-model=\"tab\">\r\n        <v-window-item value=\"chart\">\r\n          <Pie :data=\"chartData\" :options=\"chartOptions\" />\r\n        </v-window-item>\r\n\r\n        <v-window-item value=\"table\">\r\n          <v-table>\r\n            <thead>\r\n              <tr>\r\n                <th>Name</th>\r\n                <th>Amount</th>\r\n                <th>Percentage</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr v-for=\"(item, index) in chartData.datasets[0].data\" :key=\"index\">\r\n                <td>{{ chartData.labels[index] }}</td>\r\n                <td>{{ item.toFixed(2) }}</td>\r\n                <td>{{ ((item / totalAmount) * 100).toFixed(2) }}%</td>\r\n              </tr>\r\n            </tbody>\r\n          </v-table>\r\n        </v-window-item>\r\n      </v-window>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport { Pie } from 'vue-chartjs'\r\nimport { Chart as ChartJS, Title, Tooltip, Legend, ArcElement, CategoryScale } from 'chart.js'\r\n\r\nChartJS.register(Title, Tooltip, Legend, ArcElement, CategoryScale)\r\n\r\nexport default {\r\n  name: 'BreakdownChart',\r\n  components: { Pie },\r\n  props: {\r\n    title: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    data: {\r\n      type: Object,\r\n      required: true\r\n    }\r\n  },\r\n  setup(props) {\r\n    const tab = ref('chart')\r\n\r\n    const chartData = computed(() => ({\r\n      labels: Object.keys(props.data),\r\n      datasets: [{\r\n        data: Object.values(props.data).map(item => parseFloat(item.amount)),\r\n        backgroundColor: [\r\n          '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40',\r\n          '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'\r\n        ]\r\n      }]\r\n    }))\r\n\r\n    const chartOptions = {\r\n      responsive: true,\r\n      maintainAspectRatio: false\r\n    }\r\n\r\n    const totalAmount = computed(() => \r\n      Object.values(props.data).reduce((sum, item) => sum + parseFloat(item.amount), 0)\r\n    )\r\n\r\n    return {\r\n      tab,\r\n      chartData,\r\n      chartOptions,\r\n      totalAmount\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAsCA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,GAAE,QAAS,aAAY;AAChC,SAASC,KAAI,IAAKC,OAAO,EAAEC,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,UAAU,EAAEC,aAAY,QAAS,UAAS;AAE7FL,OAAO,CAACM,QAAQ,CAACL,KAAK,EAAEC,OAAO,EAAEC,MAAM,EAAEC,UAAU,EAAEC,aAAa;AAElE,eAAe;EACbE,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAEV;EAAI,CAAC;EACnBW,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,IAAI,EAAE;MACJH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ;EACF,CAAC;EACDG,KAAKA,CAACP,KAAK,EAAE;IACX,MAAMQ,GAAE,GAAIrB,GAAG,CAAC,OAAO;IAEvB,MAAMsB,SAAQ,GAAIrB,QAAQ,CAAC,OAAO;MAChCsB,MAAM,EAAEJ,MAAM,CAACK,IAAI,CAACX,KAAK,CAACK,IAAI,CAAC;MAC/BO,QAAQ,EAAE,CAAC;QACTP,IAAI,EAAEC,MAAM,CAACO,MAAM,CAACb,KAAK,CAACK,IAAI,CAAC,CAACS,GAAG,CAACC,IAAG,IAAKC,UAAU,CAACD,IAAI,CAACE,MAAM,CAAC,CAAC;QACpEC,eAAe,EAAE,CACf,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAChE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAQ;MAEnE,CAAC;IACH,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAI;MACnBC,UAAU,EAAE,IAAI;MAChBC,mBAAmB,EAAE;IACvB;IAEA,MAAMC,WAAU,GAAIlC,QAAQ,CAAC,MAC3BkB,MAAM,CAACO,MAAM,CAACb,KAAK,CAACK,IAAI,CAAC,CAACkB,MAAM,CAAC,CAACC,GAAG,EAAET,IAAI,KAAKS,GAAE,GAAIR,UAAU,CAACD,IAAI,CAACE,MAAM,CAAC,EAAE,CAAC,CAClF;IAEA,OAAO;MACLT,GAAG;MACHC,SAAS;MACTU,YAAY;MACZG;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}