{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport UpdateBrokerPerformanceDialog from '@/components/dialogs/UpdateBrokerPerformanceDialog.vue';\nimport ProgressDialog from '@/components/dialogs/ProgressDialog.vue';\nimport { updateBrokerPerformance } from '@/services/api';\nexport default {\n  name: 'SummaryOverTimeTable',\n  components: {\n    UpdateBrokerPerformanceDialog,\n    ProgressDialog\n  },\n  props: {\n    lines: {\n      type: Array,\n      default: () => []\n    },\n    years: {\n      type: Array,\n      default: () => []\n    },\n    currentYear: {\n      type: String,\n      default: ''\n    },\n    error: {\n      type: String,\n      default: ''\n    }\n  },\n  emits: ['refresh-data'],\n  setup(props, {\n    emit\n  }) {\n    const showDialog = ref(false);\n    const showProgressDialog = ref(false);\n    const updateProgress = ref(0);\n    const currentOperation = ref(0);\n    const totalOperations = ref(0);\n    const currentMessage = ref('');\n    const errors = ref([]);\n    const showUpdateDialog = () => {\n      showDialog.value = true;\n    };\n    const handleUpdateStarted = async formData => {\n      console.log('Update started', formData);\n      showProgressDialog.value = true;\n      currentMessage.value = 'Starting update';\n      updateProgress.value = 0;\n      currentOperation.value = 0;\n      totalOperations.value = 0;\n      errors.value = [];\n      try {\n        await updateBrokerPerformance(formData);\n      } catch (error) {\n        handleUpdateError(error.message);\n      }\n    };\n    const handleProgress = event => {\n      const data = event.detail;\n      console.log('Progress:', data);\n      if (data.status === 'initializing') {\n        totalOperations.value = data.total;\n      } else if (data.status === 'progress') {\n        updateProgress.value = data.progress;\n        currentOperation.value = data.current;\n        // totalOperations.value = data.total\n        currentMessage.value = compileProgressMessage(data);\n      } else if (data.status === 'complete') {\n        // showProgressDialog.value = false\n        emit('refresh-data');\n      } else if (data.status === 'error') {\n        errors.value.push(data.message);\n        console.error('Update error:', data.message);\n      }\n    };\n    const compileProgressMessage = data => {\n      return `Processing year ${data.year}, currency: ${data.currency}, restricted: ${data.is_restricted}`;\n    };\n    const handleUpdateError = error => {\n      console.error('Update error:', error);\n      errors.value.push(error);\n      currentMessage.value = `Error: ${error}`;\n    };\n    const handleStopImport = () => {\n      // Implement stop import logic here\n      console.log('Stop import requested');\n      showProgressDialog.value = false;\n    };\n    onMounted(() => {\n      window.addEventListener('brokerPerformanceUpdateProgress', handleProgress);\n    });\n    onUnmounted(() => {\n      window.removeEventListener('brokerPerformanceUpdateProgress', handleProgress);\n    });\n    return {\n      showDialog,\n      showProgressDialog,\n      showUpdateDialog,\n      handleUpdateStarted,\n      handleUpdateError,\n      updateProgress,\n      currentOperation,\n      totalOperations,\n      currentMessage,\n      errors,\n      handleStopImport\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","UpdateBrokerPerformanceDialog","ProgressDialog","updateBrokerPerformance","name","components","props","lines","type","Array","default","years","currentYear","String","error","emits","setup","emit","showDialog","showProgressDialog","updateProgress","currentOperation","totalOperations","currentMessage","errors","showUpdateDialog","value","handleUpdateStarted","formData","console","log","handleUpdateError","message","handleProgress","event","data","detail","status","total","progress","current","compileProgressMessage","push","year","currency","is_restricted","handleStopImport","window","addEventListener","removeEventListener"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\SummaryOverTimeTable.vue"],"sourcesContent":["<template>\r\n  <v-card v-if=\"lines && years && currentYear\">\r\n    <v-card-title>Summary Over Time</v-card-title>\r\n    <v-card-text>\r\n      <v-alert v-if=\"error\" type=\"error\" dismissible>\r\n        {{ error }}\r\n      </v-alert>\r\n      <v-table v-if=\"!error\" density=\"compact\">\r\n        <thead>\r\n          <tr>\r\n            <th></th>\r\n            <th v-for=\"year in years\" :key=\"year\" class=\"text-center font-weight-bold\">{{ year }}</th>\r\n            <th class=\"text-center highlight font-weight-bold\">{{ currentYear }}YTD</th>\r\n            <th class=\"text-center highlight font-weight-bold\">All-time</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"line in lines\" :key=\"line.name\" :class=\"{ 'font-weight-bold': line.name === 'BoP NAV' || line.name === 'EoP NAV', 'font-italic': line.name === 'TSR' }\">\r\n            <td>\r\n              {{ line.name }}\r\n            </td>\r\n            <td v-for=\"year in years\" :key=\"`${line.name}-${year}`\" class=\"text-center\">\r\n              {{ line.data[year] }}\r\n            </td>\r\n            <td class=\"text-center highlight\">{{ line.data['YTD'] }}</td>\r\n            <td class=\"text-center font-weight-bold highlight\">{{ line.data['All-time'] }}</td>\r\n          </tr>\r\n        </tbody>\r\n      </v-table>\r\n      <v-btn @click=\"showUpdateDialog\" color=\"primary\" class=\"mt-4\">Update Broker Performance</v-btn>\r\n    </v-card-text>\r\n  </v-card>\r\n  <v-card v-else>\r\n    <v-card-title>Summary Over Time</v-card-title>\r\n    <v-card-text>\r\n      <v-alert type=\"info\">\r\n        No data available for the selected broker.\r\n      </v-alert>\r\n      <v-btn @click=\"showUpdateDialog\" color=\"primary\" class=\"mt-4\">Update Broker Performance</v-btn>\r\n    </v-card-text>\r\n  </v-card>\r\n\r\n  <UpdateBrokerPerformanceDialog\r\n    v-model=\"showDialog\"\r\n    @update-started=\"handleUpdateStarted\"\r\n    @update-error=\"handleUpdateError\"\r\n  />\r\n  <ProgressDialog\r\n    v-model=\"showProgressDialog\"\r\n    :title=\"'Updating Broker Performance'\"\r\n    :progress=\"updateProgress\"\r\n    :current=\"currentOperation\"\r\n    :total=\"totalOperations\"\r\n    :currentMessage=\"currentMessage\"\r\n    :errors=\"errors\"\r\n    @stop-import=\"handleStopImport\"\r\n  />\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted } from 'vue'\r\nimport UpdateBrokerPerformanceDialog from '@/components/dialogs/UpdateBrokerPerformanceDialog.vue'\r\nimport ProgressDialog from '@/components/dialogs/ProgressDialog.vue'\r\nimport { updateBrokerPerformance } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'SummaryOverTimeTable',\r\n  components: {\r\n    UpdateBrokerPerformanceDialog,\r\n    ProgressDialog\r\n  },\r\n  props: {\r\n    lines: {\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    years: {\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    currentYear: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    error: {\r\n      type: String,\r\n      default: ''\r\n    }\r\n  },\r\n  emits: ['refresh-data'],\r\n  setup(props, { emit }) {\r\n    const showDialog = ref(false)\r\n    const showProgressDialog = ref(false)\r\n    const updateProgress = ref(0)\r\n    const currentOperation = ref(0)\r\n    const totalOperations = ref(0)\r\n    const currentMessage = ref('')\r\n    const errors = ref([])\r\n\r\n    const showUpdateDialog = () => {\r\n      showDialog.value = true\r\n    }\r\n\r\n    const handleUpdateStarted = async (formData) => {\r\n      console.log('Update started', formData)\r\n      showProgressDialog.value = true\r\n      currentMessage.value = 'Starting update'\r\n      updateProgress.value = 0\r\n      currentOperation.value = 0\r\n      totalOperations.value = 0\r\n      errors.value = []\r\n\r\n      try {\r\n        await updateBrokerPerformance(formData)\r\n      } catch (error) {\r\n        handleUpdateError(error.message)\r\n      }\r\n    }\r\n\r\n    const handleProgress = (event) => {\r\n      const data = event.detail\r\n      console.log('Progress:', data)\r\n      if (data.status === 'initializing') {\r\n        totalOperations.value = data.total\r\n      } else if (data.status === 'progress') {\r\n        updateProgress.value = data.progress\r\n        currentOperation.value = data.current\r\n        // totalOperations.value = data.total\r\n        currentMessage.value = compileProgressMessage(data)\r\n      } else if (data.status === 'complete') {\r\n        // showProgressDialog.value = false\r\n        emit('refresh-data')\r\n      } else if (data.status === 'error') {\r\n        errors.value.push(data.message)\r\n        console.error('Update error:', data.message)\r\n      }\r\n    }\r\n\r\n    const compileProgressMessage = (data) => {\r\n      return `Processing year ${data.year}, currency: ${data.currency}, restricted: ${data.is_restricted}`\r\n    }\r\n\r\n    const handleUpdateError = (error) => {\r\n      console.error('Update error:', error)\r\n      errors.value.push(error)\r\n      currentMessage.value = `Error: ${error}`\r\n    }\r\n\r\n    const handleStopImport = () => {\r\n      // Implement stop import logic here\r\n      console.log('Stop import requested')\r\n      showProgressDialog.value = false\r\n    }\r\n\r\n    onMounted(() => {\r\n      window.addEventListener('brokerPerformanceUpdateProgress', handleProgress)\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      window.removeEventListener('brokerPerformanceUpdateProgress', handleProgress)\r\n    })\r\n\r\n    return {\r\n      showDialog,\r\n      showProgressDialog,\r\n      showUpdateDialog,\r\n      handleUpdateStarted,\r\n      handleUpdateError,\r\n      updateProgress,\r\n      currentOperation,\r\n      totalOperations,\r\n      currentMessage,\r\n      errors,\r\n      handleStopImport\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.highlight {\r\n  background-color: rgba(0, 0, 0, 0.05);\r\n}\r\n</style>"],"mappings":";AA4DA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAChD,OAAOC,6BAA4B,MAAO,wDAAuD;AACjG,OAAOC,cAAa,MAAO,yCAAwC;AACnE,SAASC,uBAAsB,QAAS,gBAAe;AAEvD,eAAe;EACbC,IAAI,EAAE,sBAAsB;EAC5BC,UAAU,EAAE;IACVJ,6BAA6B;IAC7BC;EACF,CAAC;EACDI,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB,CAAC;IACDE,WAAW,EAAE;MACXJ,IAAI,EAAEK,MAAM;MACZH,OAAO,EAAE;IACX,CAAC;IACDI,KAAK,EAAE;MACLN,IAAI,EAAEK,MAAM;MACZH,OAAO,EAAE;IACX;EACF,CAAC;EACDK,KAAK,EAAE,CAAC,cAAc,CAAC;EACvBC,KAAKA,CAACV,KAAK,EAAE;IAAEW;EAAK,CAAC,EAAE;IACrB,MAAMC,UAAS,GAAIpB,GAAG,CAAC,KAAK;IAC5B,MAAMqB,kBAAiB,GAAIrB,GAAG,CAAC,KAAK;IACpC,MAAMsB,cAAa,GAAItB,GAAG,CAAC,CAAC;IAC5B,MAAMuB,gBAAe,GAAIvB,GAAG,CAAC,CAAC;IAC9B,MAAMwB,eAAc,GAAIxB,GAAG,CAAC,CAAC;IAC7B,MAAMyB,cAAa,GAAIzB,GAAG,CAAC,EAAE;IAC7B,MAAM0B,MAAK,GAAI1B,GAAG,CAAC,EAAE;IAErB,MAAM2B,gBAAe,GAAIA,CAAA,KAAM;MAC7BP,UAAU,CAACQ,KAAI,GAAI,IAAG;IACxB;IAEA,MAAMC,mBAAkB,GAAI,MAAOC,QAAQ,IAAK;MAC9CC,OAAO,CAACC,GAAG,CAAC,gBAAgB,EAAEF,QAAQ;MACtCT,kBAAkB,CAACO,KAAI,GAAI,IAAG;MAC9BH,cAAc,CAACG,KAAI,GAAI,iBAAgB;MACvCN,cAAc,CAACM,KAAI,GAAI;MACvBL,gBAAgB,CAACK,KAAI,GAAI;MACzBJ,eAAe,CAACI,KAAI,GAAI;MACxBF,MAAM,CAACE,KAAI,GAAI,EAAC;MAEhB,IAAI;QACF,MAAMvB,uBAAuB,CAACyB,QAAQ;MACxC,EAAE,OAAOd,KAAK,EAAE;QACdiB,iBAAiB,CAACjB,KAAK,CAACkB,OAAO;MACjC;IACF;IAEA,MAAMC,cAAa,GAAKC,KAAK,IAAK;MAChC,MAAMC,IAAG,GAAID,KAAK,CAACE,MAAK;MACxBP,OAAO,CAACC,GAAG,CAAC,WAAW,EAAEK,IAAI;MAC7B,IAAIA,IAAI,CAACE,MAAK,KAAM,cAAc,EAAE;QAClCf,eAAe,CAACI,KAAI,GAAIS,IAAI,CAACG,KAAI;MACnC,OAAO,IAAIH,IAAI,CAACE,MAAK,KAAM,UAAU,EAAE;QACrCjB,cAAc,CAACM,KAAI,GAAIS,IAAI,CAACI,QAAO;QACnClB,gBAAgB,CAACK,KAAI,GAAIS,IAAI,CAACK,OAAM;QAC