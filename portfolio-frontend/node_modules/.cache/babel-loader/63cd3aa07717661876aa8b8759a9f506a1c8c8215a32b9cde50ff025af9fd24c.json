ImportModal,\n      headers,\n      priceData,\n      loading,\n      totalItems,\n      itemsPerPage,\n      editDialog,\n      deleteDialog,\n      editedItem,\n      handleTableUpdate,\n      editPrice,\n      closeEditDialog,\n      updatePrice,\n      deletePrice,\n      closeDeleteDialog,\n      confirmDelete\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","getAssetTypes","getBrokers","getSecurities","AddSecurityButton","AddPriceEntryButton","name","components","setup","assetTypes","brokers","securities","selectedAssetTypes","selectedBroker","selectedSecurities","startDate","endDate","loading","priceData","totalItems","itemsPerPage","editDialog","deleteDialog","editedItem","deletedItem","headers","title","key","sortable","value","fetchPriceData","error","console","applyFilters","showImportModal","log","id","date","security","asset_type","currency","price","length","handleTableUpdate","options","editPrice","item","closeEditDialog","updatePrice","deletePrice","closeDeleteDialog","confirmDelete"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\database\\PricesPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid>\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\">\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-select\r\n              v-model=\"selectedAssetTypes\"\r\n              :items=\"assetTypes\"\r\n              label=\"Asset Types\"\r\n              multiple\r\n              chips\r\n              dense\r\n            ></v-select>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-select\r\n              v-model=\"selectedBroker\"\r\n              :items=\"brokers\"\r\n              label=\"Brokers\"\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              dense\r\n            ></v-select>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-select\r\n              v-model=\"selectedSecurities\"\r\n              :items=\"securities\"\r\n              label=\"Securities\"\r\n              multiple\r\n              chips\r\n              item-title=\"name\"\r\n              item-value=\"id\"\r\n              dense\r\n            ></v-select>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-text-field\r\n              v-model=\"startDate\"\r\n              label=\"Start Date\"\r\n              type=\"date\"\r\n              dense\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-text-field\r\n              v-model=\"endDate\"\r\n              label=\"End Date\"\r\n              type=\"date\"\r\n              dense\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"12\" sm=\"6\" md=\"2\">\r\n            <v-btn color=\"primary\" @click=\"applyFilters\" block>\r\n              Apply Filters\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card class=\"mb-4\">\r\n      <v-card-text>\r\n        <v-row align=\"center\" justify=\"space-between\">\r\n          <v-col cols=\"auto\">\r\n            <v-row>\r\n              <v-col cols=\"auto\">\r\n                <AddSecurityButton />\r\n              </v-col>\r\n              <v-col cols=\"auto\">\r\n                <AddPriceEntryButton />\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n          <v-col cols=\"auto\">\r\n            <v-btn color=\"success\" @click=\"showImportModal\">\r\n              Import Prices\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n    </v-card>\r\n\r\n    <v-card>\r\n      <v-data-table\r\n        :headers=\"headers\"\r\n        :items=\"priceData\"\r\n        :loading=\"loading\"\r\n        :items-per-page=\"itemsPerPage\"\