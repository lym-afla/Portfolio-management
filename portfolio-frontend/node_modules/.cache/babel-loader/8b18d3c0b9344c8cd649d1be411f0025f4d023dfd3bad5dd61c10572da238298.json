{"ast":null,"code":"import { ref, computed, watch } from 'vue';\nimport { getSecurities } from '@/services/api';\nexport default {\n  name: 'SecurityMappingDialog',\n  props: {\n    showSecurityMapping: {\n      type: Boolean,\n      default: false\n    },\n    security: String,\n    bestMatch: Object,\n    brokerId: Number\n  },\n  emits: ['security-mapped'],\n  setup(props, {\n    emit\n  }) {\n    console.log('SecurityMappingDialog setup called');\n    const selectedSecurity = ref(null);\n    const securityOptions = computed(() => {\n      console.log('Computing securityOptions, brokerId:', props.brokerId);\n      const securities = getSecurities([], props.brokerId);\n      if (securities.length === 0) {\n        return [];\n      }\n      return securities.map(security => ({\n        id: security.id,\n        name: security.name\n      }));\n    });\n    watch(() => props.showSecurityMapping, newValue => {\n      console.log('showSecurityMapping changed:', newValue);\n    });\n    watch(() => props.security, newValue => {\n      console.log('security changed:', newValue);\n    });\n    watch(() => props.bestMatch, newValue => {\n      console.log('bestMatch changed:', newValue);\n    });\n    watch(() => props.brokerId, newValue => {\n      console.log('brokerId changed:', newValue);\n    });\n    const mapSecurity = () => {\n      console.log('mapSecurity called, selectedSecurity:', selectedSecurity.value);\n      emit('security-mapped', {\n        action: 'map',\n        security_id: selectedSecurity.value\n      });\n    };\n    const skipSecurity = () => {\n      console.log('skipSecurity called');\n      emit('security-mapped', {\n        action: 'skip',\n        security_id: null\n      });\n    };\n    return {\n      selectedSecurity,\n      securityOptions,\n      mapSecurity,\n      skipSecurity\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","getSecurities","name","props","showSecurityMapping","type","Boolean","default","security","String","bestMatch","Object","brokerId","Number","emits","setup","emit","console","log","selectedSecurity","securityOptions","securities","length","map","id","newValue","mapSecurity","value","action","security_id","skipSecurity"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dialogs\\SecurityMappingDialog.vue"],"sourcesContent":["<template>\r\n  <div class=\"mt-4\">\r\n    <p>Debug: showSecurityMapping = {{ showSecurityMapping }}</p>\r\n    <p>Debug: security = {{ security }}</p>\r\n    <p>Debug: bestMatch = {{ JSON.stringify(bestMatch) }}</p>\r\n    <p>Debug: brokerId = {{ brokerId }}</p>\r\n    <v-card v-if=\"showSecurityMapping\">\r\n      <v-card-title>Map Security</v-card-title>\r\n      <v-card-text>\r\n        <p>Unrecognized security: {{ security }}</p>\r\n        <p v-if=\"bestMatch\">Best match: {{ bestMatch.match_name }} (Score: {{ bestMatch.match_score }})</p>\r\n        <v-autocomplete\r\n          v-model=\"selectedSecurity\"\r\n          :items=\"securityOptions\"\r\n          label=\"Select Security\"\r\n          item-text=\"name\"\r\n          item-value=\"id\"\r\n        ></v-autocomplete>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn color=\"primary\" @click=\"mapSecurity\">Map</v-btn>\r\n        <v-btn color=\"error\" @click=\"skipSecurity\">Skip</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch } from 'vue'\r\nimport { getSecurities } from '@/services/api'\r\n\r\nexport default {\r\n  name: 'SecurityMappingDialog',\r\n  props: {\r\n    showSecurityMapping: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    security: String,\r\n    bestMatch: Object,\r\n    brokerId: Number\r\n  },\r\n  emits: ['security-mapped'],\r\n  setup(props, { emit }) {\r\n    console.log('SecurityMappingDialog setup called')\r\n    \r\n    const selectedSecurity = ref(null)\r\n    const securityOptions = computed(() => {\r\n      console.log('Computing securityOptions, brokerId:', props.brokerId)\r\n      const securities = getSecurities([], props.brokerId)\r\n      if (securities.length === 0) {\r\n        return []\r\n      }\r\n      return securities.map(security => ({\r\n        id: security.id,\r\n        name: security.name\r\n      }))\r\n    })\r\n\r\n    watch(() => props.showSecurityMapping, (newValue) => {\r\n      console.log('showSecurityMapping changed:', newValue)\r\n    })\r\n\r\n    watch(() => props.security, (newValue) => {\r\n      console.log('security changed:', newValue)\r\n    })\r\n\r\n    watch(() => props.bestMatch, (newValue) => {\r\n      console.log('bestMatch changed:', newValue)\r\n    })\r\n\r\n    watch(() => props.brokerId, (newValue) => {\r\n      console.log('brokerId changed:', newValue)\r\n    })\r\n\r\n    const mapSecurity = () => {\r\n      console.log('mapSecurity called, selectedSecurity:', selectedSecurity.value)\r\n      emit('security-mapped', {\r\n        action: 'map',\r\n        security_id: selectedSecurity.value\r\n      })\r\n    }\r\n\r\n    const skipSecurity = () => {\r\n      console.log('skipSecurity called')\r\n      emit('security-mapped', {\r\n        action: 'skip',\r\n        security_id: null\r\n      })\r\n    }\r\n\r\n    return {\r\n      selectedSecurity,\r\n      securityOptions,\r\n      mapSecurity,\r\n      skipSecurity,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA6BA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAI,QAAS,KAAI;AACzC,SAASC,aAAY,QAAS,gBAAe;AAE7C,eAAe;EACbC,IAAI,EAAE,uBAAuB;EAC7BC,KAAK,EAAE;IACLC,mBAAmB,EAAE;MACnBC,IAAI,EAAEC,OAAO;MACbC,OAAO,EAAE;IACX,CAAC;IACDC,QAAQ,EAAEC,MAAM;IAChBC,SAAS,EAAEC,MAAM;IACjBC,QAAQ,EAAEC;EACZ,CAAC;EACDC,KAAK,EAAE,CAAC,iBAAiB,CAAC;EAC1BC,KAAKA,CAACZ,KAAK,EAAE;IAAEa;EAAK,CAAC,EAAE;IACrBC,OAAO,CAACC,GAAG,CAAC,oCAAoC;IAEhD,MAAMC,gBAAe,GAAIrB,GAAG,CAAC,IAAI;IACjC,MAAMsB,eAAc,GAAIrB,QAAQ,CAAC,MAAM;MACrCkB,OAAO,CAACC,GAAG,CAAC,sCAAsC,EAAEf,KA