\n      type: Boolean,\r\n      default: false\r\n    },\r\n    security: String,\r\n    bestMatch: Object,\r\n    brokerId: Number\r\n  },\r\n  emits: ['security-selected'],\r\n  setup(props, { emit }) {\r\n    console.log('SecurityMappingDialog setup called')\r\n    \r\n    const selectedSecurity = ref(null)\r\n    const securityOptions = ref([])\r\n    const loadingSecurities = ref(false)\r\n    const securityError = ref(null)\r\n\r\n    const fetchSecurities = async () => {\r\n      loadingSecurities.value = true\r\n      securityError.value = null\r\n      try {\r\n        console.log('Fetching securities for brokerId:', props.brokerId)\r\n        const securities = await getSecurities([], props.brokerId)\r\n        console.log('Fetched securities:', securities)\r\n        if (Array.isArray(securities)) {\r\n          securityOptions.value = securities.map(security => ({\r\n            id: security.id,\r\n            name: security.name\r\n          }))\r\n          selectedSecurity.value = props.bestMatch.match_id\r\n          console.log(\"Assigning value to Select\", props.bestMatch.match_id, props.bestMatch.match_name, selectedSecurity.value)\r\n        } else {\r\n          console.error('Fetched securities is not an array:', securities)\r\n          securityError.value = 'Invalid data received from server'\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching securities:', error)\r\n        securityError.value = 'Failed to fetch securities'\r\n      } finally {\r\n        loadingSecurities.value = false\r\n      }\r\n    }\r\n\r\n    watch(() => props.brokerId, (newValue) => {\r\n      console.log('brokerId changed:', newValue)\r\n      if (newValue) {\r\n        fetchSecurities()\r\n      }\r\n    }, { immediate: true })\r\n\r\n    watch(() => selectedSecurity.value, (newValue) => {\r\n      emit('security-selected', newValue)\r\n    })\r\n\r\n    const mapSecurity = () => {\r\n      console.log('mapSecurity called, selectedSecurity:', selectedSecurity.value)\r\n      emit('security-mapped', {\r\n        action: 'map',\r\n        security_id: selectedSecurity.value\r\n      })\r\n    }\r\n\r\n    const skipSecurity = () => {\r\n      console.log('skipSecurity called')\r\n      emit('security-mapped', {\r\n        action: 'skip',\r\n        security_id: null\r\n      })\r\n    }\r\n\r\n    return {\r\n      selectedSecurity,\r\n      securityOptions,\r\n      loadingSecurities,\r\n      securityError,\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":";;EACOA,KAAK,EAAC;AAAM;;EADnBC,GAAA;AAAA;;;;;;uBACEC,mBAAA,CAkBM,OAlBNC,UAkBM,GAjBUC,MAAA,CAAAC,mBAAmB,I,cAAjCC,YAAA,CAgBSC,iBAAA;IAlBbN,GAAA;EAAA;IAAAO,OAAA,EAAAC,QAAA,CAGM,MAAyC,CAAzCC,YAAA,CAAyCC,uBAAA;MAH/CH,OAAA,EAAAC,QAAA,CAGoB,MAAY,CAHhCG,gBAAA,CAGoB,cAAY,E;MAHhCC,CAAA;QAIMH,YAAA,CAacI,sBAAA;MAjBpBN,OAAA,EAAAC,QAAA,CAKQ,MAA4C,CAA5CM,mBAAA,CAA4C,WAAzC,yBAAuB,GAAAC,gBAAA,CAAGZ,MAAA,CAAAa,QAAQ,kBAC5Bb,MAAA,CAAAc,SAAS,I,cAAlBhB,mBAAA,CAAmG,KAN3GiB,UAAA,EAM4B,cAAY,GAAAH,gBAAA,CAAGZ,MAAA,CAAAc,SAAS,CAACE,UAAU,IAAG,WAAS,GAAAJ,gBAAA,CAAGZ,MAAA,CAAAc,SAAS,CAACG,WAAW,IAAG,GAAC,mBANvGC,mBAAA,gBAOQZ,YAAA,CASkBa,yBAAA;QAhB1BC,UAAA,EAQmBC,MAAA,CAAAC,gBAAgB;QARnC,uBAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAQmBH,MAAA,CAAAC,gBAAgB,GAAAE,MAAA;QACxBC,KAAK,EAAEJ,MAAA,CAAAK,eAAe;QACvBC,KAAK,EAAC,iBAAiB;QACvB,YAAU,EAAC,MAAM;QACjB,YAAU,EAAC,IAAI;QACdC,OAAO,EAAEP,MAAA,CAAAQ,iBAAiB;QAC1BC,QAAQ,EAAET,MAAA,CAAAQ,iBAAiB;QAC3B,gBAAc,EAAER,MAAA,CAAAU;;MAf3BtB,CAAA;;IAAAA,CAAA;QAAAS,mBAAA,e","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}