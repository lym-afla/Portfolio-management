{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nexport default {\n  name: 'ClosedPositions',\n  emits: ['update-page-title'],\n  setup(props, {\n    emit\n  }) {\n    const closedPositions = ref([]);\n    const totals = ref({});\n    const loading = ref(true);\n    const tableLoading = ref(true);\n    const selectedYear = ref('YTD');\n    const yearOptions = ref([]);\n    const headers = [{\n      title: 'Type',\n      key: 'type',\n      align: 'start'\n    }, {\n      title: 'Name',\n      key: 'name',\n      align: 'start'\n    }, {\n      title: 'Currency',\n      key: 'currency',\n      align: 'center'\n    }, {\n      title: 'Max position',\n      key: 'max_position',\n      align: 'center'\n    }, {\n      title: 'Entry Date',\n      key: 'investment_date',\n      align: 'center'\n    }, {\n      title: 'Entry Value',\n      key: 'entry_value',\n      align: 'center'\n    }, {\n      title: 'Exit Date',\n      key: 'exit_date',\n      align: 'center'\n    }, {\n      title: 'Exit Value',\n      key: 'exit_value',\n      align: 'center'\n    }, {\n      title: 'Realized G/L',\n      key: 'realized_gl',\n      align: 'center'\n    }, {\n      title: 'Realized G/L %',\n      key: 'price_change_percentage',\n      align: 'center'\n    }, {\n      title: 'Capital Distribution',\n      key: 'capital_distribution',\n      align: 'center'\n    }, {\n      title: 'Capital Distribution %',\n      key: 'capital_distribution_percentage',\n      align: 'center'\n    }, {\n      title: 'Commission',\n      key: 'commission',\n      align: 'center'\n    }, {\n      title: 'Commission %',\n      key: 'commission_percentage',\n      align: 'center'\n    }, {\n      title: 'Total Return',\n      key: 'total_return_amount',\n      align: 'center'\n    }, {\n      title: 'Total Return %',\n      key: 'total_return_percentage',\n      align: 'center'\n    }, {\n      title: 'IRR',\n      key: 'irr',\n      align: 'center'\n    }];\n    const fetchClosedPositions = async () => {\n      tableLoading.value = true;\n      try {\n        const response = await axios.post('/closed_positions/api/get_closed_positions_table/', {\n          timespan: selectedYear.value\n        });\n        closedPositions.value = response.data.portfolio_closed;\n        totals.value = response.data.portfolio_closed_totals;\n      } catch (error) {\n        console.error('Error fetching closed positions:', error);\n      } finally {\n        tableLoading.value = false;\n      }\n    };\n    const handleYearChange = newValue => {\n      selectedYear.value = newValue;\n      fetchClosedPositions();\n    };\n    const fetchYearOptions = async () => {\n      try {\n        const response = await axios.get('/closed_positions/api/get_year_options/');\n        yearOptions.value = response.data.closed_table_years.map(year => {\n          if (typeof year === 'string') {\n            return {\n              text: year,\n              value: year\n            };\n          }\n          return year; // For divider and special options\n        });\n      } catch (error) {\n        console.error('Error fetching year options:', error);\n      }\n    };\n    const fetchData = async () => {\n      loading.value = true;\n      await Promise.all([fetchYearOptions(), fetchClosedPositions()]);\n      loading.value = false;\n    };\n    onMounted(() => {\n      fetchData();\n      emit('update-page-title', 'Closed Positions');\n    });\n    onUnmounted(() => {\n      emit('update-page-title', ''); // Clear the page title when component is unmounted\n    });\n    return {\n      closedPositions,\n      totals,\n      loading,\n      tableLoading,\n      headers,\n      selectedYear,\n      yearOptions,\n      handleYearChange\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","axios","name","emits","setup","props","emit","closedPositions","totals","loading","tableLoading","selectedYear","yearOptions","headers","title","key","align","fetchClosedPositions","value","response","post","timespan","data","portfolio_closed","portfolio_closed_totals","error","console","handleYearChange","newValue","fetchYearOptions","get","closed_table_years","map","year","text","fetchData","Promise","all"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\views\\ClosedPositionsPage.vue"],"sourcesContent":["<template>\r\n  <v-container fluid>\r\n    <v-overlay :model-value=\"loading\" class=\"align-center justify-center\">\r\n      <v-progress-circular color=\"primary\" indeterminate size=\"64\"></v-progress-circular>\r\n    </v-overlay>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\" md=\"3\" lg=\"2\">\r\n        <v-select\r\n          v-model=\"selectedYear\"\r\n          :items=\"yearOptions\"\r\n          item-title=\"text\"\r\n          item-value=\"value\"\r\n          label=\"Year\"\r\n          @update:model-value=\"handleYearChange\"\r\n          density=\"compact\"\r\n        >\r\n          <template v-slot:item=\"{ item, props }\">\r\n            <v-list-item\r\n              v-if=\"!item.raw.divider\"\r\n              v-bind=\"props\"\r\n              :title=\"item.title\"\r\n            ></v-list-item>\r\n            <v-divider v-else class=\"my-2\"></v-divider>\r\n          </template>\r\n        </v-select>\r\n      </v-col>\r\n    </v-row>\r\n\r\n    <v-row>\r\n      <v-col cols=\"12\">\r\n        <v-data-table\r\n          :headers=\"headers\"\r\n          :items=\"closedPositions\"\r\n          :loading=\"tableLoading\"\r\n          class=\"elevation-1\"\r\n        >\r\n          <template v-slot:top>\r\n            <v-toolbar flat>\r\n              <v-toolbar-title>Closed Positions</v-toolbar-title>\r\n            </v-toolbar>\r\n          </template>\r\n\r\n          <template v-slot:footer>\r\n            <tr>\r\n              <td colspan=\"2\" class=\"text-right font-weight-bold\">TOTAL</td>\r\n              <td></td>\r\n              <td></td>\r\n              <td></td>\r\n              <td class=\"text-center font-weight-bold\">{{ totals.entry_value }}</td>\r\n              <td></td>\r\n              <td></td>\r\n              <td class=\"text-center font-weight-bold\">{{ totals.exit_value }}</td>\r\n              <td></td>\r\n              <td class=\"text-center font-weight-bold\">{{ totals.realized_gl }}</td>\r\n              <td class=\"text-center font-weight-bold font-italic\">\r\n                {{ totals.price_change_percentage }}\r\n              </td>\r\n              <td></td>\r\n              <td class=\"text-center font-weight-bold\">\r\n                {{ totals.capital_distribution }}\r\n              </td>\r\n              <td class=\"text-center font-weight-bold font-italic\">\r\n                {{ totals.capital_distribution_percentage }}\r\n              </td>\r\n              <td></td>\r\n              <td class=\"text-center font-weight-bold\">{{ totals.commission }}</td>\r\n              <td class=\"text-center font-weight-bold font-italic\">\r\n                {{ totals.commission_percentage }}\r\n              </td>\r\n              <td></td>\r\n              <td class=\"text-center font-weight-bold\">\r\n                {{ totals.total_return_amount }}\r\n              </td>\r\n              <td class=\"text-center font-weight-bold font-italic\">\r\n                {{ totals.total_return_percentage }}\r\n              </td>\r\n            </tr>\r\n          </template>\r\n        </v-data-table>\r\n      </v-col>\r\n    </v-row>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted } from 'vue'\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'ClosedPositions',\r\n  emits: ['update-page-title'],\r\n  setup(props, { emit }) {\r\n    const closedPositions = ref([])\r\n    const totals = ref({})\r\n    const loading = ref(true)\r\n    const tableLoading = ref(true)\r\n    const selectedYear = ref('YTD')\r\n    const yearOptions = ref([])\r\n\r\n    const headers = [\r\n      { title: 'Type', key: 'type', align: 'start' },\r\n      { title: 'Name', key: 'name', align: 'start' },\r\n      { title: 'Currency', key: 'currency', align: 'center' },\r\n      { title: 'Max position', key: 'max_position', align: 'center' },\r\n      { title: 'Entry Date', key: 'investment_date', align: 'center' },\r\n      { title: 'Entry Value', key: 'entry_value', align: 'center' },\r\n      { title: 'Exit Date', key: 'exit_date', align: 'center' },\r\n      { title: 'Exit Value', key: 'exit_value', align: 'center' },\r\n      { title: 'Realized G/L', key: 'realized_gl', align: 'center' },\r\n      { title: 'Realized G/L %', key: 'price_change_percentage', align: 'center' },\r\n      { title: 'Capital Distribution', key: 'capital_distribution', align: 'center' },\r\n      { title: 'Capital Distribution %', key: 'capital_distribution_percentage', align: 'center' },\r\n      { title: 'Commission', key: 'commission', align: 'center' },\r\n      { title: 'Commission %', key: 'commission_percentage', align: 'center' },\r\n      { title: 'Total Return', key: 'total_return_amount', align: 'center' },\r\n      { title: 'Total Return %', key: 'total_return_percentage', align: 'center' },\r\n      { title: 'IRR', key: 'irr', align: 'center' },\r\n    ]\r\n\r\n    const fetchClosedPositions = async () => {\r\n      tableLoading.value = true\r\n      try {\r\n        const response = await axios.post(\r\n          '/closed_positions/api/get_closed_positions_table/',\r\n          {\r\n            timespan: selectedYear.value,\r\n          }\r\n        )\r\n        closedPositions.value = response.data.portfolio_closed\r\n        totals.value = response.data.portfolio_closed_totals\r\n      } catch (error) {\r\n        console.error('Error fetching closed positions:', error)\r\n      } finally {\r\n        tableLoading.value = false\r\n      }\r\n    }\r\n\r\n    const handleYearChange = (newValue) => {\r\n      selectedYear.value = newValue\r\n      fetchClosedPositions()\r\n    }\r\n\r\n    const fetchYearOptions = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          '/closed_positions/api/get_year_options/'\r\n        )\r\n        yearOptions.value = response.data.closed_table_years.map(year => {\r\n          if (typeof year === 'string') {\r\n            return { text: year, value: year }\r\n          }\r\n          return year  // For divider and special options\r\n        })\r\n      } catch (error) {\r\n        console.error('Error fetching year options:', error)\r\n      }\r\n    }\r\n\r\n    const fetchData = async () => {\r\n      loading.value = true\r\n      await Promise.all([fetchYearOptions(), fetchClosedPositions()])\r\n      loading.value = false\r\n    }\r\n\r\n    onMounted(() => {\r\n      fetchData()\r\n      emit('update-page-title', 'Closed Positions')\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      emit('update-page-title', '') // Clear the page title when component is unmounted\r\n    })\r\n\r\n    return {\r\n      closedPositions,\r\n      totals,\r\n      loading,\r\n      tableLoading,\r\n      headers,\r\n      selectedYear,\r\n      yearOptions,\r\n      handleYearChange,\r\n    }\r\n  },\r\n}\r\n</script>"],"mappings":"AAsFA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAChD,OAAOC,KAAI,MAAO,OAAM;AAExB,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IACrB,MAAMC,eAAc,GAAIT,GAAG,CAAC,EAAE;IAC9B,MAAMU,MAAK,GAAIV,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMW,OAAM,GAAIX,GAAG,CAAC,IAAI;IACxB,MAAMY,YAAW,GAAIZ,GAAG,CAAC,IAAI;IAC7B,MAAMa,YAAW,GAAIb,GAAG,CAAC,KAAK;IAC9B,MAAMc,WAAU,GAAId,GAAG,CAAC,EAAE;IAE1B,MAAMe,OAAM,GAAI,CACd;MAAEC,KAAK,EAAE,MAAM;MAAEC,GAAG,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAQ,CAAC,EAC9C;MAAEF,KAAK,EAAE,MAAM;MAAEC,GAAG,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAQ,CAAC,EAC9C;MAAEF,KAAK,EAAE,UAAU;MAAEC,GAAG,EAAE,UAAU;MAAEC,KAAK,EAAE;IAAS,CAAC,EACvD;MAAEF,KAAK,EAAE,cAAc;MAAEC,GAAG,EAAE,cAAc;MAAEC,K