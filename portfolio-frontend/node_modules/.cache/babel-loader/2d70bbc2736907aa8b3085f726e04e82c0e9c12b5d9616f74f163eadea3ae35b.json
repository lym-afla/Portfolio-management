{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { Pie } from 'vue-chartjs';\nimport { Chart as ChartJS, Title, Tooltip, ArcElement, CategoryScale } from 'chart.js';\nimport ChartDataLabels from 'chartjs-plugin-datalabels';\nChartJS.register(Title, Tooltip, ArcElement, CategoryScale, ChartDataLabels);\nexport default {\n  name: 'BreakdownChart',\n  components: {\n    Pie\n  },\n  props: {\n    title: {\n      type: String,\n      required: true\n    },\n    data: {\n      type: Object,\n      required: true\n    },\n    currency: {\n      type: String,\n      required: true\n    }\n  },\n  setup(props) {\n    const tab = ref('chart');\n    console.log(\"BreakdownChart.vue. props.data\", props.data);\n    const sortedData = computed(() => {\n      return Object.entries(props.data.data).map(([label, value]) => ({\n        label,\n        value,\n        percentage: props.data.percentage[label]\n      })).sort((a, b) => parseFloat(b.value.replace(/[^0-9.-]+/g, \"\")) - parseFloat(a.value.replace(/[^0-9.-]+/g, \"\")));\n    });\n    const pieChartOptions = computed(() => ({\n      responsive: true,\n      maintainAspectRatio: false,\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          enabled: true,\n          callbacks: {\n            label: context => {\n              const label = context.label || '';\n              const value = context.parsed || 0;\n              const percentage = props.data.percentage[label] || '0%';\n              return `${label}: ${props.currency} ${value.toLocaleString()} (${percentage})`;\n            }\n          }\n        },\n        datalabels: {\n          color: '#fff',\n          font: {\n            weight: 'bold',\n            size: 12\n          },\n          formatter: (value, context) => {\n            const label = context.chart.data.labels[context.dataIndex];\n            const percentage = props.data.percentage[label] || '0%';\n            return `${label}\\n${percentage}`;\n          },\n          textAlign: 'center'\n        }\n      }\n    }));\n    const chartData = computed(() => ({\n      labels: sortedData.value.map(item => item.label),\n      datasets: [{\n        data: sortedData.value.map(item => parseFloat(item.value.replace(/[^0-9.-]+/g, \"\")))\n        // backgroundColor: colorPalette\n      }]\n    }));\n    return {\n      tab,\n      chartData,\n      pieChartOptions,\n      sortedData,\n      props // Expose props to the template\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","Pie","Chart","ChartJS","Title","Tooltip","ArcElement","CategoryScale","ChartDataLabels","register","name","components","props","title","type","String","required","data","Object","currency","setup","tab","console","log","sortedData","entries","map","label","value","percentage","sort","a","b","parseFloat","replace","pieChartOptions","responsive","maintainAspectRatio","plugins","legend","display","tooltip","enabled","callbacks","context","parsed","toLocaleString","datalabels","color","font","weight","size","formatter","chart","labels","dataIndex","textAlign","chartData","item","datasets"],"sources":["D:\\Programming\\Portfolio-management\\portfolio-frontend\\src\\components\\dashboard\\BreakdownChart.vue"],"sourcesContent":["<template>\r\n  <v-card class=\"h-100\">\r\n    <v-card-title>{{ title }}</v-card-title>\r\n    <v-card-text class=\"pa-0 h-100\">\r\n      <v-tabs v-model=\"tab\">\r\n        <v-tab value=\"chart\">Pie Chart</v-tab>\r\n        <v-tab value=\"table\">Table</v-tab>\r\n      </v-tabs>\r\n\r\n      <v-window v-model=\"tab\" class=\"h-100\">\r\n        <v-window-item value=\"chart\" class=\"h-100\">\r\n          <div class=\"chart-wrapper h-100\">\r\n            <Pie :data=\"chartData\" :options=\"pieChartOptions\" />\r\n          </div>\r\n        </v-window-item>\r\n\r\n        <v-window-item value=\"table\">\r\n          <v-table density=\"compact\">\r\n            <thead>\r\n              <tr>\r\n                <th class=\"text-left category-column\"></th>\r\n                <th class=\"text-right font-weight-bold\">{{ currency }}</th>\r\n                <th class=\"text-right font-weight-bold\">%</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr v-for=\"(item, index) in sortedData\" :key=\"index\">\r\n                <td class=\"text-left category-column\">{{ item.label }}</td>\r\n                <td class=\"text-right\">{{ item.value }}</td>\r\n                <td class=\"text-right\">{{ item.percentage }}</td>\r\n              </tr>\r\n              <tr class=\"font-weight-bold\">\r\n                <td class=\"text-left category-column\">Total</td>\r\n                <td class=\"text-right\">{{ props.data.totalNAV }}</td>\r\n                <td class=\"text-right\">100%</td>\r\n              </tr>\r\n            </tbody>\r\n          </v-table>\r\n        </v-window-item>\r\n      </v-window>\r\n    </v-card-text>\r\n  </v-card>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport { Pie } from 'vue-chartjs'\r\nimport { Chart as ChartJS, Title, Tooltip, ArcElement, CategoryScale } from 'chart.js'\r\nimport ChartDataLabels from 'chartjs-plugin-datalabels'\r\n\r\nChartJS.register(Title, Tooltip, ArcElement, CategoryScale, ChartDataLabels)\r\n\r\nexport default {\r\n  name: 'BreakdownChart',\r\n  components: { Pie },\r\n  props: {\r\n    title: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    data: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    currency: {\r\n      type: String,\r\n      required: true\r\n    }\r\n  },\r\n  setup(props) {\r\n    const tab = ref('chart')\r\n\r\n    console.log(\"BreakdownChart.vue. props.data\", props.data)\r\n\r\n    const sortedData = computed(() => {\r\n      return Object.entries(props.data.data)\r\n        .map(([label, value]) => ({ \r\n          label, \r\n          value,\r\n          percentage: props.data.percentage[label]\r\n        }))\r\n        .sort((a, b) => parseFloat(b.value.replace(/[^0-9.-]+/g,\"\")) - parseFloat(a.value.replace(/[^0-9.-]+/g,\"\")))\r\n    })\r\n\r\n    const pieChartOptions = computed(() => ({\r\n      responsive: true,\r\n      maintainAspectRatio: false,\r\n      plugins: {\r\n        legend: {\r\n          display: false\r\n        },\r\n        tooltip: {\r\n          enabled: true,\r\n          callbacks: {\r\n            label: (context) => {\r\n              const label = context.label || '';\r\n              const value = context.parsed || 0;\r\n              const percentage = props.data.percentage[label] || '0%';\r\n              return `${label}: ${props.currency} ${value.toLocaleString()} (${percentage})`;\r\n            }\r\n          }\r\n        },\r\n        datalabels: {\r\n          color: '#fff',\r\n          font: {\r\n            weight: 'bold',\r\n            size: 12\r\n          },\r\n          formatter: (value, context) => {\r\n            const label = context.chart.data.labels[context.dataIndex];\r\n            const percentage = props.data.percentage[label] || '0%';\r\n            return `${label}\\n${percentage}`;\r\n          },\r\n          textAlign: 'center'\r\n        }\r\n      }\r\n    }))\r\n\r\n    const chartData = computed(() => ({\r\n      labels: sortedData.value.map(item => item.label),\r\n      datasets: [{\r\n        data: sortedData.value.map(item => parseFloat(item.value.replace(/[^0-9.-]+/g,\"\"))),\r\n        // backgroundColor: colorPalette\r\n      }]\r\n    }))\r\n\r\n    return {\r\n      tab,\r\n      chartData,\r\n      pieChartOptions,\r\n      sortedData,\r\n      props // Expose props to the template\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.category-column {\r\n  width: 50%;\r\n}\r\n\r\n.v-table :deep(th) {\r\n  font-weight: bold !important;\r\n}\r\n\r\n.v-table :deep(td), .v-table :deep(th) {\r\n  padding: 0 16px !important;\r\n}\r\n\r\n.chart-wrapper {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>"],"mappings":"AA6CA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,GAAE,QAAS,aAAY;AAChC,SAASC,KAAI,IAAKC,OAAO,EAAEC,KAAK,EAAEC,OAAO,EAAEC,UAAU,EAAEC,aAAY,QAAS,UAAS;AACrF,OAAOC,eAAc,MAAO,2BAA0B;AAEtDL,OAAO,CAACM,QAAQ,CAACL,KAAK,EAAEC,OAAO,EAAEC,UAAU,EAAEC,aAAa,EAAEC,eAAe;AAE3E,eAAe;EACbE,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAEV;EAAI,CAAC;EACnBW,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,IAAI,EAAE;MACJH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ,CAAC;IACDG,QAAQ,EAAE;MACRL,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDI,KAAKA,CAACR,KAAK,EAAE;IACX,MAAMS,GAAE,GAAItB,GAAG,CAAC,OAAO;IAEvBuB,OAAO,CAACC,GAAG,CAAC,gCAAgC,EAAEX,KAAK,CAACK,IAAI;IAExD,MAAMO,UAAS,GAAIxB,QAAQ,CAAC,MAAM;MAChC,OAAOkB,MAAM,CAACO,OAAO,CAACb,KAAK,CAACK,IAAI,CAACA,IAAI,EAClCS,GAAG,CAAC,CAAC,CAACC,KAAK,EAAEC,KAAK,CAAC,MAAM;QACxBD,KAAK;QACLC,KAAK;QACLC,UAAU,EAAEjB,KAAK,CAACK,IAAI,CAACY,UAAU,CAACF,KAAK;MACzC,CAAC,CAAC,EACDG,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKC,UAAU,CAACD,CAAC,CAACJ,KAAK,CAACM,OAAO,CAAC,YAAY,EAAC,EAAE,CAAC,IAAID,UAAU,CAACF,CAAC,CAACH,KAAK,CAACM,OAAO,CAAC,YAAY,EAAC,EAAE,CAAC,CAAC;IAC/G,CAAC;IAED,MAAMC,eAAc,GAAInC,QAAQ,CAAC,OAAO;MACtCoC,UAAU,EAAE,IAAI;MAChBC,mBAAmB,EAAE,KAAK;MAC1BC,OAAO,EAAE;QACPC,MAAM,EAAE;UACNC,OAAO,EAAE;QACX,CAAC;QACDC,OAAO,EAAE;UACPC,OAAO,EAAE,IAAI;UACbC,SAAS,EAAE;YACThB,KAAK,EAAGiB,OAAO,IAAK;cAClB,MAAMjB,KAAI,GAAIiB,OAAO,CAACjB,KAAI,IAAK,EAAE;cACjC,MAAMC,KAAI,GAAIgB,OAAO,CAACC,MAAK,IAAK,CAAC;cACjC,MAAMhB,UAAS,GAAIjB,KAAK,CAACK,IAAI,CAACY,UAAU,CAACF,KAAK,KAAK,IAAI;cACvD,OAAO,GAAGA,KAAK,KAAKf,KAAK,CAACO,QAAQ,IAAIS,KAAK,CAACkB,cAAc,CAAC,CAAC,KAAKjB,UAAU,GAAG;YAChF;UACF;QACF,CAAC;QACDkB,UAAU,EAAE;UACVC,KAAK,EAAE,MAAM;UACbC,IAAI,EAAE;YACJC,MAAM,EAAE,MAAM;YACdC,IAAI,EAAE;UACR,CAAC;UACDC,SAAS,EAAEA,CAACxB,KAAK,EAAEgB,OAAO,KAAK;YAC7B,MAAMjB,KAAI,GAAIiB,OAAO,CAACS,KAAK,CAACpC,IAAI,CAACqC,MAAM,CAACV,OAAO,CAACW,SAAS,CAAC;YAC1D,MAAM1B,UAAS,GAAIjB,KAAK,CAACK,IAAI,CAACY,UAAU,CAACF,KA